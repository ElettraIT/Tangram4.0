      *    *===========================================================*
      *    * Routine di sort preliminare                               *
      *    *-----------------------------------------------------------*
       exe-rou-srt-000.
      *              *-------------------------------------------------*
      *              * Flag di sort eseguito a : Si'                   *
      *              *-------------------------------------------------*
           move      "#"                  to   w-cnt-exe-rou-srt      .
      *              *-------------------------------------------------*
      *              * Esecuzione sort                                 *
      *              *-------------------------------------------------*
           sort      srt                  on   ascending srt-key
                     input  procedure     is   stp-srt-inp-000
                                          thru stp-srt-inp-999
                     output procedure     is   prn-rou-pri-000
                                          thru prn-rou-pri-999        .
       exe-rou-srt-999.
           exit.

      *    *===========================================================*
      *    * Input procedure per sort                                  *
      *    *-----------------------------------------------------------*
       stp-srt-inp-000.
      *              *-------------------------------------------------*
      *              * Pre scansione                                   *
      *              *-------------------------------------------------*
      *                  *---------------------------------------------*
      *                  * Subroutine                                  *
      *                  *---------------------------------------------*
           perform   stp-srt-inp-pre-000  thru stp-srt-inp-pre-999    .
      *                  *---------------------------------------------*
      *                  * Test su esito scansione                     *
      *                  *---------------------------------------------*
           if        w-det-doc-add-ctr    =    zero
                     go to stp-srt-inp-900.
       stp-srt-inp-100.
      *              *-------------------------------------------------*
      *              * Start su file [fit]                             *
      *              *-------------------------------------------------*
           move      "SK"                 to   f-ope                  .
           move      "NL"                 to   f-cfr                  .
           move      "IDEDOC    "         to   f-key                  .
           move      rr-dtr-min           to   rf-fit-dat-doc         .
           move      rr-dpz-inu           to   rf-fit-cod-dpz         .
           move      zero                 to   rf-fit-num-doc         .
           move      spaces               to   rf-fit-cod-tmo         .
           move      zero                 to   rf-fit-num-prt         .
           move      "pgm/fat/fls/ioc/obj/ioffit"
                                          to   s-pat                  .
           call      "swd/mod/prg/obj/mfiltp"
                                         using s                      .
           call      s-pat               using f
                                               rf-fit                 .
      *                  *---------------------------------------------*
      *                  * Test su esito operazione                    *
      *                  *---------------------------------------------*
           if        f-sts                not  = e-not-err
                     go to stp-srt-inp-900.
       stp-srt-inp-200.
      *              *-------------------------------------------------*
      *              * Indicatore di programma in esecuzione           *
      *              *-------------------------------------------------*
           move      "IE"                 to   s-ope                  .
           call      "swd/mod/prg/obj/msegrt"
                                         using s                      .
      *              *-------------------------------------------------*
      *              * Lettura sequenziale record [fit]                *
      *              *-------------------------------------------------*
           move      "RN"                 to   f-ope                  .
           move      "pgm/fat/fls/ioc/obj/ioffit"
                                          to   s-pat                  .
           call      "swd/mod/prg/obj/mfiltp"
                                         using s                      .
           call      s-pat               using f
                                               rf-fit                 .
      *                  *---------------------------------------------*
      *                  * Test se 'At End'                            *
      *                  *---------------------------------------------*
           if        f-sts                not  = e-not-err
                     go to stp-srt-inp-900.
       stp-srt-inp-300.
      *              *-------------------------------------------------*
      *              * Test sul massimo                                *
      *              *-------------------------------------------------*
      *                  *---------------------------------------------*
      *                  * Test su data documento                      *
      *                  *---------------------------------------------*
           if        rf-fit-dat-doc       >    rr-dtr-max
                     go to stp-srt-inp-900.
       stp-srt-inp-400.
      *              *-------------------------------------------------*
      *              * Selezioni sul record                            *
      *              *-------------------------------------------------*
      *                  *---------------------------------------------*
      *                  * Lettura tabella fatture con addebito spese  *
      *                  *---------------------------------------------*
           set       w-det-doc-add-inx    to   1                      .
           search    w-det-doc-add-ele
                     when    w-det-doc-add-cli
                            (w-det-doc-add-inx)
                                          =    rf-fit-cod-cli and
                             w-det-doc-add-dat
                            (w-det-doc-add-inx)
                                          =    rf-fit-dat-doc and
                             w-det-doc-add-fop
                            (w-det-doc-add-inx)
                                          =    rf-fit-cod-fop and
                             w-det-doc-add-add
                            (w-det-doc-add-inx)
                                          =    rf-fit-add-spi
                     go to   stp-srt-inp-410.
      *                  *---------------------------------------------*
      *                  * Se record non trovato: selezione non su-    *
      *                  * perata                                      *
      *                  *---------------------------------------------*
           go to     stp-srt-inp-200.
       stp-srt-inp-410.
      *                  *---------------------------------------------*
      *                  * Se record trovato: test sul contatore       *
      *                  *---------------------------------------------*
           if        w-det-doc-add-cta
                    (w-det-doc-add-inx)   not  > 1
                     go to stp-srt-inp-200.
       stp-srt-inp-415.
      *                  *---------------------------------------------*
      *                  * Test su codice dipendenza                   *
      *                  *---------------------------------------------*
           if        rf-fit-cod-dpz       not  = rr-dpz-inu
                     go to stp-srt-inp-200.
      *                  *---------------------------------------------*
      *                  * Test su codice archivio                     *
      *                  *---------------------------------------------*
           if        rr-cod-cli           not  = zero   and
                     rf-fit-cod-cli       not  = rr-cod-cli
                     go to stp-srt-inp-200
           else      go to stp-srt-inp-420.
       stp-srt-inp-420.
      *                  *---------------------------------------------*
      *                  * Test su dipendenza archivio                 *
      *                  *---------------------------------------------*
           if        rr-cod-cli           =    zero
                     go to stp-srt-inp-440.
           if        rr-dpz-cli           =    "*   "
                     go to stp-srt-inp-440.
           if        rf-fit-dpz-cli       not  = rr-dpz-cli
                     go to stp-srt-inp-200.
       stp-srt-inp-440.
      *                  *---------------------------------------------*
      *                  * Test su presenza di spese incasso           *
      *                  *---------------------------------------------*
           if        rf-fit-add-spi       =    spaces
                     go to stp-srt-inp-200.
           if        rf-fit-tot-sic       =    zero
                     go to stp-srt-inp-200.
       stp-srt-inp-500.
      *              *-------------------------------------------------*
      *              * Lettura record [dcc]                            *
      *              *-------------------------------------------------*
           if        rf-fit-dpz-cli       =    spaces
                     move  "C"            to   w-let-arc-dcc-tle
           else      move  "D"            to   w-let-arc-dcc-tle      .
           move      rf-fit-cod-cli       to   w-let-arc-dcc-cod      .
           move      rf-fit-dpz-cli       to   w-let-arc-dcc-dpz      .
           perform   let-arc-dcc-000      thru let-arc-dcc-999        .
       stp-srt-inp-600.
      *              *-------------------------------------------------*
      *              * Preparazione record di Sort                     *
      *              *-------------------------------------------------*
      *                  *---------------------------------------------*
      *                  * Normalizzazione iniziale                    *
      *                  *---------------------------------------------*
           move      spaces               to   srt-rec                .
      *                  *---------------------------------------------*
      *                  * Chiave di sort                              *
      *                  *---------------------------------------------*
           move      w-let-arc-dcc-rsu    to   srt-rag-key            .
           move      rf-fit-cod-cli       to   srt-cod-cli            .
           move      rf-fit-dpz-cli       to   srt-dpz-cli            .
           move      rf-fit-cod-fop       to   srt-cod-fop            .
           move      rf-fit-dat-doc       to   srt-dat-doc            .
      *                  *---------------------------------------------*
      *                  * Dati di sort                                *
      *                  *---------------------------------------------*
           move      rf-fit-num-prt       to   srt-num-prt            .
           move      w-let-arc-dcc-rag    to   srt-rag-cli            .
