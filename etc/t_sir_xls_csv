#!/usr/bin/perl -w
#===============================================================*
#                                                               *
# Traduttore in formato Spreadsheet (da Excel a CSV)            *
#                                                               *
#                   ------------------------------------------- *
#                    Versione originale:    001 del 21/02/11    *
#                      Ultima revisione:    NdK del 27/06/11    *
#                   ------------------------------------------- *
#                                Autore:    Nicola de Kunovich  *
# ------------------------------------------------------------- *
#                                                               *
# Parametri in input : file XLS da tradurre (percorso)          *
#                                                               *
# ------------------------------------------------------------- *
#                                                               *
# SU MISURA PER SIRI (utilizzato da 'pagb4420')                 *
#                                                               *
# N.B.: MANCA IL 'LOG'                                          *
#                                                               *
# ------------------------------------------------------------- *
#                                                               *
# Utilizzo :                                                    *
#                                                               *
# $ t_sir_xls_csv FILE.xls I                                    *
#                                                               *
#===============================================================*

#===============================================================*
# Dichiarazione per restrizione variabili                       *
#---------------------------------------------------------------*
use strict                                                     ;

#===============================================================*
# Moduli Perl                                                   *
#---------------------------------------------------------------*
use Spreadsheet::ParseExcel                                    ;
use Net::FTP                                                   ;
use File::Basename                                             ;

#===============================================================*
# Lettura della variabile in input                              *
#---------------------------------------------------------------*
my $fxls = shift                                               ;
my $texe = shift                                               ;

if (!$texe)
{
    $texe = "C"                                                ;
}

#==========================================*
# Help                                     *
#------------------------------------------*
if (!$fxls || !$texe || $fxls eq "-help")
{
    print "\n"
        . "Uso :"
        . "\n"
        . "> t_sir_xls_csv FILE "
        . "TIPO(C/I)"
        . "\n"
        . "\n"
        . "(C) Copyright - dKb"
        . "\n"
        . "\n"                            ;
    exit()                                ;
}

#===============================================================*
# Variabili statiche                                            *
#---------------------------------------------------------------*
my $base = '/abd/asc/exp/'                                     ;

my $host = 'ftp.molex.com'                                     ;
my $user = 'ndekunov'                                          ;
my $pass = 'hl16fsree9'                                        ;
# my $path = 'siri-146016/slsrpt/in-test'                        ;
my $path = 'siri-146016/slsrpt/in'                             ;

#==========================================*
# Open file di LOG                         *
#------------------------------------------*
my $log_fil = '/abd/asc/'
            . 'log/t_sir_xls_csv.log'     ;
open (LOG_FIL, ">>$log_fil") or die 
        "Impossibile aprire '$log_fil'"   ;

#===============================================================*
# Open del file in output                                       *
#---------------------------------------------------------------*
my $fcsv = basename($fxls, ".xls") . ".csv"                    ;

open (OUTFILE, ">$base$fcsv") or print LOG_FIL
         "Impossibile aprire il file $base$fcsv"               ;

#===============================================================*
# Parsing                                                       *
#---------------------------------------------------------------*
my $pars = Spreadsheet::ParseExcel->new()                      ;

my $finw = $fxls                                               ;
my $finp = $pars->parse($finw)                                 ;
my $celv = ""                                                  ;

if ( !defined $finp ) {
    print LOG_FIL $pars->error(), " $finw .\n"                 ;
}

for my $worksheet ( $finp->worksheets() ) {

    my ( $row_min, $row_max ) = $worksheet->row_range();
    my ( $col_min, $col_max ) = $worksheet->col_range();

    for my $row ( $row_min .. $row_max )
    {
        for my $col ( $col_min .. $col_max )
        {

            my $cell = $worksheet->get_cell( $row, $col );
            next unless $cell;

#            print OUTFILE $cell->value(),;
            
            
#           *------------------------------------------------------*
#           * Allineamento preliminare a sinistra                  *
#           *------------------------------------------------------*
            for ($celv)
            {
                s/^\s+//                                       ;
                s/\s+$//                                       ;
            }            
            
#           *------------------------------------------------------*
#           * Numero report                                     A  *
#           *------------------------------------------------------*
            if ($col == 0)
            {
#               $celv = sprintf("%-*s", 35, $cell->value())    ;
                
                $celv = pack("A35", $cell->value())            ;
            }
#           *------------------------------------------------------*
#           * Data report (YYYYMMDD)                            B  *
#           *------------------------------------------------------*
            elsif ($col == 1)
            {
                $celv = pack("A8", $cell->value())             ;
            }
#           *------------------------------------------------------*
#           * Data report min (YYYYMMDD)                        C  *
#           *------------------------------------------------------*
            elsif ($col == 2)
            {
                $celv = pack("A8", $cell->value())             ;
            }
#           *------------------------------------------------------*
#           * Data report max (YYYYMMDD)                        D  *
#           *------------------------------------------------------*
            elsif ($col == 3)
            {
                $celv = pack("A8", $cell->value())             ;
            }
#           *------------------------------------------------------*
#           * Distributore                                      E  *
#           *------------------------------------------------------*
            elsif ($col == 4)
            {
                $celv = pack("A35", $cell->value())            ;
            }
#           *------------------------------------------------------*
#           * Valuta fattura                                    F  *
#           *------------------------------------------------------*
            elsif ($col == 5)
            {
                $celv = pack("A3", $cell->value())             ;
            }
#           *------------------------------------------------------*
#           * Valuta ordine                                     G  *
#           *------------------------------------------------------*
            elsif ($col == 6)
            {
                $celv = pack("A3", $cell->value())             ;
            }
#           *------------------------------------------------------*
#           * Sales organisation (MIG=5100 - Autom.=5500)       H  *
#           *------------------------------------------------------*
            elsif ($col == 7)
            {
                $celv = pack("A4", $cell->value())             ;
            }
#           *------------------------------------------------------*
#           * Debito o Credito                                  I  *
#           *------------------------------------------------------*
            elsif ($col == 8)
            {
                $celv = pack("A1", $cell->value())             ;
            }
#           *------------------------------------------------------*
#           * Codice cliente                                    J  *
#           *------------------------------------------------------*
            elsif ($col == 9)
            {
                $celv = pack("A35", $cell->value())            ;
            }
#           *------------------------------------------------------*
#           * Codice Molex                                      K  *
#           *------------------------------------------------------*
            elsif ($col == 10)
            {
                $celv = pack("A10", $cell->value())            ;
            }
#           *------------------------------------------------------*
#           * Ragione sociale cliente                           L  *
#           *------------------------------------------------------*
            elsif ($col == 11)
            {
                $celv = pack("A40", $cell->value())            ;
            }
#           *------------------------------------------------------*
#           * Indirizzo cliente                                 M  *
#           *------------------------------------------------------*
            elsif ($col == 12)
            {
                $celv = pack("A40", $cell->value())            ;
            }
#           *------------------------------------------------------*
#           * Localita' cliente                                 N  *
#           *------------------------------------------------------*
            elsif ($col == 13)
            {
                $celv = pack("A40", $cell->value())            ;
            }
#           *------------------------------------------------------*
#           * CAP cliente                                       O  *
#           *------------------------------------------------------*
            elsif ($col == 14)
            {
                $celv = pack("A10", $cell->value())            ;
            }
#           *------------------------------------------------------*
#           * Nazione cliente                                   P  *
#           *------------------------------------------------------*
            elsif ($col == 15)
            {
                $celv = pack("A3", $cell->value())             ;
            }
#           *------------------------------------------------------*
#           * Codice del prodotto per la casa produttrice       Q  *
#           *------------------------------------------------------*
            elsif ($col == 16)
            {
            
#               *--------------------------------------------------*
#               * Trattamento preliminare numero                   *
#               *--------------------------------------------------*
                my $part = $cell->value()                      ;
                $part =~ s/^0*//                               ;

#               *--------------------------------------------------*
#               * Taglio a 10 caratteri                            *
#               *--------------------------------------------------*
                $celv = pack("A10", $part)                     ;
            
            }
#           *------------------------------------------------------*
#           * Numero documento                                  R  *
#           *------------------------------------------------------*
            elsif ($col == 17)
            {
                $celv = pack("A35", $cell->value())            ;
            }
#           *------------------------------------------------------*
#           * Numero riga                                       S  *
#           *------------------------------------------------------*
            elsif ($col == 18)
            {
                $celv = pack("A6", $cell->value())             ;
            }
#           *------------------------------------------------------*
#           * Quantita'                                         T  *
#           *------------------------------------------------------*
            elsif ($col == 19)
            {
                $celv = pack("A15", $cell->value())            ;
            }
#           *------------------------------------------------------*
#           * Data documento (YYYYMMDD)                         U  *
#           *------------------------------------------------------*
            elsif ($col == 20)
            {
                $celv = pack("A8", $cell->value())             ;
            }
#           *------------------------------------------------------*
#           * Prezzo unitario (14 interi, 3 decimali)           V  *
#           *------------------------------------------------------*
            elsif ($col == 21)
            {

#               *--------------------------------------------------*
#               * Trattamento preliminare numero                   *
#               *--------------------------------------------------*
                my $stringa = $cell->value()                   ;
                $stringa =~ s/\,/./                            ;
                $stringa =~ s/^\s+//                           ;
                $stringa =~ s/\s+$//                           ;

#               *--------------------------------------------------*
#               * 3 decimali                                       *
#               *--------------------------------------------------*
                my $nume = sprintf '%.3f', $stringa            ;

#               *--------------------------------------------------*
#               * Taglio a 18 caratteri                            *
#               *--------------------------------------------------*
                $celv = pack("A18", $nume)                     ;

#               *--------------------------------------------------*
#               * Controllo punto o virgola decimali               *
#               *--------------------------------------------------*
                my $punt = ($celv =~ tr/.//)                   ;
                my $virg = ($celv =~ tr/,//)                   ;

                if ($punt == 1 && $virg == 0)
                {
#                   *----------------------------------------------*
#                   * Se punto invece di virgola                   *
#                   *----------------------------------------------*
                    $celv =~ s/\./,/                           ;
                }
                elsif ($punt == 0 && $virg == 0)
                {
#                   *----------------------------------------------*
#                   * Se ne punto ne virgola                       *
#                   *----------------------------------------------*
                    $celv = sprintf '%.4f', $celv              ;
                    $celv =~ s/\./,/                           ;
                    $celv = pack("A18", $celv)                 ;
                }
                
            }

#           *------------------------------------------------------*
#           * Riferimento prezzo (x 1000)                       W  *
#           *------------------------------------------------------*
            elsif ($col == 22)
            {
                $celv = pack("A9", $cell->value())             ;
            }
#           *------------------------------------------------------*
#           * Prezzo acquisto (14 interi, 3 decimali)           X  *
#           *------------------------------------------------------*
            elsif ($col == 23)
            {
                $celv = pack("A18", $cell->value())            ;
            }
#           *------------------------------------------------------*
#           * Riferimento prezzo (x 1000)                       Y  *
#           *------------------------------------------------------*
            elsif ($col == 24)
            {
                $celv = pack("A9", $cell->value())             ;
            }
#           *------------------------------------------------------*
#           * Quota prezzo                                      Z  *
#           *------------------------------------------------------*
            elsif ($col == 25)
            {
                $celv = pack("A10", $cell->value())            ;
            }
#           *------------------------------------------------------*
#           * Partita IVA                                       AA *
#           *------------------------------------------------------*
            elsif ($col == 26)
            {
                $celv = pack("A35", $cell->value())            ;
            }
#           *------------------------------------------------------*
#           * Segmento cliente                                  AB *
#           *------------------------------------------------------*
            elsif ($col == 27)
            {
                $celv = pack("A35", $cell->value())            ;
            }
#           *------------------------------------------------------*
#           * Design reg number                                 AC *
#           *------------------------------------------------------*
            elsif ($col == 28)
            {
                $celv = pack("A35", $cell->value())            ;
            }
#           *------------------------------------------------------*
#           * Contract number                                   AD *
#           *------------------------------------------------------*
            elsif ($col == 29)
            {
                $celv = pack("A35", $cell->value())            ;
            }
#           *------------------------------------------------------*
#           * Trailer 'X'                                       AE *
#           *------------------------------------------------------*
            elsif ($col == 30)
            {
                $celv = pack("A1", $cell->value())             ;
            }

#           *======================================================*
#           * Output cella                                         *
#           *------------------------------------------------------*
            if ($col == 30)
            {
                print OUTFILE $celv                            ;
            }
            else
            {
                print OUTFILE $celv . ";"                      ;
            }
        }
        print OUTFILE "\n";
    }
}
    
    
#===============================================================*
# Close del file in output                                      *
#---------------------------------------------------------------*
close (OUTFILE)                                                ;

#===============================================================*
# Determinazione se invio da effettuare                         *
#---------------------------------------------------------------*
if ($texe eq "I")
{
    &invio                                                     ;
}

#==========================================*
# Close file di LOG                        *
#------------------------------------------*
close LOG_FIL                             ;

#===============================================================*
# SUBROUTINES                                                   *
#===============================================================*

#===============================================================*
# Invio del file trattato                                       *
#---------------------------------------------------------------*
sub invio
{
#   *-----------------------------------------------------------*
#   * Connessione                                               *
#   *-----------------------------------------------------------*
    my $ftp = Net::FTP->new($host, Debug => 0)
          or print LOG_FIL "Impossibile connettersi a : $@"    ;
#   *-----------------------------------------------------------*
#   * Login                                                     *
#   *-----------------------------------------------------------*
    $ftp->login($user,$pass)
          or print LOG_FIL "Fallito il login ", $ftp->message  ;

#   *-----------------------------------------------------------*
#   * Directory di output                                       *
#   *-----------------------------------------------------------*
    $ftp->cwd($path)
        or print LOG_FIL "Impossibile cambiare "
             . "directory ", $ftp->message                     ;

#   *-----------------------------------------------------------*
#   * Metodo binario                                            *
#   *-----------------------------------------------------------*
    $ftp->binary()                                             ;

#   *-----------------------------------------------------------*
#   * Invio vero e proprio                                      *
#   *-----------------------------------------------------------*
    $ftp->put("$base$fcsv")
        or print LOG_FIL "Invio del file non riuscito ", $ftp->message;

#   *-----------------------------------------------------------*
#   * Uscita da FTP                                             *
#   *-----------------------------------------------------------*
    $ftp->quit                                                 ;
}
