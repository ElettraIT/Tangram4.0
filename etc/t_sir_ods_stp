#!/usr/bin/perl -w
#==========================================*
# Stampa lista di spedizione (da ods300s)  *
# con barcode Code128                      *
#                                          *
# Ad hoc SIRI                              *
#                                          *
# ---------------------------------------- *
# Versione originale:   001 del 10/04/2016 *
#   Ultima revisione:   wip del 23/06/2023 *
# ---------------------------------------- *
#             Autore:   Nicola de Kunovich *
# ---------------------------------------- *
#                                          *
# Parametri in input : - file CSV da       *
#                        stampare (proto-  *
#                        collo)            *
#                                          *
# ---------------------------------------- *
#                                          *
# Utilizzo :                               *
#                                          *
# $ t_sir_ods_stp 99999999999              *
#                                          *
#==========================================*

#==========================================*
# Moduli Perl                              *
#------------------------------------------*
use PostScript::Simple                    ;

#==========================================*
# Variabili statiche                       *
#------------------------------------------*
#------------------------------------------*
# Codice stampante                         *
#------------------------------------------*
#my $cod_stp = "hp4000"                    ;
   my $cod_stp = "pdf"                   ;
#------------------------------------------*
# Logo                                     *
#------------------------------------------*
my $fil_log = "siri_logo"                 ;
#------------------------------------------*
# Protocollo in input                      *
#------------------------------------------*
my $num_prt = $ARGV[0]                    ;
#------------------------------------------*
# Percorsi file                            *
#------------------------------------------*
my $pth_tmp = "/abd/spl/"                 ;
my $pth_bcd = "/abd/asc/bcd/"             ;
my $pth_csv = $pth_tmp . $num_prt . ".CSV";
my $out_stp = $pth_tmp . $num_prt . ".ps" ;
my $out_pdf = $pth_tmp . $num_prt . ".pdf";
#------------------------------------------*
# Contatori e posizionatori pagina         *
#------------------------------------------*
my $max_rig = 18                          ;
my $ctr_rig = 0                           ;
my $num_pag = 0                           ;
my $tit_lin = 278                         ;
my $top_pag = 276                         ;
my $cur_lin = $top_pag                    ;
my $alt_lin = -15                         ;
my $top_grd = 275                         ;
my $bot_grd = 12                          ;
#------------------------------------------*
# Colonne griglia                          *
#------------------------------------------*
my $c01_grd = 38                          ;
my $c02_grd = 50                          ;
my $c03_grd = 115                         ;
my $c04_grd = 132                         ;
my $c05_grd = 152                         ;
my $c06_grd = 180                         ;
#------------------------------------------*
# Dimensioni barcode EPS in mm.            *
#------------------------------------------*
my $eps_alt = 15                          ;
my $eps_lun = 36                          ;
#------------------------------------------*
# Comodi per trattamento numero protocollo *
#------------------------------------------*
my $lit_sec = substr($num_prt, 1, 2)      ;
my $lit_num = substr($num_prt, 6, 6)      ;
   $lit_num += 0                          ;
my $lit_prt = $lit_num . "/" . $lit_sec   ;
#------------------------------------------*
# Comodi per trattamento numero protocollo *
# in                                       *
#------------------------------------------*
my $eps_sec = substr($num_prt, 1, 2)      ;
my $eps_num = substr($num_prt, 7, 4)      ;
my $eps_prt = $eps_sec . $eps_num         ;

#==========================================*
# Preparazione pagina                      *
#------------------------------------------*
my $ps = new PostScript::Simple::(papersize => "A4",
                                     colour => 1,
                                        eps => 0,
                                      units => "mm");

#==========================================*
# Trattamento stampa                       *
#------------------------------------------*
#------------------------------------------*
# Open file                                *
#------------------------------------------*
open (I_FILE, "$pth_csv") or die
   "Impossibile aprire il file '$pth_csv'";
#------------------------------------------*
# Array linee file                         *
#------------------------------------------*
my @linea = <I_FILE>                      ;

#------------------------------------------*
# Ciclo di scansione                       *
#------------------------------------------*
foreach $linea (@linea)
{
    #--------------------------------------*
    # Separazione campi                    *
    #--------------------------------------*
    my   @campo = split(/;/, $linea)      ;
    #--------------------------------------*
    # Trattamento testata                  *
    #--------------------------------------*
    if  ($campo[0] eq "T")
    {
        &stp_tes                          ;
    }
    #--------------------------------------*
    # Trattamento righe                    *
    #--------------------------------------*
    else
    {
        &stp_rig                          ;
    }
}

#------------------------------------------*
# Generazione file Postscript              *
#------------------------------------------*
$ps->output($out_stp)                     ;

#------------------------------------------*
# Stampa file Postscript                   *
#------------------------------------------*
#===============================================================*
# Stampa file Postscript                                        *
#---------------------------------------------------------------*
if ($cod_stp eq "pdf")
{
    system("ps2pdf $out_stp $out_pdf")    ;
}
 else
{
    system("cat $out_stp | lpr -P$cod_stp");
}

#==========================================*
# Close del file in input                  *
#------------------------------------------*
&fil_cls                                  ;

#==========================================*
# SUBROUTINES                              *
#==========================================*

#==========================================*
# Stampa testata                           *
#------------------------------------------*
sub stp_tes
{
    #--------------------------------------*
    # Estrazione campi                     *
    #--------------------------------------*
    my @campo = split(/;/, $linea)        ;
    #--------------------------------------*
    # Titolo                               *
    #--------------------------------------*
    &mynewpage($ps, "Spedizione : " . $lit_prt);
    #--------------------------------------*
    # Font                                 *
    #--------------------------------------*
    $ps->setfont("Courier", 10)           ;
    #--------------------------------------*
    # Stampa ragione sociale cliente       *
    #--------------------------------------*
    $ps->text(110, $tit_lin, $campo[1])   ;
    #--------------------------------------*
    # Font                                 *
    #--------------------------------------*
    $ps->setfont("Courier", 8)            ;
    #--------------------------------------*
    # Protocollo: inclusione barcode EPS   *
    #--------------------------------------*
    &inc_eps ($eps_prt, 70)               ;
}

#==========================================*
# Stampa riga                              *
#------------------------------------------*
sub stp_rig
{
    #--------------------------------------*
    # Contatore righe                      *
    #--------------------------------------*
    $ctr_rig++                            ;
    #--------------------------------------*
    # Eventuale reintestazione pagina      *
    #--------------------------------------*
    if ( !($ctr_rig < $max_rig))
    {
        &mynewpage($ps, "Spedizione : " . $lit_prt);
        $ctr_rig = 0                      ;
        $cur_lin = $top_pag               ;
    }
    #--------------------------------------*
    # Interlinea                           *
    #--------------------------------------*
    $cur_lin = $cur_lin + $alt_lin        ;
    #--------------------------------------*
    # Estrazione campi                     *
    #--------------------------------------*
    my @campo = split(/;/, $linea)        ;
    #--------------------------------------*
    # Pulizia trailing spaces campi testo  *
    #--------------------------------------*
    my $max_val = 10                      ;
    my $ctr_001                           ;
    for ($ctr_001 = 1 ; $ctr_001 < $max_val ; $ctr_001++ )
    {
        $campo[$ctr_001] =~ s/^\s+//      ;
        $campo[$ctr_001] =~ s/\s+$//      ;
    }
    #--------------------------------------*
    # Codice alfanumerico prodotto         *
    #--------------------------------------*
    my $alf_pro = $campo[3]               ;
    #--------------------------------------*
    # Codice prodotto per casa produttrice *
    #--------------------------------------*
    my $cdp_pro = $campo[4]               ;
    #--------------------------------------*
    # Descrizione prodotto                 *
    #--------------------------------------*
    my $des_pro = $campo[5]               ;
    #--------------------------------------*
    # Quantita' in ordine                  *
    #--------------------------------------*
    my $qta_ord = $campo[6]               ;
    #--------------------------------------*
    # Lotto di vendita                     *
    #--------------------------------------*
    my $lot_ven = $campo[7]               ;
    #--------------------------------------*
    # Quantita' in giacenza                *
    #--------------------------------------*
    my $qta_gia = $campo[8]               ;

    #======================================*
    # Codice prodotto: inclusione barcode  *
    #--------------------------------------*
    &inc_eps ($alf_pro, 10)               ;
    #--------------------------------------*
    # Descrizione prodotto                 *
    #--------------------------------------*
    my $des_len = length($des_pro)        ;
    
    if ($des_len > 35)
    {
        #----------------------------------*
        # Se supera i 35 caratteri         *
        #----------------------------------*
        my $sub_de1 = substr($des_pro, 0, 35);
        my $sub_de2 = substr($des_pro, 35, $des_len);
        #
        $ps->text($c02_grd+2,
                  $cur_lin+8,
                  $sub_de1)               ;
        #
        $ps->text($c02_grd+2,
                  $cur_lin+3,
                  $sub_de2)               ;
    }
     else
    {
        #----------------------------------*
        # Se non supera i 35 caratteri     *
        #----------------------------------*
        $ps->text($c02_grd+2,
                  $cur_lin+5,
                  $des_pro)               ;
    }    
    
    #--------------------------------------*
    # Lotto                                *
    #--------------------------------------*
    $ps->text({align => 'right'},
                      $c04_grd-1,
                      $cur_lin+5,
                      $lot_ven)           ;
    #--------------------------------------*
    # Giacenza                             *
    #--------------------------------------*
    $ps->text({align => 'right'},
                      $c05_grd-2,
                      $cur_lin+5,
                      $qta_gia)           ;
    #--------------------------------------*
    # Codice prodotto casa produttrice     *
    #--------------------------------------*
    my $str_len = length($cdp_pro)        ;
    
    if ($str_len > 14)
    {
        #----------------------------------*
        # Se supera i 14 caratteri         *
        #----------------------------------*
        my $sub_st1 = substr($cdp_pro, 0, 14);
        my $sub_st2 = substr($cdp_pro, 14, $str_len);
        #
        $ps->text(155,
           $cur_lin+8,
             $sub_st1)                    ;
        #
        $ps->text(155,
           $cur_lin+3,
             $sub_st2)                    ;
    }
     else
    {
        #----------------------------------*
        # Se non supera i 14 caratteri     *
        #----------------------------------*
        $ps->text(155,
           $cur_lin+5,
             $cdp_pro)                    ;
    }    
    #--------------------------------------*
    # Stampa quantita'                     *
    #--------------------------------------*
    $ps->text({align => 'right'},198, 
                          $cur_lin+5, 
                            $qta_ord)     ;
    #--------------------------------------*
    # Sottolineatura linea                 *
    #--------------------------------------*
    $ps->line(10, $cur_lin-2, 200, $cur_lin-2);
}

#==========================================*
# Trattamento EPS                          *
#------------------------------------------*
sub inc_eps
{
    #--------------------------------------*
    # Valore in input                      *
    #--------------------------------------*
    my $val_cmp = shift                   ;
    #--------------------------------------*
    # Posizione in input                   *
    #--------------------------------------*
    my $pos_cmp = shift                   ;
    #--------------------------------------*
    # Determinazione coordinate barcode    *
    #--------------------------------------*
    my $eps_x01 = $pos_cmp                ;
    my $eps_y01 = $cur_lin                ;
    my $eps_x02 = $eps_x01+$eps_lun       ;
    my $eps_y02 = $cur_lin+$eps_alt       ;
    #--------------------------------------*
    # Percorso file barcode EPS            *
    #--------------------------------------*
    my $prf_cod = substr($val_cmp, 0, 2)  ;
    my $pth_eps = $pth_bcd
                . $prf_cod
                . "/"
                . $val_cmp
                . ".eps"                  ;
    #--------------------------------------*
    # Inclusione barcode EPS               *
    #--------------------------------------*
    $ps->importepsfile($pth_eps,
                       $eps_x01,
                       $eps_y01,
                       $eps_x02,
                       $eps_y02)          ;
}

#==========================================*
# Intestazione pagina                      *
#------------------------------------------*
sub mynewpage
{
    #--------------------------------------*
    # Valore in input                      *
    #--------------------------------------*
    my $ps = shift                        ;
    #--------------------------------------*
    # Titolo pagina in input               *
    #--------------------------------------*
    my $tit_pag = shift                   ;
    #--------------------------------------*
    # Numero pagina                        *
    #--------------------------------------*
    $num_pag++                            ;
    #--------------------------------------*
    # Nuova pagina                         *
    #--------------------------------------*
    $ps->newpage                          ;
    #--------------------------------------*
    # Box pagina                           *
    #--------------------------------------*
    $ps->box(10, 12, 200, 288)            ;
    #--------------------------------------*
    # Sottolineatura titolo                *
    #--------------------------------------*
    $ps->line(10, $top_grd, 200, $top_grd);
    #--------------------------------------*
    # Colonna codice prodotto              *
    #--------------------------------------*
    $ps->line($c02_grd,
              $bot_grd,
              $c02_grd,
              $top_grd)                   ;
    #--------------------------------------*
    # Colonna descrizione prodotto         *
    #--------------------------------------*
    $ps->line($c03_grd,
              $bot_grd,
              $c03_grd,
              $top_grd)                   ;
    #--------------------------------------*
    # Colonna lotto prodotto               *
    #--------------------------------------*
    $ps->line($c04_grd,
              $bot_grd,
              $c04_grd,
              $top_grd)                   ;
    #--------------------------------------*
    # Colonna giacenza                     *
    #--------------------------------------*
    $ps->line($c05_grd,
              $bot_grd,
              $c05_grd,
              $top_grd)                   ;
    #--------------------------------------*
    # Colonna ccodice prodotto fornitore   *
    #--------------------------------------*
    $ps->line($c06_grd,
              $bot_grd,
              $c06_grd,
              $top_grd)                   ;
    #--------------------------------------*
    # Font                                 *
    #--------------------------------------*
    $ps->setfont("Courier", 8)            ;
    #--------------------------------------*
    # Titolo                               *
    #--------------------------------------*
    $ps->text(15, $tit_lin,
                  $tit_pag
                . " - Pag. "
                . $num_pag)               ;
}

#==========================================*
# Chiusura file                            *
#------------------------------------------*
sub fil_cls
{
close I_FILE                              ;
}

