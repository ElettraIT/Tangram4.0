#!/usr/bin/perl -w
#==========================================*
# Modulo Perl                              *
#                                          *
# t_ele_eps_dir                            *
#                                          *
# Per creare le directory 'bcd' nel server *
#------------------------------------------*

#==========================================*
# Moduli Perl                              *
#------------------------------------------*
use File::Basename                        ;

#==========================================*
# Variabili statiche                       *
#------------------------------------------*
my $bas = "/abd/asc/bcd/"                 ;

#==========================================*
# Scansione directory di base              *
#------------------------------------------*
for($inx=0; $inx<70; $inx++)
{

    #--------------------------------------*
    # Variabili di lavoro                  *
    #--------------------------------------*
    my $ind = sprintf ("%04d",$inx)       ;
       $dir = $bas . $ind                 ;
    #--------------------------------------*
    # Creazione directory                  *
    #--------------------------------------*
    system("mkdir " . $dir)               ;
}

