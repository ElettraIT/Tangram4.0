#===============================================================*
# Stampa piede                                                  *
#---------------------------------------------------------------*
sub stp_pie
{
#   *-----------------------------------------------------------*
#   * Documento in input                                        *
#   *-----------------------------------------------------------*
    my $ps = shift                                             ;
    my $wrk_lin = shift                                        ;
#   *-----------------------------------------------------------*
#   * Determinazione interlinea                                 *
#   *-----------------------------------------------------------*
    my $stp_lin = $top_ini - ($wrk_lin * $alt_lin)             ;
#   *-----------------------------------------------------------*
#   * Definizione posizioni                                     *
#   *-----------------------------------------------------------*
    my $c01_pos = $mrg_snx+5                                   ;
    my $c02_pos = $c01_pos+$c01_lar                            ;
    my $c03_pos = $c02_pos+$c02_lar                            ;
    my $c04_pos = $c03_pos+$c03_lar                            ;
    my $c05_pos = $c04_pos+$c04_lar                            ;
    my $c06_pos = $c05_pos+$c05_lar                            ;
    my $c07_pos = $c06_pos+$c06_lar                            ;
    my $c08_pos = $c07_pos+$c07_lar                            ;
#   *-----------------------------------------------------------*
#   * Deviazione in funzione del numero linea                   *
#   *-----------------------------------------------------------*
    $num_lin = int(substr($row, 5, 2))                         ;
    if  ($num_lin > 57 && $num_lin < 63)
    {
#       *-------------------------------------------------------*
#       * Condizioni di pagamento                               *
#       *-------------------------------------------------------*
        my $cnd_pag = substr($row, 11, 40)                     ;
#       *-------------------------------------------------------*
#       * Stampa                                                *
#       *-------------------------------------------------------*
        $ps->setfont("Courier-Bold", 8)                        ;
        $ps->text($c01_pos, $stp_lin, $cnd_pag)                ;
#       *-------------------------------------------------------*
#       * Imponibile castelletto Iva                            *
#       *-------------------------------------------------------*
        my $imp_cst = substr($row, 68, 11)                     ;
#       *-------------------------------------------------------*
#       * Stampa                                                *
#       *-------------------------------------------------------*
        $ps->text($c03_pos, $stp_lin, $imp_cst)                ;
#       *-------------------------------------------------------*
#       * Aliquota castelletto Iva                              *
#       * ___ SE ESENZIONE !!! ___                              *
#       *-------------------------------------------------------*



#       *-------------------------------------------------------*
#       * Imponibile totale                                     *
#       *-------------------------------------------------------*
        my $imp_tot = substr($row, 113, 13)                    ;
#       *-------------------------------------------------------*
#       * Stampa                                                *
#       *-------------------------------------------------------*
        $ps->text($c07_pos, $stp_lin, $imp_tot)                ;
        
        
        
    }
    if  ($num_lin == 63)
    {
#       *-------------------------------------------------------*
#       * Literal "segue" o totale documento                    *
#       *-------------------------------------------------------*
        my $lit_seg = substr($row, 113, 15)                    ;

        if ($lit_seg eq "*** Segue ***")
        {
            $ps->setcolour('blue');
        }
         else
        {
            $ps->setcolour('red');
        }
#       *-------------------------------------------------------*
#       * Stampa                                                *
#       *-------------------------------------------------------*
        $ps->setfont("Courier-Bold", 10)                       ;
        $ps->text({align => 'right'}, 540, $top_pag-690, $lit_seg);
        $ps->setcolour('black')                                ;
        
        
        
#       *-------------------------------------------------------*
#       * ___ BANNER DI PROVA ___                               *
#       *-------------------------------------------------------*
        my $num_pag = int(substr($row, 0, 5))                  ;
        my $rot_ang = 0;
        $ps->setcolour('red');
        $ps->setfont("Helvetica-Bold", 40)                     ;
        
        if ($num_pag == 1)
            {$rot_ang = 0}
        elsif ($num_pag == 2)
            {$rot_ang = 10}
        elsif ($num_pag == 3)
            {$rot_ang = 20}
        elsif ($num_pag == 4)
            {$rot_ang = 30}
        elsif ($num_pag == 5)
            {$rot_ang = 40}
        elsif ($num_pag == 6)
            {$rot_ang = 45}
        else{$rot_ang = 90};
        
        $ps->text({rotate => $rot_ang}, 150, 305, 'ANNULLATA!!!')    ;
#        $ps->setlinewidth(3);
#        $ps->polygon({rotate => 45}, 105, 305, 300, 305, 300, 420, 105, 420);
        $ps->setfont("Courier-Bold", 10)                       ;
        $ps->setcolour("black");
#       *-------------------------------------------------------*
#       * ___ QR DI PROVA PER IBAN ___                          *
#       *-------------------------------------------------------*
        if  ($num_lin == 63 && $num_pag == $max_pag)
        {
#           *---------------------------------------------------*
#           * Inclusione barcode EPS                            *
#           * ___ DI PROVA ___                                  *
#           * ___ DI IMPLEMENTARE CREAZIONE ONFLY BARCODE ___   *
#           *---------------------------------------------------*
            $ps->importepsfile($bcd_eps, 230, 150, 290, 210)   ;
        }








    }
    elsif  ($num_lin > 65)
    {
#       *-------------------------------------------------------*
#       * Scadenziario                                          *
#       *-------------------------------------------------------*
        my $dat_scd = substr($row, 11, 10)                     ;
        my $imp_scd = substr($row, 26, 12)                     ;
#       *-------------------------------------------------------*
#       * Stampa                                                *
#       *-------------------------------------------------------*
        $ps->setfont("Courier-Bold", 8)                        ;
        $ps->setcolour('red')                                  ;
        $ps->text($c01_pos, $stp_lin, $dat_scd)                ;
        $ps->text($c02_pos, $stp_lin, $imp_scd)                ;
        $ps->setcolour('black')                                ;
    }
}

