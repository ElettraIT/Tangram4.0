#!/usr/bin/perl -w
#===============================================================*
#                                                               *
# Modulo SPERIMENTALE di stampa fatture con modulo              *
#                                                               *
#                   ------------------------------------------- *
#                    Versione originale:    001 del 06/05/2018  *
#                      Ultima revisione:    NdK del 07/05/2018  *
#                   ------------------------------------------- *
#                                Autore:    Nicola de Kunovich  *
# ------------------------------------------------------------- *
#                                                               *
# Parametri in input : - file PRF da stampare                   *
#                                                               *
# ___ FUNZIONA: DA COMPLETARE ___                               *
#                                                               *
# ------------------------------------------------------------- *
#                                                               *
# Utilizzo :                                                    *
#                                                               *
# $ t_stp_fat PF999999                                          *
#                                                               *
# ------------------------------------------------------------- *
#                                                               *
# Note     : lo script "importa" un modulo fattura EPS definito *
#            nei parametri di configurazione. Legge un file PRF *
#            generato da Tangram che contiene la fattura.       *
#            Il risultato viene inviato alla stampante o al     *
#            generatore PDF.                                    *
#                                                               *
# ------------------------------------------------------------- *
#                                                               *
# Fonts Adobe Postscript Standard                               *
# -------------------------------                               *
#                                                               *
# 01) Times-Roman                                               *
# 02) Times-Italic                                              *
# 03) Times-Bold                                                *
# 04) Times-BoldItalic                                          *
# 05) Helvetica                                                 *
# 06) Helvetica-Oblique                                         *
# 07) Helvetica-Bold                                            *
# 08) Helvetica-BoldOblique                                     *
# 09) Courier                                                   *
# 10) Courier-Oblique                                           *
# 11) Courier-Bold                                              *
# 12) Courier-BoldOblique                                       *
# 13) Symbol                                                    *
#===============================================================*

#===============================================================*
# Moduli Perl                                                   *
#---------------------------------------------------------------*
use PostScript::Simple                                         ;

#===============================================================*
# Variabili statiche                                            *
#---------------------------------------------------------------*
#   *-----------------------------------------------------------*
#   * Lettura configurazione                                    *
#   *-----------------------------------------------------------*
    my $cfg_bas = "/abd/asc/cfg/t_stp_fat.ini"                 ;
    my %cnf_ele = do $cfg_bas                                  ;
#   *-----------------------------------------------------------*
#   * File in input                                             *
#   *-----------------------------------------------------------*
    my $num_prf = $ARGV[0]                                     ;
#   *-----------------------------------------------------------*
#   * Codice stampante da file configurazione                   *
#   *-----------------------------------------------------------*
    my $cod_stp = $cnf_ele{cod_stp}                            ;
#   *-----------------------------------------------------------*
#   * Percorsi file da file configurazione                      *
#   *-----------------------------------------------------------*
    my $pth_inp = $cnf_ele{pth_inp}                            ;
    my $pth_out = $cnf_ele{pth_out}                            ;
    my $pth_pdf = $cnf_ele{pth_pdf}                            ;
    my $mod_eps = $cnf_ele{pth_eps}                            ;

    my $bcd_eps = $cnf_ele{pth_bcd}                            ;

#   *-----------------------------------------------------------*
#   * Percorsi assemblati                                       *
#   *-----------------------------------------------------------*
    my $pth_prf = $pth_inp . $num_prf                          ;
#   *-----------------------------------------------------------*
#   * Posizionamenti da file configurazione                     *
#   *-----------------------------------------------------------*
    my $top_pag = $cnf_ele{top_pag}                            ;
    my $top_ini = $cnf_ele{top_ini}                            ;
    my $mrg_snx = $cnf_ele{mrg_snx}                            ;
    my $alt_lin = $cnf_ele{alt_lin}                            ;
    my $pos_dst = $cnf_ele{pos_dst}                            ;
    my $pos_int = $cnf_ele{pos_int}                            ;
#   *-----------------------------------------------------------*
#   * Posizionamenti corpo da file configurazione               *
#   *-----------------------------------------------------------*
    my $c01_lar = $cnf_ele{c01_lar}                            ;
    my $c02_lar = $cnf_ele{c02_lar}                            ;
    my $c03_lar = $cnf_ele{c03_lar}                            ;
    my $c04_lar = $cnf_ele{c04_lar}                            ;
    my $c05_lar = $cnf_ele{c05_lar}                            ;
    my $c06_lar = $cnf_ele{c06_lar}                            ;
    my $c07_lar = $cnf_ele{c07_lar}                            ;
    my $c08_lar = $cnf_ele{c08_lar}                            ;
#   *-----------------------------------------------------------*
#   * Coordinate modulo EPS                                     *
#   *-----------------------------------------------------------*
    my $eps_x01 = $cnf_ele{eps_x01}                            ;
    my $eps_y01 = $cnf_ele{eps_y01}                            ;
    my $eps_x02 = $cnf_ele{eps_x02}                            ;
    my $eps_y02 = $cnf_ele{eps_y02}                            ;

#===============================================================*
# Preparazione pagina                                           *
#---------------------------------------------------------------*
my $ps = new PostScript::Simple::(papersize => "A4",
                                  landscape => 0,
                                     colour => 1,
                                        eps => 0,
                                      units => "bp")           ;

#===============================================================*
# Trattamento stampa                                            *
#---------------------------------------------------------------*
#   *-----------------------------------------------------------*
#   * Open file PRF                                             *
#   *-----------------------------------------------------------*
    open (I_PRF, "$pth_prf") or die
         "Impossibile aprire il file '$pth_prf'"               ;
    my   @linea = <I_PRF>                                      ;

#   *-----------------------------------------------------------*
#   * Close del file in input                                   *
#   *-----------------------------------------------------------*
    close I_PRF                                                ;

#   *-----------------------------------------------------------*
#   * Ciclo di scansione preliminare per numero pagine totali   *
#   *-----------------------------------------------------------*
foreach $row (@linea)
{
#   *-----------------------------------------------------------*
#   * Tipo record                                               *
#   *-----------------------------------------------------------*
    my $tip_rec = substr($row, 7, 1)                           ;
    if  ($tip_rec eq "P")
    {
#       *-------------------------------------------------------*
#       * L'ultimo record 'P' contiene il numero pagina max     *
#       *-------------------------------------------------------*
        $max_pag = int(substr($row, 0, 5))                     ;
    }
    elsif  ($tip_rec eq "H")
    {
#       *-------------------------------------------------------*
#       * Estrazione ampiezza linea                             *
#       *-------------------------------------------------------*
        $amp_lin = int(substr($row, 83, 3)) + 8                ;
    }
}

#   *-----------------------------------------------------------*
#   * Ciclo di scansione                                        *
#   *-----------------------------------------------------------*
foreach $row (@linea)
{
#       *-------------------------------------------------------*
#       * Pulizia linea                                         *
#       *-------------------------------------------------------*
    chomp(@linea)                                              ;
#       *-------------------------------------------------------*
#       * Numero linea                                          *
#       *-------------------------------------------------------*
    $num_lin = substr($row, 5, 2)                              ;
#       *-------------------------------------------------------*
#       * Tipo record                                           *
#       *-------------------------------------------------------*
    $tip_rec = substr($row, 7, 1)                              ;
#       *-------------------------------------------------------*
#       * Completamento linea estratta con spazi bianchi        *
#       *-------------------------------------------------------*
        my $lun_str = length($row)                             ;
        my $ctr_001                                                ;
        for ($ctr_001 = 1 ; $ctr_001 <= $amp_lin ; $ctr_001++ )
        {
             if ($ctr_001 > $lun_str) {$row .= ' '}
        }
#       *-------------------------------------------------------*
#       * Trattamento Header                                    *
#       *-------------------------------------------------------*
    if  ($tip_rec eq "H")
    {
        &trt_hea                                               ;
    }
#       *-------------------------------------------------------*
#       * Trattamento linea di stampa                           *
#       *-------------------------------------------------------*
    elsif ($tip_rec eq "I")
    {
#       *-------------------------------------------------------*
#       * Deviazione in funzione del numero linea               *
#       *-------------------------------------------------------*
        if  ($num_lin < 26)
        {
#           *---------------------------------------------------*
#           * Testata                                           *
#           *---------------------------------------------------*
            &stp_tes($ps, $row)                                ;
        }
        elsif (($num_lin > 25) && ($num_lin < 58))
        {
#           *---------------------------------------------------*
#           * Corpo                                             *
#           *---------------------------------------------------*
            &stp_cor($ps, $num_lin)                            ;
        }
        else
        {
#           *---------------------------------------------------*
#           * Piede                                             *
#           *---------------------------------------------------*
            &stp_pie($ps, $num_lin)                            ;
        }
    }
#        *------------------------------------------------------*
#        * Trattamento reintestazione                           *
#        *------------------------------------------------------*
    elsif ($tip_rec eq "P")
    {
        &new_pag($ps)                                          ;
    }
    else
    {
#        *------------------------------------------------------*
#        * Linea ignorata                                       *
#        *------------------------------------------------------*
        next()                                                 ;
    }
}

#===============================================================*
# Preparazione percorsi files di output                         *
#---------------------------------------------------------------*
my $out_stp = $pth_out . $fil_nam . ".ps"                      ;
my $out_pdf = $pth_out . $fil_nam . ".pdf"                     ;
my $ou2_pdf = $pth_pdf . $fil_nam . ".pdf"                     ;

#===============================================================*
# Generazione file Postscript                                   *
#---------------------------------------------------------------*
$ps->output($out_stp)                                          ;

#===============================================================*
# Stampa file Postscript                                        *
#---------------------------------------------------------------*
if ($cod_stp eq "pdf")
{
    system("ps2pdf $out_stp $out_pdf")                        ;
    system("ps2pdf $out_stp $ou2_pdf")                        ;
}
 else
{
    system("cat $out_stp | lpr -P$cod_stp")                   ;
    system("ps2pdf $out_stp $ou2_pdf")                         ;
}

#===============================================================*
# SUBROUTINES                                                   *
#===============================================================*

#===============================================================*
# Trattamento Header                                            *
#---------------------------------------------------------------*
sub trt_hea
{
#   *-----------------------------------------------------------*
#   * Estrazione campi                                          *
#   *-----------------------------------------------------------*
    $fil_nam = substr($row, 92, 40)                            ;
    $fil_nam =~ s/\s//g                                        ;
}

#===============================================================*
# Stampa testata                                                *
#---------------------------------------------------------------*
sub stp_tes
{
#   *-----------------------------------------------------------*
#   * Documento in input                                        *
#   *-----------------------------------------------------------*
    my $ps = shift                                             ;
#   *-----------------------------------------------------------*
#   * Deviazione in funzione del numero linea                   *
#   *-----------------------------------------------------------*
    $num_lin = int(substr($row, 5, 2))                         ;
    if  ($num_lin == 1)
    {
#       *-------------------------------------------------------*
#       * Tipo documento                                        *
#       *-------------------------------------------------------*
        my $tip_doc = substr($row, 107, 30)                    ;
#       *-------------------------------------------------------*
#       * Stampa                                                *
#       *-------------------------------------------------------*
        $ps->setcolour('red')                                  ;
        $ps->setfont("Helvetica-Bold", 12)                     ;
        $ps->text({align => 'center'}, 467, $top_pag-75, $tip_doc);
        $ps->setcolour('black')                                ;
    }
     elsif ($num_lin == 5)
    {
#       *-------------------------------------------------------*
#       * Numero documento                                      *
#       *-------------------------------------------------------*
        my $num_doc = substr($row, 94, 14)                     ;
#       *-------------------------------------------------------*
#       * Data documento                                        *
#       *-------------------------------------------------------*
        my $dat_doc = substr($row, 114, 10)                    ;
#       *-------------------------------------------------------*
#       * Stampa                                                *
#       *-------------------------------------------------------*
        $ps->setfont("Helvetica", 10)                          ;
        $ps->text(385, $top_pag-113, $num_doc)                 ;
        $ps->text(480, $top_pag-113, $dat_doc)                 ;
    }
     elsif ($num_lin == 8)
    {
#       *-------------------------------------------------------*
#       * Codice fiscale                                        *
#       *-------------------------------------------------------*
        $ps->setfont("Helvetica", 8)                           ;
        my $cod_fis = substr($row, 94, 16)                     ;
#       *-------------------------------------------------------*
#       * Partita Iva                                           *
#       *-------------------------------------------------------*
        my $prt_iva = substr($row, 114, 11)                    ;
#       *-------------------------------------------------------*
#       * Stampa                                                *
#       *-------------------------------------------------------*
        $ps->text({align => 'center'}, 430, $top_pag-140, $cod_fis);
        $ps->text(480, $top_pag-140, $prt_iva)                 ;
    }
     elsif ($num_lin == 14)
    {
#       *-------------------------------------------------------*
#       * Ragione sociale destinatario                          *
#       *-------------------------------------------------------*
        $ps->setfont("Helvetica-Bold", 9)                      ;
        my $rag_dst = substr($row, 77, 40)                     ;
#       *-------------------------------------------------------*
#       * Stampa                                                *
#       *-------------------------------------------------------*
        $ps->text($mrg_snx+$pos_dst, $top_pag-220, $rag_dst)   ;
    }
     elsif ($num_lin == 15)
    {
#       *-------------------------------------------------------*
#       * Font                                                  *
#       *-------------------------------------------------------*
        $ps->setfont("Helvetica-Bold", 8)                      ;
#       *-------------------------------------------------------*
#       * Ragione sociale intestatario                          *
#       *-------------------------------------------------------*
        my $rag_cli = substr($row, 11, 40)                     ;
#       *-------------------------------------------------------*
#       * Stampa                                                *
#       *-------------------------------------------------------*
        $ps->text($mrg_snx+$pos_int, $top_pag-210, $rag_cli)   ;
    }
     elsif ($num_lin == 16)
    {
#       *-------------------------------------------------------*
#       * Indirizzo intestatario                                *
#       *-------------------------------------------------------*
        my $via_cli = substr($row, 11, 40)                     ;
#       *-------------------------------------------------------*
#       * Indirizzo destinatario                                *
#       *-------------------------------------------------------*
        my $via_dst = substr($row, 77, 40)                     ;
#       *-------------------------------------------------------*
#       * Stampa                                                *
#       *-------------------------------------------------------*
        $ps->text($mrg_snx+$pos_int, $top_pag-220, $via_cli)   ;
        $ps->text($mrg_snx+$pos_dst, $top_pag-245, $via_dst)   ;
    }
     elsif ($num_lin == 17)
    {
#       *-------------------------------------------------------*
#       * Localita' intestatario                                *
#       *-------------------------------------------------------*
        my $loc_cli = substr($row, 11, 40)                     ;
#       *-------------------------------------------------------*
#       * Stampa                                                *
#       *-------------------------------------------------------*
        $ps->text($mrg_snx+$pos_int, $top_pag-230, $loc_cli)   ;
    }
     elsif ($num_lin == 18)
    {
#       *-------------------------------------------------------*
#       * Localita' destinatario                                *
#       *-------------------------------------------------------*
        my $loc_dst = substr($row, 77, 40)                     ;
#       *-------------------------------------------------------*
#       * Stampa                                                *
#       *-------------------------------------------------------*
        $ps->text($mrg_snx+$pos_dst, $top_pag-265, $loc_dst)   ;
    }
     elsif ($num_lin == 20)
    {
#       *-------------------------------------------------------*
#       * Codice cliente                                        *
#       *-------------------------------------------------------*
        my $cod_cli = substr($row, 43, 10)                     ;
#       *-------------------------------------------------------*
#       * Stampa                                                *
#       *-------------------------------------------------------*
        $ps->text(250, $top_pag-250, $cod_cli)                ;
    }
}

#===============================================================*
# Stampa corpo                                                  *
#---------------------------------------------------------------*
sub stp_cor
{
#   *-----------------------------------------------------------*
#   * Valori in input                                           *
#   *-----------------------------------------------------------*
    my $ps = shift                                             ;
    my $lin_stp = shift                                        ;
#   *-----------------------------------------------------------*
#   * Estrazione dati a seconda del contenuto della linea       *
#   *-----------------------------------------------------------*
    my $ele_cor = substr($row, 11, 15)                         ;
    
    if  ($ele_cor eq "            Ns.")
    {
        &stp_cor_ord($ps, $row, $lin_stp)                      ;
    }
    elsif  ($ele_cor eq "            ***")
    {
        &stp_cor_bol($ps, $row, $lin_stp)                      ;
    }
    elsif  ($ele_cor eq "               ")
    {
        &stp_cor_com($ps, $row, $lin_stp)                      ;
    }
    else
    {
        &stp_cor_pro($ps, $row, $lin_stp)                      ;
    }
}

#===============================================================*
# Stampa corpo                                                  *
#                                                               *
# Subroutine per Riferimenti Ordine                             *
#---------------------------------------------------------------*
sub stp_cor_ord
{
#   *-----------------------------------------------------------*
#   * Valori in input                                           *
#   *-----------------------------------------------------------*
    my $ps = shift                                             ;
    my $wrk_row = shift                                        ;
    my $wrk_lin = shift                                        ;
#   *-----------------------------------------------------------*
#   * Definizione posizioni                                     *
#   *-----------------------------------------------------------*
    my $c01_pos = $mrg_snx+5                                   ;
#   *-----------------------------------------------------------*
#   * Determinazione interlinea                                 *
#   *-----------------------------------------------------------*
    my $stp_lin = $top_ini - ($wrk_lin * $alt_lin)             ;
#   *-----------------------------------------------------------*
#   * Estrazione elementi                                       *
#   *-----------------------------------------------------------*
    my $rif_ord = substr($wrk_row, 23, 80)                     ;
#   *-----------------------------------------------------------*
#   * Stampa elementi estratti                                  *
#   *-----------------------------------------------------------*
    $ps->setcolour(0,191,255)                                  ;
    $ps->setfont("Helvetica-Bold", 10)                         ;
    $ps->text($c01_pos+40, $stp_lin, $rif_ord)                 ;
    $ps->setcolour('black')                                    ;
    $ps->setfont("Courier-Bold", 9)                            ;
}

#===============================================================*
# Stampa corpo                                                  *
#                                                               *
# Subroutine per Riferimenti DDT                                *
#---------------------------------------------------------------*
sub stp_cor_bol
{
#   *-----------------------------------------------------------*
#   * Valori in input                                           *
#   *-----------------------------------------------------------*
    my $ps = shift                                             ;
    my $wrk_row = shift                                        ;
    my $wrk_lin = shift                                        ;
#   *-----------------------------------------------------------*
#   * Definizione posizioni                                     *
#   *-----------------------------------------------------------*
    my $c01_pos = $mrg_snx+5                                   ;
#   *-----------------------------------------------------------*
#   * Determinazione interlinea                                 *
#   *-----------------------------------------------------------*
    my $stp_lin = $top_ini - ($wrk_lin * $alt_lin)             ;
#   *-----------------------------------------------------------*
#   * Estrazione elementi                                       *
#   *-----------------------------------------------------------*
    my $rif_bol = substr($wrk_row, 23, 80)                     ;
#   *-----------------------------------------------------------*
#   * Stampa elementi estratti                                  *
#   *-----------------------------------------------------------*
    $ps->setcolour('red')                                      ;
    $ps->setfont("Helvetica-Bold", 10)                         ;
    $ps->text($c01_pos+40, $stp_lin, $rif_bol)                 ;
    $ps->setcolour('black')                                    ;
    $ps->setfont("Courier-Bold", 9)                            ;
}

#===============================================================*
# Stampa corpo                                                  *
#                                                               *
# Subroutine per riga prodotto                                  *
#---------------------------------------------------------------*
sub stp_cor_pro
{
#   *-----------------------------------------------------------*
#   * Valori in input                                           *
#   *-----------------------------------------------------------*
    my $ps = shift                                             ;
    my $wrk_row = shift                                        ;
    my $wrk_lin = shift                                        ;
#   *-----------------------------------------------------------*
#   * Definizione posizioni                                     *
#   *-----------------------------------------------------------*
    my $c01_pos = $mrg_snx+5                                   ;
    my $c02_pos = $c01_pos+$c01_lar                            ;
    my $c03_pos = $c02_pos+$c02_lar                            ;
    my $c04_pos = $c03_pos+$c03_lar                            ;
    my $c05_pos = $c04_pos+$c04_lar                            ;
    my $c06_pos = $c05_pos+$c05_lar                            ;
    my $c07_pos = $c06_pos+$c06_lar                            ;
    my $c08_pos = $c07_pos+$c07_lar                            ;
#   *-----------------------------------------------------------*
#   * Determinazione interlinea                                 *
#   *-----------------------------------------------------------*
    my $stp_lin = $top_ini - ($wrk_lin * $alt_lin)             ;
#   *-----------------------------------------------------------*
#   * Font generale linea                                       *
#   *-----------------------------------------------------------*
    $ps->setfont("Courier-Bold", 9)                            ;
#   *-----------------------------------------------------------*
#   * Estrazione elementi                                       *
#   *-----------------------------------------------------------*
    my $alf_pro = substr($wrk_row, 11, 14)                     ;
    my $des_pro = substr($wrk_row, 27, 40)                     ;
    my $qta_ven = substr($wrk_row, 71, 10)                     ;
    my $umi_ven = substr($wrk_row, 82, 3)                      ;
    my $prz_ven = substr($wrk_row, 87, 12)                     ;

    my $imp_rig = substr($wrk_row, 111, 12)                    ;
    my $cod_iva = substr($wrk_row, 125, 3)                     ;
#   *-----------------------------------------------------------*
#   * Stampa elementi estratti                                  *
#   *-----------------------------------------------------------*

    $ps->setcolour('green')                                    ;
    $ps->text($c01_pos, $stp_lin, $alf_pro)                    ;
    $ps->setcolour('black')                                    ;

    $ps->setfont("Courier-Bold", 7)                            ;
    $ps->text($c02_pos, $stp_lin, $des_pro)                    ;
    $ps->setfont("Courier-Bold", 8)                            ;

    $ps->text($c03_pos, $stp_lin, $qta_ven)                    ;
    $ps->text($c04_pos, $stp_lin, $umi_ven)                    ;
    
    $ps->setcolour('blue')                                     ;
    $ps->text($c05_pos, $stp_lin, $prz_ven)                    ;
    $ps->setcolour('black')                                    ;
    
    $ps->text($c07_pos, $stp_lin, $imp_rig)                    ;
    $ps->text($c08_pos, $stp_lin, $cod_iva)                    ;
}

