# /etc/rc.d/tangram_init (/etc/rc/init.d)
#
# description   : Pulizia temporanei TANGRAM
#
### BEGIN INIT INFO
# Provides: tangram_init
# Required-Start:
# Required-Stop:
# Default-Start: 5
# Default-Stop:
# Description: Pulizia temporanei TANGRAM
### END INIT INFO

     ############ tangram_init
     #
     # Procedura di init per l' ambiente TANGRAM
     #
     # da posizionare in '/etc/rc.d' e gestire con i 'runlevel' di Yast.
     #
     ######
     
######
# - Inizializzazione valore di ritorno a zero
###

returnvalue=0 ;

######
# - Esecuzione a seconda del parametro passato da /sbin/rc
###

case "$1" in
'start_msg')
      echo "Startup Sistema Informativo TANGRAM"
      ;;
'stop_msg')
      ;;
'stop')
      ;;
'start')
      echo "Cancellazione dei files di /abd/tmp:"
          ls -lia /abd/tmp
          rm /abd/tmp/*
      echo "Cancellazione dei files di /abd/spl:"
          ls -lia /abd/spl
          rm /abd/spl/*
      echo "Cancellazione dei files di /abd/srt:"
          ls -lia /abd/srt
          rm /abd/srt/*
      ;;
*)
      echo "usage: $0 {start|stop|start_msg|stop_msg}"
      exit=1
      ;;
esac

######
# - Fine procedura
###

