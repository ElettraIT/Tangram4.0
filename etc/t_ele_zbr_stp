            $str  = "Spedizione"          ;
            prText($lin, 22, $str,'','q3');
            $str  = ":"                   ;
            prText($lin, 120, $str,'','q3');
        }
        #----------------------------------*
        # Font per Spedizione              *
        #----------------------------------*
        prFontSize(18)                    ;       
        #----------------------------------*
        # Codice spedizione                *
        #----------------------------------*
        $str  = $cod_spd                  ;
        prText($lin, 130, $str,'','q3')   ;
        #----------------------------------*
        # Descrizione spedizione           *
        #----------------------------------*
        $str  = $des_spd                  ;
        prText($lin, 175, $str,'','q3')   ;
        
        #==================================*
        # Prompt per Porto                 *
        #----------------------------------*
        $des_por =~ s/\s+$//              ;
        #----------------------------------*
        # Linea per Porto                  *
        #----------------------------------*
        $lin  = 205                       ;
        #----------------------------------*
        # Stampa                           *
        #----------------------------------*
        if (length($des_por) != 0)
        {
            prFontSize(12)                ;       
            $str  = "Porto"               ;
            prText($lin, 22, $str,'','q3');
            $str  = ":"                   ;
            prText($lin, 120, $str,'','q3');
        }
        #----------------------------------*
        # Font per Porto                   *
        #----------------------------------*
        prFontSize(18)                    ;       
        #----------------------------------*
        # Codice Porto                     *
        #----------------------------------*
        $str  = $cod_por                  ;
        prText($lin, 130, $str,'','q3')   ;
        #----------------------------------*
        # Descrizione porto                *
        #----------------------------------*
        $str  = $des_por                  ;
        prText($lin, 175, $str,'','q3')   ;
        
        #==================================*
        # Prompt per Spese di spedizione   *
        #----------------------------------*
        $spe_spd =~ s/\s+$//              ;
        #----------------------------------*
        # Linea per Spese di spedizione    *
        #----------------------------------*
        $lin  = 225                       ;
        #----------------------------------*
        # Stampa                           *
        #----------------------------------*
        if (length($spe_spd) != 0)
        {
            prFontSize(12)                ;       
            $str  = "Spese"               ;
            prText($lin, 22, $str,'','q3');
            $str  = ":"                   ;
            prText($lin, 120, $str,'','q3');
        }
        #----------------------------------*
        # Font per Spese di spedizione     *
        #----------------------------------*
        prFontSize(18)                    ;       
        #----------------------------------*
        # Spese di spedizione              *
        #----------------------------------*
        $str  = $spe_spd                  ;
        prText($lin, 130, $str,'','q3')   ;
        
        #==================================*
        # Prompt per Annotazioni           *
        #----------------------------------*
        $ann_sp1 =~ s/\s+$//              ;
        #----------------------------------*
        # Linea per Annotazioni            *
        #----------------------------------*
        $lin  = 245                       ;
        #----------------------------------*
        # Stampa                           *
        #----------------------------------*
        if (length($ann_sp1) != 0)
        {
            prFontSize(12)                ;       
            $str  = "Annotazioni"         ;
            prText($lin, 22, $str,'','q3');
            $str  = ":"                   ;
            prText($lin, 120, $str,'','q3');
        }
        #----------------------------------*
        # Font per Annotazioni             *
        #----------------------------------*
        prFontSize(12)                    ;       
        #----------------------------------*
        # Annotazioni                      *
        #----------------------------------*
        $str  = $ann_sp1                  ;
        prText($lin, 130, $str,'','q3')   ;
        #
        $lin  = 255                       ;
        $str  = $ann_sp2                  ;
        prText($lin, 130, $str,'','q3')   ;
        #
        $lin  = 265                       ;
        $str  = $ann_sp3                  ;
        prText($lin, 130, $str,'','q3')   ;
        #
        $lin  = 275                       ;
        $str  = $ann_sp4                  ;
        prText($lin, 130, $str,'','q3')   ;

        #----------------------------------*
        # Logo Elettra                     *
        #----------------------------------*
        prImage(  { file    => $log_az1,
                    page    => 1,
                    imageNo => 1,
                    x       => 20,
                    y       => 20,
                    rotate  => 'q3',
                    size    => 0.2 }  )   ;
        #----------------------------------*
        # Logo AEG                         *
        #----------------------------------*
        prImage(  { file    => $log_az2,
                    page    => 1,
                    imageNo => 1,
                    x       => 20,
                    y       => 340,
                    rotate  => 'q3',
                    size    => 0.5 }  )   ;
        #----------------------------------*
        # Barcode per Numero documento     *
        #----------------------------------*
        PDF::Reuse::Barcode::Code128(x      => 90,
                                     y      => 300,
                                     value  => $num_doc,
                                     rotate => 90);
        #----------------------------------*
        # Chiusura PDF                     *
        #----------------------------------*
        prEnd()                           ;
        #----------------------------------*
        # Stampa file PDF                  *
        #----------------------------------*
        system("cat $out_pdf | lpr -P$cod_stp");
        #----------------------------------*
        # Incremento contatore             *
        #----------------------------------*
        $stp_ctr++                        ;
    }
}

#==========================================*
# Stampa stringa con eventuale ritaratura  *
# del font size                            *
#------------------------------------------*
sub stp_str
{
    #======================================*
    # Variabili in input                   *
    #--------------------------------------*
    my $xxx = shift                       ;
    my $yyy = shift                       ;
    my $rot = shift                       ;
    my $str = shift                       ;
    #--------------------------------------*
    # Pulizia spazi vuoti a fine stringa   *
    #--------------------------------------*
    $str =~ s/\s+$//                      ;
    #--------------------------------------*
    # Determinazione lunghezza stringa     *
    #--------------------------------------*
    my $lun = length($str)                ;
    #--------------------------------------*
    # Eventuale ritaratura FontSize        *
    #--------------------------------------*
    if ($lun >= 10)
    {
        prFontSize(20)                    ;       
    }
     else
    {
        prFontSize(30)                    ;       
    }
    #--------------------------------------*
    # Emissione stringa                    *
    #--------------------------------------*
    prText($xxx, $yyy, $str, '', $rot)    ;
}

#==========================================*
# Stampa stringa con eventuale ritaratura  *
# del font size - Riferimento              *
#------------------------------------------*
sub stp_rif
{
    #======================================*
    # Variabili in input                   *
    #--------------------------------------*
    my $xxx = shift                       ;
    my $yyy = shift                       ;
    my $rot = shift                       ;
    my $str = shift                       ;
    #--------------------------------------*
    # Pulizia spazi vuoti a fine stringa   *
    #--------------------------------------*
    $str =~ s/\s+$//                      ;
    #--------------------------------------*
    # Determinazione lunghezza stringa     *
    #--------------------------------------*
    my $lun = length($str)                ;
    #--------------------------------------*
