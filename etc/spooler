############ /abd/etc/spooler
#
# Procedura per il lancio dello spooler da tangram
#
# PER SISTEMA MAC OSX - ADATTATO PER LINUX
#
############

case $1 in
    pdf)
        b=`basename $2`
        ps2pdf $2 /abd/asc/master/pdf/out/$b.pdf
#        pstopdf $2 -o /abd/pdf/$b.pdf
        rm -f $2
        ;;
    *)
        lpr -P $1 -o raw $2;
        rm -f $2;
# EX    lp -d$1 -s $2;
# EX    rm -f $2;
        ;;
esac
