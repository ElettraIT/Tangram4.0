#!/usr/bin/perl -w
#===============================================================*
#                                                               *
# Traduttore in formato Spreadsheet (tipo Excel)                *
#                                                               *
# Ad hoc per POS Molex SIRI                                     *
#                                                               *
#                   ------------------------------------------- *
#                    Versione originale:    001 del 20/06/11    *
#                      Ultima revisione:    NdK del 20/06/11    *
#                   ------------------------------------------- *
#                                Autore:    Nicola de Kunovich  *
# ------------------------------------------------------------- *
#                                                               *
# Parametri in input : - file CSV da tradurre (percorso)        *
#                                                               *
# ------------------------------------------------------------- *
#                                                               *
# Utilizzo :                                                    *
#                                                               *
# $ t_sir_csv_xls /percorso/FILE                                *
#                                                               *
#===============================================================*

#===============================================================*
# Dichiarazione per restrizione variabili                       *
#---------------------------------------------------------------*
use strict                                                     ;

#===============================================================*
# Modulo Perl Spreadsheet::WriteExcel                           *
#---------------------------------------------------------------*
use Spreadsheet::WriteExcel                                    ;

#===============================================================*
# Lettura della variabile in input                              *
#---------------------------------------------------------------*
my $csv = $ARGV[0]                                             ;

#===============================================================*
# Open del file in input                                        *
#---------------------------------------------------------------*
&f_input                                                       ;

#===============================================================*
# Trattamento foglio                                            *
#---------------------------------------------------------------*
#    *----------------------------------------------------------*
#    * Nuovo file                                               *
#    *----------------------------------------------------------*
my $workbook  = Spreadsheet::WriteExcel->new("$csv.xls")       ;
my $worksheet = $workbook->add_worksheet()                     ;

#    *----------------------------------------------------------*
#    * Formattazione per celle                                  *
#    *                                                          *
#    * Bordo da 1 punto di spessore                             *
#    *----------------------------------------------------------*
my $cel_fmt = $workbook->add_format()                          ;
   $cel_fmt->set_border(1)                                     ;

#    *----------------------------------------------------------*
#    * Formattazione colonne valori                             *
#    *                                                          *
#    * Formato numero e 'bold'                                  *
#    *----------------------------------------------------------*
my $col_fmt = $workbook->add_format()                          ;
   $col_fmt->set_num_format('#,###.00')                        ;
#   $col_fmt->set_bold()                                        ;

my $piv_fmt = $workbook->add_format()                          ;
   $piv_fmt->set_num_format('00000000000')                     ;

#    *----------------------------------------------------------*
#    * Formattazione colonne                                    *
#    *----------------------------------------------------------*
#        *------------------------------------------------------*
#        * Numero report                                     A  *
#        *------------------------------------------------------*
$worksheet->set_column(0, 0, 35)                               ;
#        *------------------------------------------------------*
#        * Data report (YYYYMMDD)                            B  *
#        *------------------------------------------------------*
$worksheet->set_column(1, 1, 8)                                ;
#        *------------------------------------------------------*
#        * Data report min (YYYYMMDD)                        C  *
#        *------------------------------------------------------*
$worksheet->set_column(2, 2, 8)                                ;
#        *------------------------------------------------------*
#        * Data report max (YYYYMMDD)                        D  *
#        *------------------------------------------------------*
$worksheet->set_column(3, 3, 8)                                ;
#        *------------------------------------------------------*
#        * Distributore                                      E  *
#        *------------------------------------------------------*
$worksheet->set_column(4, 4, 35)                               ;
#        *------------------------------------------------------*
#        * Valuta fattura                                    F  *
#        *------------------------------------------------------*
$worksheet->set_column(5, 5, 3)                                ;
#        *------------------------------------------------------*
#        * Valuta ordine                                     G  *
#        *------------------------------------------------------*
$worksheet->set_column(6, 6, 3)                                ;
#        *------------------------------------------------------*
#        * Sales organisation (MIG=5100 - Autom.=5500)       H  *
#        *------------------------------------------------------*
$worksheet->set_column(7, 7, 4)                                ;
#        *------------------------------------------------------*
#        * Debito o Credito                                  I  *
#        *------------------------------------------------------*
$worksheet->set_column(8, 8, 1)                                ;
#        *------------------------------------------------------*
#        * Codice cliente                                    J  *
#        *------------------------------------------------------*
$worksheet->set_column(9, 9, 35)                               ;
#        *------------------------------------------------------*
#        * Codice Molex                                      K  *
#        *------------------------------------------------------*
$worksheet->set_column(10, 10, 10)                             ;
#        *------------------------------------------------------*
#        * Ragione sociale cliente                           L  *
#        *------------------------------------------------------*
$worksheet->set_column(11, 11, 40)                             ;
#        *------------------------------------------------------*
#        * Indirizzo cliente                                 M  *
#        *------------------------------------------------------*
$worksheet->set_column(12, 12, 40)                             ;
#        *------------------------------------------------------*
#        * Localita' cliente                                 N  *
#        *------------------------------------------------------*
$worksheet->set_column(13, 13, 40)                             ;
#        *------------------------------------------------------*
#        * CAP cliente                                       O  *
#        *------------------------------------------------------*
$worksheet->set_column(14, 14, 10)                             ;
#        *------------------------------------------------------*
#        * Nazione cliente                                   P  *
#        *------------------------------------------------------*
$worksheet->set_column(15, 15, 3)                              ;
#        *------------------------------------------------------*
#        * Codice del prodotto per la casa produttrice       Q  *
#        *------------------------------------------------------*
$worksheet->set_column(16, 16, 10)                             ;
#        *------------------------------------------------------*
#        * Numero documento                                  R  *
#        *------------------------------------------------------*
$worksheet->set_column(17, 17, 35)                             ;
#        *------------------------------------------------------*
#        * Numero riga                                       S  *
#        *------------------------------------------------------*
$worksheet->set_column(18, 18, 6)                              ;
#        *------------------------------------------------------*
#        * Quantita'                                         T  *
#        *------------------------------------------------------*
$worksheet->set_column(19, 19, 15)                             ;
#        *------------------------------------------------------*
#        * Data documento (YYYYMMDD)                         U  *
#        *------------------------------------------------------*
$worksheet->set_column(20, 20, 8)                              ;
#        *------------------------------------------------------*
#        * Prezzo unitario (14 interi, 3 decimali)           V  *
#        *------------------------------------------------------*
$worksheet->set_column(21, 21, 18)                             ;
#        *------------------------------------------------------*
#        * Riferimento prezzo (x 1000)                       W  *
#        *------------------------------------------------------*
$worksheet->set_column(22, 22, 9)                              ;
#        *------------------------------------------------------*
#        * Prezzo acquisto (14 interi, 3 decimali)           X  *
#        *------------------------------------------------------*
$worksheet->set_column(23, 23, 18)                             ;
#        *------------------------------------------------------*
#        * Riferimento prezzo (x 1000)                       Y  *
#        *------------------------------------------------------*
$worksheet->set_column(24, 24, 9)                              ;
#        *------------------------------------------------------*
#        * Quota prezzo                                      Z  *
#        *------------------------------------------------------*
$worksheet->set_column(25, 25, 10)                             ;
#        *------------------------------------------------------*
#        * Partita IVA                                       AA *
#        *------------------------------------------------------*
$worksheet->set_column(26, 26, 35, $piv_fmt)                   ;
#        *------------------------------------------------------*
#        * Segmento cliente                                  AB *
#        *------------------------------------------------------*
$worksheet->set_column(27, 27, 35)                             ;
#        *------------------------------------------------------*
#        * Design reg number                                 AC *
#        *------------------------------------------------------*
$worksheet->set_column(28, 28, 35)                             ;
#        *------------------------------------------------------*
#        * Contract number                                   AD *
#        *------------------------------------------------------*
$worksheet->set_column(29, 29, 35)                             ;
#        *------------------------------------------------------*
#        * Trailer 'X'                                       AE *
#        *------------------------------------------------------*
$worksheet->set_column(30, 30, 1)                              ;

#    *----------------------------------------------------------*
#    * Normalizzazione contatore righe                          *
#    *----------------------------------------------------------*
my $row = 0                                                    ;

#    *----------------------------------------------------------*
#    * Ciclo di scansione                                       *
#    *----------------------------------------------------------*
while (<I_FILE>) {

#        *------------------------------------------------------*
#        * Pulizia fine riga                                    *
#        *------------------------------------------------------*
    chomp                                                      ;

#        *------------------------------------------------------*
#        * Lettura della riga                                   *
#        *------------------------------------------------------*
    my @Fld = $_                                               ;

#        *------------------------------------------------------*
#        * Costruzione colonne                                  *
#        *------------------------------------------------------*
    $worksheet->write_string($row, 0, substr($_,0,35), $cel_fmt);
    $worksheet->write_string($row, 1, substr($_,35,8), $cel_fmt);
    $worksheet->write_string($row, 2, substr($_,43,8), $cel_fmt);
    $worksheet->write_string($row, 3, substr($_,51,8), $cel_fmt);
    $worksheet->write_string($row, 4, substr($_,59,35), $cel_fmt);
    $worksheet->write_string($row, 5, substr($_,94,3), $cel_fmt);
    $worksheet->write_string($row, 6, substr($_,97,3), $cel_fmt);
    $worksheet->write_string($row, 7, substr($_,100,4), $cel_fmt);
    $worksheet->write_string($row, 8, substr($_,104,1), $cel_fmt);
    $worksheet->write_string($row, 9, substr($_,105,35), $cel_fmt);
    $worksheet->write_string($row, 10, substr($_,140,10), $cel_fmt);
    $worksheet->write_string($row, 11, substr($_,150,40), $cel_fmt);
    $worksheet->write_string($row, 12, substr($_,190,40), $cel_fmt);
    $worksheet->write_string($row, 13, substr($_,230,40), $cel_fmt);
    $worksheet->write_string($row, 14, substr($_,270,10), $cel_fmt);
    $worksheet->write_string($row, 15, substr($_,280,3), $cel_fmt);
    $worksheet->write_string($row, 16, substr($_,283,10), $cel_fmt);
    $worksheet->write_string($row, 17, substr($_,293,35), $cel_fmt);
    $worksheet->write_string($row, 18, substr($_,328,6), $cel_fmt);
    $worksheet->write_string($row, 19, substr($_,334,15), $cel_fmt);
    $worksheet->write_string($row, 20, substr($_,349,8), $cel_fmt);
    $worksheet->write_string($row, 21, substr($_,357,18), $cel_fmt);
    $worksheet->write_string($row, 22, substr($_,375,9), $cel_fmt);
    $worksheet->write_string($row, 23, substr($_,384,18), $cel_fmt);
    $worksheet->write_string($row, 24, substr($_,402,9), $cel_fmt);
    $worksheet->write_string($row, 25, substr($_,411,10), $cel_fmt);
    $worksheet->write_string($row, 26, substr($_,421,35), $cel_fmt);
    $worksheet->write_string($row, 27, substr($_,456,35), $cel_fmt);
    $worksheet->write_string($row, 28, substr($_,491,35), $cel_fmt);
    $worksheet->write_string($row, 29, substr($_,526,35), $cel_fmt);
    $worksheet->write_string($row, 30, substr($_,561,1), $cel_fmt);

#        *------------------------------------------------------*
#        * Incremento riga                                      *
#        *------------------------------------------------------*
    $row++                                                     ;
}

#===============================================================*
# Apertura file da trattare                                     *
#---------------------------------------------------------------*
sub f_input
{
    open (I_FILE, "$csv") or die
         "Impossibile aprire il file '$csv'"               ;
}

#===============================================================*
# Chiusura file da trattare                                     *
#---------------------------------------------------------------*
close I_FILE                                                   ;

