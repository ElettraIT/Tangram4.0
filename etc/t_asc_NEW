#==========================================*
# Subroutine di creazione                  *
#------------------------------------------*
sub mak_dir 
{
    #--------------------------------------*
    # Valori in input                      *
    #--------------------------------------*
    my $inp_001 = shift                   ;
    my $inp_002 = shift                   ;
    my $inp_003 = shift                   ;
    #--------------------------------------*
    # Normalizzazioni                      *
    #--------------------------------------*
    my $dir_new = ""                      ;
    my $sep_002 = ""                      ;
    my $sep_003 = ""                      ;
    #--------------------------------------*
    # Eventuali barre                      *
    #--------------------------------------*
    if ($inp_002 ne ""){$sep_002 = "/"}   ;
    if ($inp_003 ne ""){$sep_003 = "/"}   ;
    #--------------------------------------*
    # Preparazione directory               *
    #--------------------------------------*
    $dir_new = $azi_dir
             . $inp_001
             . $sep_002
             . $inp_002
             . $sep_003
             . $inp_003                   ;
    #--------------------------------------*
    # Creazione                            *
    #--------------------------------------*
    eval {mkdir($dir_new)}                ;
    if ($@)
    {
        print "Non posso creare la cartella $dir_new: $@";
    }
    #--------------------------------------*
    # Privilegi                            *
    #--------------------------------------*
    chmod(0775, $dir_new) or
          die "Fallito chmod di $dir_new: $!";
}






