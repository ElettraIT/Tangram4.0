#!/usr/bin/perl -w
#===============================================================#
#                                                               #
# Prova stampa modulo tipo fattura                              #
#                                                               #
# output su PDF o in stampa                                     #
#                                                               #
#                   ------------------------------------------- #
#                    Versione originale:    001 del 23/03/2018  #
#                      Ultima revisione:    NdK del 28/03/2018  #
#                   ------------------------------------------- #
#                                Autore:    Nicola de Kunovich  #
# ------------------------------------------------------------- #
#                                                               #
# Parametri in input : - file CSV da stampare (protocollo)      #
#                      - Azienda ___                            #
#                                                               #
# ------------------------------------------------------------- #
#                                                               #
# Utilizzo :                                                    #
#                                                               #
# $ t_mod_csv AZI 99999999999  ___ PROVVISORIO ___              #
#                                                               #
# ___ DA COMPLETARE ___                                         #
#                                                               #
# ___ Lettura parametri da 'wipfat0.csv' ___                    #
#                                                               #
# ___ Genera un file EPS on fly   ___                           #
#                                                               #
# ___ Richiamato sperimentalmente da 'psua4' ___                #
# ___ con risultati strani                   ___                #
#                                                               #
#===============================================================#

#===============================================================#
# Moduli Perl                                                   #
#---------------------------------------------------------------#
use PostScript::Simple                                         ;

#===============================================================#
# Variabili statiche                                            #
#---------------------------------------------------------------#
#---------------------------------------------------------------#
# Stampante                                                     #
#---------------------------------------------------------------#
my $cod_stp = "hp"                                             ;
#---------------------------------------------------------------#
# Modulo csv                                                    #
#---------------------------------------------------------------#
my $mod_csv = "/abd/asc/tmp/wipfat0.csv"                       ;
#---------------------------------------------------------------#
# Modulo in input                                               #
#---------------------------------------------------------------#
my $pat_out = "/abd/asc/tmp/"                                  ;
#---------------------------------------------------------------#
# Modulo in output                                              #
#---------------------------------------------------------------#
my $mod_pdf = "/abd/asc/tmp/wipfatX.pdf"                        ;

#===============================================================#
# Nuova pagina Postscript                                       #
#---------------------------------------------------------------#
$p = new PostScript::Simple(papersize => "A4",
                            landscape => 0,
                               colour => 1,
                                  eps => 1,
                                units => "mm")                 ;

#===============================================================#
# Inizializzazione pagina : togliere se EPS                     #
#---------------------------------------------------------------#
#$p->newpage                                                    ;

#===============================================================#
# Open file                                                     #
#---------------------------------------------------------------#
open (I_FILE, "$mod_csv") or die
     "Impossibile aprire il file '$mod_csv'"                   ;
my   @linea = <I_FILE>                                         ;

#===============================================================#
# Close del file in input                                       #
#---------------------------------------------------------------#
close I_FILE                                                   ;

#===============================================================#
# Ciclo di scansione                                            #
#---------------------------------------------------------------#
foreach $row (@linea)
{
#   #-----------------------------------------------------------#
#   # Estrazione campi                                          #
#   #-----------------------------------------------------------#
    my   @rec = split(/;/, $row)                               ;
#   #-----------------------------------------------------------#
#   # Trattamento Parametri generali                            #
#   #-----------------------------------------------------------#
    if  ($rec[0] eq "P")
    {
        &trt_gen                                               ;
    }
#   #-----------------------------------------------------------#
#   # Trattamento EPS                                           #
#   #-----------------------------------------------------------#
    elsif ($rec[0] eq "E")
    {
        &trt_eps                                               ;
    }
#   #-----------------------------------------------------------#
#   # Trattamento Testo                                         #
#   #-----------------------------------------------------------#
    elsif ($rec[0] eq "T")
    {
        &trt_txt                                               ;
    }
#   #-----------------------------------------------------------#
#   # Trattamento Linea                                         #
#   #-----------------------------------------------------------#
    elsif ($rec[0] eq "L")
    {
        &trt_lin                                               ;
    }
#   #-----------------------------------------------------------#
#   # Trattamento Box                                           #
#   #-----------------------------------------------------------#
    elsif ($rec[0] eq "B")
    {
        &trt_box                                               ;
    }
#   #-----------------------------------------------------------#
#   # Trattamento Box con angoli arrotondati                    #
#   #-----------------------------------------------------------#
    elsif ($rec[0] eq "A")
    {
        &trt_bar                                               ;
    }
#   #-----------------------------------------------------------#
#   # Trattamento Font                                          #
#   #-----------------------------------------------------------#
    elsif ($rec[0] eq "F")
    {
        &trt_fnt                                               ;
    }
#   #-----------------------------------------------------------#
#   # Righe di commento (ignorate)                              #
#   #-----------------------------------------------------------#
    else
    {
        next()                                                 ;
    }
}

#===============================================================#
# Generazione file PostScript                                   #
#---------------------------------------------------------------#
$p->output($mod_out)                                           ;

#===============================================================#
# Stampa                                                        #
#---------------------------------------------------------------#
# system("cat $mod_out | lpr -P$cod_stp")                      ;
#===============================================================#
# Generazione PDF : disattivare se chiamato da TANGRAM !!! ___  #
#---------------------------------------------------------------#
system("ps2pdf $mod_out $mod_pdf")                             ;

#===============================================================#
# SUBROUTINES                                                   #
#===============================================================#

#===============================================================#
# Subroutine per Parametri Generali                             #
#---------------------------------------------------------------#
sub trt_gen
{
#   #-----------------------------------------------------------#
#   # Estrazione campi                                          #
#   #-----------------------------------------------------------#
    my @rig = split(/;/, $row)                                 ;
#   #-----------------------------------------------------------#
#   # Campi estratti                                            #
#   #-----------------------------------------------------------#
    my $out = $rig[1]                                          ;
#   #-----------------------------------------------------------#
#   # Pathname output                                           #
#   #-----------------------------------------------------------#
    $mod_out = $pat_out . $out                                 ;
}

#===============================================================#
# Subroutine per EPS                                            #
#---------------------------------------------------------------#
sub trt_eps
{
#   #-----------------------------------------------------------#
#   # Estrazione campi                                          #
#   #-----------------------------------------------------------#
    my @rig = split(/;/, $row)                                 ;
#   #-----------------------------------------------------------#
#   # Campi estratti                                            #
#   #-----------------------------------------------------------#
    my $xxx = $rig[1]                                          ;
    my $yyy = $rig[2]                                          ;
    my $lun = $rig[3]                                          ;
    my $alt = $rig[4]                                          ;
    my $pth = $rig[5]                                          ;
#   #-----------------------------------------------------------#
#   # Inclusione barcode EPS                                    #
#   #-----------------------------------------------------------#
    $p->importepsfile($pth,
                      $xxx,
                      $yyy,
                      $xxx+$lun,
                      $yyy+$alt)                               ;
}

#===============================================================#
# Subroutine per Font                                           #
#---------------------------------------------------------------#
sub trt_fnt
{
#   #-----------------------------------------------------------#
#   # Estrazione campi                                          #
#   #-----------------------------------------------------------#
    my @rig = split(/;/, $row)                                 ;
#   #-----------------------------------------------------------#
#   # Campi estratti                                            #
#   #-----------------------------------------------------------#
    my $fnt = $rig[1]                                          ;
    my $siz = $rig[2]                                          ;
#   #-----------------------------------------------------------#
#   # Set del Font                                              #
#   #-----------------------------------------------------------#
    $p->setfont($fnt, $siz)                                    ;
}

#===============================================================#
# Subroutine per Testo                                          #
#---------------------------------------------------------------#
sub trt_txt
{
#   #-----------------------------------------------------------#
#   # Estrazione campi                                          #
#   #-----------------------------------------------------------#
    my @rig = split(/;/, $row)                                 ;
#   #-----------------------------------------------------------#
#   # Campi estratti                                            #
#   #-----------------------------------------------------------#
    my $ali = $rig[1]                                          ;
    my $xxx = $rig[2]                                          ;
    my $yyy = $rig[3]                                          ;
    my $txt = $rig[4]                                          ;
#   #-----------------------------------------------------------#
#   # Allineamento                                              #
#   #-----------------------------------------------------------#
    if    ($ali eq "L") {$all = "left"}
    elsif ($ali eq "C") {$all = "center"}
    elsif ($ali eq "R") {$all = "right"}
    else                {$all = "right"}                       ;
#   #-----------------------------------------------------------#
#   # Emissione testo                                           #
#   #-----------------------------------------------------------#
    $p->text({align => $all},$xxx, $yyy, $txt)                 ;
}

#===============================================================#
# Subroutine per Linea                                          #
#---------------------------------------------------------------#
sub trt_lin
{
#   #-----------------------------------------------------------#
#   # Estrazione campi                                          #
#   #-----------------------------------------------------------#
    my @rig = split(/;/, $row)                                 ;
#   #-----------------------------------------------------------#
#   # Campi estratti                                            #
#   #-----------------------------------------------------------#
    my $xxx = $rig[1]                                          ;
    my $yyy = $rig[2]                                          ;
    my $lun = $rig[3]                                          ;
    my $ori = $rig[4]                                          ;
#   #-----------------------------------------------------------#
#   # Orientamento linea                                        #
#   #-----------------------------------------------------------#
    if    ($ori eq "O") {$xin = $lun; $yin = 0}
    else                {$xin = 0; $yin = $lun}                ;
#   #-----------------------------------------------------------#
#   # Emissione linea                                           #
#   #-----------------------------------------------------------#
    $p->line($xxx, $yyy, $xxx+$xin, $yyy+$yin)                 ;
}

#===============================================================#
# Subroutine per Box                                            #
#---------------------------------------------------------------#
sub trt_box
{

#   #-----------------------------------------------------------#
#   # Estrazione campi                                          #
#   #-----------------------------------------------------------#
    my @rig = split(/;/, $row)                                 ;
#   #-----------------------------------------------------------#
#   # Campi estratti                                            #
#   #-----------------------------------------------------------#
    my $xxx = $rig[1]                                          ;
    my $yyy = $rig[2]                                          ;
    my $lun = $rig[3]                                          ;
    my $alt = $rig[4]                                          ;
    my $sps = $rig[5]                                          ;
    my $col = $rig[6]                                          ;
    my $fll = $rig[7]                                          ;
    my $shd = $rig[8]                                          ;
#   #-----------------------------------------------------------#
#   # Estrazione RGB colore                                     #
#   #-----------------------------------------------------------#
    my @rgb = split(/,/, $col)                                 ;
    my $rrr = $rgb[0]                                          ;
    my $ggg = $rgb[1]                                          ;
    my $bbb = $rgb[2]                                          ;
#   #-----------------------------------------------------------#
#   # Spessore linea                                            #
#   #-----------------------------------------------------------#
    $p->setlinewidth($sps)                                     ;
#   #-----------------------------------------------------------#
#   # Test se ombra                                             #
#   #-----------------------------------------------------------#
    if ($shd eq "S")
    {
#       #-------------------------------------------------------#
#       # Colore ombra                                          #
#       #-------------------------------------------------------#
        $p->setcolour(204,204,204)                             ;
#       #-------------------------------------------------------#
#       # Box ombra inferiore                                   #
#       #-------------------------------------------------------#
        $p->box({filled => 1},
                       $xxx+1,
                       $yyy-1,
                  $xxx+$lun+1,
                         $yyy)                                 ;
#       #-------------------------------------------------------#
#       # Box ombra laterale destra                             #
#       #-------------------------------------------------------#
        $p->box({filled => 1},
                    $xxx+$lun,
                         $yyy,
                  $xxx+$lun+1,
                  $yyy+$alt-1)                                 ;
#       #-------------------------------------------------------#
#       # Ripristino colore                                     #
#       # ___                                                   #
#       #-------------------------------------------------------#
        $p->setcolour('black')                                 ;
    }
#   #-----------------------------------------------------------#
#   # Colore                                                    #
#   #-----------------------------------------------------------#
    $p->setcolour($rrr,$ggg,$bbb)                              ;
#   #-----------------------------------------------------------#
#   # Test se riempito                                          #
#   #-----------------------------------------------------------#
    if ($fll eq "F")
    {
#       #-------------------------------------------------------#
#       # Box rettangolare riempito                             #
#       #-------------------------------------------------------#
        $p->box({filled => 1},
                         $xxx,
                         $yyy,
                    $xxx+$lun,
                    $yyy+$alt)                                 ;
#       #-------------------------------------------------------#
#       # Ripristino colore                                     #
#       # ___                                                   #
#       #-------------------------------------------------------#
        $p->setcolour('black')                                 ;
    }
     else
    {
#       #-------------------------------------------------------#
#       # Box rettangolare vuoto                                #
#       #-------------------------------------------------------#
        $p->box($xxx, $yyy, $xxx+$lun, $yyy+$alt)              ;
    }

}

#===============================================================#
# Subroutine per Box con angoli arrotondati                     #
#---------------------------------------------------------------#
sub trt_bar
{
#   #-----------------------------------------------------------#
#   # Estrazione campi                                          #
#   #-----------------------------------------------------------#
    my @rig = split(/;/, $row)                                 ;
#   #-----------------------------------------------------------#
#   # Campi estratti                                            #
#   #-----------------------------------------------------------#
    my $xxx = $rig[1]                                          ;
    my $yyy = $rig[2]                                          ;
    my $lun = $rig[3]                                          ;
    my $alt = $rig[4]                                          ;
    my $rag = $rig[5]                                          ;
    my $sps = $rig[6]                                          ;
    my $col = $rig[7]                                          ;
#   #-----------------------------------------------------------#
#   # Spessore linea                                            #
#   #-----------------------------------------------------------#
    $p->setlinewidth($sps)                                     ;
#   #-----------------------------------------------------------#
#   # Colore                                                    #
#   #-----------------------------------------------------------#
    $p->setcolour($col)                                        ;
#   #-----------------------------------------------------------#
#   # Linee Box                                                 #
#   #-----------------------------------------------------------#
    $p->line($xxx+$rag, $yyy, $xxx+$lun-$rag, $yyy)           ; # linea in basso
    $p->line($xxx+$rag, $yyy+$alt, $xxx+$lun-$rag, $yyy+$alt) ; # linea in alto
    $p->line($xxx, $yyy+$rag, $xxx, $yyy+$alt-$rag)           ; # linea a sinistra
    $p->line($xxx+$lun, $yyy+$rag, $xxx+$lun, $yyy+$alt-$rag) ; # linea a destra
#   #-----------------------------------------------------------#
#   # Angoli Box                                                #
#   #-----------------------------------------------------------#
    $p->arc($xxx+$rag, $yyy+$rag, $rag, 180, 270)             ; # angolo in basso a sinistra
    $p->arc($xxx+$lun-$rag, $yyy+$rag, $rag, 270, 360)        ; # angolo in basso a destra
    $p->arc($xxx+$rag, $yyy+$alt-$rag, $rag, 90, 180)         ; # angolo in alto a sinistra
    $p->arc($xxx+$lun-$rag, $yyy+$alt-$rag, $rag, 0, 90)      ; # angolo in alto a destra
}

