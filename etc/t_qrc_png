#!/usr/bin/perl -w
#==========================================*
# FUNZIONA!!! (18/11/21)                   *
#                                          *
# Genera un file PNG con il QRcode         *
#                                          *
# t_qrc_png http://www.wip-info.it /abd/asc/tmp/wip_qr.png
#                                          *
#==========================================*

use Image::PNG::QRCode 'qrpng'            ;

#==========================================*
# Variabili in input                       *
#------------------------------------------*
my $txt = shift                           ;
my $fil = shift                           ;

#==========================================*
# Output                                   *
#                                          *
# Parametri:                               *
#                                          *
# - level = da 1 a 4 - tolleranza errore   *
# - quiet = spessore cornice esterna       *
# - scale = scala del QR code              *
#------------------------------------------*
qrpng (text => $txt,
        out => $fil,
#    version => 40,
      level => 4,
      quiet => 0,
      scale => 5);