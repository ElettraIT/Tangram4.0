#!/usr/bin/perl -w
#==========================================*
# Modulo Perl per Zippare una lista di     *
# files in un unico archivio               *
#                                          *
# t_zip_add_siri                           *
#                                          *
# ---------------------------------------- *
# Versione originale:   001 del 20/02/18   *
#   Ultima revisione:   NdK del 02/08/19   *
# ---------------------------------------- *
#             Autore:   Nicola de Kunovich *
# ---------------------------------------- *
#                                          *
# In input : - codice azienda              *
#            - area (fat, scf,...)         *
#            - anno (1 carattere Alfa)     *
#            - numero distinta (zero acc.) *
#            - prefisso (IT99999999999)    *
#                                          *
# ---------------------------------------- *
# N.B.: i campi in input sono separati da  *
#       virgola ','                        *
#------------------------------------------*

#==========================================*
# Moduli Perl utilizzati                   *
#------------------------------------------*
use Archive::Zip qw( :ERROR_CODES :CONSTANTS );
use File::Basename                        ;

#==========================================*
# Variabili lette in input                 *
#------------------------------------------*
#    *-------------------------------------*
#    * Lettura variabile in input          *
#    *-------------------------------------*
$inpt = $ARGV[0]                          ;

#==========================================*
# Help                                     *
#------------------------------------------*
if (!$ARGV[0] || $ARGV[0] eq "-help")
{
    print "\n"
        . "Uso : (parametri "
        . "separati da virgola)"
        . "\n"
        . "> t_zip_add_siri"
        . "\n"
        . "           AZIENDA,"
        . "\n"
        . "           AREA (fat\,scf\),"
        . "\n"
        . "           ANNO (A/B/..),"
        . "\n"
        . "           DISTINTA (ANCHE A '0'),"
        . "\n"
        . "           PREFISSO (IT99999999999),"
        . "\n"
        . "\n"
        . "Release : 05/11/2018"
        . "\n"
        . "\n"
        . "(C) Copyright - wip"
        . "\n"
        . "\n"                            ;
    exit()                                ;
}

#    *-------------------------------------*
#    * Separazione dei componenti (,)      *
#    *-------------------------------------*
@vars = split(/,/, $inpt)                 ;
#    *-------------------------------------*
#    * Azienda                             *
#    *-------------------------------------*
my $azie = $vars[0]                       ;
#    *-------------------------------------*
#    * Area                                *
#    *-------------------------------------*
my $area = $vars[1]                       ;
#    *-------------------------------------*
#    * Anno                                *
#    *-------------------------------------*
my $anno = $vars[2]                       ;
#    *-------------------------------------*
#    * Progressivo in input                *
#    *-------------------------------------*
my $prgi = $vars[3]                       ;
#    *-------------------------------------*
#    * Prefisso                            *
#    *-------------------------------------*
my $pref = $vars[4]                       ;

#==========================================*
# Variabili statiche                       *
#------------------------------------------*
my $base = "/abd/asc/"                    ;
my $cont = 0                              ;
my $newz = ""                             ;

#==========================================*
# Composizione directory da leggere        *
#------------------------------------------*
my $dire = $base
         . $azie
         . "/"
         . $area                          ;

#==========================================*
# DEBUG                                    *
#------------------------------------------*
#print $nzip . "\n"                        ;
#print $dire . "\n"                        ;
#print $list . "\n"                        ;
#print $dstn . "\n"                        ;
#exit()                                    ;

#==========================================*
# Nuovo oggetto                            *
#------------------------------------------*
my $obj = Archive::Zip->new()             ;

#==========================================*
# Cambio directory                         *
#------------------------------------------*
chdir $dire                               ;

#==========================================*
# Open directory                           *
#------------------------------------------*
opendir (DIR,$dire)                       ;
    
#==========================================*
# Ciclo interno alla directory             *
#------------------------------------------*
LINE: foreach $elem (sort readdir(DIR))
{
    #--------------------------------------*
    # Esclusione 'albero' directory        *
    #--------------------------------------*
    if ($elem eq "." || $elem eq "..")
       {next(LINE)}                       ;
    #--------------------------------------*
    # Pulizia fine riga                    *
    #--------------------------------------*
    chomp ($elem)                         ;
    #--------------------------------------*
    # Esclusione files di sistema          *
    #--------------------------------------*
    next if $elem =~ /^\./                ;
    #--------------------------------------*
    # Esclusione estensioni diverse        *
    #--------------------------------------*
    my ($name,
        $path,
        $suff) = fileparse($elem, '\.[^\.]*');
        if ($suff ne ".xml" && $suff ne ".p7m")
           {next(LINE);}                  ;
    #--------------------------------------*
    # Test che il file esista              *
    #--------------------------------------*
    if (-e $elem)
    { 
        #----------------------------------*
        # Incremento contatore (max 10)    *
        #----------------------------------*
        $cont++                           ;
        #----------------------------------*
        # Test su contatore (max 10)       *
        #----------------------------------*
        if ($cont > 10)
        {
            #------------------------------*
            # Riposizionamento contatore   *
            #------------------------------*
            $cont = 1                     ;
        }
        #----------------------------------*
        # Test se contatore a 1            *
        #----------------------------------*
        if ($cont < 2)
        {
            #------------------------------*
            # Incremento progressivo       *
            #------------------------------*
            $prgi++                       ;
            #------------------------------*
            # Riposizionamento contatore   *
            #------------------------------*
            $newz = &nom_zip ($prgi)      ;
            #------------------------------*
            # Nuova istanza creazione Zip  *
            #------------------------------*
            $obj = Archive::Zip->new()    ;
            #------------------------------*
            # Aggiunta file                *
            #------------------------------*
            $obj->addFile($elem)          ;
            $obj->writeToFileNamed($newz) ;
        }
         else
        {
            #------------------------------*
            # Aggiunta file                *
            #------------------------------*
            $obj->addFile($elem)          ;
            $obj->writeToFileNamed($newz) ;
        }
    }
}


#==========================================*
# Close directory                          *
#------------------------------------------*
closedir (DIR)                            ;

#=========================================*
# Nome file                               *
#-----------------------------------------*
sub nom_zip
{
    #=====================================*
    # Progressivo in input                *
    #-------------------------------------*
    my $prog = shift                      ;
    #-------------------------------------*
    # Formattazione progressivo           *
    #-------------------------------------*
    my $prof = sprintf("%04d", $prog)     ;
    #-------------------------------------*
    # Nome composto                       *
    #-------------------------------------*
    my $nzip = $pref
             . "_"
             . $anno
             . $prof
             . ".zip"                     ;
    #-------------------------------------*
    # Valore in output                    *
    #=====================================*
    return $nzip                          ;
}

