#!/usr/bin/perl -w
#==========================================*
# Modulo Perl per traduzione MD5 azienda e *
# utente                                   *
#                                          *
# t_md5                                    *
#                                          *
# ---------------------------------------- *
# Versione originale:  001 del 25/12/10    *
#   Ultima revisione:  NdK del 25/12/10    *
# ---------------------------------------- *
#             Autore:  Nicola de Kunovich  *
# ---------------------------------------- *
#                                          *
# In input : - azienda e utente            *
#                                          *
#==========================================*

#==========================================*
# Moduli Perl                              *
#------------------------------------------*
use Digest::MD5 qw(md5_hex)               ;

#==========================================*
# Variabili lette in input                 *
#------------------------------------------*
my $azie = shift                          ;
my $user = shift                          ;

#==========================================*
# Help                                     *
#------------------------------------------*
if (!$azie || $azie eq "-help")
{
    print "\n"
        . "Uso :"
        . "\n"
        . "> t_md5 azienda utente "
        . "\n"
        . "\n"
        . "Release : 25/12/10"
        . "\n"
        . "\n"
        . "(C) Copyright - dKb"
        . "\n"
        . "\n"                            ;
    exit()                                ;
}

#==========================================*
# Sub-routine di traduzione                *
#------------------------------------------*
&md5f                                     ;

#==========================================*
# SUB-ROUTINES                             *
#==========================================*

#==========================================*
# Subroutine di traduzione                 *
#------------------------------------------*
sub md5f
{
    #--------------------------------------*
    # Determinazione nomi cartelle e file  *
    #--------------------------------------*
    my $md5a = md5_hex($azie)             ;
    my $md5u = md5_hex($user)             ;

    my $dest = $md5a
             . $md5u                      ;

    #--------------------------------------*
    # Visualizzazione risultato            *
    #--------------------------------------*
    print $dest . "\n"                    ;
}
