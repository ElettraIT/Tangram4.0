#!/usr/bin/perl -w
#===============================================================*
#                                                               *
# Creazione barcode 128 per ubicazioni da file sequenziale      *
#                                                               *
# Ad hoc SIRI                                                   *
#                                                               *
#                   ------------------------------------------- *
#                    Versione originale:    001 del 05/05/2023  *
#                      Ultima revisione:    NdK del 05/05/2023  *
#                   ------------------------------------------- *
#                                Autore:    Nicola de Kunovich  *
# ------------------------------------------------------------- *
#                                                               *
# Parametri in input : (nessuno)                                *
#                                                               *
# ------------------------------------------------------------- *
#                                                               *
# Nota bene : i barcode EPS vengono generati on-fly tramite     *
#             il modulo PostScript 'barcode.ps'                 *
#                                                               *
#             ___ NON USATO: FILES TROPPO GROSSI ___            *
#                                                               *
#===============================================================*

#===============================================================*
# Moduli Perl                                                   *
#---------------------------------------------------------------*
use PostScript::Simple                                         ;

#===============================================================*
# Variabili statiche                                            *
#---------------------------------------------------------------*
#   *-----------------------------------------------------------*
#   * Percorsi file                                             *
#   *-----------------------------------------------------------*
    my $pth_csv = "/abd/asc/tmp/elezub.sqz"                    ;
    my $pth_ubi = "/abd/asc/bcd/ubi/"                          ;

#===============================================================*
# Lettura del modulo 'barcode.ps'                               *
#---------------------------------------------------------------*
my $gen_bcd = "/abd/asc/cfg/barcode.ps"                        ;
open(PS,$gen_bcd) || die 'File di '
                           . 'configurazione non trovato'      ;
$_=join('',<PS>)                                               ;
close(PS)                                                      ;

#===============================================================*
# Estrazione dal modulo 'barcode.ps' del TEMPLATE da richiamare *
#---------------------------------------------------------------*
m/
    %\ --BEGIN\ TEMPLATE--
    (.*)
    %\ --END\ TEMPLATE--
    /sx || die 'Unable to parse out the template'              ;

#===============================================================*
# Completamento del TEMPLATE                                    *
#---------------------------------------------------------------*
my $template=''                                                ;
$template.="%!PS-Adobe-2.0 EPSF-2.0\n"                         ;
$template.="%%BoundingBox: 0 0 [% width %] [% height %]\n"     ;
$template.="%%EndComments"                                     ;
$template.=$1                                                  ;
$template.="10 7 moveto\n"                                     ;
$template.="[% call %]\n"                                      ;
$template.="showpage\n"                                        ;

#===============================================================*
# Trattamento file sequenziale                                  *
#---------------------------------------------------------------*
#   *-----------------------------------------------------------*
#   * Open e Close file in input                                *
#   *-----------------------------------------------------------*
    open (I_FILE, "$pth_csv") or die
         "Impossibile aprire il file '$pth_csv'"               ;
    my   @linea = <I_FILE>                                     ;
    close I_FILE                                               ;

#   *-----------------------------------------------------------*
#   * Ciclo di scansione                                        *
#   *-----------------------------------------------------------*
foreach $linea (@linea)
{
#       *-------------------------------------------------------*
#       * Estrazione codice                                     *
#       *-------------------------------------------------------*
        my   $cod_ubi = substr($linea, 2, 7)                   ;
        
             $cod_ubi =~ s/\s*$//                              ;
       
#       *-------------------------------------------------------*
#       * Emissione file                                        *
#       *-------------------------------------------------------*
        &emi_fil ($cod_ubi)                                    ;
}

#===============================================================*
# SUBROUTINES                                                   *
#===============================================================*

#===============================================================*
# Emissione file                                                *
#---------------------------------------------------------------*
sub emi_fil
{
#   *-----------------------------------------------------------*
#   * Nome file                                                 *
#   *-----------------------------------------------------------*
    my $fil_nam = shift                                        ;
#   *-----------------------------------------------------------*
#   * Generazione file                                          *
#   *-----------------------------------------------------------*
    &gen_eps ($fil_nam)                                        ;
}

#===============================================================*
# Generazione EPS                                               *
#---------------------------------------------------------------*
sub gen_eps
{
#   *-----------------------------------------------------------*
#   * Valore in input                                           *
#   *-----------------------------------------------------------*
    my $val_cmp = shift                                        ;
#   *-----------------------------------------------------------*
#   * Parametri per generazione tramite modulo 'barcode.ps'     *
#   *-----------------------------------------------------------*
    my $filename= $pth_ubi . $val_cmp . ".eps"                 ;
    my $width=140                                              ;
    my $height=36                                              ;
    my $contents = "("
                 . $val_cmp
                 . ") (includetext) /code128 "
                 . "/uk.co.terryburton.bwipp "
                 . "findresource exec"                    ;
#   *-----------------------------------------------------------*
#   * Completamento per EPS                                     *
#   *-----------------------------------------------------------*
    my $barcode=$template                                      ;
    $barcode=~s/\[% call %\]/$contents/                        ;
    $barcode=~s/\[% width %\]/$width/                          ;
    $barcode=~s/\[% height %\]/$height/                        ;
#   *-----------------------------------------------------------*
#   * DEBUG                                                     *
#   *-----------------------------------------------------------*
#    print $filename . "\n";
#    print $width . "\n";
#    print $height . "\n";
#    print $contents . "\n";
#   *-----------------------------------------------------------*
#   * Apertura e generazione del file EPS                       *
#   *-----------------------------------------------------------*
    open(OUT,"> $filename")                                ;
    print OUT $barcode                                         ;
    close(OUT)                                                 ;
}

