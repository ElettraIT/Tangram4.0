#!/usr/bin/perl -w
#===============================================================*
#                                                               *
# Driver generico di stampa file PostScript da Tangram          *
#                                                               *
#                   ------------------------------------------- *
#                    Versione originale:    001 del 10/04/2016  *
#                      Ultima revisione:    NdK del 18/04/2016  *
#                   ------------------------------------------- *
#                                Autore:    Nicola de Kunovich  *
# ------------------------------------------------------------- *
#                                                               *
# Parametri in input  : - file di testo da 'prf'                *
#                                                               *
# Risultato in output : - file PostScript in 'spl'              *
#                                                               *
# ------------------------------------------------------------- *
#                                                               *
# Utilizzo :                                                    *
#                                                               *
# $ t_driver_ps pf999999                                        *
#                                                               *
# ------------------------------------------------------------- *
#                                                               *
# Promemoria : prevedere nome stampante opzionale in input      *
#                                                               *
#===============================================================*

#===============================================================*
# Moduli Perl                                                   *
#---------------------------------------------------------------*
use PostScript::Simple                                         ;

#===============================================================*
# Variabili statiche                                            *
#---------------------------------------------------------------*
#   *-----------------------------------------------------------*
#   * Codice stampante                                          *
#   *-----------------------------------------------------------*
    my $cod_stp = "hp"                                         ;
#   *-----------------------------------------------------------*
#   * Logo                                                      *
#   *                                                           *
#   * Attualmente non gestito                                   *
#   *-----------------------------------------------------------*
#    my $fil_log = "AZI_log"                                   ;
#   *-----------------------------------------------------------*
#   * Filename 'prf' in input                                   *
#   *-----------------------------------------------------------*
    my $num_prf = $ARGV[0]                                     ;
    
#   *-----------------------------------------------------------*
#   * Help                                                      *
#   *-----------------------------------------------------------*
if (!$ARGV[0] || $ARGV[0] eq "-help")
{
    print "\n"
        . "Uso :"
        . "\n"
        . "> t_driver_ps pf999999"
        . "\n"
        . "\n"
        . "Release : 17/05/2016"
        . "\n"
        . "\n"
        . "(C) Copyright - wip"
        . "\n"
        . "\n"                                                 ;
    exit()                                                     ;
}
    
#   *-----------------------------------------------------------*
#   * Percorsi file                                             *
#   *-----------------------------------------------------------*
    my $pth_inp = "/abd/prf/"                                  ;
    my $pth_out = "/abd/spl/"                                  ;
    my $pth_prf = $pth_inp . $num_prf                          ;
    my $fil_num = substr($num_prf, 2, 6)                       ;
    my $pth_spl = $pth_out . "sf" . $fil_num                   ;
#   *-----------------------------------------------------------*
#   * Contatori pagina                                          *
#   *-----------------------------------------------------------*
    my $bot_mrg = 10                                           ;
    my $max_rig = 72                                           ;
    my $ctr_rig = 0                                            ;
    my $num_pag = 0                                            ;
    my $tit_lin = 278                                          ;
    my $top_pag = 283                                          ;
    my $cur_lin = $top_pag                                     ;
    my $alt_lin = -(($top_pag - $bot_mrg) / $max_rig)          ;

#===============================================================*
# Preparazione pagina                                           *
#---------------------------------------------------------------*
my $ps = new PostScript::Simple::(papersize => "A4",
                                     colour => 1,
                                        eps => 0,
                                  landscape => 0,
                                      units => "mm")           ;

#===============================================================*
# Trattamento stampa                                            *
#---------------------------------------------------------------*
#   *-----------------------------------------------------------*
#   * Open file                                                 *
#   *-----------------------------------------------------------*
    open (I_FILE, "$pth_prf") or die
         "Impossibile aprire il file '$pth_prf'"               ;
    my   @linea = <I_FILE>                                     ;

#   *-----------------------------------------------------------*
#   * Ciclo di scansione                                        *
#   *-----------------------------------------------------------*
foreach $linea (@linea)
{
#       *-------------------------------------------------------*
#       * Pulizia linea                                         *
#       *-------------------------------------------------------*
    chomp(@linea)                                              ;
#       *-------------------------------------------------------*
#       * Estrazione tipo record                                *
#       *-------------------------------------------------------*
    my  $tip_rec = substr($linea, 7, 1)                        ;
#       *-------------------------------------------------------*
#       * Trattamento header                                    *
#       *-------------------------------------------------------*
    if  ($tip_rec eq "H")
    {
        &hea_der                                               ;
    }
#       *-------------------------------------------------------*
#       * Trattamento salto pagina                              *
#       *-------------------------------------------------------*
    elsif  ($tip_rec eq "P")
    {
        &pag_ini                                               ;
    }
#       *-------------------------------------------------------*
#       * Trattamento corpo                                     *
#       *-------------------------------------------------------*
    else
    {
        &stp_cor                                               ;
    }
}

#===============================================================*
# Generazione file Postscript                                   *
#---------------------------------------------------------------*
$ps->output($pth_spl)                                          ;

#===============================================================*
# Stampa file Postscript                                        *
#---------------------------------------------------------------*
#   system("cat $pth_spl | lpr -P$cod_stp")                     ;

#===============================================================*
# Close del file in input                                       *
#---------------------------------------------------------------*
&fil_cls                                                       ;

#===============================================================*
# SUBROUTINES                                                   *
#===============================================================*

#===============================================================*
# Trattamento header                                            *
#---------------------------------------------------------------*
sub hea_der
{
#   *-----------------------------------------------------------*
#   * Ampiezza linea                                            *
#   *-----------------------------------------------------------*
    $amp_lin = substr($linea, 83, 03)                          ;
    $amp_lin += 0                                              ;
#   *-----------------------------------------------------------*
#   * Dimensioni font                                           *
#   *-----------------------------------------------------------*
    if ($amp_lin > 80)
    {
        $dim_fnt = 6                                           ;
    }
    else
    {
        $dim_fnt = 10                                          ;
    }
}

#===============================================================*
# Trattamento inizio pagina                                     *
#---------------------------------------------------------------*
sub pag_ini
{
#   *-----------------------------------------------------------*
#   * Estrazione campi                                          *
#   *-----------------------------------------------------------*
    my @campo = split(/:/, $linea)                             ;
#   *-----------------------------------------------------------*
#   * Intestazione pagina                                       *
#   *-----------------------------------------------------------*
    &mynewpage($ps)                                            ;
}

#===============================================================*
# Trattamento riga                                              *
#---------------------------------------------------------------*
sub stp_cor
{
#   *-----------------------------------------------------------*
#   * Contatore righe                                           *
#   *-----------------------------------------------------------*
    $ctr_rig++                                                 ;
#   *-----------------------------------------------------------*
#   * Estrazione campi                                          *
#   *-----------------------------------------------------------*
    my  $lin_stp = substr($linea, 8, $amp_lin)                 ;
#   *-----------------------------------------------------------*
#   * Pulizia trailing spaces campi testo                       *
#   *-----------------------------------------------------------*
    $lin_stp =~ s/\s+$//                                       ;
#   *-----------------------------------------------------------*
#   * Deviazione in funzione del numero riga                    *
#   *-----------------------------------------------------------*
    if    ($ctr_rig == 1)
    {
        &lin_001 ($lin_stp)                                    ;
    }
    elsif ($ctr_rig == 2)
    {
        &lin_002 ($lin_stp)                                    ;
    }
    else
    {
        &lin_oth ($lin_stp)                                    ;
    }
}

#===============================================================*
# Trattamento riga 1                                            *
#---------------------------------------------------------------*
sub lin_001
{
#   *-----------------------------------------------------------*
#   * Interlinea                                                *
#   *-----------------------------------------------------------*
    $cur_lin = $cur_lin + $alt_lin                             ;
#   *-----------------------------------------------------------*
#   * Linea in input                                            *
#   *-----------------------------------------------------------*
    my $lin_stp = shift                                        ;
#   *-----------------------------------------------------------*
#   * Test se contiene intestazione                             *
#   *-----------------------------------------------------------*
    my $flg_int = substr($lin_stp, 0, 3)                       ;
    if    ($flg_int eq "===")
    {
#       *-------------------------------------------------------*
#       * Rettangolo superiore                                  *
#       *-------------------------------------------------------*
        $ps->setcolour("grey")                                 ;
        $ps->box( {filled => 1}, 15, $cur_lin, 190,$cur_lin+1) ;
    } 
    else
    {
#       *-------------------------------------------------------*
#       * Stampa linea                                          *
#       *-------------------------------------------------------*
        $ps->text(15, $cur_lin, $lin_stp)                      ;
    } 
}

#===============================================================*
# Trattamento riga 2                                            *
#---------------------------------------------------------------*
sub lin_002
{
#   *-----------------------------------------------------------*
#   * Interlinea                                                *
#   *-----------------------------------------------------------*
    $cur_lin = $cur_lin + $alt_lin                             ;
#   *-----------------------------------------------------------*
#   * Linea in input                                            *
#   *-----------------------------------------------------------*
    my $lin_stp = shift                                        ;
#   *-----------------------------------------------------------*
#   * Test se contiene intestazione                             *
#   *-----------------------------------------------------------*
    my $flg_int = substr($lin_stp, 0, 3)                       ;
    if    ($flg_int eq "===")
    {
#       *-------------------------------------------------------*
#       * Rettangolo superiore                                  *
#       *-------------------------------------------------------*
        $ps->setcolour("grey")                                 ;
        $ps->box( {filled => 1}, 15, $cur_lin, 190,$cur_lin+1) ;
    } 
    else
    {
#       *-------------------------------------------------------*
#       * Stampa linea                                          *
#       *-------------------------------------------------------*
        $ps->text(15, $cur_lin, $lin_stp)                      ;
    } 
}

#===============================================================*
# Trattamento riga successive                                   *
#---------------------------------------------------------------*
sub lin_oth
{
#   *-----------------------------------------------------------*
#   * Linea in input                                            *
#   *-----------------------------------------------------------*
    my $lin_stp = shift                                        ;
#   *-----------------------------------------------------------*
#   * Eventuale reintestazione pagina                           *
#   *-----------------------------------------------------------*
    if ( !($ctr_rig < $max_rig))
    {
        &mynewpage($ps)                                        ;
    }
#   *-----------------------------------------------------------*
#   * Interlinea                                                *
#   *-----------------------------------------------------------*
    $cur_lin = $cur_lin + $alt_lin                             ;
#   *-----------------------------------------------------------*
#   * Stampa linea                                              *
#   *-----------------------------------------------------------*
    $ps->text(15, $cur_lin, $lin_stp)                          ;
}

#===============================================================*
# Intestazione pagina                                           *
#---------------------------------------------------------------*
sub mynewpage
{
#   *-----------------------------------------------------------*
#   * Documento in input                                        *
#   *-----------------------------------------------------------*
    my $ps = shift                                             ;
#   *-----------------------------------------------------------*
#   * Numero pagina                                             *
#   *-----------------------------------------------------------*
    $num_pag++                                                 ;
#   *-----------------------------------------------------------*
#   * Nuova pagina                                              *
#   *-----------------------------------------------------------*
    $ps->newpage                                               ;
#   *-----------------------------------------------------------*
#   * Box pagina                                                *
#   *-----------------------------------------------------------*
    $ps->setlinewidth(0.01)                                    ;
    $ps->box(10, 12, 200, 285)                                 ;
#   *-----------------------------------------------------------*
#   * Font per riferimenti                                      *
#   *-----------------------------------------------------------*
    $ps->setfont("Helvetica", 4)                               ;
#   *-----------------------------------------------------------*
#   * Stampa riferimenti                                        *
#   *-----------------------------------------------------------*
    $ps->text({rotate => 90}, 8, 12, 'Sistema Informativo TANGRAM');
#   *-----------------------------------------------------------*
#   * Font                                                      *
#   *-----------------------------------------------------------*
    $ps->setfont("Courier", $dim_fnt)                          ;
#   *-----------------------------------------------------------*
#   * Riposizionamento linea                                    *
#   *-----------------------------------------------------------*
    $ctr_rig = 0                                               ;
    $cur_lin = $top_pag                                        ;
}

#===============================================================*
# Apertura file da trattare                                     *
#---------------------------------------------------------------*
sub fil_cls
{
close I_FILE                                                   ;
}

