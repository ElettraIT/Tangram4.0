        #----------------------------------*
        # Albo Professionale     (1.2.1.4) *
        #----------------------------------*
        $pmt_nam = "AlboProfessionale"    ;
        $pmt_dat = $pmt_fnt->{DatiAnagrafici}
                           ->{AlboProfessionale};
        #
        &pmt_val ($wrk_nam,
                  $tip_rec,
                  $tip_ele,
                  $pmt_nam,
                  $pmt_dat)               ;
        #----------------------------------*
        # Provincia Albo         (1.2.1.5) *
        #----------------------------------*
        $pmt_nam = "ProvinciaAlbo"        ;
        $pmt_dat = $pmt_fnt->{DatiAnagrafici}
