        #==================================*
        # Sconto o maggiorazione (2.1.1.8) *
        # campo multiplo                   *
        #----------------------------------*
        if (ref($data->{FatturaElettronicaBody}
                     ->{DatiGenerali}
                     ->{DatiGeneraliDocumento}
                     ->{ScontoMaggiorazione}) =~ /ARRAY/)
        {
            #-----------------------------*
            # Ciclo su righe sconto       *
            #-----------------------------*
            foreach $s (@{$data->{FatturaElettronicaBody}
                               ->{DatiGenerali}
                               ->{DatiGeneraliDocumento}
                               ->{ScontoMaggiorazione}})
            {
            #-----------------------------*
            # Tipo                        *
            #-----------------------------*
            $pmt_nam = "Tipo"             ;
            $pmt_val = $s->{Tipo}         ;
            #
            &pmt_val ($wrk_nam,
                      $tip_rec,
                      $tip_ele,
                      $pmt_nam,
                      $pmt_val)           ;
            #-----------------------------*
            # Percentuale                 *
            #-----------------------------*
            $pmt_nam = "Percentuale"      ;
            $pmt_val = $s->{Percentuale}  ;
            #
            &pmt_val ($wrk_nam,
                      $tip_rec,
                      $tip_ele,
                      $pmt_nam,
                      $pmt_val)           ;
            #-----------------------------*
            # Importo                     *
            #-----------------------------*
            $pmt_nam = "Importo"          ;
            $pmt_val = $s->{Importo}      ;
            #
            &pmt_val ($wrk_nam,
                      $tip_rec,
                      $tip_ele,
                      $pmt_nam,
                      $pmt_val)           ;
            }
        }
         else
        {
            #-----------------------------*
            # Se una sola riga di sconto  *
            #-----------------------------*
            # Tipo                        *
            #-----------------------------*
            $pmt_nam = "Tipo"             ;
            $pmt_val = $data->{FatturaElettronicaBody}
