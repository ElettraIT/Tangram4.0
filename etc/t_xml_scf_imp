                  $tip_rec,
                  $tip_ele,
                  $pmt_trz)               ;

    #--------------------------------------*
    # Terzo intermediario - Fine           *
    #======================================*

    #======================================*
    # Dati Generali Documento              *
    #--------------------------------------*
        #----------------------------------*
        # Tipo elemento                    *
        #----------------------------------*
        $tip_ele = "doc"                  ;
        #----------------------------------*
        # Tipo documento         (2.1.1.1) *
        #----------------------------------*
        $pmt_nam = "TipoDocumento"        ;
        $pmt_dat = $data->{FatturaElettronicaBody}
                        ->{DatiGenerali}
                        ->{DatiGeneraliDocumento}
                        ->{TipoDocumento} ;
        #
        &pmt_val ($wrk_nam,
                  $tip_rec,
                  $tip_ele,
                  $pmt_nam,
                  $pmt_dat)               ;
