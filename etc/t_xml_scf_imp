#=========================================*
# Trattamento date                        *
#-----------------------------------------*
sub trt_dat
{
    #=====================================*
    # Valore in input                     *
    #--------------------------------------*
    my $date = shift                      ;
    #--------------------------------------*
    # Scomposizione data                  *
    #--------------------------------------*
    my @adate = split (/-/, $date)        ;
    #--------------------------------------*
    # Formato 'GG/MM/AAAA'                *
    #--------------------------------------*
    my $ndate= $adate[2]
             . "/"
             . sprintf("%02d", $adate[1])
             . "/"
             . sprintf("%04d",$adate[0])  ;
    #--------------------------------------*
    # Valore in output                    *
    #=====================================*
    return $ndate                         ;
}

#==========================================*
# Composizione prompt, valore ed eventuale *
# descrizione                              *
#------------------------------------------*
sub pmt_val
{
    #======================================*
    # Valori in input                      *
    #--------------------------------------*
    my $nam = shift                       ;
    my $rec = shift                       ;
    my $tip = shift                       ;
    my $pmt = shift                       ;
    my $val = shift                       ;
    #--------------------------------------*
    # Trattamento valore                   *
    #--------------------------------------*
    if (!$val){return}                    ;
    #--------------------------------------*
    # Eliminazione spazi superflui valore  *
    #--------------------------------------*
    $val =~ s/^\s+|\s+$//g                ;
    #--------------------------------------*
    # Eliminazione eventuali caratteri     *
    # accentati valore                     *
    #--------------------------------------*
    my $wrk = NFKD($val)                  ;
       $wrk =~ s/\p{NonspacingMark}//g    ;
       $val = $wrk                        ;
    #--------------------------------------*
    # Pulizia eventuali ' valore           *
    #--------------------------------------*
    $qvl = $dtb_con->quote($val)          ;
    #--------------------------------------*
    # Scrittura                            *
    #--------------------------------------*
    my $ins_dat = "INSERT INTO "
                . $dtb_tbr
                . " (nam_xml, "
                . "tip_rec, "
                . "tip_ele, "
                . "pmt_ele, "
                . "val_ele) "
                . " VALUES ('"
                . $nam
                . "', '"
                . $rec
                . "', '"
                . $tip
                . "', '"
                . $pmt
                . "',"
                . $qvl
                . ")"                     ;
    #--------------------------------------*
    # Preparazione                         *
    #--------------------------------------*
    my $sth_dtb = $dtb_con->prepare($ins_dat);
    #--------------------------------------*
    # Esecuzione                           *
    #--------------------------------------*
    $sth_dtb->execute()                   ;
    #--------------------------------------*
    # FINE SUBROUTINE                      *
    #======================================*
}

#==========================================*
# Aggiornamento tabella testate            *
#------------------------------------------*
sub upd_xml
{
    #======================================*
    # Valori in input                      *
    #--------------------------------------*
    my $fil_upd = shift                   ;
    #--------------------------------------*
    # Scrittura                            *
    #--------------------------------------*
    my $upd_dat = "UPDATE "
                . $dtb_tbt
                . " SET "
                . "dat_sql = NOW()"
                . " WHERE nam_xml = '"
                . $fil_upd
                . "' LIMIT 1"             ;
    #--------------------------------------*
    # Preparazione                         *
    #--------------------------------------*
    my $sth_dtb = $dtb_con->prepare($upd_dat);
    #--------------------------------------*
    # Esecuzione                           *
    #--------------------------------------*
    $sth_dtb->execute()                   ;
    #--------------------------------------*
    # FINE SUBROUTINE                      *
    #======================================*
}


