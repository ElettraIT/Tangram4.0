#!/usr/bin/perl -w
#===============================================================*
# Stampa CMR (da bol300)                                        *
#                                                               *
# SU MISURA PER NOBILI                                          *
#                                                               *
#                   ------------------------------------------- *
#                    Versione originale:    001 del 27/03/2023  *
#                      Ultima revisione:    NdK del 27/03/2023  *
#                   ------------------------------------------- *
#                                Autore:    Nicola de Kunovich  *
# ------------------------------------------------------------- *
#                                                               *
# Parametri in input : - file CSV da stampare (protocollo)      *
#                                                               *
# ------------------------------------------------------------- *
#                                                               *
# Utilizzo :                                                    *
#                                                               *
# $ t_nob_bol_cmr 99999999999                                   *
#                                                               *
# ------------------------------------------------------------- *
#                                                               *
# Note     : lo script "importa" un modulo EPS. Legge un file   *
#            CSV generato da Tangram (nob/pbol300s) che contie- *
#            ne una sintesi di una bolla estero e il risultato  *
#            viene inviato alla stampante o diventa PDF.        *
#                                                               *
#===============================================================*

#===============================================================*
# Moduli Perl                                                   *
#---------------------------------------------------------------*
use PostScript::Simple                                         ;

#===============================================================*
# Variabili statiche                                            *
#---------------------------------------------------------------*
#   *-----------------------------------------------------------*
#   * Lettura configurazione                                    *
#   *-----------------------------------------------------------*
    my $cfg_bas = "/abd/asc/cfg/t_nob_bol_cmr.ini"             ;
    my %cnf_ele = do $cfg_bas                                  ;
#   *-----------------------------------------------------------*
#   * Codice stampante da file configurazione                   *
#   *-----------------------------------------------------------*
    my $cod_stp = $cnf_ele{cod_stp}                            ;
#   *-----------------------------------------------------------*
#   * Protocollo in input                                       *
#   *-----------------------------------------------------------*
    my $num_prt = $ARGV[0]                                     ;
#   *-----------------------------------------------------------*
#   * Percorsi file                                             *
#   *-----------------------------------------------------------*
    my $pth_spl = $cnf_ele{pth_spl}                            ;
    my $pth_pdf = $cnf_ele{pth_pdf}                            ;
    my $mod_eps = $cnf_ele{pth_eps}                            ;
    my $pth_csv = $pth_spl . $num_prt . ".csv"                 ;
    my $out_stp = $pth_spl . $num_prt . ".ps"                  ;
    my $out_pdf = $pth_spl . $num_prt . ".pdf"                 ;
    my $ou2_pdf = $pth_pdf . $num_prt . ".pdf"                 ;
#   *-----------------------------------------------------------*
#   * Contatori e posizionatori pagina                          *
#   *-----------------------------------------------------------*
    my $max_rig = 16                                           ;
    my $ctr_rig = 0                                            ;
    my $num_pag = 0                                            ;
    my $num_rig = 0                                            ;
    my $top_rig = 152                                          ;
    my $row_hgt = 7.25                                         ;
    my $cur_lin = $top_rig                                     ;
#   *-----------------------------------------------------------*
#   * Normalizzazione variabili globali                         *
#   *-----------------------------------------------------------*
    my $nnu_bol = ""                                           ;
    my $nda_bol = ""                                           ;
#
    my $rag_cli = ""                                           ;
    my $via_cli = ""                                           ;
    my $loc_cli = ""                                           ;
    my $tel_cli = ""                                           ;
#
    my $rag_dst = ""                                           ;
    my $via_dst = ""                                           ;
    my $loc_dst = ""                                           ;
#
    my $rag_vet = ""                                           ;
    my $via_vet = ""                                           ;
    my $loc_vet = ""                                           ;
    my $piv_vet = ""                                           ;
    my $alb_vet = ""                                           ;
#
    my $pes_tot = ""                                           ;
    my $num_col = ""                                           ;

#===============================================================*
# Preparazione pagina                                           *
#---------------------------------------------------------------*
my $ps = new PostScript::Simple::(papersize => "A4",
                                  landscape => 0,
                                     copies => 4,
                                     colour => 1,
                                        eps => 0,
                                      units => "bp")           ;

#===============================================================*
# Trattamento stampa                                            *
#---------------------------------------------------------------*
#   *-----------------------------------------------------------*
#   * Open file                                                 *
#   *-----------------------------------------------------------*
    open (I_FILE, "$pth_csv") or die
         "Impossibile aprire il file '$pth_csv'"               ;
    my   @linea = <I_FILE>                                     ;

#   *-----------------------------------------------------------*
#   * Close del file in input                                   *
#   *-----------------------------------------------------------*
&fil_cls                                                       ;

#   *-----------------------------------------------------------*
#   * Ciclo di scansione preliminare per numero pagine totali   *
#   *-----------------------------------------------------------*
foreach $row (@linea)
{
    my   @rec = split(/;/, $row)                               ;
#       *-------------------------------------------------------*
#       * Trattamento testata                                   *
#       *-------------------------------------------------------*
    if  ($rec[0] eq "R")
    {
        $num_rig = $num_rig+1                                  ;
    }

}

#   *-----------------------------------------------------------*
#   * Determinazione numero pagine totali                       *
#   *-----------------------------------------------------------*
my $max_pag = &clc_pag ($max_rig, $num_rig)                    ;

#   *-----------------------------------------------------------*
#   * Ciclo di scansione                                        *
#   *-----------------------------------------------------------*
foreach $row (@linea)
{
    my   @rec = split(/;/, $row)                               ;
#       *-------------------------------------------------------*
#       * Trattamento testata                                   *
#       *-------------------------------------------------------*
    if  ($rec[0] eq "T")
    {
        &stp_tes                                               ;
    }
}

#===============================================================*
# Generazione file Postscript                                   *
#---------------------------------------------------------------*
$ps->output($out_stp)                                          ;

#===============================================================*
# Stampa file Postscript                                        *
#---------------------------------------------------------------*
if ($cod_stp eq "pdf")
{
    system("ps2pdf $out_stp $out_pdf")                        ;
    system("ps2pdf $out_stp $ou2_pdf")                        ;
}
 else
{
    system("cat $out_stp | lpr -P$cod_stp")                   ;
    system("ps2pdf $out_stp $ou2_pdf")                        ;
}

#===============================================================*
# SUBROUTINES                                                   *
#===============================================================*

#===============================================================*
# Stampa testata                                                *
#---------------------------------------------------------------*
sub stp_tes
{
#   *-----------------------------------------------------------*
#   * Estrazione campi                                          *
#   *-----------------------------------------------------------*
    my @tes = split(/;/, $row)                                 ;
#   *-----------------------------------------------------------*
#   * Pulizia trailing spaces campi testo                       *
#   *-----------------------------------------------------------*
    my $max_val = 17                                           ;
    my $ctr_001                                                ;
    for ($ctr_001 = 1 ; $ctr_001 < $max_val ; $ctr_001++ )
    {
        $tes[$ctr_001] =~ s/^\s+//                             ;
        $tes[$ctr_001] =~ s/\s+$//                             ;
    }
#   *-----------------------------------------------------------*
#   * Assegnazione variabile singolo campo di testata           *
#   *-----------------------------------------------------------*
    $nnu_bol = $tes[1]                                         ;
    $nda_bol = $tes[2]                                         ;
#
    $rag_cli = $tes[3]                                         ;
    $via_cli = $tes[4]                                         ;
    $loc_cli = $tes[5]                                         ;
    $tel_cli = $tes[6]                                         ;
#
    $rag_dst = $tes[7]                                         ;
    $via_dst = $tes[8]                                         ;
    $loc_dst = $tes[9]                                         ;
#
    $rag_vet = $tes[10]                                        ;
    $via_vet = $tes[11]                                        ;
    $loc_vet = $tes[12]                                        ;
    $piv_vet = $tes[13]                                        ;
    $alb_vet = $tes[14]                                        ;
#
    $pes_tot = $tes[15]                                        ;
    $num_col = $tes[16]                                        ;
    $dat_itr = $tes[17]                                        ;
#   *-----------------------------------------------------------*
#   * Posizionamenti fissi                                      *
#   *-----------------------------------------------------------*
    $lft_pos = 70                                              ;
#   *-----------------------------------------------------------*
#   * Prima intestazione pagina                                 *
#   *-----------------------------------------------------------*
    &mynewpage($ps)                                            ;
}

#===============================================================*
# Intestazione pagina                                           *
#---------------------------------------------------------------*
sub mynewpage
{
#   *-----------------------------------------------------------*
#   * Documento in input                                        *
#   *-----------------------------------------------------------*
    my $ps = shift                                             ;
#   *-----------------------------------------------------------*
#   * Numero pagina                                             *
#   *-----------------------------------------------------------*
    $num_pag++                                                 ;
#   *-----------------------------------------------------------*
#   * Nuova pagina                                              *
#   *-----------------------------------------------------------*
    $ps->newpage                                               ;
#   *-----------------------------------------------------------*
#   * Stampa ragione sociale cliente                            *
#   *-----------------------------------------------------------*
    $ps->setfont("Helvetica", 9)                               ;
    $ps->text($lft_pos, 640, $rag_cli)                         ;
    $ps->text($lft_pos, 630, $via_cli)                         ;
    $ps->text($lft_pos, 620, $loc_cli)                         ;
#   *-----------------------------------------------------------*
#   * Stampa ragione sociale vettore                            *
#   *-----------------------------------------------------------*
    $ps->text(315, 625, $rag_vet)                              ;
    $ps->text(315, 615, $via_vet)                              ;
    $ps->text(315, 605, $loc_vet)                              ;
#   *-----------------------------------------------------------*
#   * P.I. vettore                                              *
#   *-----------------------------------------------------------*
    $ps->text({align => 'left'}, 430, 640, "P.IVA "
                                          . $piv_vet)          ;
#   *-----------------------------------------------------------*
#   * Albo vettore                                              *
#   *-----------------------------------------------------------*
    $ps->text({align => 'left'}, 430, 630, "Iscr. Albo "
                                          . $alb_vet)          ;
#   *-----------------------------------------------------------*
#   * Stampa ragione sociale destinatario                       *
#   *-----------------------------------------------------------*
    $ps->text($lft_pos, 575, $rag_dst)                         ;
    $ps->text($lft_pos, 565, $via_dst)                         ;
    $ps->text($lft_pos, 555, $loc_dst)                         ;
#   *-----------------------------------------------------------*
#   * Data inizio trasporto                                     *
#   *-----------------------------------------------------------*
    $ps->text(220, 512, $dat_itr)                              ;
#   *-----------------------------------------------------------*
#   * Data documento                                            *
#   *-----------------------------------------------------------*
    $ps->text($lft_pos, 470, $nda_bol)                         ;
#   *-----------------------------------------------------------*
#   * Numero documento                                          *
#   *-----------------------------------------------------------*
    $ps->text({align => 'left'}, $lft_pos, 460, "DELIVERY NOTE N. "
                                          . $nnu_bol)          ;
#   *-----------------------------------------------------------*
#   * Colli                                                     *
#   *-----------------------------------------------------------*
    $ps->text(170, 400, $num_col)                              ;
#   *-----------------------------------------------------------*
#   * Peso lordo                                                *
#   *-----------------------------------------------------------*
    $ps->text(430, 400, $pes_tot)                              ;
#   *-----------------------------------------------------------*
#   * Data documento (Compilato il)                             *
#   *-----------------------------------------------------------*
    $ps->text(220, 135, $nda_bol)                              ;
#   *-----------------------------------------------------------*
#   * Determinazione coordinate modulo EPS                      *
#   *-----------------------------------------------------------*
    my $eps_x01 = 0                                            ;
    my $eps_y01 = 0                                            ;
    my $eps_x02 = 590                                          ;
    my $eps_y02 = 840                                          ;
#   *-----------------------------------------------------------*
#   * Inclusione modulo EPS                                     *
#   *-----------------------------------------------------------*
    $ps->importepsfile($mod_eps,
                       $eps_x01,
                       $eps_y01,
                       $eps_x02,
                       $eps_y02)                               ;
}

#===============================================================*
# Chiusura file                                                 *
#---------------------------------------------------------------*
sub fil_cls
{
    close I_FILE                                               ;
}

#===============================================================*
# Calcolo numero massimo di pagine                              *
#---------------------------------------------------------------*
sub clc_pag
{
    #-----------------------------------------------------------*
    # Valori in input                                           *
    #-----------------------------------------------------------*
    my $wrk_mpg = shift                                        ;
    my $wrk_nrg = shift                                        ;
    #-----------------------------------------------------------*
    # Calcolo                                                   *
    #-----------------------------------------------------------*
    my $wrk_max = 1                                            ;
    my $wrk_int = int($wrk_nrg / $wrk_mpg)                     ;
    my $wrk_rem = $wrk_nrg / $wrk_mpg                          ;
    if ($wrk_rem > $wrk_int){$wrk_max = $wrk_max+$wrk_int}     ;
    #-----------------------------------------------------------*
    # Valore in output                                          *
    #-----------------------------------------------------------*
    return $wrk_max                                            ;
}
