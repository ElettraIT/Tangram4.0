#    *-------------------------------------*
#    * Separazione dei componenti (,)      *
#    *-------------------------------------*
@vars = split(/,/, $inpt)                 ;
#    *-------------------------------------*
#    * Azienda Tangram                     *
#    *-------------------------------------*
my $atgm = $vars[0]                       ;
#    *-------------------------------------*
#    * Server SMTP                         *
#    *-------------------------------------*
my $srvr = $vars[1]                       ;
#    *-------------------------------------*
#    * Mittente                            *
#    *-------------------------------------*
my $mitt = $vars[2]                       ;
#    *-------------------------------------*
#    * Username autenticazione             *
#    *-------------------------------------*
my $user = $vars[3]                       ;
#    *-------------------------------------*
#    * Password autenticazione             *
#    *-------------------------------------*
my $pass = $vars[4]                       ;
#    *-------------------------------------*
#    * Indirizzi                          *
#    *-------------------------------------*
my $indi = $vars[5]                       ;
#    *-------------------------------------*
#    * Soggetto                            *
#    *-------------------------------------*
my $sogi = $vars[6]                       ;
#    *-------------------------------------*
#    * Messaggio                           *
#    *-------------------------------------*
my $mesi = $vars[7]                       ;

#==========================================*
# Debug (da scommentare)                   *
