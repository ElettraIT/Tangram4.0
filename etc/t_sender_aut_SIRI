my $temp = '/tmp/'                        ;
#
my $sogg = 'sogg.txt'                     ;
my $mess = 'mess.txt'                     ;
my $emla = 'indi.txt'                     ;
#
my $wsog = ''                             ;
my $wmes = ''                             ;
my $wind = ''                             ;

#==========================================*
# Variabili lette in input                 *
#------------------------------------------*
#    *-------------------------------------*
#    * Lettura variabile in input          *
#    *-------------------------------------*
$inpt = $ARGV[0]                          ;

#==========================================*
