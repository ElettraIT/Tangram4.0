#==========================================*
# Emissione linea retta                    *
#                                          *
#   Parametri                              *
#   -------------------------------------- *
# - Punto di partenza (x1)                 *
# - Punto di partenza (y1)                 *
# - Punto di arrivo   (x2)                 *
# - Punto di arrivo   (y2)                 *
#------------------------------------------*
sub stp_lin
{
    #======================================*
    # Variabili in input                   *
    #--------------------------------------*
    my $xx1 = shift                       ;
    my $yy1 = shift                       ;
    my $xx2 = shift                       ;
    my $yy2 = shift                       ;
    #--------------------------------------*
    # Composizione stringa                 *
    #--------------------------------------*
    my $str = "q "
            . $xx1
            . " "
            . $yy1
            . " m "
            . $xx2
            . " "
            . $yy2
            . " l S Q"                    ;
    #--------------------------------------*
    # Emissione stringa                    *
    #--------------------------------------*
    prAdd($str)                           ;
}

