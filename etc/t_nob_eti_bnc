#==========================================*
# Check se numero pari o dispari           *
#------------------------------------------*
sub par_dsp
{
    #======================================*
    # Variabili in input                   *
    #--------------------------------------*
    my $num = shift                       ;
    #--------------------------------------*
    # Normalizzazione risultato            *
    #--------------------------------------*
    my $pod = ''                          ;
    #--------------------------------------*
    # Test                                 *
    #--------------------------------------*
    if (0 == $num % 2)
    {
        #----------------------------------*
        # Pari                             *
        #----------------------------------*
        $pod = 'P'                        ;
    }
     else
    {
        #----------------------------------*
        # Dispari                          *
        #----------------------------------*
        $pod = 'D'                        ;
    }
    #--------------------------------------*
    # Valore in uscita                     *
    #======================================*
    return $pod                           ;
}

