     ############ /abd/etc/lnkazi
     #
     # Procedura di condivisione degli archivi statici tra due aziende
     #
     ######

######
# Controllo identita' utente
###

x=`whoami`
if [ $x != "master" ]
   then
       echo "                                                                 " ;
       echo "-----------------------------------------------------------------" ;
       echo "               # Errore per il comando 'lnkazi' #                " ;
       echo "              ------------------------------------               " ;
       echo "                                                                 " ;
       echo "Il comando puo' essere eseguito solamente dall'utente 'master'   " ;
       echo "                                                                 " ;
       echo "-----------------------------------------------------------------" ;
       echo "                                                                 " ;
       exit 0;
   fi

######
# - Note operative per l'accettazione della sigla azienda originale
###

clear;
echo    "======================================================================" ;
echo    "    ISTITUZIONE DELLA CONDIVISIONE ARCHIVI STATICI TRA DUE AZIENDE    " ;
echo    "----------------------------------------------------------------------" ;
echo    "                                                                      " ;
echo    "Note operative  : Digitare la sigla dell'azienda che deve fornire     " ;
echo    "                  gli archivi statici originali.                      " ;
echo    "                                                                      " ;
echo    "           Nota : Rispondere a vuoto se si vuole uscire immediatamen- " ;
echo    "                  te dalla procedura.                                 " ;
echo    "                                                                      " ;
/abd/etc/echonnl "--------------> : " ;

######
# - Accettazione sigla azienda originale
###

read    a;

######
# - Una linea di separazione
###

echo    "                                                                      " ;

######
# - Test se impostazione a vuoto
###

if [ -z "$a" ]
   then
      exit 0;
   fi

######
# - Test che esista la directory in /abd/azi per l'azienda digitata
###

if [ ! -d /abd/azi/$a ]
   then
       echo "-----------------------------------------------------------------" ;
       echo "               # Errore per il comando 'lnkazi' #                " ;
       echo "              ------------------------------------               " ;
       echo "                                                                 " ;
       echo "Non esiste un'azienda con la sigla '$a'                          " ;
       echo "                                                                 " ;
       echo "-----------------------------------------------------------------" ;
       echo "                                                                 " ;
       exit 0;
   fi

######
# - Note operative per l'accettazione della sigla azienda che mutua gli archivi
###

echo    "                                                                      " ;
echo    "Note operative  : Digitare la sigla dell'azienda che deve mutuare     " ;
echo    "                  gli archivi statici da quelli originali.            " ;
echo    "                                                                      " ;
echo    "           Nota : Rispondere a vuoto se si vuole uscire immediatamen- " ;
echo    "                  te dalla procedura.                                 " ;
echo    "                                                                      " ;
/abd/etc/echonnl "--------------> : " ;

######
# - Accettazione sigla azienda che mutua gli archivi
###

read    b;

######
# - Una linea di separazione
###

echo    "                                                                      " ;

######
# - Test se impostazione a vuoto
###

if [ -z "$b" ]
   then
      exit 0;
   fi

######
# - Test che esista la directory in /abd/azi per l'azienda digitata
###

if [ ! -d /abd/azi/$b ]
   then
       echo "-----------------------------------------------------------------" ;
       echo "               # Errore per il comando 'lnkazi' #                " ;
       echo "              ------------------------------------               " ;
       echo "                                                                 " ;
       echo "Non esiste un'azienda con la sigla '$b'                          " ;
       echo "                                                                 " ;
       echo "-----------------------------------------------------------------" ;
       echo "                                                                 " ;
       exit 0;
   fi

