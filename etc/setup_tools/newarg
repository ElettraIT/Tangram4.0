     ############ /abd/etc/newarg
     #
     # Procedura per la creazione delle directores /abd/srg/xxx/yyy e
     #                                             /abd/ogt/xxx/yyy
     #
     # Input : $1:Sigla sistema applicativo xxx
     #
     #         $2:Sigla nuova area gestionale yyy
     #
     # Ultimo aggiornamento 20/02/07
     #
     ######

######
# Controllo identita' utente
###

altervx88=`whoami`
if [ $altervx88 != "master" ]
   then
       echo "                                                                 " ;
       echo "-----------------------------------------------------------------" ;
       echo "                # Errore per il comando 'newarg' #               " ;
       echo "                ----------------------------------               " ;
       echo "                                                                 " ;
       echo " Il comando puo' essere eseguito solamente dall'utente 'master'  " ;
       echo "                                                                 " ;
       echo "-----------------------------------------------------------------" ;
       echo "                                                                 " ;
       exit 0;
   fi

######
# Controllo sul numero di parametri in input per la procedura
###

case $# in
       2)
          ;;
       *)
          echo "                                                                 " ;
          echo "-----------------------------------------------------------------" ;
          echo "         # Errore nei parametri per il comando 'newarg' #        " ;
          echo "         ------------------------------------------------        " ;
          echo "                                                                 " ;
          echo " Errore : Sono richiesti due parametri :                         " ;
          echo "                                                                 " ;
          echo "          1. parametro : Sigla del sistema applicativo cui       " ;
          echo "                         deve appartenere l'area gestionale      " ;
          echo "                         che si vuole creare.                    " ;
          echo "                                                                 " ;
          echo "          2. parametro : Sigla dell'area gestionale.             " ;
          echo "                                                                 " ;
          echo "          Non e' ammesso omettere nessuno dei due parametri,     " ;
          echo "          ne' fornire piu' di due parametri.                     " ;
          echo "-----------------------------------------------------------------" ;
          echo "                                                                 " ;
          exit 0;
         ;;
     esac

######
# - Creazione directories e subdirectories in /abd/srg/xxx
###

mkdir         /abd/srg/$1/$2                 # /abd/srg/xxx/yyy
chmod  0750   /abd/srg/$1/$2

mkdir         /abd/srg/$1/$2/prg             # /abd/srg/xxx/yyy/prg
chmod  0750   /abd/srg/$1/$2/prg

mkdir         /abd/srg/$1/$2/prg/cbl         # /abd/srg/xxx/yyy/prg/cbl
chmod  0750   /abd/srg/$1/$2/prg/cbl

mkdir         /abd/srg/$1/$2/prg/cpy         # /abd/srg/xxx/yyy/prg/cpy
chmod  0750   /abd/srg/$1/$2/prg/cpy

mkdir         /abd/srg/$1/$2/prg/scr         # /abd/srg/xxx/yyy/prg/scr
chmod  0750   /abd/srg/$1/$2/prg/scr

mkdir         /abd/srg/$1/$2/prg/stp         # /abd/srg/xxx/yyy/prg/stp
chmod  0750   /abd/srg/$1/$2/prg/stp

mkdir         /abd/srg/$1/$2/fls             # /abd/srg/xxx/yyy/fls
chmod  0750   /abd/srg/$1/$2/fls

mkdir         /abd/srg/$1/$2/fls/ioc         # /abd/srg/xxx/yyy/fls/ioc
chmod  0750   /abd/srg/$1/$2/fls/ioc

mkdir         /abd/srg/$1/$2/fls/ioc/cbl     # /abd/srg/xxx/yyy/fls/ioc/cbl
chmod  0750   /abd/srg/$1/$2/fls/ioc/cbl

mkdir         /abd/srg/$1/$2/fls/rec         # /abd/srg/xxx/yyy/fls/rec
chmod  0750   /abd/srg/$1/$2/fls/rec

mkdir         /abd/srg/$1/$2/num             # /abd/srg/xxx/yyy/num
chmod  0750   /abd/srg/$1/$2/num

mkdir         /abd/srg/$1/$2/num/ioc         # /abd/srg/xxx/yyy/num/ioc
chmod  0750   /abd/srg/$1/$2/num/ioc

mkdir         /abd/srg/$1/$2/num/ioc/cbl     # /abd/srg/xxx/yyy/num/ioc/cbl
chmod  0750   /abd/srg/$1/$2/num/ioc/cbl

mkdir         /abd/srg/$1/$2/num/rec         # /abd/srg/xxx/yyy/num/rec
chmod  0750   /abd/srg/$1/$2/num/rec

mkdir         /abd/srg/$1/$2/not             # /abd/srg/xxx/yyy/not
chmod  0750   /abd/srg/$1/$2/not

echo     "" > /abd/srg/$1/$2/not/err         # /abd/srg/xxx/yyy/not/err
chmod  0644   /abd/srg/$1/$2/not/err

