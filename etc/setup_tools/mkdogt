     ############ /abd/etc/mkdogt
     #
     # Procedura di creazione della subdirectory 'ogt' di '/abd'
     #
     # Input : $1:Pathname completo per la directory al cui interno deve
     #                     essere creata la subdirectory 'ogt'
     #
     ######

######
# Controllo identita' utente
###

altervx88=`whoami`
if [ $altervx88 != "master" ]
   then
       echo "                                                                 " ;
       echo "-----------------------------------------------------------------" ;
       echo "                # Errore per il comando 'mkdogt' #               " ;
       echo "                ----------------------------------               " ;
       echo "                                                                 " ;
       echo " Il comando puo' essere eseguito solamente dall'utente 'master'  " ;
       echo "                                                                 " ;
       echo "-----------------------------------------------------------------" ;
       echo "                                                                 " ;
       exit 0;
   fi

######
# Controllo sul numero di parametri
###

case $# in
       1)
          ;;
       *)
          echo "                                                                 " ;
          echo "-----------------------------------------------------------------" ;
          echo "          # Errore nei parametri per il comando 'mkdogt' #       " ;
          echo "         -------------------------------------------------       " ;
          echo "                                                                 " ;
          echo " Errore : E' richiesto in input il parametro per il pathname     " ;
          echo "          della directory al cui interno deve essere creata      " ;
	  echo "          la subdirectory 'ogt'.                                 " ;
          echo "                                                                 " ;
          echo "          Non e' ammesso omettere il parametro, ne' fornirne     " ;
          echo "          piu' di uno.                                           " ;
          echo "-----------------------------------------------------------------" ;
          echo "                                                                 " ;
          exit 0;
	  ;;
     esac

######
# - Creazione directory 'ogt'
###

mkdir           $1/ogt
chmod  0750     $1/ogt

######
# - Simbolic link, se necessario, a '/abd/ogt'
###

case $1 in
     /abd)
          ;;
        *)
          ln -s $1/ogt /abd/ogt ;
	  ;;
     esac

######
# - Creazione subdirectory 'ogt/xpgagsd'
###

mkdir           $1/ogt/xpgagsd
chmod  0750     $1/ogt/xpgagsd

######
# - Creazione subdirectory 'ogt/doc'
###

mkdir           $1/ogt/doc
chmod  0755     $1/ogt/doc

######
# - Creazione subdirectory 'ogt/doc/app'
###

mkdir           $1/ogt/doc/app
chmod  0755     $1/ogt/doc/app

######
# - Fine procedura
###
