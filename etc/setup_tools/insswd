     ############ /abd/etc/insswd
     #
     # Procedura per la creazione della directory /abd/ogt/swd
     #
     ######

######
# Controllo identita' utente
###

altervx88=`whoami`
if [ $altervx88 != "master" ]
   then
       echo "                                                                 " ;
       echo "-----------------------------------------------------------------" ;
       echo "                # Errore per il comando 'insswd' #               " ;
       echo "                ----------------------------------               " ;
       echo "                                                                 " ;
       echo " Il comando puo' essere eseguito solamente dall'utente 'master'  " ;
       echo "                                                                 " ;
       echo "-----------------------------------------------------------------" ;
       echo "                                                                 " ;
       exit 0;
   fi

######
# - Creazione directories e subdirectories in /abd/ogt/swd
###

mkdir         /abd/ogt/swd                   # /abd/ogt/swd
chmod  0750   /abd/ogt/swd

mkdir         /abd/ogt/swd/xpg               # /abd/ogt/swd/xpg
chmod  0750   /abd/ogt/swd/xpg

mkdir         /abd/ogt/swd/xpg/prg           # /abd/ogt/swd/xpg/prg
chmod  0750   /abd/ogt/swd/xpg/prg

mkdir         /abd/ogt/swd/xpg/prg/obj       # /abd/ogt/swd/xpg/prg/obj
chmod  0750   /abd/ogt/swd/xpg/prg/obj

mkdir         /abd/ogt/swd/xpg/fls           # /abd/ogt/swd/xpg/fls
chmod  0750   /abd/ogt/swd/xpg/fls

mkdir         /abd/ogt/swd/xpg/fls/ioc       # /abd/ogt/swd/xpg/fls/ioc
chmod  0750   /abd/ogt/swd/xpg/fls/ioc

mkdir         /abd/ogt/swd/xpg/fls/ioc/obj   # /abd/ogt/swd/xpg/fls/ioc/obj
chmod  0750   /abd/ogt/swd/xpg/fls/ioc/obj

mkdir         /abd/ogt/swd/mod               # /abd/ogt/swd/mod
chmod  0750   /abd/ogt/swd/mod

mkdir         /abd/ogt/swd/mod/prg           # /abd/ogt/swd/mod/prg
