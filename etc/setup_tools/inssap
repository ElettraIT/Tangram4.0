     ############ /abd/etc/inssap
     #
     # Procedura per la creazione della directory /abd/ogt/xxx
     #
     # Input : $1:Sigla nuovo sistema applicativo xxx
     #
     ######

######
# Controllo identita' utente
###

altervx88=`whoami`
if [ $altervx88 != "master" ]
   then
       echo "                                                                 " ;
       echo "-----------------------------------------------------------------" ;
       echo "                # Errore per il comando 'inssap' #               " ;
       echo "                ----------------------------------               " ;
       echo "                                                                 " ;
       echo " Il comando puo' essere eseguito solamente dall'utente 'master'  " ;
       echo "                                                                 " ;
       echo "-----------------------------------------------------------------" ;
       echo "                                                                 " ;
       exit 0;
   fi

######
# Controllo sul numero di parametri in input per la procedura
###

case $# in
       1)
          ;;
       *)
          echo "                                                                 " ;
          echo "-----------------------------------------------------------------" ;
          echo "         # Errore nei parametri per il comando 'inssap' #        " ;
          echo "         ------------------------------------------------        " ;
          echo "                                                                 " ;
          echo " Errore : E' richiesto un parametro per la sigla del nuovo       " ;
          echo "          sistema applicativo che si vuole creare.               " ;
          echo "                                                                 " ;
          echo "          Non e' ammesso omettere il parametro, ne' fornire      " ;
          echo "          piu' di un parametro.                                  " ;
          echo "-----------------------------------------------------------------" ;
          echo "                                                                 " ;
          exit 0;
	  ;;
     esac

######
# - Creazione directory /abd/ogt/xxx
###

mkdir         /abd/ogt/$1                    # /abd/ogt/xxx/yyy
chmod  0750   /abd/ogt/$1

######
# - Fine procedura
###
