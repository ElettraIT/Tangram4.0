     ############ /abd/etc/mkdsvl
     #
     # Procedura di creazione di tutte le subdirectories di /abd relative
     # agli sviluppatori
     #
     # - bps
     # - doc
     # - srg
     #
     ######

######
# Controllo identita' utente
###

altervx88=`whoami`
if [ $altervx88 != "master" ]
   then
       echo "                                                                 " ;
       echo "-----------------------------------------------------------------" ;
       echo "                # Errore per il comando 'mkdsvl' #               " ;
       echo "                ----------------------------------               " ;
       echo "                                                                 " ;
       echo " Il comando puo' essere eseguito solamente dall'utente 'master'  " ;
       echo "                                                                 " ;
       echo "-----------------------------------------------------------------" ;
       echo "                                                                 " ;
       exit 0;
   fi

######
# - Directory 'bps'
###

### Note operative

clear
echo    "======================================================================" ;
echo    "  CREAZIONE SUBDIRECTORIES DI '/abd' - Passo  1 : subdirectory 'bps'  " ;
echo    "----------------------------------------------------------------------" ;
echo    "Descrizione     : Area per gli strumenti necessari agli sviluppatori  " ;
echo    "                  software, come ad esempio compilatori ed editors    " ;
echo    "                  specifici.                                          " ;
echo    "                                                                      " ;
echo    "Commento        : Normalmente viene situata alla sua normale collo-   " ;
echo    "                  cazione, ovvero '/abd/bps'.                         " ;
echo    "                                                                      " ;
echo    "Note operative  : Digitare il pathname della directory al cui in-     " ;
echo    "                  terno deve essere creata la subdirectory 'bps'.     " ;
echo    "                                                                      " ;
echo    "                  Se la subdirectory va' posizionata alla sua nor-    " ;
echo    "                  male collocazione, rispondere a vuoto.              " ;
echo    "                                                                      " ;
echo    "                  Se si vuole interrompere la procedura di creazione  " ;
echo    "                  subdirectories digitare:  stop  (oppure solo s)     " ;
echo    "                                                                      " ;
echo    "                  Se si vuole passare alla creazione della subdirec-  " ;
echo    "                  tory successiva digitare: next  (oppure solo n)     " ;
echo    "                                                                      " ;
echnnl "--------------> : " ;

### Accettazione pathname

read    altervx00;

### Normalizzazione pathname accettato

if [ -z "$altervx00" ]
   then
      altervx00="/abd/bps"
   fi

### Esecuzione creazione, oppure uscita, oppure skip del passo

case $altervx00 in
     stop|s)
          exit 0;
          ;;
     next|n)
          ;;
          *)
          echo "                                           ";
          echo "Creazione subdirectory $altervx00/bps ..  .";
          /abd/etc/mkdbps $altervx00                        ;
          echo "Ok                                         ";
          echo "                                           ";
	  ;;
     esac

