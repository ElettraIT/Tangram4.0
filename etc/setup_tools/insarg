     ############ /abd/etc/insarg
     #
     # Procedura per la creazione della directory /abd/ogt/xxx/yyy
     #
     # Input : $1:Sigla sistema applicativo xxx
     #
     #         $2:Sigla nuova area gestionale yyy
     #
     ######

######
# Controllo identita' utente
###

altervx88=`whoami`
if [ $altervx88 != "master" ]
   then
       echo "                                                                 " ;
       echo "-----------------------------------------------------------------" ;
       echo "                # Errore per il comando 'insarg' #               " ;
       echo "                ----------------------------------               " ;
       echo "                                                                 " ;
       echo " Il comando puo' essere eseguito solamente dall'utente 'master'  " ;
       echo "                                                                 " ;
       echo "-----------------------------------------------------------------" ;
       echo "                                                                 " ;
       exit 0;
   fi

######
# Controllo sul numero di parametri in input per la procedura
###

case $# in
       2)
          ;;
       *)
          echo "                                                                 " ;
          echo "-----------------------------------------------------------------" ;
          echo "         # Errore nei parametri per il comando 'insarg' #        " ;
          echo "         ------------------------------------------------        " ;
          echo "                                                                 " ;
          echo " Errore : Sono richiesti due parametri :                         " ;
          echo "                                                                 " ;
          echo "          1. parametro : Sigla del sistema applicativo cui       " ;
          echo "                         deve appartenere l'area gestionale      " ;
          echo "                         che si vuole creare.                    " ;
          echo "                                                                 " ;
          echo "          2. parametro : Sigla dell'area gestionale.             " ;
          echo "                                                                 " ;
          echo "          Non e' ammesso omettere nessuno dei due parametri,     " ;
          echo "          ne' fornire piu' di due parametri.                     " ;
          echo "-----------------------------------------------------------------" ;
          echo "                                                                 " ;
          exit 0;
	  ;;
     esac

######
# - Creazione directories e subdirectories in /abd/ogt/xxx
###

mkdir         /abd/ogt/$1/$2                 # /abd/ogt/xxx/yyy
chmod  0750   /abd/ogt/$1/$2

mkdir         /abd/ogt/$1/$2/prg             # /abd/ogt/xxx/yyy/prg
chmod  0750   /abd/ogt/$1/$2/prg

mkdir         /abd/ogt/$1/$2/prg/obj         # /abd/ogt/xxx/yyy/prg/obj
chmod  0750   /abd/ogt/$1/$2/prg/obj

mkdir         /abd/ogt/$1/$2/fls             # /abd/ogt/xxx/yyy/fls
chmod  0750   /abd/ogt/$1/$2/fls

mkdir         /abd/ogt/$1/$2/fls/ioc         # /abd/ogt/xxx/yyy/fls/ioc
chmod  0750   /abd/ogt/$1/$2/fls/ioc

mkdir         /abd/ogt/$1/$2/fls/ioc/obj     # /abd/ogt/xxx/yyy/fls/ioc/obj
chmod  0750   /abd/ogt/$1/$2/fls/ioc/obj

mkdir         /abd/ogt/$1/$2/num             # /abd/ogt/xxx/yyy/num
chmod  0750   /abd/ogt/$1/$2/num

mkdir         /abd/ogt/$1/$2/num/ioc         # /abd/ogt/xxx/yyy/num/ioc
chmod  0750   /abd/ogt/$1/$2/num/ioc

mkdir         /abd/ogt/$1/$2/num/ioc/obj     # /abd/ogt/xxx/yyy/num/ioc/obj
chmod  0750   /abd/ogt/$1/$2/num/ioc/obj

mkdir         /abd/ogt/$1/$2/tbl             # /abd/ogt/xxx/yyy/tbl
chmod  0750   /abd/ogt/$1/$2/tbl

mkdir         /abd/ogt/$1/$2/tbl/ioc         # /abd/ogt/xxx/yyy/tbl/ioc
chmod  0750   /abd/ogt/$1/$2/tbl/ioc

mkdir         /abd/ogt/$1/$2/tbl/ioc/obj     # /abd/ogt/xxx/yyy/tbl/ioc/obj
chmod  0750   /abd/ogt/$1/$2/tbl/ioc/obj

######
# - Fine procedura
###
