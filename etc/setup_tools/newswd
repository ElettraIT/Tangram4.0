######
# Controllo identita' utente
###

altervx88=`whoami`
if [ $altervx88 != "master" ]
   then
       echo "                                                                 " ;
       echo "-----------------------------------------------------------------" ;
       echo "                # Errore per il comando 'newswd' #               " ;
       echo "                ----------------------------------               " ;
       echo "                                                                 " ;
       echo " Il comando puo' essere eseguito solamente dall'utente 'master'  " ;
       echo "                                                                 " ;
       echo "-----------------------------------------------------------------" ;
       echo "                                                                 " ;
       exit 0;
   fi

