echo    "                                                                      " ;
echo    "Commento        : Normalmente viene situata alla sua normale collo-   " ;
echo    "                  cazione, ovvero '/abd/tmp'.                         " ;
echo    "                                                                      " ;
echo    "Note operative  : Digitare il pathname della directory al cui in-     " ;
echo    "                  terno deve essere creata la subdirectory 'tmp'.     " ;
echo    "                                                                      " ;
echo    "                  Se la subdirectory va' posizionata alla sua nor-    " ;
echo    "                  male collocazione, rispondere a vuoto.              " ;
echo    "                                                                      " ;
echo    "                  Se si vuole interrompere la procedura di creazione  " ;
echo    "                  subdirectories digitare:  stop  (oppure solo s)     " ;
echo    "                                                                      " ;
echo    "                  Se si vuole passare alla creazione della subdirec-  " ;
echo    "                  tory successiva digitare: next  (oppure solo n)     " ;
echo    "                                                                      " ;
/abd/etc/echonnl "--------------> : " ;

### Accettazione pathname

read    altervx00;

### Normalizzazione pathname accettato

if [ -z "$altervx00" ]
   then
      altervx00="/abd"
   fi

### Esecuzione creazione, oppure uscita, oppure skip del passo

case $altervx00 in
     stop|s)
          exit 0;
          ;;
     next|n)
          ;;
          *)
          echo "                                         ";
          echo "Creazione subdirectory $altervx00/tmp ...";
          /abd/etc/mkdtmp $altervx00                      ;
          echo "Ok                                       ";
          echo "                                         ";
	  ;;
     esac

