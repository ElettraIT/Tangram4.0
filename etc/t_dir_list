#=========================================*
# Variabili lette in input                *
#-----------------------------------------*
my $user = shift                          ;

#=========================================*
# Variabili statiche                      *
# --------------------------------------- *
#  - Pathname di base per i file          *
#-----------------------------------------*
my $dire = "/abd/asc/"
         . $user
         . "/pdf/out/"                    ;


    #--------------------------------------*
    # Open directory                       *
    #--------------------------------------*
    opendir (DIR,$dire)                    ;
    


    #--------------------------------------*
    # Ciclo interno alla directory         *
    #--------------------------------------*
    LINE: foreach $nam (sort readdir(DIR))
    {

        my $fil = $dire . $nam             ;

        if ($nam eq "." || $nam eq "..")
           {next(LINE)}                   ;


        print "$nam\n";





    }

    closedir (DIR);
