#!/usr/bin/perl -w
#===============================================================*
#                                                               *
# Stampa elenco documenti (da bfo302) con protocollo barcode    *
#                                                               *
#                   ------------------------------------------- *
#                    Versione originale:    001 del 05/04/2023  *
#                      Ultima revisione:    NdK del 10/04/2023  *
#                   ------------------------------------------- *
#                                Autore:    Nicola de Kunovich  *
# ------------------------------------------------------------- *
#                                                               *
# Parametri in input : - percorso CSV da stampare               *
#                      - codice stampante                       *
#                                                               *
# ------------------------------------------------------------- *
#                                                               *
# Nota bene : i barcode EPS vengono generati on-fly tramite     *
#             il modulo PostScript 'barcode.ps'                 *
#                                                               *
#             ___ ATTUALMENTE BNON UTILIZZATO ___               *
#                                                               *
#===============================================================*

#===============================================================*
# Moduli Perl                                                   *
#---------------------------------------------------------------*
use PostScript::Simple                                         ;
use File::Basename                                             ;

#===============================================================*
# Variabili in input                                            *
#---------------------------------------------------------------*
#   *-----------------------------------------------------------*
#   * Percorso in input                                         *
#   *-----------------------------------------------------------*
    my $pth_fil = $ARGV[0]                                     ;
#   *-----------------------------------------------------------*
#   * Stampante in input                                        *
#   *-----------------------------------------------------------*
    my $cod_stp = $ARGV[1]                                     ;

#===============================================================*
# Variabili statiche                                            *
#---------------------------------------------------------------*
#   *-----------------------------------------------------------*
#   * Estrazione nome file                                      *
#   *-----------------------------------------------------------*
   (my $fil_nam,
    my $fil_pth,
    my $fil_ext) = fileparse($pth_fil,'\..*')                  ;
#   *-----------------------------------------------------------*
#   * Percorsi file                                             *
#   *-----------------------------------------------------------*
    my $pth_bcd = "/abd/asc/bcd/"                              ;
    my $pth_pdf = "/abd/asc/pdf/"                              ;
    my $pth_csv = $pth_fil                                     ;
    my $out_stp = $pth_fil . ".ps"                             ;
    my $out_pdf = $pth_pdf . $fil_nam . ".pdf"                 ;
#   *-----------------------------------------------------------*
#   * Contatori e posizionatori pagina                          *
#   *-----------------------------------------------------------*
    my $max_rig = 18                                           ;
    my $ctr_rig = 0                                            ;
    my $num_pag = 0                                            ;
    my $tit_lin = 278                                          ;
    my $top_pag = 275                                          ;
    my $cur_lin = $top_pag                                     ;
    my $alt_lin = -15                                          ;
    my $top_grd = 275                                          ;
    my $bot_grd = 12                                           ;
#   *-----------------------------------------------------------*
#   * Colonne griglia                                           *
#   *-----------------------------------------------------------*
    my $c01_grd = 43                                           ;
    my $c02_grd = 64                                           ;
    my $c03_grd = 80                                           ;
    my $c04_grd = 160                                          ;
    my $c05_grd = 170                                          ;
#   *-----------------------------------------------------------*
#   * Posizionamento campi                                      *
#   *-----------------------------------------------------------*
    my $bcd_pos = 11                                           ;
    my $prt_pos = 62                                           ;
    my $dat_pos = 65                                           ;
    my $rag_pos = 81                                           ;
    my $rig_pos = 167                                          ;
    my $num_pos = 172                                          ;
#   *-----------------------------------------------------------*
#   * Dimensioni barcode EPS in mm.                             *
#   *-----------------------------------------------------------*
    my $eps_alt = 15                                           ;
    my $eps_lun = 36                                           ;

#===============================================================*
# Lettura del modulo 'barcode.ps'                               *
#---------------------------------------------------------------*
my $gen_bcd = "/abd/asc/cfg/barcode.ps"                        ;
open(PS,$gen_bcd) || die 'File di '
                           . 'configurazione non trovato'      ;
$_=join('',<PS>)                                               ;
close(PS)                                                      ;

#===============================================================*
# Estrazione dal modulo 'barcode.ps' del TEMPLATE da richiamare *
#---------------------------------------------------------------*
m/
    %\ --BEGIN\ TEMPLATE--
    (.*)
    %\ --END\ TEMPLATE--
    /sx || die 'Unable to parse out the template'              ;

#===============================================================*
# Completamento del TEMPLATE                                    *
#---------------------------------------------------------------*
my $template=''                                                ;
$template.="%!PS-Adobe-2.0 EPSF-2.0\n"                         ;
$template.="%%BoundingBox: 0 0 [% width %] [% height %]\n"     ;
$template.="%%EndComments"                                     ;
$template.=$1                                                  ;
$template.="10 7 moveto\n"                                     ;
$template.="[% call %]\n"                                      ;
$template.="showpage\n"                                        ;

#===============================================================*
# Preparazione pagina                                           *
#---------------------------------------------------------------*
my $ps = new PostScript::Simple::(papersize => "A4",
                                     colour => 1,
                                        eps => 0,
                                      units => "mm")           ;

#===============================================================*
# Trattamento stampa                                            *
#---------------------------------------------------------------*
#   *-----------------------------------------------------------*
#   * Open e Close file in input                                *
#   *-----------------------------------------------------------*
    open (I_FILE, "$pth_csv") or die
         "Impossibile aprire il file '$pth_csv'"               ;
    my   @linea = <I_FILE>                                     ;
    close I_FILE                                               ;

#   *-----------------------------------------------------------*
#   * Ciclo di scansione                                        *
#   *-----------------------------------------------------------*
foreach $linea (@linea)
{
#   *-----------------------------------------------------------*
#   * Trattamento riga                                          *
#   *-----------------------------------------------------------*
    &stp_rig                                                   ;
}

#===============================================================*
# Generazione file Postscript                                   *
#---------------------------------------------------------------*
$ps->output($out_stp)                                          ;

#===============================================================*
# Stampa file Postscript                                        *
#---------------------------------------------------------------*
if ($cod_stp eq "pdf")
{
    system("ps2pdf $out_stp $out_pdf")                        ;
}
 else
{
    system("cat $out_stp | lpr -P$cod_stp")                   ;
}

#===============================================================*
# SUBROUTINES                                                   *
#===============================================================*

#===============================================================*
# Stampa riga                                                   *
#---------------------------------------------------------------*
sub stp_rig
{
#   *-----------------------------------------------------------*
#   * Contatore righe                                           *
#   *-----------------------------------------------------------*
    $ctr_rig++                                                 ;
#   *-----------------------------------------------------------*
#   * Eventuale reintestazione pagina                           *
#   *-----------------------------------------------------------*
    if ( !($ctr_rig < $max_rig) | ($ctr_rig == 1))
    {
        &mynewpage($ps, "Documenti di entrata merce")          ;
        $ctr_rig = 1                                           ;
        $cur_lin = $top_pag                                    ;
    }
#   *-----------------------------------------------------------*
#   * Interlinea                                                *
#   *-----------------------------------------------------------*
    $cur_lin = $cur_lin + $alt_lin                             ;
#   *-----------------------------------------------------------*
#   * Estrazione campi                                          *
#   *-----------------------------------------------------------*
    my @campo = split(/;/, $linea)                             ;
#   *-----------------------------------------------------------*
#   * Pulizia trailing spaces campi testo                       *
#   *-----------------------------------------------------------*
    my $max_val = 8                                            ;
    my $ctr_001                                                ;
    for ($ctr_001 = 1 ; $ctr_001 < $max_val ; $ctr_001++ )
    {
        $campo[$ctr_001] =~ s/^\s+//                           ;
        $campo[$ctr_001] =~ s/\s+$//                           ;
    }
#   *-----------------------------------------------------------*
#   * Assegnazione valori campi                                 *
#   *-----------------------------------------------------------*
    my $prt_bfo = $campo[2]                                    ;
    my $dat_reg = $campo[1]                                    ;
    my $rag_fnt = $campo[7]                                    ;
    my $num_rig = $campo[8]                                    ;
    my $num_doc = $campo[3]                                    ;
#   *-----------------------------------------------------------*
#   * Protocollo: inclusione barcode EPS                        *
#   *-----------------------------------------------------------*
    &inc_eps ($prt_bfo, $bcd_pos)                              ;
#   *-----------------------------------------------------------*
#   * Setup del Font                                            *
#   *-----------------------------------------------------------*
    $ps->setfont("Helvetica", 10)                              ;
#   *-----------------------------------------------------------*
#   * Protocollo: numero leggibile                              *
#   *-----------------------------------------------------------*
    my $num_edt = substr($prt_bfo, 5, 6)                       ;
       $num_edt =~ s/^0+(?=[0-9])//                            ;
    my $ann_edt = substr($prt_bfo, 1, 2)                       ;
    my $prt_edt = $num_edt . "/" . $ann_edt                    ;
    $ps->text({align => 'right'}, $prt_pos, $cur_lin+5,  $prt_edt);
#   *-----------------------------------------------------------*
#   * Data registrazione                                        *
#   *-----------------------------------------------------------*
    $ps->text($dat_pos, $cur_lin+5, $dat_reg)                  ;
#   *-----------------------------------------------------------*
#   * Ragione sociale fornitore                                 *
#   *-----------------------------------------------------------*
#    $ps->setfont("Helvetica-Bold", 9)                          ;
    $ps->setfont("Courier", 9)                          ;
    $ps->text($rag_pos, $cur_lin+5, $rag_fnt)                  ;
#   *-----------------------------------------------------------*
#   * Setup del Font                                            *
#   *-----------------------------------------------------------*
    $ps->setfont("Helvetica", 10)                              ;
#   *-----------------------------------------------------------*
#   * Numero righe                                              *
#   *-----------------------------------------------------------*
    $ps->text({align => 'right'}, $rig_pos, $cur_lin+5, $num_rig);
#   *-----------------------------------------------------------*
#   * Numero documento                                          *
#   *-----------------------------------------------------------*
    $ps->text($num_pos, $cur_lin+5, $num_doc)                  ;
#   *-----------------------------------------------------------*
#   * Sottolineatura linea                                      *
#   *-----------------------------------------------------------*
    $ps->line(10, $cur_lin-2, 200, $cur_lin-2)                 ;
}

#===============================================================*
# Trattamento EPS                                               *
#---------------------------------------------------------------*
sub inc_eps
{
#   *-----------------------------------------------------------*
#   * Valore in input                                           *
#   *-----------------------------------------------------------*
    my $val_cmp = shift                                        ;
#   *-----------------------------------------------------------*
#   * Aggiunta di uno zero in coda per ottenere i 13 caratteri  *
#   *-----------------------------------------------------------*
       $val_cmp = $val_cmp . "0"                               ;
    
#   *-----------------------------------------------------------*
#   * Posizione in input                                        *
#   *-----------------------------------------------------------*
    my $pos_cmp = shift                                        ;
#   *-----------------------------------------------------------*
#   * Determinazione coordinate barcode EPS                     *
#   *-----------------------------------------------------------*
    my $eps_x01 = $pos_cmp                                     ;
    my $eps_y01 = $cur_lin                                     ;
    my $eps_x02 = $eps_x01+$eps_lun                            ;
    my $eps_y02 = $cur_lin+$eps_alt                            ;
#   *-----------------------------------------------------------*
#   * Percorso file barcode EPS                                 *
#   *-----------------------------------------------------------*
    my $prf_cod = substr($val_cmp, 0, 4)                       ;
    my $pth_eps = $pth_bcd
                . $prf_cod
                . "/"
                . $val_cmp
                . ".eps"                                       ;
#   *-----------------------------------------------------------*
#   * Inclusione barcode EPS                                    *
#   *-----------------------------------------------------------*
    $ps->importepsfile($pth_eps,
                       $eps_x01,
                       $eps_y01,
                       $eps_x02,
                       $eps_y02)                               ;
}

#===============================================================*
# Intestazione pagina                                           *
#---------------------------------------------------------------*
sub mynewpage
{
#   *-----------------------------------------------------------*
#   * Documento in input                                        *
#   *-----------------------------------------------------------*
    my $ps = shift                                             ;
#   *-----------------------------------------------------------*
#   * Titolo pagina in input                                    *
#   *-----------------------------------------------------------*
    my $tit_pag = shift                                        ;
#   *-----------------------------------------------------------*
#   * Numero pagina                                             *
#   *-----------------------------------------------------------*
    $num_pag++                                                 ;
#   *-----------------------------------------------------------*
#   * Nuova pagina                                              *
#   *-----------------------------------------------------------*
    $ps->newpage                                               ;
#   *-----------------------------------------------------------*
#   * Spessore linea generale                                   *
#   *-----------------------------------------------------------*
    $ps->setlinewidth( 0.01 )                                  ;
#   *-----------------------------------------------------------*
#   * Box pagina                                                *
#   *-----------------------------------------------------------*
    $ps->box(10, 12, 200, 288)                                 ;
#   *-----------------------------------------------------------*
#   * Sottolineatura titolo                                     *
#   *-----------------------------------------------------------*
    $ps->line(10, $top_grd, 200, $top_grd)                     ;

#   *===========================================================*
#   * Colonna 1 : protocollo barcode                            *
#   *-----------------------------------------------------------*
#    $ps->line($c01_grd, $bot_grd, $c01_grd, $top_grd)          ;
#   *-----------------------------------------------------------*
#   * Colonna 2 : protocollo                                    *
#   *-----------------------------------------------------------*
    $ps->line($c02_grd, $bot_grd, $c02_grd, $top_grd)          ;
#   *-----------------------------------------------------------*
#   * Colonna 3 : Numero e data documento                       *
#   *-----------------------------------------------------------*
    $ps->line($c03_grd, $bot_grd, $c03_grd, $top_grd)          ;
#   *-----------------------------------------------------------*
#   * Colonna 4 : Fornitore                                     *
#   *-----------------------------------------------------------*
    $ps->line($c04_grd, $bot_grd, $c04_grd, $top_grd)          ;
#   *-----------------------------------------------------------*
#   * Colonna 5 : numero righe                                  *
#   *===========================================================*
    $ps->line($c05_grd, $bot_grd, $c05_grd, $top_grd)          ;

#   *-----------------------------------------------------------*
#   * Font                                                      *
#   *-----------------------------------------------------------*
    $ps->setfont("Helvetica-Bold", 14)                         ;
#   *-----------------------------------------------------------*
#   * Elettra                                                   *
#   *-----------------------------------------------------------*
    $ps->text(12, $tit_lin+5, "Elettra Srl")                   ;
#   *-----------------------------------------------------------*
#   * Numero pagina                                             *
#   *-----------------------------------------------------------*
    $ps->text(175, $tit_lin+5, "Pag. ". $num_pag)              ;
#   *-----------------------------------------------------------*
#   * Titolo                                                    *
#   *-----------------------------------------------------------*
    $ps->text(64, $tit_lin, $tit_pag)                          ;

#   *===========================================================*
#   * Intestazione colonne                                      *
#   *-----------------------------------------------------------*
    $ps->setfont("Helvetica-Bold", 10)                         ;
    $ps->line($c02_grd, $top_grd-5, 200, $top_grd-6)           ;
#    $ps->text($c01_grd-23, $top_grd-4, "Barcode")              ;
    $ps->text($c02_grd-15, $top_grd-4, "Protoc.")              ;
    $ps->text($c03_grd-15, $top_grd-4, "Data reg")             ;
    $ps->text($c04_grd-45, $top_grd-4, "Fornitore")            ;
    $ps->text($c05_grd-8, $top_grd-4, "Rig")                   ;
    $ps->text($c05_grd+8, $top_grd-4, "Numero")                ;
                
}

