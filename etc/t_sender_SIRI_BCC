#==========================================*
# Modulo Perl di invio posta Mail::Sender  *
#                                          *
# t_sender                                 *
#                                          *
# Invio di messaggi ad una lista di        *
# indirizzi e con i relativi allegati PDF  *
# (utilizzato per i lotti di fatture PDF)  *
#                                          *
# ---------------------------------------- *
# Versione originale:   001 del 08/02/07   *
#   Ultima revisione:   NdK del 18/10/10   *
# ---------------------------------------- *
#             Autore:   Nicola de Kunovich *
# ---------------------------------------- *
#                                          *
# In input : - codice azienda              *
#            - server SMTP                 *
#            - mittente                    *
#            - username  (opzionale)       *
#            - password  (opzionale)       *
#            - indirizzi (opzionale)       *
#            - soggetto  (opzionale)       *
#            - messaggio (opzionale)       *
#                                          *
# ---------------------------------------- *
# N.B.: i campi in input sono separati da  *
#       virgola ','                        *
#                                          *
#------------------------------------------*

#==========================================*
# Moduli Perl utilizzati                   *
#------------------------------------------*
use Mail::Sender                          ;
use File::Basename                        ;

#==========================================*
# Variabili statiche                       *
#------------------------------------------*
my $base = '/abd/asc/'                    ;
my $temp = '/tmp/'                        ;
#
my $sogg = 'sogg.txt'                     ;
my $mess = 'mess.txt'                     ;
my $emla = 'indi.txt'                     ;
#
my $wsog = ''                             ;
my $wmes = ''                             ;
my $wind = ''                             ;

#==========================================*
# Variabili lette in input                 *
#------------------------------------------*
#    *-------------------------------------*
#    * Lettura variabile in input          *
#    *-------------------------------------*
$inpt = $ARGV[0]                          ;

#==========================================*
# Help                                     *
#------------------------------------------*
if (!$ARGV[0] || $ARGV[0] eq "-help")
{
    print "\n"
        . "Uso : (parametri separati da virgola)"
        . "\n"
        . "> t_sender"
        . "\n"
        . "           AZIENDA(default: doc),"
        . "\n"
        . "           SERVER_SMTP,"
        . "\n"
        . "           MITTENTE,"
        . "\n"
        . "           USERID(opz),"
        . "\n"
        . "           PASSWORD(opz),"
        . "\n"
        . "           INDIRIZZI(opz),"
        . "\n"
        . "           SOGGETTO(opz),"
        . "\n"
        . "           MESSAGGIO(opz),"
        . "\n"
        . "\n"
        . "Release : 06/07/09"
        . "\n"
        . "\n"
        . "(C) Copyright - dKb"
        . "\n"
        . "\n"                            ;
    exit()                                ;
}

#    *-------------------------------------*
#    * Separazione dei componenti (,)      *
#    *-------------------------------------*
@vars = split(/,/, $inpt)                 ;
#    *-------------------------------------*
#    * Azienda Tangram                     *
#    *-------------------------------------*
my $atgm = $vars[0]                       ;
#    *-------------------------------------*
#    * Server SMTP                         *
#    *-------------------------------------*
my $srvr = $vars[1]                       ;
#  $srvr = "siriel-com01b.mail.protection.outlook.com";
#    *-------------------------------------*
#    * Mittente                            *
#    *-------------------------------------*
my $mitt = $vars[2]                       ;
#    *-------------------------------------*
#    * Username autenticazione             *
#    *-------------------------------------*
my $user = $vars[3]                       ;
#    *-------------------------------------*
#    * Password autenticazione             *
#    *-------------------------------------*
my $pass = $vars[4]                       ;
#    *-------------------------------------*
#    * Indirizzi                          *
#    *-------------------------------------*
my $indi = $vars[5]                       ;
#    *-------------------------------------*
#    * Soggetto                            *
#    *-------------------------------------*
my $sogi = $vars[6]                       ;
#    *-------------------------------------*
#    * Messaggio                           *
#    *-------------------------------------*
my $mesi = $vars[7]                       ;




my $bcca = 'info@siri-el.com,filippo.buggio@siri-el.com';




