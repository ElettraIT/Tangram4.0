#==========================================*
# Sub-routine per lettura soggetto         *
#------------------------------------------*
&soggetto                                 ;

#==========================================*
# Sub-routine per lettura testo            *
#------------------------------------------*
&messaggio                                ;

#==========================================*
# Sub-routine di spedizione a lista        *
#------------------------------------------*
&lista                                    ;

#==========================================*
# SUB-ROUTINES                             *
#==========================================*

#==========================================*
# Apertura file contenente il soggetto     *
#------------------------------------------*
sub soggetto
{
    #--------------------------------------*
    # Verifica variabile letta             *
    #--------------------------------------*
    if (!$sogi)
    {
        $wsog = $sogg                     ;
    } else
    {
        $wsog = $sogi                     ;
    }
    #--------------------------------------*
    # Composizione directory               *
    #--------------------------------------*
    my $wdir = $base
             . $atgm
             . $temp
             . $wsog                      ;
    #--------------------------------------*
    # Open                                 *
    #--------------------------------------*
    open (SOGGETTO, "$wdir")or die
         "Impossibile aprire file '$wdir'";
    @subject=<SOGGETTO>                   ;
    #--------------------------------------*
    # Close                                *
    #--------------------------------------*
    close SOGGETTO                        ;
}

#==========================================*
# Apertura file contenente il messaggio    *
#------------------------------------------*
sub messaggio
{
    #--------------------------------------*
    # Verifica variabile letta             *
    #--------------------------------------*
    if (!$mesi)
    {
        $wmes = $mess                     ;
    } else
    {
        $wmes = $mesi                     ;
    }
    #--------------------------------------*
    # Composizione directory               *
    #--------------------------------------*
    my $wdir = $base
             . $atgm
             . $temp
             . $wmes                      ;
    #--------------------------------------*
    # Open                                 *
    #--------------------------------------*
    open (MESSAGE, "$wdir")
          or die
         "Impossibile aprire file '$mess'";
    @message=<MESSAGE>                    ;
    #--------------------------------------*
    # Close                                *
    #--------------------------------------*
    close MESSAGE                         ;
    #--------------------------------------*
    # Compattazione testo letto            *
    #--------------------------------------*
    $testo = qq{@message}                 ;
}

#==========================================*
# Invio ad una lista                       *
#------------------------------------------*
sub lista
{
    #--------------------------------------*
    # Verifica variabile letta             *
    #--------------------------------------*
    if (!$indi)
    {
        $wind = $emla                     ;
    } else
    {
        $wind = $indi                     ;
    }
    #--------------------------------------*
    # Composizione directory               *
    #--------------------------------------*
    my $wdir = $base
             . $atgm
             . $temp
             . $wind                      ;
    #--------------------------------------*
    # Open                                 *
    #--------------------------------------*
    open (INDIRIZZI, "$wdir")or die
        "Impossibile aprire file indirizzi";
    @indirizzo = <INDIRIZZI>              ;
    #--------------------------------------*
    # Ciclo di scansione file              *
    #--------------------------------------*
    foreach $indirizzo (@indirizzo)
    {
        @elem = split(/,/, $indirizzo)    ;
        if ($elem[0] !~ /\@/)
            {next}
            else {&send}                  ;
    }

    #--------------------------------------*
    # Close                                *
    #--------------------------------------*
    close (INDIRIZZI)                     ;
}

#==========================================*
# Singolo invio                            *
#------------------------------------------*
sub send
{
    #--------------------------------------*
    # Test se autenticazione necessaria    *
    #--------------------------------------*
    if (!$pass)
    {
        #----------------------------------*
        # Senza autenticazione             *
        #----------------------------------*
        $sender = new Mail::Sender
        {
            #------------------------------*
            # Server SMTP                  *
            #------------------------------*
            smtp => $srvr,
            #------------------------------*
            # Mittente                     *
            #------------------------------*
            from => $mitt,
            #------------------------------*
            # Gestione errori              *
            #------------------------------*
            on_errors => undef,
        }
        or die "Errore: $Mail::Sender::Error\n";
    } else
    {
        #----------------------------------*
        # Con autenticazione               *
        #----------------------------------*
        $sender = new Mail::Sender
        {
            #------------------------------*
            # Server SMTP                  *
            #------------------------------*
            smtp => $srvr,
            #------------------------------*
            # Tipo autenticazione          *
            #------------------------------*
            auth => 'NTLM',
            #------------------------------*
            # Username e password          *
            #------------------------------*
          authid => $user,
         authpwd => $pass,
            #------------------------------*
            # Mittente                     *
            #------------------------------*
            from => $mitt,
            #------------------------------*
            # Gestione errori              *
            #------------------------------*
            on_errors => undef,
        }
        or die "Errore: $Mail::Sender::Error\n";
    }

    #--------------------------------------*
    # Connessione                          *
    #--------------------------------------*
    $sender = new Mail::Sender
    {
        #----------------------------------*
        # Server SMTP                      *
        #----------------------------------*
        smtp => $srvr,
        #----------------------------------*
        # Mittente                         *
        #----------------------------------*
        from => $mitt,
        #----------------------------------*
        # Gestione errori                  *
        #----------------------------------*
        on_errors => undef,
    }
        or die "Errore: $Mail::Sender::Error\n";
    #--------------------------------------*
    # Estrazione nome allegato             *
    #--------------------------------------*
    my $fname = basename($elem[1])        ;
    #--------------------------------------*
    # Estrazione nome allegato senza       *
    # estensione                           *
    #--------------------------------------*
   (my $fnams,
    my $direc,
    my $exten) = fileparse($elem[1],'\..*');
    #--------------------------------------*
    # Composizione soggetto e allegato     *
    # eliminando blank superflui dal sog-  *
    # getto del file                       *
    #--------------------------------------*
    my $oggw = qq{@subject}               ;
    $oggw =~ s/^\s+//                     ;
    $oggw =~ s/\s+$//                     ;    
    my $ogge = $oggw . " - " . $fnams     ;
    #--------------------------------------*
    # Destinazione                         *
    #--------------------------------------*
    $sender->OpenMultipart({
            to => $elem[0],
#           bcc => $mitt,
            bcc => $bcca,
       subject => $ogge,
         ctype => 'text/html',
      encoding => 'quoted-printable'})    ;
    #--------------------------------------*
    # Corpo messaggio                      *
    #--------------------------------------*
    $sender->Body                         ;
    $sender->SendEnc($testo)              ;
    #--------------------------------------*
    # Attachement                          *
    #--------------------------------------*
    $sender->Attach({
  description => 'Documento PDF',
        ctype => 'application/pdf',
  disposition => 'attachment; filename='
               . $fname
               . ';type="PDF archive"',
         file => $elem[1]
 });
    #--------------------------------------*
    # Close messaggio                      *
    #--------------------------------------*
    $sender->Close                        ;
}

