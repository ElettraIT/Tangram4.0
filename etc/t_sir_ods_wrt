#!/usr/bin/perl -w
#==========================================*
# Scrittura lista di spedizione da         *
# 'ods300s' in database [osw] MySQL        *
#                                          *
# Ad hoc SIRI                              *
#                                          *
# ___ ATTUALMENTE NON UTILIZZATO ___       *
#                                          *
# ---------------------------------------- *
# Versione originale:   001 del 10/04/2016 *
#   Ultima revisione:   wip del 22/06/2023 *
# ---------------------------------------- *
#             Autore:   Nicola de Kunovich *
# ---------------------------------------- *
#                                          *
# Parametri in input : - file CSV da       *
#                        stampare (proto-  *
#                        collo)            *
#                                          *
# ---------------------------------------- *
#                                          *
# Utilizzo :                               *
#                                          *
# $ t_sir_ods_wrt 99999999999              *
#                                          *
#==========================================*

#==========================================*
# Per la creazione della tabella [osw]     *
#                                          *
# ---------------------------------------- *
# CREATE TABLE IF NOT EXISTS `osw` (        
#  `num_prt` bigint(11) NOT NULL default '0',
#  `num_prg` int(5) NOT NULL default '0',
#  `num_pri` int(5) NOT NULL default '0',
#  `num_prc` int(5) NOT NULL default '0',
#  `num_pro` int(7) NOT NULL default '0',
#  `alf_pro` varchar(20) NOT NULL default '',
#  `cdp_pro` varchar(20) NOT NULL default '',
#  `des_pro` varchar(80) NOT NULL default '',
#  `qta_ord` decimal(13,3) NOT NULL default '0.000',
#  `qta_let` decimal(13,3) NOT NULL default '0.000',
#  `dat_let` date NOT NULL default '0000-00-00',
#  `inf_bcd` longtext NOT NULL,
#  `not_lib` longtext NOT NULL,
#  KEY `NUM_PRT` (`num_prt`,`num_prg`)
# ) TYPE=MyISAM;
#==========================================*

#==========================================*
# Moduli Perl                              *
#------------------------------------------*
use DBI()                                 ;

#==========================================*
# Protocollo in input                      *
#------------------------------------------*
my $num_prt = $ARGV[0]                    ;
    
#==========================================*
# Help                                     *
#------------------------------------------*
if (!$ARGV[0] || $ARGV[0] eq "-help")
{
    print "\n"
        . "Uso :"
        . "\n"
        . "> t_sir_ods_wrt [protocollo ods]"
        . "\n"
        . "\n"
        . "Release : 22/06/23"
        . "\n"
        . "\n"
        . "(C) Copyright - wip"
        . "\n"
        . "\n"                            ;
    exit()                                ;
}

#==========================================*
# Percorsi file                            *
#------------------------------------------*
my $pth_tmp = "/abd/spl/"                 ;
my $pth_csv = $pth_tmp . $num_prt . ".CSV";

#==========================================*
# Parametri di connessione al database     *
#------------------------------------------*
my $cfg_dtb = "/abd/asc/cfg/dtb.ini"      ;
#
my %cnf_dtb = do $cfg_dtb                 ;
my $dtb_hst = $cnf_dtb{dtb_hst}           ;
my $dtb_usr = $cnf_dtb{dtb_usr}           ;
my $dtb_pwd = $cnf_dtb{dtb_pwd}           ;
#
my $dtb_azi = "siri"                      ;
my $dtb_tbl = "osw"                       ;

#==========================================*
# Connessione database                     *
#------------------------------------------*
my $dbh = DBI->connect("DBI:"
                     . "mysql:database="
                     . "$dtb_azi;host=$dtb_hst",
                       $dtb_usr,
                       $dtb_pwd,
                      {RaiseError => 1,
                       PrintError => 0})  ;

#==========================================*
# Open file CSV                            *
#------------------------------------------*
open (I_FILE, "$pth_csv") or die
         "Impossibile aprire "
       . " il file '$pth_csv'"            ;
#------------------------------------------*
# Lettura singola linea                    *
#------------------------------------------*
my @linea = <I_FILE>                      ;

#------------------------------------------*
# Ciclo di scansione                       *
#------------------------------------------*
foreach $linea (@linea)
{
    #--------------------------------------*
    # Separazione campi                    *
    #--------------------------------------*
    my   @campo = split(/;/, $linea)      ;
    #--------------------------------------*
    # Trattamento testata                  *
    #--------------------------------------*
    if  ($campo[0] eq "T")
    {
        &wrt_tes                          ;
    }
    #--------------------------------------*
    # Trattamento righe                    *
    #--------------------------------------*
    else
    {
        &wrt_rig                          ;
    }
}

#------------------------------------------*
# Disconnessione dal database              *
#------------------------------------------*
$dbh->disconnect()                        ;

#------------------------------------------*
# Close del file in input                  *
#==========================================*
&fil_cls                                  ;

#==========================================*
# SUBROUTINES                              *
#==========================================*

#==========================================*
# Scrittura testata                        *
#------------------------------------------*
sub wrt_tes
{
    #--------------------------------------*
    # Estrazione campi                     *
    #--------------------------------------*
    my @campo = split(/;/, $linea)        ;
    #--------------------------------------*
    # Ragione sociale cliente             *
    #--------------------------------------*
    my $rag_soc = $campo[1]               ;
    #--------------------------------------*
    # Test se record esistente             *
    #--------------------------------------*
    &tst_prt ($num_prt)                   ;
    #--------------------------------------*
    # Eventuale scrittura testata          *
    #--------------------------------------*
    if ($row == 0)
    {
        #----------------------------------*
        # Se non trovato : inserimento     *
        #                  testata         *
        #----------------------------------*
        my $ins = "INSERT INTO "
                . $dtb_tbl
                . " VALUES ( "
                #--------------------------*
                # Protocollo               *
                #--------------------------*
                . "'$num_prt',"
                #--------------------------*
                # Progressivo Tangram      *
                #--------------------------*
                . "'0',"
                #--------------------------*
                # Progressivo interno      *
                #--------------------------*
                . "'0',"
                #--------------------------*
                # Progressivo lotto        *
                #--------------------------*
                . "'0',"
                #--------------------------*
                # Codice numerico prodotto *
                #--------------------------*
                . "'0',"
                #--------------------------*
                # Codice alfanumerico      *
                #--------------------------*
                . "'',"
                #--------------------------*
                # Codice del produttore    *
                #--------------------------*
                . "'',"
                #--------------------------*
                # Descrizione / rag. soc.  *
                #--------------------------*
                . "'$rag_soc',"
                #--------------------------*
                # Quantita' in ordine      *
                #--------------------------*
                . "'0.000',"
                #--------------------------*
                # Quantita' letta          *
                #--------------------------*
                . "'0.000',"
                #--------------------------*
                # Data lettura             *
                #--------------------------*
                . "'0000-00-00',"
                #--------------------------*
                # Testo da barcode         *
                #--------------------------*
                . "'',"
                #--------------------------*
                # Note libere              *
                #--------------------------*
                . "'')"                   ;
        my $sth = $dbh->prepare($ins)     ;
        #----------------------------------*
        # Esecuzione                       *
        #----------------------------------*
        $sth->execute()                   ;
    }
     else
    {
        #----------------------------------*
        # Se trovato : cancellazione pre-  *
        #              liminare di testata *
        #              e righe             *
        #----------------------------------*
        my $del = "DELETE FROM "
                . $dtb_tbl
                . " WHERE `num_prt` "
                . "= $num_prt"            ;
        my $sth = $dbh->prepare($del)     ;
        #----------------------------------*
        # Esecuzione                       *
        #----------------------------------*
        $sth->execute()                   ;
        #----------------------------------*
        # Inserimento testata              *
        #----------------------------------*
        my $ins = "INSERT INTO "
                . $dtb_tbl
                . " VALUES ( "
                #--------------------------*
                # Protocollo               *
                #--------------------------*
                . "'$num_prt',"
                #--------------------------*
                # Progressivo Tangram      *
                #--------------------------*
                . "'0',"
                #--------------------------*
                # Progressivo interno      *
                #--------------------------*
                . "'0',"
                #--------------------------*
                # Progressivo lotto        *
                #--------------------------*
                . "'0',"
                #--------------------------*
                # Codice numerico prodotto *
                #--------------------------*
                . "'0',"
                #--------------------------*
                # Codice alfanumerico      *
                #--------------------------*
                . "'',"
                #--------------------------*
                # Codice del produttore    *
                #--------------------------*
                . "'',"
                #--------------------------*
                # Descrizione / rag. soc.  *
                #--------------------------*
                . "'$rag_soc',"
                #--------------------------*
                # Quantita' in ordine      *
                #--------------------------*
                . "'0.000',"
                #--------------------------*
                # Quantita' letta          *
                #--------------------------*
                . "'0.000',"
                #--------------------------*
                # Data lettura             *
                #--------------------------*
                . "'0000-00-00',"
                #--------------------------*
                # Testo da barcode         *
                #--------------------------*
                . "'',"
                #--------------------------*
                # Note libere              *
                #--------------------------*
                . "'')"                   ;
           $sth = $dbh->prepare($ins)     ;
        #----------------------------------*
        # Esecuzione                       *
        #----------------------------------*
        $sth->execute()                   ;
    }
}

#==========================================*
# Scrittura riga                           *
#------------------------------------------*
sub wrt_rig
{
    #--------------------------------------*
    # Estrazione campi                     *
    #--------------------------------------*
    my @campo = split(/;/, $linea)        ;
    #--------------------------------------*
    # DEBUG                                *
    #--------------------------------------*
#   print $campo[0] . "\n";
#   print $campo[1] . "\n";
#   print $campo[2] . "\n";
#   print $campo[3] . "\n";
#   print $campo[4] . "\n";
#   print $campo[5] . "\n";
#   print $campo[6] . "\n";
#   print $campo[7] . "\n";
#   print $campo[8] . "\n";

    #--------------------------------------*
    # Progressivo riga                     *
    #--------------------------------------*
    my $prg_rig = $campo[1]               ;
    #--------------------------------------*
    # Codice numerico prodotto             *
    #--------------------------------------*
    my $num_pro = $campo[2]               ;
    #--------------------------------------*
    # Codice alfanumerico prodotto         *
    #--------------------------------------*
    my $alf_pro = $campo[3]               ;
    #--------------------------------------*
    # Codice prodotto per casa produttrice *
    #--------------------------------------*
    my $cdp_pro = $campo[4]               ;
    #--------------------------------------*
    # Descrizione prodotto                 *
    #--------------------------------------*
    my $des_pro = $campo[5]               ;
    #--------------------------------------*
    # Quantita' in ordine                  *
    #--------------------------------------*
    my $qta_ord = $campo[6]               ;
    #--------------------------------------*
    # Lotto di vendita                     *
    #--------------------------------------*
    my $lot_ven = $campo[7]               ;
    #--------------------------------------*
    # Composizione 'INSERT'                *
    #--------------------------------------*
    my $ins = "INSERT INTO "
            . $dtb_tbl
            . " VALUES ("
            #------------------------------*
            # Protocollo                   *
            #------------------------------*
            . "'$num_prt',"
            #------------------------------*
            # Progressivo Tangram          *
            #------------------------------*
            . "'$prg_rig',"
            #------------------------------*
            # Progressivo interno          *
            #------------------------------*
            . "'0',"
            #------------------------------*
            # Progressivo lotto            *
            #------------------------------*
            . "'0',"
            #------------------------------*
            # Codice numerico prodotto     *
            #------------------------------*
            . "'$num_pro',"
            #------------------------------*
            # Codice alfanumerico prodotto *
            #------------------------------*
            . "'$alf_pro',"
            #------------------------------*
            # Codice del produttore        *
            #------------------------------*
            . "'$cdp_pro',"
            #------------------------------*
            # Descrizione prodotto         *
            #------------------------------*
            . "'$des_pro',"
            #------------------------------*
            # Quantita' in ordine          *
            #------------------------------*
            . "'$qta_ord',"
            #------------------------------*
            # Quantita' letta              *
            #------------------------------*
            . "'0.000',"
            #------------------------------*
            # Data lettura                 *
            #------------------------------*
            . "'0000-00-00',"
            #------------------------------*
            # Testo da barcode             *
            #------------------------------*
            . "'',"
            #------------------------------*
            # Note libere                  *
            #------------------------------*
            . "'')"                       ;
    #--------------------------------------*
    # DEBUG                                *
    #--------------------------------------*
#    print $ins;
#    exit();
            
#   *--------------------------------------*
#   * Preparazione                         *
#   *--------------------------------------*
    my $sth = $dbh->prepare($ins)         ;
#   *--------------------------------------*
#   * Esecuzione                           *
#   *--------------------------------------*
    $sth->execute()                       ;
}

#==========================================*
# Chiusura file                            *
#------------------------------------------*
sub fil_cls
{
    close I_FILE                          ;
}

#==========================================*
# Test se protocollo esistente             *
#------------------------------------------*
sub tst_prt
{
#   *--------------------------------------*
#   * Valore in input                      *
#   *--------------------------------------*
    my $prt_inp = shift                   ;
#   *--------------------------------------*
#   * Lettura elemento                     *
#   *--------------------------------------*
    my $sel = "SELECT `num_prt`
                      FROM "
                    . $dtb_tbl
                    . " WHERE num_prt = '"
                    . $prt_inp
                    . "'"                 ;
    my $sth = $dbh->prepare($sel)         ;
#   *--------------------------------------*
#   * Esecuzione                           *
#   *--------------------------------------*
    $sth->execute()                       ;
#   *--------------------------------------*
#   * Esito lettura                        *
#   *--------------------------------------*
    $row = $sth->rows                     ;
}


