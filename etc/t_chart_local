#==========================================*
# Moduli Perl di base                      *
#------------------------------------------*
use Net::FTP                              ;
use Digest::MD5 qw(md5_hex)               ;

#==========================================*
# Variabili lette in input                 *
#------------------------------------------*
my $azie = shift                          ;
my $user = shift                          ;
my $file = shift                          ;
my $ctyp = shift                          ;
my $isps = shift                          ;
my $ieml = shift                          ;

#==========================================*
# Help                                     *
#------------------------------------------*
if (!$azie || $azie eq "-help")
{
