        . "============================="
        . "\n"
        . "USO     :"
        . "\n"
        . "> t_chart azi utente "
        . "file tipo(C/P) "
        . " Server_SMTP (opz) "
        . "ind_mail (opz)"
        . "\n"
        . "\n"
        . "-----------------------------"
        . "\n"
        . "ESEMPIO :"
        . "\n"
        . "\n"
        . "> t_chart prv master "
        . "svf200 C "
        . " smtp.libero.it "
        . " prova\@libero.it "
        . "\n"
        . "\n"
        . "-----------------------------"
        . "\n"
        . "RELEASE : 17/05/2012"
        . "\n"
        . "\n"
        . "(C) Copyright - dKb"
        . "\n"
        . "============================="
        . "\n"                            ;
    exit()                                ;
}

#==========================================*
# Variabili di configurazione              *
#------------------------------------------*
my $host = '10.1.1.226'                   ;
my $ftps = '10.1.1.226'                   ;
my $ftpu = 'master'                       ;
my $ftpp = 'loppio2'                      ;
my $ftpd = '/abd/web/htm/chart/'          ;

#==========================================*
# Assegnazione valori di default           *
#------------------------------------------*
if (!$host)
{
    $host = 'www.dkb.it'                  ;
}

if (!$ftps)
{
    $ftps = 'www17.protec.it'             ;
}

if (!$ftpu)
{
    $ftpu = 'dkb'                         ;
}

if (!$ftpp)
{
    $ftpp = 'cavallo'                     ;
}

if (!$ftpd)
{
    $ftpd = 'dkb.it/chart/'               ;
}

#==========================================*
# Costanti di configurazione               *
#------------------------------------------*
my $base = '/abd/asc/'                    ;
my $path = '/tmp/'                        ;
my $http = 'http://'
         . $host
         . '/chart/t_engine.html?CT='     ;

#==========================================*
# Sub-routine di trasferimento file        *
#------------------------------------------*
my $link = &ftpf                          ;

#==========================================*
# Sub-routine di invio mail a utente       *
#------------------------------------------*
if ($isps && $ieml)
{
    &inmu($link)                          ;
}

#==========================================*
# SUB-ROUTINES                             *
#==========================================*

#==========================================*
# Subroutine di trasferimento del file     *
#------------------------------------------*
sub ftpf
{
    #--------------------------------------*
    # Comodo per errori                    *
    #--------------------------------------*
    my $erra=0                            ;

    #--------------------------------------*
    # Determinazione nomi cartelle e file  *
    #--------------------------------------*
    my $md5a = md5_hex($azie)             ;
    my $md5u = md5_hex($user)             ;

    my $dest = $ftpd
             . $md5a
             . $md5u                      ;

    my $fnam = $md5a
             . $md5u                      ;

    my $fput = $base
             . $user
             . $path
             . $azie
             . "_"
             . $file 
             . ".csv"                     ;

    #--------------------------------------*
    # (Debug)                              *
    #--------------------------------------*
    # print $dest . "\n"                    ;
    # print         "\n"                    ;
    # print $fput . "\n"                    ;

    #--------------------------------------*
    # Apertura connessione                 *
    #--------------------------------------*
    $ftp = Net::FTP->new($ftps,
                         Debug => 0)
           or die "Non connesso a: $@"    ;

    #--------------------------------------*
    # Login connessione                    *
    #--------------------------------------*
    $ftp->login($ftpu,$ftpp)
          or die "Login errato ",
                 $ftp->message            ;
    
    #--------------------------------------*
    # Posizionamento cartella destinazione *
    #--------------------------------------*
    $ftp->cwd($dest) or $erra=1           ;

    if ($erra)
    {
        #----------------------------------*
        # Creazione directory              *
        #----------------------------------*
        &crea($fnam)                      ;
    }
                 
    #--------------------------------------*
    # Modalita' Binary                     *
    #--------------------------------------*
    $ftp->binary
          or die "Binary NO",
                 $ftp->message            ;

    #--------------------------------------*
    # Ri-posizionamento cautelativo        *
    #--------------------------------------*
    $ftp->cwd($dest) or $erra=2           ;

    #--------------------------------------*
    # Trasferimento                        *
    #--------------------------------------*
    $ftp->put($fput)
          or die "put fallita ",
                 $ftp->message            ;

    #--------------------------------------*
    # Chiusura FTP                         *
    #--------------------------------------*
    $ftp->quit                            ;

    #--------------------------------------*
    # Link in uscita                       *
    #--------------------------------------*
    return $fnam                          ;

}

#==========================================*
# Subroutine di creazione directory        *
#------------------------------------------*
sub crea
{
    #--------------------------------------*
    # Nome della cartella da creare        *
    #--------------------------------------*
    my $cred = shift @_                   ;

    #--------------------------------------*
    # Posizionamento cartella destinazione *
    #--------------------------------------*
    $ftp->cwd($ftpd)
          or die "Posizionamento ",
                 $ftp->message            ;
                 
    #--------------------------------------*
    # Creazione cartella destinazione      *
    #--------------------------------------*
    $ftp->mkdir($cred)
          or die "Creazione fallita",
                 $ftp->message            ;
}

#==========================================*
# Subroutine di invio mail a utente        *
#------------------------------------------*
sub inmu
{
    #--------------------------------------*
    # Modulo PERL di invio mail            *
    #--------------------------------------*
    use MIME::Lite                        ;

    #--------------------------------------*
    # Link da subroutine di trasferimento  *
    #--------------------------------------*
    my $lnkw = shift @_                   ;

    $lnkw    = $http
             . $ctyp
             . '&EN='
             . $file
             . '&ID='
             . $lnkw
             . '/'
             . $azie
             . '_'
             . $file
             . '.csv'                     ;
    
    #--------------------------------------*
    # (Debug)                              *
    #--------------------------------------*
    #print $lnkw . "\n"                   ;
    
    #--------------------------------------*
    # Composizione soggetto                *
    #--------------------------------------*
    my $subj = "Grafico TANGRAM - "
             . $file
             . " - ["
             . $user
             . " - "
             . $azie
             . "]"                        ;

    #--------------------------------------*
    # Messaggio di posta                   *
    #--------------------------------------*
    $msg = MIME::Lite->new(
           From     =>$ieml,
           To       =>$ieml,
           Subject  =>$subj,
           Data     =>$lnkw)              ;

    #--------------------------------------*
    # Invio                                *
    #--------------------------------------*
    $msg->send('smtp', $isps, Timeout=>60);
}