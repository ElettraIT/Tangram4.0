############ /abd/etc/spooler         
#                                     
# Procedura per lo spooler da tangram 
#                                     
############                          
                                      
case $1 in                            
    pdf)                              
        b=`basename $2`               
        pstopdf $2 -o /abd/pdf/$b.pdf 
        rm -f $2                      
        ;;                            
    *)                                
        lpr -P$1 -l -r $2             
        ;;                            
esac                                  
