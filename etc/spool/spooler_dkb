############ /abd/etc/spooler_dkb
#                                     
# ___ NON IMPLEMENTATO ___ 15/01/2013
#                                     
# Procedura per lo spooler da tangram 
#                                     
# Variabili in input:
#                                     
#     - $1 : 'pdf' o nome stampante                             
#     - $2 : filename in /abd/spl                             
#     - $3 : filename in output                           
#     - $4 : utente Tangram                            
#                                     
############                          
                                      
case $1 in                            
    pdf)                              
        b=`basename $2`               
        ps2pdf $2 /abd/asc/$4/pdf/out/$3.pdf 
        rm -f $2                      
        ;;                            
    *)                                
        lpr -P$1 -l -r $2             
        ;;                            
esac                                  
