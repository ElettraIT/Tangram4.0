     ############ /abd/etc/echonnl
     #
     # Procedura di echo senza carattere finale di 'newline'
     #
     # Input : $1:Stringa da emettere in output
     #
     # Output: La stringa passata + un blank di separazione e senza NL
     #
     ######
     
echo -n "" > /tmp/echonnl$$
if [ -s /tmp/echonnl$$ ]
   then
       echo $1"\c";
       echo " \c";
   else
       echo -n $1" ";
   fi
rm -rf /tmp/echonnl$$
