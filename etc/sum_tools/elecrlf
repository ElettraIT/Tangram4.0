#
# Posizionamento sulla directory di base per oggetti
#
cd /abd/asc/imp;

#
# Lettura parametro
#
V_INPUT=$1;

if [ -z "$1" ]
   then
      V_INPUT="InvExp.txt"
   fi

#
# Esecuzione newret
#
/abd/run/newret CRLF "$V_INPUT";

chmod 0777 "$V_INPUT" ;
