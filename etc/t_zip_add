#!/usr/bin/perl -w
#==========================================*
# Modulo Perl per Zippare una lista di     *
# files in un unico archivio               *
#                                          *
# t_zip_add                                *
#                                          *
# ---------------------------------------- *
# Versione originale:   001 del 20/02/18   *
#   Ultima revisione:   NdK del 07/02/19   *
# ---------------------------------------- *
#             Autore:   Nicola de Kunovich *
# ---------------------------------------- *
#                                          *
# In input : - codice azienda              *
#            - area                        *
#            - anno (1 carattere Alfa)     *
#            - numero distinta             *
#            - prefisso (IT99999999999)    *
#                                          *
# ---------------------------------------- *
# N.B.: i campi in input sono separati da  *
#       virgola ','                        *
#------------------------------------------*

#==========================================*
# Moduli Perl utilizzati                   *
#------------------------------------------*
use Archive::Zip qw( :ERROR_CODES :CONSTANTS );

#==========================================*
# Nuova istanza di creazione Zip           *
#------------------------------------------*
$obj = Archive::Zip->new()                ;

#==========================================*
# Variabili lette in input                 *
#------------------------------------------*
#    *-------------------------------------*
#    * Lettura variabile in input          *
#    *-------------------------------------*
$inpt = $ARGV[0]                          ;

#==========================================*
# Help                                     *
#------------------------------------------*
if (!$ARGV[0] || $ARGV[0] eq "-help")
{
    print "\n"
        . "Uso : (parametri "
        . "separati da virgola)"
        . "\n"
        . "> t_zip_add"
        . "\n"
        . "           AZIENDA,"
        . "\n"
        . "           AREA,"
        . "\n"
        . "           ANNO (A/B/..),"
        . "\n"
        . "           DISTINTA,"
        . "\n"
        . "           PREFISSO (IT99999999999),"
        . "\n"
        . "\n"
        . "Release : 05/11/2018"
        . "\n"
        . "\n"
        . "(C) Copyright - wip"
        . "\n"
        . "\n"                            ;
    exit()                                ;
}

#    *-------------------------------------*
#    * Separazione dei componenti (,)      *
#    *-------------------------------------*
@vars = split(/,/, $inpt)                 ;
#    *-------------------------------------*
#    * Azienda                             *
#    *-------------------------------------*
my $azie = $vars[0]                       ;
#    *-------------------------------------*
#    * Area                                *
#    *-------------------------------------*
my $area = $vars[1]                       ;
#    *-------------------------------------*
#    * Anno                                *
#    *-------------------------------------*
my $anno = $vars[2]                       ;
#    *-------------------------------------*
#    * Distinta                            *
#    *-------------------------------------*
my $dist = $vars[3]                       ;
#    *-------------------------------------*
#    * Prefisso                            *
#    *-------------------------------------*
my $pref = $vars[4]                       ;

#==========================================*
# Variabili statiche                       *
#------------------------------------------*
my $base = "/abd/asc/"                    ;

#==========================================*
# Composizione directory di lavoro         *
#------------------------------------------*
my $dire = $base
         . $azie
         . "/"
         . $area                          ;

#==========================================*
# Composizione nome lista da leggere       *
#------------------------------------------*
my $list = $base
         . $azie
         . "/tmp/"
         . $dist
         . ".txt"                         ;

#==========================================*
# Composizione nome archivio zip           *
#------------------------------------------*
my $dstn = substr($dist, 5, 4)            ;
my $nzip = $pref
         . "_"
         . $anno
         . $dstn
         . ".zip"                         ;

#==========================================*
# DEBUG                                    *
#------------------------------------------*
#print $nzip . "\n"                        ;
#print $dire . "\n"                        ;
#print $list . "\n"                        ;
#print $dstn . "\n"                        ;
#exit()                                    ;

#==========================================*
# Cambio directory                         *
#------------------------------------------*
chdir $dire                               ;

#==========================================*
# Open lista files da includere            *
#------------------------------------------*
open (LISTA, $list) or die
    "Impossibile aprire l'elenco\n"       ;
@name = <LISTA>                           ;

#==========================================*
# Ciclo di scansione file                  *
#------------------------------------------*
foreach $elem(@name)
{
    #--------------------------------------*
    # Pulizia fine riga                    *
    #--------------------------------------*
    chomp ($elem)                         ;
    #--------------------------------------*
    # Test che il file esista              *
    #--------------------------------------*
    if (-e $elem)
    { 
        #----------------------------------*
        # Aggiunta file                    *
        #----------------------------------*
        $obj->addFile($elem)              ;
        $obj->writeToFileNamed($nzip)     ;
    }
     else 
    {
        print "non trovato = "
            . $elem
            . "\n"                        ;
    }
}

#==========================================*
# Close                                    *
#------------------------------------------*
close (LISTA)                             ;

