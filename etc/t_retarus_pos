#!/usr/bin/perl -w
#==========================================*
# Modulo Perl per invio POS a Retarus      *
#                                          *
# t_retaurs_pos                            *
#                                          *
# ---------------------------------------- *
# Versione originale:  001 del 03/01/21    *
#   Ultima revisione:  NdK del 12/09/25    *
# ---------------------------------------- *
#             Autore:  Nicola de Kunovich  *
# ---------------------------------------- *
#                                          *
# In input : - host di destinazione        *
#                                          *
#            - username                    *
#                                          *
#            - password                    *
#                                          *
#            - file da inviare             *
#                                          *
#            - tipo esecuzione             *
#                                          *
#------------------------------------------*

#==========================================*
# Moduli Perl                              *
#------------------------------------------*
use Net::SFTP::Foreign;
use File::Basename                        ;

#==========================================*
# Variabili lette in input                 *
#------------------------------------------*
my $host = shift                          ;
my $user = shift                          ;
my $pass = shift                          ;
my $file = shift                          ;
my $texe = shift                          ;

#==========================================*
# Help                                     *
#------------------------------------------*
if (!$host || !$user || $host eq "-help")
{
    print "\n"
        . "Uso :"
        . "\n"
        . "> t_retaurs_pos HOST "
        . "USERNAME "
        . "PASSWORD "
        . "FILENAME "
        . "TIPO(Test/Productive)"
        . "\n"
        . "\n"
        . "(C) Copyright - WIP"
        . "\n"
        . "\n"                            ;
    exit()                                ;
}

#==========================================*
# Determinazione percorso di destinazione  *
#------------------------------------------*
my $path = ""                             ;

if ($texe eq "T")
{
    $path = "/test/slsrpt_out"            ;
}
 else
{
    $path = "/productive/slsrpt_out"      ;
}

#==========================================*
# Open file di LOG                         *
#------------------------------------------*
my $logf = $file . ".log"                 ;
open (OUTFILE, ">$logf") or die
     "Impossibile aprire '$logf'"         ;

#==========================================*
# Connessione                              *
#------------------------------------------*
my $sftp = Net::SFTP::Foreign->new(
  host     => $host,
  user     => $user,
  password => $pass,                      # usa la password passata a riga di comando
  port     => 22,                         # <-- QUI serviva la virgola!
);

if ($sftp->error) {
  print OUTFILE "Connessione SFTP fallita: " . $sftp->error . "\n";
  close OUTFILE;
  exit 1;
}

#==========================================*
# Directory di output                      *
#------------------------------------------*
$sftp->setcwd($path)
  or do {
    print OUTFILE "setcwd('$path') fallita: " . $sftp->error . "\n";
    close OUTFILE;
    exit 1;
  };

#==========================================*
# Invio vero e proprio                     *
#------------------------------------------*
$sftp->put($file)
  or do {
    print OUTFILE "put('$file') fallita: " . $sftp->error . "\n";
    close OUTFILE;
    exit 1;
  };

#==========================================*
# Rename del file                          *
#------------------------------------------*
my $name = basename($file);
my $rnmd = $name . ".CSV.ok";

$sftp->rename($name, $rnmd)
  or do {
    print OUTFILE "rename('$name' -> '$rnmd') fallita: " . $sftp->error . "\n";
    close OUTFILE;
    exit 1;
  };

#==========================================*
# Uscita da FTP                            *
#------------------------------------------*
$sftp->disconnect;

#==========================================*
# Close file di LOG                        *
#------------------------------------------*
print OUTFILE "OK: inviato '$name' come '$rnmd' in $path\n";
close OUTFILE                             ;


