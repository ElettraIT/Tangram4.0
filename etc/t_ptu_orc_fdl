#!/usr/bin/perl -w
#===============================================================*
#                                                               *
# Stampa Foglio di Lavoro (da orc300)                           *
#                                                               *
# SU MISURA PER PERONTECNICI                                    *
#                                                               *
#                   ------------------------------------------- *
#                    Versione originale:    001 del 23/03/2018  *
#                      Ultima revisione:    NdK del 05/05/2018  *
#                   ------------------------------------------- *
#                                Autore:    Nicola de Kunovich  *
# ------------------------------------------------------------- *
#                                                               *
# Parametri in input : - file CSV da stampare (protocollo)      *
#                                                               *
# ------------------------------------------------------------- *
#                                                               *
# Utilizzo :                                                    *
#                                                               *
# $ t_ptu_orc_fdl 99999999999                                   *
#                                                               *
# ------------------------------------------------------------- *
#                                                               *
# Note     : lo script "importa" un modulo EPS che viene poi    *
#            completato con le righe orizzontali. Legge un file *
#            CSV generato da Tangram (pet/porc300t) che contie- *
#            ne una sintesi di una conferma ordine e il risul-  *
#            tato viene inviato alla stampante o diventa PDF.   *
#                                                               *
#===============================================================*

#===============================================================*
# Moduli Perl                                                   *
#---------------------------------------------------------------*
use PostScript::Simple                                         ;

#===============================================================*
# Variabili statiche                                            *
#---------------------------------------------------------------*
#   *-----------------------------------------------------------*
#   * Lettura configurazione                                    *
#   *-----------------------------------------------------------*
    my $cfg_bas = "/abd/asc/cfg/t_ptu_orc_fdl.ini"             ;
    my %cnf_ele = do $cfg_bas                                  ;
#   *-----------------------------------------------------------*
#   * Codice stampante da file configurazione                   *
#   *-----------------------------------------------------------*
    my $cod_stp = $cnf_ele{cod_stp}                            ;
#   *-----------------------------------------------------------*
#   * Protocollo in input                                       *
#   *-----------------------------------------------------------*
    my $num_prt = $ARGV[0]                                     ;
#   *-----------------------------------------------------------*
#   * Percorsi file                                             *
#   *-----------------------------------------------------------*
    my $pth_spl = $cnf_ele{pth_spl}                            ;
    my $pth_pdf = $cnf_ele{pth_pdf}                            ;
    my $mod_eps = $cnf_ele{pth_eps}                            ;
    my $pth_csv = $pth_spl . $num_prt . ".csv"                 ;
    my $out_stp = $pth_spl . $num_prt . ".ps"                  ;
    my $out_pdf = $pth_spl . $num_prt . ".pdf"                 ;
    my $ou2_pdf = $pth_pdf . $num_prt . ".pdf"                 ;
#   *-----------------------------------------------------------*
#   * Contatori e posizionatori pagina                          *
#   *-----------------------------------------------------------*
    my $max_rig = 16                                           ;
    my $ctr_rig = 0                                            ;
    my $num_pag = 0                                            ;
    my $num_rig = 0                                            ;
    my $top_rig = 152                                          ;
    my $row_hgt = 7.25                                         ;
    my $cur_lin = $top_rig                                     ;
#   *-----------------------------------------------------------*
#   * Normalizzazione variabili globali                         *
#   *-----------------------------------------------------------*
    my $nnu_ord = ""                                           ;
    my $nda_ord = ""                                           ;
    my $rag_cli = ""                                           ;
    my $tel_cli = ""                                           ;
    my $rag_dst = ""                                           ;
    my $via_dst = ""                                           ;
    my $loc_dst = ""                                           ;
    my $rif_or1 = ""                                           ;
    my $rif_or2 = ""                                           ;
    my $dat_cns = ""                                           ;
    my $not_001 = ""                                           ;
    my $not_002 = ""                                           ;
    my $not_003 = ""                                           ;

#===============================================================*
# Preparazione pagina                                           *
#---------------------------------------------------------------*
my $ps = new PostScript::Simple::(papersize => "A4",
                                  landscape => 1,
                                     colour => 1,
                                        eps => 0,
                                      units => "mm")           ;

#===============================================================*
# Trattamento stampa                                            *
#---------------------------------------------------------------*
#   *-----------------------------------------------------------*
#   * Open file                                                 *
#   *-----------------------------------------------------------*
    open (I_FILE, "$pth_csv") or die
         "Impossibile aprire il file '$pth_csv'"               ;
    my   @linea = <I_FILE>                                     ;

#   *-----------------------------------------------------------*
#   * Close del file in input                                   *
#   *-----------------------------------------------------------*
&fil_cls                                                       ;

#   *-----------------------------------------------------------*
#   * Ciclo di scansione preliminare per numero pagine totali   *
#   *-----------------------------------------------------------*
foreach $row (@linea)
{
    my   @rec = split(/;/, $row)                               ;
#       *-------------------------------------------------------*
#       * Trattamento testata                                   *
#       *-------------------------------------------------------*
    if  ($rec[0] eq "R")
    {
        $num_rig = $num_rig+1                                  ;
    }

}

#   *-----------------------------------------------------------*
#   * Determinazione numero pagine totali                       *
#   *-----------------------------------------------------------*
my $max_pag = &clc_pag ($max_rig, $num_rig)                    ;

#   *-----------------------------------------------------------*
#   * Ciclo di scansione                                        *
#   *-----------------------------------------------------------*
foreach $row (@linea)
{
    my   @rec = split(/;/, $row)                               ;
#       *-------------------------------------------------------*
#       * Trattamento testata                                   *
#       *-------------------------------------------------------*
    if  ($rec[0] eq "T")
    {
        &stp_tes                                               ;
    }
#        *------------------------------------------------------*
#        * Trattamento righe                                    *
#        *------------------------------------------------------*
    elsif ($rec[0] eq "R")
    {
        &stp_rig                                               ;
    }
#        *------------------------------------------------------*
#        * Trattamento separatore righe                         *
#        *------------------------------------------------------*
    else
    {
        &stp_sep                                               ;
    }
}

#===============================================================*
# Generazione file Postscript                                   *
#---------------------------------------------------------------*
$ps->output($out_stp)                                          ;

#===============================================================*
# Stampa file Postscript                                        *
#---------------------------------------------------------------*
if ($cod_stp eq "pdf")
{
    system("ps2pdf $out_stp $out_pdf")                        ;
    system("ps2pdf $out_stp $ou2_pdf")                        ;
}
 else
{
    system("cat $out_stp | lpr -P$cod_stp")                   ;
    system("ps2pdf $out_stp $ou2_pdf")                        ;
}

#===============================================================*
# SUBROUTINES                                                   *
#===============================================================*

#===============================================================*
# Stampa testata                                                *
#---------------------------------------------------------------*
sub stp_tes
{
#   *-----------------------------------------------------------*
#   * Estrazione campi                                          *
#   *-----------------------------------------------------------*
    my @tes = split(/;/, $row)                                 ;
#   *-----------------------------------------------------------*
#   * Pulizia trailing spaces campi testo                       *
#   *-----------------------------------------------------------*
    my $max_val = 14                                           ;
    my $ctr_001                                                ;
    for ($ctr_001 = 1 ; $ctr_001 < $max_val ; $ctr_001++ )
    {
        $tes[$ctr_001] =~ s/^\s+//                             ;
        $tes[$ctr_001] =~ s/\s+$//                             ;
    }
#   *-----------------------------------------------------------*
#   * Assegnazione variabile singolo campo di testata           *
#   *-----------------------------------------------------------*
    $nnu_ord = $tes[1]                                         ;
    $nda_ord = $tes[2]                                         ;
    $rag_cli = $tes[3]                                         ;
    $tel_cli = $tes[4]                                         ;
    $rag_dst = $tes[5]                                         ;
    $via_dst = $tes[6]                                         ;
    $loc_dst = $tes[7]                                         ;
    $rif_or1 = $tes[8]                                         ;
    $rif_or2 = $tes[9]                                         ;
    $dat_cns = $tes[10]                                        ;
    $not_001 = $tes[11]                                        ;
    $not_002 = $tes[12]                                        ;
    $not_003 = $tes[13]                                        ;
#   *-----------------------------------------------------------*
#   * Prima intestazione pagina                                 *
#   *-----------------------------------------------------------*
    &mynewpage($ps)                                            ;
}

#===============================================================*
# Stampa riga                                                   *
#---------------------------------------------------------------*
sub stp_rig
{
#   *-----------------------------------------------------------*
#   * Contatore righe                                           *
#   *-----------------------------------------------------------*
    $ctr_rig++                                                 ;
#   *-----------------------------------------------------------*
#   * Eventuale reintestazione pagina                           *
#   *-----------------------------------------------------------*
    if ($ctr_rig > $max_rig)
    {
        &mynewpage($ps)                                        ;
        $ctr_rig = 1                                           ;
        $cur_lin = $top_rig                                    ;
    }
#   *-----------------------------------------------------------*
#   * Interlinea                                                *
#   *-----------------------------------------------------------*
    $cur_lin = $cur_lin - $row_hgt                             ;
#   *-----------------------------------------------------------*
#   * Estrazione campi                                          *
#   *-----------------------------------------------------------*
    my @rig = split(/;/, $row)                                 ;
#   *-----------------------------------------------------------*
#   * Pulizia trailing spaces campi testo                       *
#   *-----------------------------------------------------------*
    my $max_val = 6                                            ;
    my $ctr_001                                                ;
    for ($ctr_001 = 1 ; $ctr_001 < $max_val ; $ctr_001++ )
    {
        $rig[$ctr_001] =~ s/^\s+//                             ;
        $rig[$ctr_001] =~ s/\s+$//                             ;
    }
#   *-----------------------------------------------------------*
#   * Assegnazione variabile singolo campo di riga              *
#   *-----------------------------------------------------------*
    my $uni_mis = $rig[1]                                      ;
    my $qta_pos = $rig[2]                                      ;
    my $cod_pro = $rig[3]                                      ;
    my $des_pos = $rig[4]                                      ;
    my $dat_cns = $rig[5]                                      ;
    my $flg_fnr = $rig[6]                                      ;
#   *-----------------------------------------------------------*
#   * Unita' di misura                                          *
#   *-----------------------------------------------------------*
    $ps->setfont("Helvetica", 10)                              ;
    $ps->text(020, $cur_lin+2, $uni_mis)                       ;
#   *-----------------------------------------------------------*
#   * Quantita'                                                 *
#   *-----------------------------------------------------------*
    $ps->setfont("Helvetica-Bold", 10)                          ;
    $ps->text({align => 'right'}, 062, $cur_lin+2, $qta_pos)   ;
#   *-----------------------------------------------------------*
#   * Codice prodotto                                           *
#   *-----------------------------------------------------------*
    $ps->setfont("Helvetica-Bold", 9)                          ;
    $ps->text(031, $cur_lin+2, $cod_pro)                       ;
#   *-----------------------------------------------------------*
#   * Descrizione prodotto                                      *
#   *-----------------------------------------------------------*
    $ps->setfont("Helvetica", 10)                              ;
    $ps->text(067, $cur_lin+2, $des_pos)                       ;
#   *-----------------------------------------------------------*
#   * Data consegna                                             *
#   *-----------------------------------------------------------*
    $ps->setfont("Helvetica-Bold", 10)                         ;
    $ps->text(252, $cur_lin+2, $dat_cns)                       ;
}
#===============================================================*
# Stampa separatore riga                                        *
#---------------------------------------------------------------*
sub stp_sep
{
#   *-----------------------------------------------------------*
#   * Separatore linea                                          *
#   *-----------------------------------------------------------*
    if ($ctr_rig < $max_rig)
    {
        $ps->line(14, $cur_lin, 285, $cur_lin)                 ;
    }
}

#===============================================================*
# Intestazione pagina                                           *
#---------------------------------------------------------------*
sub mynewpage
{
#   *-----------------------------------------------------------*
#   * Documento in input                                        *
#   *-----------------------------------------------------------*
    my $ps = shift                                             ;
#   *-----------------------------------------------------------*
#   * Numero pagina                                             *
#   *-----------------------------------------------------------*
    $num_pag++                                                 ;
#   *-----------------------------------------------------------*
#   * Nuova pagina                                              *
#   *-----------------------------------------------------------*
    $ps->newpage                                               ;
#   *-----------------------------------------------------------*
#   * Stampa ragione sociale cliente                            *
#   *-----------------------------------------------------------*
    $ps->setfont("Helvetica-Bold", 20)                         ;
    $ps->text(30, 192, $rag_cli)                               ;
#   *-----------------------------------------------------------*
#   * Numero e data documento                                   *
#   *-----------------------------------------------------------*
    $ps->setfont("Helvetica", 10)                              ;
    $ps->text({align => 'right'}, 245, 192, "["
                                          . $nnu_ord
                                          . " - "
                                          . $nda_ord
                                          . "]")               ;
#   *-----------------------------------------------------------*
#   * Stampa ragione sociale destinatario                       *
#   *-----------------------------------------------------------*
    $ps->text(20, 183, $rag_dst)                               ;
    $ps->text(20, 178, $via_dst)                               ;
    $ps->text(20, 173, $loc_dst)                               ;
#   *-----------------------------------------------------------*
#   * Riferimenti ordine cliente                                *
#   *-----------------------------------------------------------*
    $ps->text(152, 183, $rif_or1)                              ;
    $ps->text(152, 178, $rif_or2)                              ;
    $ps->text(152, 173, $tel_cli)                              ;
#   *-----------------------------------------------------------*
#   * Numero pagina                                             *
#   *-----------------------------------------------------------*
    $ps->text({align => 'right'}, 242, 173, "Pagina "
                                          . $num_pag
                                          . " di "
                                          . $max_pag)          ;
#   *-----------------------------------------------------------*
#   * Data di consegna generale                                 *
#   *-----------------------------------------------------------*
    $ps->setfont("Helvetica-Bold", 14)                         ;
    $ps->text(255, 168, $dat_cns)                              ;
    $ps->setfont("Helvetica-Bold", 10)                         ;
#   *-----------------------------------------------------------*
#   * Note                                                      *
#   *-----------------------------------------------------------*
    $ps->text(20, 163, $not_001
                     . " "
                     . $not_002
                     . " "
                     . $not_003)                               ;
                       
#   *-----------------------------------------------------------*
#   * Prima linea griglia                                       *
#   *-----------------------------------------------------------*
    $ps->setlinewidth( 0.01 )                                  ;
    $ps->line(14, $top_rig, 285, $top_rig)                     ;
#   *-----------------------------------------------------------*
#   * Griglia per materiale impiegato                           *
#   *-----------------------------------------------------------*
    my $max_val = 16                                           ;
    my $ctr_001                                                ;
    for ($ctr_001 = 1 ; $ctr_001 < $max_val ; $ctr_001++ )
    {
#       *-------------------------------------------------------*
#       * Linea di griglia                                      *
#       *-------------------------------------------------------*
        $lin_gri = $top_rig - ($ctr_001*$row_hgt)              ;
        $ps->setlinewidth( 0.01 )                              ;
        $ps->line(150,
                  $lin_gri,
                  246,
                  $lin_gri)                                    ;
    }
    
#   *-----------------------------------------------------------*
#   * Determinazione coordinate modulo EPS                      *
#   *-----------------------------------------------------------*
    my $eps_x01 = 5                                            ;
    my $eps_y01 = 5                                            ;
    my $eps_x02 = 410                                          ;
    my $eps_y02 = 210                                          ;
#   *-----------------------------------------------------------*
#   * Inclusione modulo EPS                                     *
#   *-----------------------------------------------------------*
    $ps->importepsfile($mod_eps,
                       $eps_x01,
                       $eps_y01,
                       $eps_x02,
                       $eps_y02)                               ;
}

#===============================================================*
# Chiusura file                                                 *
#---------------------------------------------------------------*
sub fil_cls
{
    close I_FILE                                               ;
}

#===============================================================*
# Calcolo numero massimo di pagine                              *
#---------------------------------------------------------------*
sub clc_pag
{
    #-----------------------------------------------------------*
    # Valori in input                                           *
    #-----------------------------------------------------------*
    my $wrk_mpg = shift                                        ;
    my $wrk_nrg = shift                                        ;
    #-----------------------------------------------------------*
    # Calcolo                                                   *
    #-----------------------------------------------------------*
    my $wrk_max = 1                                            ;
    my $wrk_int = int($wrk_nrg / $wrk_mpg)                     ;
    my $wrk_rem = $wrk_nrg / $wrk_mpg                          ;
    if ($wrk_rem > $wrk_int){$wrk_max = $wrk_max+$wrk_int}     ;
    #-----------------------------------------------------------*
    # Valore in output                                          *
    #-----------------------------------------------------------*
    return $wrk_max                                            ;
}
