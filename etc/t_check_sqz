#!/usr/bin/perl -w
#==========================================*
# Modulo Perl per controllo sequenziali    *
#                                          *
# t_check_sqz                              *
#                                          *
# SPERIMENTALE : attualmente per 'dcc'     *
#                                          *
# ---------------------------------------- *
# Versione originale: 001 del 19/02/09     *
#   Ultima revisione: NdK del 19/02/09     *
# ---------------------------------------- *
#             Autore: Nicola de Kunovich   *
# ---------------------------------------- *
#                                          *
# In input : - filename                    *
#                                          *
#------------------------------------------*

#==========================================*
# Variabili statiche                       *
# ---------------------------------------- *
#  - Pathname di base per i file           *
#------------------------------------------*
$base = '/abd/asc/'                       ;

#==========================================*
# Variabili lette in input                 *
# ---------------------------------------- *
#  - $path : Filename                      *
#------------------------------------------*
$path = $ARGV[0]                          ;

#==========================================*
# Sub-routine per lettura file             *
#------------------------------------------*
&lista                                    ;

#==========================================*
# Sub-routines                             *
#==========================================*

#==========================================*
# Invio ad una lista                       *
#------------------------------------------*
sub lista
{
    #--------------------------------------*
    # Open                                 *
    #--------------------------------------*
    open (SEQUENZIALE, "$base$path")or die
        "Impossibile aprire il file"      ;
    @elemento = <SEQUENZIALE>;
    #--------------------------------------*
    # Normalizzazione rottura              *
    #--------------------------------------*
    my $cod_rot = 0                       ;
    my $lin = 0                           ;
    #--------------------------------------*
    # Ciclo                                *
    #--------------------------------------*
    foreach $elemento (@elemento)
    {
        #----------------------------------*
        # Incremento contatore             *
        #----------------------------------*
        $lin = $lin + 1                   ;
        #----------------------------------*
        # Estrazione codici                *
        #----------------------------------*
        my $cod_cli = substr($elemento,24,4);
        my $dpz_cli = substr($elemento,28,4);
        #----------------------------------*
        # Se cliente principale            *
        #----------------------------------*
        if ($dpz_cli eq "    ")
        {
            $cod_rot = $cod_cli           ;
            next                          ;
        }
        #----------------------------------*
        # Se dipendenza                    *
        #----------------------------------*
         else
        {
            #------------------------------*
            # Test                         *
            #------------------------------*
            if ($cod_cli == $cod_rot)
            {
                next                      ;
            }
             else
            {
                #--------------------------*
                # Messaggio di errore      *
                #--------------------------*
                print "Errore a linea : "
                        . $lin
                        . " -> "
                        . $cod_rot
                        . " "
                        . $cod_cli
                        . " "
                        . $dpz_cli        ;
                print       "\n"          ;      
            }
        }
    }
    #--------------------------------------*
    # Open                                 *
    #--------------------------------------*
    close (SEQUENZIALE);
}


