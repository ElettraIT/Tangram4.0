#!/usr/bin/perl -w
#==========================================*
# Modulo Perl per invio dati a generatore  *
# di grafici in PHP, basato su JpGraph     *
#                                          *
# t_graph                                  *
#                                          *
# ___ OBSOLETO !!! (vedi 't_chart') ___    *
#                                          *
# ---------------------------------------- *
# Versione originale:  001 del 06/02/07    *
#   Ultima revisione:  NdK del 20/12/10    *
# ---------------------------------------- *
#             Autore:  Nicola de Kunovich  *
# ---------------------------------------- *
#                                          *
# In input : - pathname file parametri     *
#                                          *
# ---------------------------------------- *
# Richiede Perl Net::HTTP e PHP5           *
#==========================================*

#==========================================*
# Modulo Perl Net::HTTP                    *
#------------------------------------------*
use Net::HTTP                             ;

#==========================================*
# Variabili statiche                       *
#------------------------------------------*
$base = '/abd/asc/'                       ;
$path = '/pdf/out/'                       ;

#==========================================*
# Variabili lette in input                 *
#------------------------------------------*
#  - $file : file contenente parametri     *
#------------------------------------------*
#    *-------------------------------------*
#    * Lettura variabile in input          *
#    *-------------------------------------*
my $file = shift                          ;
my $locl = shift                          ;

#==========================================*
# Help                                     *
#------------------------------------------*
if (!$file || $file eq "-help")
{
    print "\n"
        . "Uso :"
        . "\n"
        . "> t_graph /abd/asc/"
        . "UTENTE/tmp/AZI_PROG.sqz L (opz)"
        . "\n"
        . "\n"
        . "Release : 20/12/10"
        . "\n"
        . "\n"
        . "(C) Copyright - dKb"
        . "\n"
        . "\n"                            ;
    exit()                                ;
}

#==========================================*
# Variabili di configurazione              *
#------------------------------------------*
my $host = ''                             ;
my $req  = ''                             ;

if (!$locl)
{
    $locl = ''                            ;
}

if ($locl eq "L")
{
    $host = '10.1.1.226'                  ;
    $req = "/php/jpgraph-2.1.4/src" 
        . "/0_dkb_gen.php?"               ;
}
 else
{
    $host = 'www.dkb.it'                  ;
    $req = "/grafici/0_dkb_gen.php?"      ;
}

#==========================================*
# Sub-routine di lettura file parametri    *
#------------------------------------------*
&para                                     ;

#==========================================*
# Preparazione parametri                   *
#------------------------------------------*
#    *-------------------------------------*
#    * Utente Tangram                      *
#    *-------------------------------------*
   my $user = $parametro[0]               ;
chomp $user                               ;
#    *-------------------------------------*
#    * Azienda                             *
#    *-------------------------------------*
   my $azie = $parametro[1]               ;
chomp $azie                               ;
#    *-------------------------------------*
#    * Nome grafico                        *
#    *-------------------------------------*
   my $name = $parametro[2]               ;
chomp $name                               ;
#    *-------------------------------------*
#    * Legenda 1                           *
#    *-------------------------------------*
   my $al01 = $parametro[3]               ;
chomp $al01                               ;
      $al01 =&URLEncode($al01)            ;
#    *-------------------------------------*
#    * Legenda 2                           *
#    *-------------------------------------*
   my $al02 = $parametro[4]               ;
chomp $al02                               ;
      $al02 =&URLEncode($al02)            ;

#    *-------------------------------------*
#    * Array di dati 1                     *
#    *-------------------------------------*
my @dt01 = ""                             ;

for ($i = 0; $i < 12 ; $i++)
{
    my $iz = $i + 5                       ;
    $dt01[$i] =&valore($parametro[$iz])   ;
}
#    *-------------------------------------*
#    * Array di dati 2                     *
#    *-------------------------------------*
my @dt02 = ""                             ;

for ($i = 0; $i < 12 ; $i++)
{
    my $iz = $i + 17                      ;
    $dt02[$i] =&valore($parametro[$iz])   ;
}

#==========================================*
# Richiamo HTTP per ottenere il grafico    *
#------------------------------------------*
#    *-------------------------------------*
#    * Assemblaggio parametri GET          *
#    *-------------------------------------*
$req = $req . "al1="
            . $al01
            . "&al2="
            . $al02                       ;

#    *-------------------------------------*
#    * Scansione array di dati 1           *
#    *-------------------------------------*
for ($i = 0; $i < 12 ; $i++)
{
    my $iw = $i + 1                       ;
    my $ix = sprintf ("%02d",$iw)         ;
    $req = $req . "&a"
                . $ix
                . "="
                . $dt01[$i]               ;
}
#    *-------------------------------------*
#    * Scansione array di dati 2           *
#    *-------------------------------------*
for ($i = 0; $i < 12 ; $i++)
{
    my $iw = $i + 1                       ;
    my $ix = sprintf ("%02d",$iw)         ;
    $req = $req . "&b"
                . $ix
                . "="
                . $dt02[$i]               ;
}

#    *-------------------------------------*
#    * (Debug)                             *
#    *-------------------------------------*
#   print $host . $req . "\n"             ;

#    *=====================================*
#    * Inizializzazione HTTP               *
#    *-------------------------------------*
my $s = Net::HTTP->new(Host => $host) || die $@;
#    *-------------------------------------*
#    * Passaggio parametri                 *
#    *-------------------------------------*
$s->write_request(GET => $req,
         'User-Agent' => "Mozilla/5.0")   ;
#    *-------------------------------------*
#    * Invio parametri                     *
#    *-------------------------------------*
my($code, $mess, %h) = $s->read_response_headers;

#==========================================*
# Sub-routine di bufferizzazione immagine  *
#------------------------------------------*
&imgf                                     ;

#==========================================*
# SUB-ROUTINES                             *
#==========================================*

#==========================================*
# Subroutine di lettura file parametri     *
#------------------------------------------*
sub para
{
    #--------------------------------------*
    # Open                                 *
    #--------------------------------------*
    open (PARAMETRI, "$file")or die
        "Impossibile aprire il file"      ;
    @parametro = <PARAMETRI>              ;
    #--------------------------------------*
    # Close                                *
    #--------------------------------------*
    close (PARAMETRI)                     ;
}

#==========================================*
# Trattamento file immagine                *
#------------------------------------------*
sub imgf
{
    #--------------------------------------*
    # Nome immagine                        *
    #--------------------------------------*
    my $imag = "/"
             . $azie
             . "_"
             . $name
             . '.png'                     ;
    #--------------------------------------*
    # Open                                 *
    #--------------------------------------*
    open (IMMAGINE, ">" . $base
                        . $user
                        . $path
                        . $imag) or die
     "Impossibile aprire il file Immagine";
    #--------------------------------------*
    # Ciclo di bufferizzazione             *
    #--------------------------------------*
    while (1) {
        my $buf                            ;
        my $n = $s->read_entity_body($buf, 1024);
        die "lettura no: $!" unless defined $n;
        last unless $n                    ;
        print IMMAGINE $buf               ;   
    }
    #--------------------------------------*
    # Chiusura immagine                    *
    #--------------------------------------*
    close IMMAGINE                        ;
}

#==========================================*
# Trattamento valori                       *
#------------------------------------------*
sub valore
{
    $valx = $_[0]                          ;
    $valx = $valx/100                      ;
    $valx = sprintf ("%09d",$valx)         ;
    chomp  $valx                           ;
    return $valx                           ;
}

#==========================================*
# URL Encode                               *
#------------------------------------------*
sub URLEncode
{
    my $theURL = $_[0]                    ;
    $theURL =~ s/([\W])/"%"
            . uc(sprintf("%2.2x",ord($1)))/eg;
    return $theURL                        ;
}


