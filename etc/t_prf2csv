#!/usr/bin/perl -w
#===============================================================*
#                                                               *
# Driver di conversione stampa di Tangram in file 'CSV'         *
#                                                               *
#                   ------------------------------------------- *
#                    Versione originale:    001 del 13/06/2016  *
#                      Ultima revisione:    NdK del 08/03/2018  *
#                   ------------------------------------------- *
#                                Autore:    Nicola de Kunovich  *
# ------------------------------------------------------------- *
#                                                               *
# In input  : - nome file 'prf'                                 *
#                                                               *
# In output : - file 'CSV'                                      *
#                                                               *
# ------------------------------------------------------------- *
#                                                               *
# Utilizzo :                                                    *
#                                                               *
# $ t_prf2csv pf999999                                          *
#                                                               *
# ------------------------------------------------------------- *
#                                                               *
# Promemoria : Parametrizzare i moduli per ciascun programma    *
#                                                               *
# ___ ATTUALMENTE SOLO PER 'gep690' ___                         *
#                                                               *
# ___ MA NON UTILIZZATO PER DIFFORMITA' ___                     *
# ___ DAL TRACCIATO STAMPA (18/02/2021)___                      *
#                                                               *
#===============================================================*

#===============================================================*
# Moduli Perl                                                   *
#---------------------------------------------------------------*
# use Spreadsheet::WriteExcel                                  ;

#===============================================================*
# Variabili in input                                            *
#---------------------------------------------------------------*
#   *-----------------------------------------------------------*
#   * Filename 'prf' in input                                   *
#   *-----------------------------------------------------------*
    my $inp_var = $ARGV[0]                                     ;
    
#   *-----------------------------------------------------------*
#   * Help                                                      *
#   *-----------------------------------------------------------*
if (!$ARGV[0] || $ARGV[0] eq "-help")
{
    print "\n"
        . "Uso :"
        . "\n"
        . "> t_prf2csv pf999999"
        . "\n"
        . "\n"
        . "Release : 15/03/2016"
        . "\n"
        . "\n"
        . "(C) Copyright - wip"
        . "\n"
        . "\n"                                                 ;
    exit()                                                     ;
}

#   *-----------------------------------------------------------*
#   * File da trattare                                          *
#   *-----------------------------------------------------------*
    my $num_prf = $ARGV[0]                                     ;
#   *-----------------------------------------------------------*
#   * Separatore CSV                                            *
#   *-----------------------------------------------------------*
    my $sep_csv = ";"                                          ;
#   *-----------------------------------------------------------*
#   * Terminatore CSV                                           *
#   *-----------------------------------------------------------*
    my $ter_csv = "\n"                                         ;
#   *-----------------------------------------------------------*
#   * Percorsi file                                             *
#   *-----------------------------------------------------------*
    my $pth_inp = "/abd/prf/"                                  ;
    my $pth_out = "/abd/asc/"                                  ;
    my $pth_prf = $pth_inp . $num_prf                          ;
    my $fil_num = substr($num_prf, 2, 6)                       ;
#   *-----------------------------------------------------------*
#   * Inizializzazione array parametri                          *
#   *-----------------------------------------------------------*
    my @prm_csv                                                ;
#   *-----------------------------------------------------------*
#   * Inizializzazione contatore righe                          *
#   *-----------------------------------------------------------*
    my $ctr_rig = 0                                            ;
#   *-----------------------------------------------------------*
#   * Inizializzazione flag di prima riga                       *
#   *-----------------------------------------------------------*
    my $flg_rig = ""                                           ;

#===============================================================*
# Trattamento stampa                                            *
#---------------------------------------------------------------*
#   *-----------------------------------------------------------*
#   * Open file in input                                        *
#   *-----------------------------------------------------------*
    open (I_FILE, "$pth_prf") or die
         "Impossibile aprire il file '$pth_prf'"               ;
    my   @linea = <I_FILE>                                     ;

#   *-----------------------------------------------------------*
#   * Ciclo di scansione                                        *
#   *-----------------------------------------------------------*
foreach $linea (@linea)
{
#       *-------------------------------------------------------*
#       * Pulizia linea                                         *
#       *-------------------------------------------------------*
    chomp(@linea)                                              ;
#       *-------------------------------------------------------*
#       * Estrazione tipo record                                *
#       *-------------------------------------------------------*
    my  $tip_rec = substr($linea, 7, 1)                        ;
#       *-------------------------------------------------------*
#       * Trattamento header                                    *
#       *-------------------------------------------------------*
    if  ($tip_rec eq "H")
    {
        &hea_der                                               ;
    }
#       *-------------------------------------------------------*
#       * Trattamento salto pagina                              *
#       *-------------------------------------------------------*
    elsif  ($tip_rec eq "P")
    {
        &pag_ini                                               ;
    }
#       *-------------------------------------------------------*
#       * Trattamento corpo                                     *
#       *-------------------------------------------------------*
    elsif  ($tip_rec eq "I")
    {
        &stp_cor                                               ;
    }
#       *-------------------------------------------------------*
#       * Uscita                                                *
#       *-------------------------------------------------------*
    else
    {
        exit()                                                 ;
    }
}

#===============================================================*
# Close dei file                                                *
#---------------------------------------------------------------*
&inp_cls                                                       ;
&out_cls                                                       ;

#===============================================================*
# SUBROUTINES                                                   *
#===============================================================*

#===============================================================*
# Trattamento header                                            *
#---------------------------------------------------------------*
sub hea_der
{
#   *-----------------------------------------------------------*
#   * Codice utente                                             *
#   *-----------------------------------------------------------*
    $ide_ute = substr($linea, 20, 06)                          ;
    $ide_ute =~ s/\s+$//                                       ;
#   *-----------------------------------------------------------*
#   * Data e ora esecuzione programma                           *
#   *-----------------------------------------------------------*
    $ide_dat = substr($linea, 28, 11)                          ;
#   *-----------------------------------------------------------*
#   * Ampiezza linea                                            *
#   *-----------------------------------------------------------*
    $amp_lin = substr($linea, 83, 03)                          ;
    $amp_lin += 0                                              ;
#   *-----------------------------------------------------------*
#   * Nome programma                                            *
#   *-----------------------------------------------------------*
    $ide_fas = substr($linea, 52, 06)                          ;
    
    
    
#                print $pth_out . "\n";
#                print $ide_ute . "\n";
#                print $ide_fas . "\n";
#                print $ide_dat . "\n";
    
    
#   *-----------------------------------------------------------*
#   * Lettura parametri legati al programma                     *
#   *-----------------------------------------------------------*
    &prm_fas ($ide_fas)                                        ;
#   *-----------------------------------------------------------*
#   * Percorso file di output                                   *
#   *-----------------------------------------------------------*
    my $pth_csv = $pth_out
                . $ide_ute
                . "/exp/"
                . $ide_fas  
                . "_"
                . $ide_dat
                . ".csv"                                       ;
                
#   *-----------------------------------------------------------*
#   * Open file di output                                       *
#   *-----------------------------------------------------------*
    open (O_FILE, ">$pth_csv") or die
         "Impossibile aprire il file '$pth_csv'"               ;
}

#===============================================================*
# Trattamento inizio pagina                                     *
#---------------------------------------------------------------*
sub pag_ini
{
#   *-----------------------------------------------------------*
#   * Inizializzazione contatore righe                          *
#   *-----------------------------------------------------------*
    $ctr_rig = 0                                               ;
}

#===============================================================*
# Trattamento riga                                              *
#---------------------------------------------------------------*
sub stp_cor
{
#   *-----------------------------------------------------------*
#   * Contatore righe                                           *
#   *-----------------------------------------------------------*
    $ctr_rig++                                                 ;
#   *-----------------------------------------------------------*
#   * Estrazione linea utile                                    *
#   *-----------------------------------------------------------*
    my  $lin_stp = substr($linea, 8, $amp_lin)                 ;
#   *-----------------------------------------------------------*
#   * Estrazione numero linea                                   *
#   *-----------------------------------------------------------*
    my  $lin_num = substr($linea, 5, 2)                        ;
#   *-----------------------------------------------------------*
#   * Deviazione in funzione del numero riga                    *
#   *-----------------------------------------------------------*
    if ($lin_num >= $prm_csv[0][3])
    {
        &lin_oth ($lin_stp)                                    ;
    }
}

#===============================================================*
# Trattamento riga successive                                   *
#---------------------------------------------------------------*
sub lin_oth
{
#   *-----------------------------------------------------------*
#   * Linea in input                                            *
#   *-----------------------------------------------------------*
    my $lin_stp = shift                                        ;
#   *-----------------------------------------------------------*
#   * Test se prima riga per fincatura                          *
#   *-----------------------------------------------------------*
    if ($flg_rig eq "")
    {
        $flg_rig = "#"                                         ;
        &int_fil                                               ;
    }
#   *-----------------------------------------------------------*
#   * Estrazione campi                                          *
#   *-----------------------------------------------------------*
    my $fld_cnt = 1                                            ;
    my $lin_out = ""                                           ;
    my @fld_ele                                                ;

    while ($fld_cnt <= $prm_csv[0][2])
    {
#       *-------------------------------------------------------*
#       * Contatore campi da estrarre                           *
#       *-------------------------------------------------------*
        $fld_ele[$fld_cnt] = substr($lin_stp,
                                    $prm_csv[$fld_cnt][3],
                                    $prm_csv[$fld_cnt][2])     ;
        $fld_ele[$fld_cnt] =~ s/\s+$//                         ;
        $fld_ele[$fld_cnt] =~ s/^\s+//                         ;
#       *-------------------------------------------------------*
#       * Assemblaggio                                          *
#       *-------------------------------------------------------*
        $lin_out = $lin_out
                 . "$fld_ele[$fld_cnt]"
                 . "$sep_csv"                                  ;
                 
                 
                 
                print $lin_out . "\n";
                 
                 
                 
#       *-------------------------------------------------------*
#       * Contatore campi da estrarre                           *
#       *-------------------------------------------------------*
        $fld_cnt++                                             ;
    }

#   *-----------------------------------------------------------*
#   * Assemblaggio terminatore                                  *
#   *-----------------------------------------------------------*
    $lin_out = $lin_out . "$ter_csv"                           ;
#   *-----------------------------------------------------------*
#   * Output linea                                              *
#   *-----------------------------------------------------------*
    print O_FILE $lin_out                                      ;
}

#===============================================================*
# Emissione prima riga di fincatura                             *
#---------------------------------------------------------------*
sub int_fil
{
#   *-----------------------------------------------------------*
#   * Normalizzazioni iniziali                                  *
#   *-----------------------------------------------------------*
    my $fld_cnt = 1                                            ;
    my $lin_out = ""                                           ;
    my @fld_ele                                                ;
#   *-----------------------------------------------------------*
#   * Ciclo di emissione labels                                 *
#   *-----------------------------------------------------------*
    while ($fld_cnt <= $prm_csv[0][2])
    {
#       *-------------------------------------------------------*
#       * Assemblaggio                                          *
#       *-------------------------------------------------------*
        $lin_out = $lin_out
                 . "$prm_csv[$fld_cnt][0]"
                 . "$sep_csv"                                  ;
#       *-------------------------------------------------------*
#       * Contatore campi da estrarre                           *
#       *-------------------------------------------------------*
        $fld_cnt++                                             ;
    }
#   *-----------------------------------------------------------*
#   * Assemblaggio terminatore                                  *
#   *-----------------------------------------------------------*
    $lin_out = $lin_out . "$ter_csv"                           ;
#   *-----------------------------------------------------------*
#   * Output linea                                              *
#   *-----------------------------------------------------------*
    print O_FILE $lin_out                                      ;
}

