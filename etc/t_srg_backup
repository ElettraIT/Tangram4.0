#!/usr/bin/perl -w
#==========================================*
# Modulo Perl per backup sorgenti          *
#                                          *
# t_srg_backup                             *
#                                          *
# ---------------------------------------- *
# Versione originale:  001 del 11/01/2022  *
#   Ultima revisione:  NdK del 06/10/2023  *
# ---------------------------------------- *
#             Autore:  Nicola de Kunovich  *
# ---------------------------------------- *
#                                          *
# In crontab, alle 20:30                   *
#                                          *
#==========================================*

#==========================================*
# Moduli Perl                              *
#------------------------------------------*

#==========================================*
# Comando di esecuzione                    *
#------------------------------------------*
my $cmd = "tar cvfz"                      ;
#------------------------------------------*
# Prefisso filename                        *
#------------------------------------------*
my $pre = "SRG_ETC_WEB_"                  ;
#------------------------------------------*
# Postfisso filename                       *
#------------------------------------------*
my $pst = ".TAR.gz"                       ;
#------------------------------------------*
# Directory del file di backup             *
#------------------------------------------*
my $dfb = "/abd/asc/bck/"                 ;
#------------------------------------------*
# Directory da salvare                     *
#------------------------------------------*
my $srg = "/abd/srg"                      ;
my $etc = "/abd/etc"                      ;
my $web = "/abd/web"                      ;

#==========================================*
# Data di sistema - Anno                   *
#------------------------------------------*
my $ann = (localtime)[5]                  ;
my $anu = int($ann)                       ;
   $anu = $anu + 1900                     ;
my $anx = sprintf ("%04d",$anu)           ;
#------------------------------------------*
# Data di sistema - Mese                   *
#------------------------------------------*
my $mes = (localtime)[4]                  ;
my $meu = int($mes)                       ;
   $meu = $meu + 1                        ;
my $mex = sprintf ("%02d",$meu)           ;
#------------------------------------------*
# Data di sistema - Giorno                 *
#------------------------------------------*
my $gio = (localtime)[3]                  ;
my $gix = sprintf ("%02d",$gio)           ;
#------------------------------------------*
# Data di sistema - Formato: AAAAMMGG      *
#------------------------------------------*
my $dat = $anx  . $mex . $gix             ;

#==========================================*
# Comando di esecuzione completo           *
#------------------------------------------*
my $bak = $cmd
        . " "
        . $dfb
        . $pre
        . $dat
        . $pst
        . " "
        . $srg
        . " "
        . $etc
        . " "
        . $web                            ;

#==========================================*
# Esecuzione                               *
#------------------------------------------*
system($bak)                              ;
