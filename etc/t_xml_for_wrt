                #==========================*
                # Dati Dettaglio Pagamento *
                #--------------------------*
                $ele_ddp = $pag->{DettaglioPagamento};
                #
                &trt_ddp ($wrk_pth,
                          $wrk_rec,
                          $wrk_ele,
                          $wrk_ctr,
                          $ele_ddp)       ;
        }
