#!/usr/bin/perl -w
#==========================================*
# Modulo Perl per importare le fattura     *
# in formato XML, ricevute da fornitori,   *
# da scansione lista creata precedente-    *
# mente, su database, dal modulo in        *
# crontab 't_xml_for_imp'                  *
#                                          *
# t_xml_for_wrt {AZI}                      *
#                                          *
# ---------------------------------------- *
#                                          *
# PROMEMORIA : Migliorare 'CDATA'          *
#                                          *
# ---------------------------------------- *
#                                          *
# Versione Fattura PA 1.2.1                *
#                                          *
# ---------------------------------------- *
# Versione originale:   001 del 17/02/18   *
#   Ultima revisione:   wip del 07/08/23   *
# ---------------------------------------- *
#             Autore:   Nicola de Kunovich *
# ---------------------------------------- *
#                                          *
# In input       : - codice azienda        *
#                                          *
# (Configurazione: - 't_xml_for.ini'       *
#                  - 'dtb.ini')            *
#                                          *
# (LOG           : - 't_xml_for_wrt.log'   *
#                                          *
# N.B.: Utilizzato da 'pscf8000'           *
#                                          *
# ---------------------------------------- *
# Per creare il database                   *
#                                          *
# CREATE TABLE `{AZI}`.`xml_frr` (         *
# `nam_xml` varchar(40) NOT NULL,          *
# `tip_rec` tinytext NOT NULL,             *
# `tip_ele` varchar(5) NOT NULL,           *
# `ctr_ele` varchar(5) NOT NULL,           *
# `pmt_ele` varchar(60) NOT NULL,          *
# `val_ele` mediumtext NOT NULL,           *
# `dat_imp` datetime NOT NULL              *
# ) ENGINE = MYISAM;                       *
#------------------------------------------*

#==========================================*
# Moduli Perl                              *
#------------------------------------------*
use DBI()                                 ;
use File::Basename                        ;
use XML::Simple                           ;
use MIME::Base64 qw(decode_base64)        ;
use utf8                                  ;
use Unicode::Normalize                    ;

#=========================================*
# Valori in input                         *
#-----------------------------------------*
my $cod_azi = shift                       ;

#==========================================*
# Variabili definite                       *
#------------------------------------------*
#------------------------------------------*
# Directory di configurazione base         *
#------------------------------------------*
my $cfg_bas = "/abd/asc/cfg/"
            . "t_xml_for.ini"             ;

my %cnf_ele = do $cfg_bas                 ;
my $pth_scf = $cnf_ele{pth_scf}           ;
my $pth_bas = $cnf_ele{pth_bas}           ;
my $pth_tmp = $cnf_ele{pth_tmp}           ;
my $pth_att = $cnf_ele{pth_att}           ;
#------------------------------------------*
# Parametri di connessione al database     *
#------------------------------------------*
my $dtb_azi = $cod_azi                    ;
#
my $cfg_dtb = "/abd/asc/cfg/dtb.ini"      ;
#
my %cnf_dtb = do $cfg_dtb                 ;
my $dtb_hst = $cnf_dtb{dtb_hst}           ;
my $dtb_usr = $cnf_dtb{dtb_usr}           ;
my $dtb_pwd = $cnf_dtb{dtb_pwd}           ;
my $dtb_tbt = $cnf_dtb{dtb_tbt}           ;
my $dtb_tbr = $cnf_dtb{dtb_tbr}           ;
#------------------------------------------*
# Data di sistema                          *
#------------------------------------------*
my @months   = qw(Gen Feb Mar Apr Mag Giu Lug Ago Set Ott Nov Dic);
my @weekDays = qw(Dom Lun Mar Mer Gio Ven Sab Dom)         ;
my ($second,
    $minute,
      $hour,
$dayOfMonth,
     $month,
$yearOffset,
 $dayOfWeek,
 $dayOfYear,
$daylightSavings) = localtime()           ;
    $year = 1900 + $yearOffset            ;
    $theTime = "$hour:$minute:$second, "
             . "$weekDays[$dayOfWeek] "
             . "$months[$month] "
             . "$dayOfMonth, $year"       ;
#==========================================*
# Open file di LOG                         *
#------------------------------------------*
my $log_fil = $pth_bas
            . 'log/t_xml_for_wrt.log'     ;
open (LOG_FIL, ">>$log_fil") or die 
        "Impossibile aprire '$log_fil'"   ;

#==========================================*
# Connessione database                     *
#------------------------------------------*
my $dtb_con = DBI->connect("DBI:"
                         . "mysql:database="
                         . "$dtb_azi;"
                         . "host=$dtb_hst",
                                  $dtb_usr,
                                  $dtb_pwd,
                          {RaiseError => 1,
                           PrintError => 0});

#------------------------------------------*
# Lettura database                         *
#------------------------------------------*
my $sel_dtb = "SELECT nam_xml FROM "
            . $dtb_tbt
            . " WHERE dat_sql = '0'"      ;
my $sth_dtb = $dtb_con->prepare($sel_dtb) ;
#------------------------------------------*
# Esecuzione                               *
#------------------------------------------*
$sth_dtb->execute()                       ;

#------------------------------------------*
# Ciclo di scansione                       *
#------------------------------------------*
    #--------------------------------------*
    # Righe tabella                        *
    #--------------------------------------*
    while (@row = $sth_dtb->fetchrow_array) 
    {
        #----------------------------------*
        # Estrazione nome file             *
        #----------------------------------*
       (my $fil_nam,
        my $fil_pat,
        my $fil_ext) = fileparse($row[0], qr/\.[^.]*/);
        #----------------------------------*
        # Test se file cryptato            *
        #----------------------------------*
        if ($fil_ext eq ".p7m" || $fil_ext eq ".P7M")
        {$xml_nam = $fil_nam;}
         else
        {$xml_nam = $fil_nam . $fil_ext;}
        #----------------------------------*
        # Check preliminare                *
        #----------------------------------*
        my $chk_xml = XML::Simple->new()  ;
        my $chk_pat = $pth_tmp
                    . $xml_nam            ;
        #----------------------------------*
        # Se check fallito                 *
        #----------------------------------*
        my $chk_dat = eval{XMLin($chk_pat)};
        if ($@) 
        { 
            print LOG_FIL $xml_nam
                        . " : Errore - $@"
                        . "\n"            ;
            next                          ;
        }
        
        #----------------------------------*
        # Estrazione dei valori            *
        #----------------------------------*
        &wrt_xml ($xml_nam)               ;
        #----------------------------------*
        # Aggiornamento data               *
        #----------------------------------*
        &upd_xml ($row[0])                ;
        #----------------------------------*
        # Scrittura LOG                    *
        #----------------------------------*
        print LOG_FIL "Scrittura file : "
             . $theTime
             . " - "
             . $xml_nam
             . "\n"                       ;
    }

#------------------------------------------*
# Chiusura database                        *
#------------------------------------------*
$dtb_con->disconnect()                    ;

#==========================================*
# Close file di LOG                        *
#------------------------------------------*
close LOG_FIL                             ;

#------------------------------------------*
# Fine script                              *
#==========================================*

#==========================================*
# Subroutines                              *
#==========================================*

