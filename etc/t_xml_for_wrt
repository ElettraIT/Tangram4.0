#==========================================*
# Composizione prompt, valore ed eventuale *
# descrizione                              *
#------------------------------------------*
sub out_val
{
    #======================================*
    # Valori in input                      *
    #--------------------------------------*
    my $nam = shift                       ;
    my $rec = shift                       ;
    my $tip = shift                       ;
    my $ctr = shift                       ;
    my $pmt = shift                       ;
    my $val = shift                       ;
    #--------------------------------------*
    # Trattamento contatore elemento       *
    #--------------------------------------*
    if (!$ctr){$ctr =""}                  ;
    #--------------------------------------*
    # Trattamento valore                   *
    #--------------------------------------*
    if (!$val){return}                    ;
    #--------------------------------------*
    # Eliminazione eventuali caratteri     *
    # accentati valore                     *
    #--------------------------------------*
    my $wrk = NFKD($val)                  ;
       $wrk =~ s/\p{NonspacingMark}//g    ;
       $val = $wrk                        ;
    #--------------------------------------*
    # Eliminazione eventuali caratteri     *
    # strani                               *
    #--------------------------------------*
    $val=~s/[^\x00-\x7f]//g               ;
    #--------------------------------------*
    # Eliminazione spazi superflui valore  *
    #--------------------------------------*
    $val =~ s/^\s+|\s+$//g                ;
    #--------------------------------------*
    # Pulizia eventuali CR o LF o TAB      *
    #--------------------------------------*
    my $str = &pul_str($val)              ;
    #--------------------------------------*
    # Pulizia eventuali ' valore           *
    #--------------------------------------*
    my $qvl = $dtb_con->quote($str)       ;
    #--------------------------------------*
    # Scrittura                            *
    #--------------------------------------*
    my $ins_dat = "INSERT INTO "
                . $dtb_tbr
                . " (nam_xml, "
                . "tip_rec, "
                . "tip_ele, "
                . "ctr_ele, "
                . "pmt_ele, "
                . "val_ele, "
                . "dat_imp) "
                . " VALUES ('"
                . $nam
                . "', '"
                . $rec
                . "', '"
                . $tip
                . "', '"
                . $ctr
                . "', '"
                . $pmt
                . "',"
                . $qvl
                . ", NOW())"              ;
    #--------------------------------------*
    # Preparazione                         *
    #--------------------------------------*
    my $sth_dtb = $dtb_con->prepare($ins_dat);
    #--------------------------------------*
    # Esecuzione                           *
    #--------------------------------------*
    $sth_dtb->execute()                   ;
    #--------------------------------------*
    # FINE SUBROUTINE - Scrittura dati     *
    #======================================*
}

#==========================================*
# Pulizia stringa da eventuali CR o LF     *
#------------------------------------------*
sub pul_str
{
    #======================================*
    # Valori in input                      *
    #--------------------------------------*
    my $wrk_str = shift                   ;
    #--------------------------------------*
    # Rimozione CR e LF a fine linea       *
    #--------------------------------------*
    chomp($wrk_str)                       ;
    #--------------------------------------*
    # Rimozione CR e LF                    *
    #--------------------------------------*
    $wrk_str =~ s/(\\r)|(\\n)|(\\)//g     ;
    $wrk_str =~ s/(\r)|(\n)|(\\)//g       ;
    #--------------------------------------*
    # Rimozione caratteri non alfanumerici *
    #--------------------------------------*
    $wrk_str =~ s/[^[:print:]]+//g        ;
    #--------------------------------------*
    # Rimozione schifezze                  *
    #--------------------------------------*
    $wrk_str=~s/\r//gs                    ;
    $wrk_str=~s/\t+//gs                   ;
    $wrk_str=~s/\n+//gs                   ;
    $wrk_str=~s/ +/ /gs                   ;
    #--------------------------------------*
    # Valore in uscita                     *
    #--------------------------------------*
    return $wrk_str                       ;
    #--------------------------------------*
    # FINE SUBROUTINE - Pulizia stringa    *
    #======================================*
}

#==========================================*
# Aggiornamento tabella testate            *
#------------------------------------------*
sub upd_xml
{
    #======================================*
