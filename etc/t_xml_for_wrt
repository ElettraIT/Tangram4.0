        #----------------------------------*
        # Contatore elementi               *
        #----------------------------------*
        $loc_ctr++                        ;
        $wrk_ctr = sprintf "%05d", $loc_ctr;
        #----------------------------------*
        # Condizioni Pagamento             *
        #----------------------------------*
