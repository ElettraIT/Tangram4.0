     ############ /abd/etc/mvpul
     #
     # Procedura per rinominare i file generati dalle "pulizie"
     #
     # N.B.: da eseguire nella directory '/abd/azi/AZIENDA'
     #
     ######

# area 'cge'
if [ -f mgr.pul ]
   then
      mv mgr.pul mgr
      mv mgt.pul mgt
      mv mgs.pul mgs
      mv mgi.pul mgi
      mv ali.pul ali
      mv ivp.pul ivp
      mv rdb.pul rdb
      echo "                            " ;
      echo "----------------------------" ;
      echo "  Archivi 'cge' aggiornati  " ;
      echo "----------------------------" ;
      echo "                            " ;
   fi

