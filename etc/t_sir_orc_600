# ------------------------------------------------------------- *
#                                                               *
# Parametri in input : - dati per LOG                           *
#                                                               *
#---------------------------------------------------------------*

#===============================================================*
# Moduli Perl                                                   *
#---------------------------------------------------------------*

#===============================================================*
# Variabili statiche                                            *
#---------------------------------------------------------------*
#   *-----------------------------------------------------------*
#   * Percorsi file                                             *
#   *-----------------------------------------------------------*
    my $log_fil = "/abd/asc/log/t_sir_orc_600.log"             ;
#   *-----------------------------------------------------------*
#   * Parametri in input                                        *
#   *-----------------------------------------------------------*
    my $prm_log = $ARGV[0]                                     ;
#   *-----------------------------------------------------------*
#   * Separazione dei componenti (;)                            *
#   *-----------------------------------------------------------*
    my @prm = split(/,/, $prm_log)                             ;
    my $num_doc = $prm[0]                                     ;
    my $num_prg = $prm[1]                                     ;
    my $cod_cli = $prm[2]                                     ;
    my $dcn_ric = $prm[3]                                     ;
    my $dcn_prv = $prm[4]                                     ;
    my $dcn_cnf = $prm[5]                                     ;
    my $dat_clc = $prm[6]                                     ;
    my $dat_ela = $prm[7]                                     ;
    my $alf_pro = $prm[8]                                     ;

#===============================================================*
# Open file di LOG                                              *
#---------------------------------------------------------------*
#   *-----------------------------------------------------------*
#   * Open                                                      *
#   *-----------------------------------------------------------*
    open (LOG_FIL, ">>$log_fil") or die
        "Impossibile aprire '$log_fil'"                        ;
#   *-----------------------------------------------------------*
#   * Intestazione LOG                                          *
#   *-----------------------------------------------------------*
    print LOG_FIL "==============================\n"           ; 
    print LOG_FIL "Elaborazione : " . $dat_ela . "\n"          ; 
    print LOG_FIL "Num. ordine  : " . $num_doc . "\n"          ; 
    print LOG_FIL "Riga ordine  : " . $num_prg . "\n"          ; 
    print LOG_FIL "Cliente      : " . $cod_cli . "\n"          ; 
    print LOG_FIL "Prodotto     : " . $alf_pro . "\n"          ; 
    print LOG_FIL "-------------- \n"                          ; 
    print LOG_FIL "Richiesta    : " . $dcn_ric . "\n"          ; 
    print LOG_FIL "Prevista     : " . $dcn_prv . "\n"          ; 
    print LOG_FIL "Confermata   : " . $dcn_cnf . "\n"          ; 
    print LOG_FIL "CALCOLATA    : " . $dat_clc . "\n"          ; 

#===============================================================*
# Close file di LOG                                             *
#---------------------------------------------------------------*
close LOG_FIL                                                  ;

#===============================================================*
# SUBROUTINES                                                   *
#===============================================================*

