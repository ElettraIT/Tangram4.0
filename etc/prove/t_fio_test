#!/usr/bin/perl -w
#===============================================================*
#                                                               *
# Parser file di tipo CSV                                       *
#                                                               *
# ------------------------------------------------------------- *
#                                                               *
# Parametri in input : - file CSV da tradurre (percorso)        *
#                                                               *
#                   ------------------------------------------- *
#                    Versione originale:    001 del 07/10/09    *
#                      Ultima revisione:    NdK del 06/04/11    *
#                   ------------------------------------------- *
#                                Autore:    Nicola de Kunovich  *
# ------------------------------------------------------------- *
# SU MISURA PER ZATTI : Traduzione file da Tedesco a ASCII      *
# ------------------------------------------------------------- *
#                                                               *
# Utilizzo :                                                    *
#                                                               *
# $ t_zat_csv /percorso/FILE                                    *
#                                                               *
# Pulizia preliminare CR in '/abd/asc/imp/new.csv'              *
#                                                               *
# Output in file temporaneo '/abd/asc/imp/FILE_IT.CSV'          *
#                                                               *
# ------------------------------------------------------------- *
#                                                               *
# Utilizzato dal programma 'pgpz2200'                           *
#                                                               *
#===============================================================*

#===============================================================*
# Dichiarazione per restrizione variabili                       *
#---------------------------------------------------------------*
use strict                                                     ;

#===============================================================*
# Moduli Perl                                                   *
#---------------------------------------------------------------*
use Lingua::DE::ASCII                                          ;
use Text::CSV                                                  ;

#===============================================================*
# Lettura della variabile in input                              *
#---------------------------------------------------------------*
my $fil = $ARGV[0]                                             ;

#===============================================================*
# Variabili di appoggio                                         *
#---------------------------------------------------------------*
my $inp = "/abd/asc/tmp/liscli.txt"                            ;
my $out = "/abd/asc/tmp/liscli.csv"                            ;

#===============================================================*
# Open del file in input                                        *
#---------------------------------------------------------------*
&f_input                                                       ;

#===============================================================*
# Open del file in output                                       *
#---------------------------------------------------------------*
&f_output                                                      ;

#===============================================================*
# Trattamento file                                              *
#---------------------------------------------------------------*
#    *----------------------------------------------------------*
#    * Normalizzazione contatore righe                          *
#    *----------------------------------------------------------*
my $row = 0                                                    ;
#    *----------------------------------------------------------*
#    * Ciclo di scansione                                       *
#    *----------------------------------------------------------*
while (<I_FILE>)
{
#        *------------------------------------------------------*
#        * Pulizia fine riga                                    *
#        *------------------------------------------------------*
    chomp                                                      ;
    
#        *------------------------------------------------------*
#        * Split della riga                                     *
#        *------------------------------------------------------*
    my @Fld = split(';', $_)                                   ;

#        *------------------------------------------------------*
#        * Emissione della riga                                 *
#        *------------------------------------------------------*
    print O_FILE "$Fld[0]"
               . ";"
               . "$Fld[1]"
               . ";"
               . "$Fld[8]\n"                                  ;
#        *------------------------------------------------------*
#        * Incremento riga                                      *
#        *------------------------------------------------------*
    $row++                                                     ;
}

#===============================================================*
# Chiusura file input                                           *
#---------------------------------------------------------------*
close I_FILE                                                   ;

#===============================================================*
# Chiusura file output                                          *
#---------------------------------------------------------------*
close O_FILE                                                   ;

#===============================================================*
# Apertura file da trattare                                     *
#---------------------------------------------------------------*
sub f_input
{
    open (I_FILE, "$inp") or die
         "Impossibile aprire il file '$inp'"                   ;
}

#===============================================================*
# Apertura file da trattare                                     *
#---------------------------------------------------------------*
sub f_output
{
    open (O_FILE, ">$out") or die
         "Impossibile aprire il file '$out'"                   ;
}

