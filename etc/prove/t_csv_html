#!/usr/bin/perl -w
#===============================================================*
#                                                               *
# Parser file di tipo CSV con output HTML                       *
#                                                               *
# ------------------------------------------------------------- *
#                                                               *
# Parametri in input : - file CSV da tradurre (percorso)        *
#                                                               *
#                   ------------------------------------------- *
#                    Versione originale:    001 del 27/05/13    *
#                      Ultima revisione:    NdK del 27/05/13    *
#                   ------------------------------------------- *
#                                Autore:    Nicola de Kunovich  *
# ------------------------------------------------------------- *
#                                                               *
# Utilizzo :                                                    *
#                                                               *
# $ t_csv_html /percorso/FILE                                   *
#                                                               *
#===============================================================*
 
#===============================================================*
# Moduli Perl                                                   *
#---------------------------------------------------------------*
use CGI qw(:standard)                                          ;
use strict                                                     ;
use warnings                                                   ;

#===============================================================*
# Lettura della variabile in input                              *
#---------------------------------------------------------------*
my $csv = $ARGV[0]                                             ;

#===============================================================*
# Variabili statiche                                            *
#---------------------------------------------------------------*
my $out = "/abd/web/htm/csv_conv.html"                         ;

#===============================================================*
# Open del file in input                                        *
#---------------------------------------------------------------*
&f_input                                                       ;

#===============================================================*
# Open del file in output                                       *
#---------------------------------------------------------------*
&f_output                                                      ;

#===============================================================*
# Trattamento file                                              *
#---------------------------------------------------------------*
    #-----------------------------------------------------------*
    # Emissione testata HTML                                    *
    #-----------------------------------------------------------*
    print O_FILE "<html>"                                      ;
    print O_FILE "<head>"                                      ;
    print O_FILE "</head>"                                     ;
    print O_FILE "<body bgcolor='#333333'>"                    ;
    print O_FILE "<title>HTML Report</title>"                  ;
    print O_FILE "<div align='left'>"                          ;
    print O_FILE "<table border='1' "
               . "cellpadding='5' "
               . "cellspacing='0' "
               . "width='100%' height='100%'>"                 ;
 
    #-----------------------------------------------------------*
    # Normalizzazione contatore righe                           *
    #-----------------------------------------------------------*
    my $row = 0                                                ;
    #-----------------------------------------------------------*
    # Ciclo di scansione                                        *
    #-----------------------------------------------------------*
    while (<I_FILE>)
    {
        #-------------------------------------------------------*
        # Pulizia fine riga                                     *
        #-------------------------------------------------------*
        chomp                                                  ;
        #-------------------------------------------------------*
        # Split della riga                                      *
        #-------------------------------------------------------*
        my @Fld = split(',', $_)                               ;
        #-------------------------------------------------------*
        # Contatore "campi" della riga                          *
        #-------------------------------------------------------*
        my $elem  = $#Fld+1                                    ;
        #-------------------------------------------------------*
        # Contatore nr. riga                                    *
        #-------------------------------------------------------*
        my $riga  = $row+1                                     ;
        #-------------------------------------------------------*
        # Emissione della riga: contatore                       *
        #-------------------------------------------------------*
        print O_FILE "<tr>"                                    ;

        print O_FILE "<td bgcolor='#666666'>"
                   . "<font size='3'>$riga</td>"               ;

        #-------------------------------------------------------*
        # Emissione della riga: ciclo per 'n' elementi          *
        #-------------------------------------------------------*
        my $inx = 0                                            ;
        my $clean = ""                                         ;

        for($inx=0; $inx<$elem; $inx++)
        {

            #---------------------------------------------------*
            # Pulizia eventuali virgolette                      *
            #---------------------------------------------------*
            $clean = $Fld[$inx]                                ;
            $clean =~ s/"//g                                   ;
            #---------------------------------------------------*
            # Scrittura elemento tabella                        *
            #---------------------------------------------------*
            print O_FILE "<td bgcolor='#666666'>"
                       . "<font size='3'>$clean</td>"          ;
        }
        print O_FILE "</tr>"                                   ;
        #-------------------------------------------------------*
        # Incremento riga                                       *
        #-------------------------------------------------------*
    $row++                                                     ;
}

#===============================================================*
# Chiusura HTML                                                 *
#---------------------------------------------------------------*
print O_FILE "</table>"                                        ;
print O_FILE "</body>"                                         ;
print O_FILE "</html>"                                         ;

#===============================================================*
# Apertura file da trattare                                     *
#---------------------------------------------------------------*
sub f_input
{
    open (I_FILE, "$csv.csv") or die
         "Impossibile aprire il file '$csv.csv'"               ;
}

#===============================================================*
# Apertura file da trattare                                     *
#---------------------------------------------------------------*
sub f_output
{
    open (O_FILE, ">$out") or die
         "Impossibile aprire il file '$out'"                   ;
}

#===============================================================*
# Chiusura file da trattare                                     *
#---------------------------------------------------------------*
close I_FILE                                                   ;

#===============================================================*
# Chiusura file output                                          *
#---------------------------------------------------------------*
close O_FILE                                                   ;

