#==========================================*
# Variabili di configurazione              *
#------------------------------------------*
my $dkbu = 'dkb'                          ;
my $dkbp = 'cavallo'                      ;
my $base = '/abd/asc/'                    ;
my $path = '/tmp/'                        ;
my $host = 'www.dkb.it'                   ;
my $dkbd = 'dkb.it/chart/'                ;
my $http = 'http://www.dkb.it/'
         . 'chart/t_engine.html?CT='      ;

#==========================================*
# Sub-routine di trasferimento file        *
#------------------------------------------*
my $link = &ftpf                          ;

#==========================================*
# Sub-routine di invio mail a utente       *
#------------------------------------------*
if ($isps && $ieml)
{
    &inmu($link)                          ;
}

#==========================================*
# SUB-ROUTINES                             *
#==========================================*

#==========================================*
# Subroutine di trasferimento del file     *
#------------------------------------------*
sub ftpf
{
    #--------------------------------------*
    # Comodo per errori                    *
    #--------------------------------------*
    my $erra=0                            ;

    #--------------------------------------*
    # Determinazione nomi cartelle e file  *
    #--------------------------------------*
    my $md5a = md5_hex($azie)             ;
    my $md5u = md5_hex($user)             ;

    my $dest = $dkbd
             . $md5a
             . $md5u                      ;

    my $fnam = $md5a
             . $md5u                      ;

    my $fput = $base
             . $user
             . $path
             . $azie
             . "_"
             . $file                      ;

    #--------------------------------------*
    # (Debug)                              *
    #--------------------------------------*
    # print $dest . "\n"                    ;
    # print         "\n"                    ;
    # print $fput . "\n"                    ;

    #--------------------------------------*
    # Apertura connessione                 *
    #--------------------------------------*
    $ftp = Net::FTP->new("www17.protec.it",
                         Debug => 0)
           or die "Non connesso a: $@"    ;

    #--------------------------------------*
    # Login connessione                    *
    #--------------------------------------*
    $ftp->login($dkbu,$dkbp)
          or die "Login errato ",
                 $ftp->message            ;

    #--------------------------------------*
    # Posizionamento cartella destinazione *
    #--------------------------------------*
    $ftp->cwd($dest) or $erra=1           ;

    if ($erra)
    {
        #----------------------------------*
        # Creazione directory              *
        #----------------------------------*
        &crea($fnam)                      ;
    }

    #--------------------------------------*
    # Posizionamento cautelativo           *
    #--------------------------------------*
    $ftp->cwd($dest) or $erra=2           ;

    #--------------------------------------*
    # Modalita' Binary                     *
    #--------------------------------------*
    $ftp->binary
          or die "Binary NO",
                 $ftp->message            ;

    #--------------------------------------*
    # Trasferimento                        *
    #--------------------------------------*
    $ftp->put($fput)
          or die "put fallita ",
                 $ftp->message            ;

    #--------------------------------------*
    # Chiusura FTP                         *
    #--------------------------------------*
    $ftp->quit                            ;

    #--------------------------------------*
    # Link in uscita                       *
    #--------------------------------------*
    return $fnam                          ;

}

#==========================================*
# Subroutine di creazione directory        *
#------------------------------------------*
sub crea
{
    #--------------------------------------*
    # Nome della cartella da creare        *
    #--------------------------------------*
    my $cred = shift @_                   ;

    #--------------------------------------*
    # Posizionamento cartella destinazione *
    #--------------------------------------*
    $ftp->cwd($dkbd)
          or die "Posizionamento 2 NO",
                 $ftp->message            ;
                 
    #--------------------------------------*
    # Creazione cartella destinazione      *
    #--------------------------------------*
    $ftp->mkdir($cred)
          or die "Creazione fallita",
                 $ftp->message            ;
}

#==========================================*
# Subroutine di invio mail a utente        *
#------------------------------------------*
sub inmu
{
    #--------------------------------------*
    # Modulo PERL di invio mail            *
    #--------------------------------------*
    use MIME::Lite                        ;

    #--------------------------------------*
    # Link da subroutine di trasferimento  *
    #--------------------------------------*
    my $lnkw = shift @_                   ;

    $lnkw    = $http
             . $ctyp
             . '&ID='
             . $lnkw
             . '/'
             . $azie
             . '_'
             . $file                      ;
    
    #--------------------------------------*
    # (Debug)                              *
    #--------------------------------------*
    #print $lnkw . "\n"                   ;
    
    #--------------------------------------*
    # Composizione soggetto                *
    #--------------------------------------*
    my $subj = "Grafico TANGRAM - "
             . $file                      ;

    #--------------------------------------*
    # Messaggio di posta                   *
    #--------------------------------------*
    $msg = MIME::Lite->new(
           From     =>$ieml,
           To       =>$ieml,
           Subject  =>$subj,
           Data     =>$lnkw)              ;

    #--------------------------------------*
    # Invio                                *
    #--------------------------------------*
    $msg->send('smtp', $isps, Timeout=>60);
}