#!/bin/sh
#========================================================================*
#                                                                        *
# NON FUNZIONA NEMMENO RICHIAMATO !!!                                    *
#                                                                        *
#                                                                        *
# Comando batch generico per Tangram da richiamare (/abd/etc)            *
#                                                                        *
# ---------------------------------------------------------------------- *
#                                                                        *
# Parametri in input : AZIENDA, UTENTE, PROGRAMMA (percorso)             *
#                                                                        *
# ---------------------------------------------------------------------- *
#                                                                        *
# Utilizzo :                                                             *
#                                                                        *
# $ t_batch AZIENDA UTENTE PROGRAMMA                                     *
#                                                                        *
# Esempio :                                                              *
#                                                                        *
# $ t_batch prv master swd/xpg/prg/obj/pxpg7000                          *
#                                                                        *
# NON FUNZIONA CON crontab ! Si mangia i parametri ....                  *
#                                                                        *
# MAILTO=""                                                              *
# *  *  *  *  *   t_batch prv master swd/xpg/prg/obj/pxpg7000 > log.log  *
#                                                                        *
#========================================================================*

######
# Preparazione esecuzione
###

#
# Set della nuova umask
#
umask 022;

#
# Posizionamento sulla directory di base per oggetti
#
cd /abd/ogt;

######
# Preparazione variabili per Acucobol
###

#
# Tipo di terminale
#
A_TERM="none"; export A_TERM;

#
# File di terminal capabilities
#
A_TERMCAP="../run/webtermcap"; export A_TERMCAP;

#
# File di configurazione Runtime Acucobol
#
A_CONFIG="../run/webcblcfg"; export A_CONFIG;

######
# Preparazione variabili per esecuzione 'TANGRAM'
###

#
# Directory di base 'abd'
#
V_DKB_HOME="/abd"; export V_DKB_HOME;

#
# Real User-Id
#
V_DKB_USER="`whoami`"; export V_DKB_USER;

#
# Codice del terminale
#
altervx71="`tty`";
V_DKB_TTYC="`basename $altervx71`"; export V_DKB_TTYC;

#
# Tipo di terminale utilizzato
#
V_DKB_TERM="vt300"; export V_DKB_TERM;

#
# Tipo di runtime utilizzato : Acucobol
#
V_DKB_RUNT="00"; export V_DKB_RUNT;

#
# Process-ID unico
#
V_DKB_GETP="`/abd/run/getpid`"; export V_DKB_GETP;

#
# Variabili TANGRAM
#

V_DKB_SUBT=""; export V_DKB_SUBT;
V_DKB_AZIE=$1; export V_DKB_AZIE;
V_DKB_UTEN=$2; export V_DKB_UTEN;
V_DKB_PRMS=$3; export V_DKB_PRMS;

######
# Lancio del runtime Acucobol
###

#
# Normalizzazione parametro POST
#

V_DKB_POST="S"; export V_DKB_POST;

#
# Esecuzione TANGRAM in foreground
#
/abd/run/runcbl -x swd/xpg/prg/obj/pxpgcg00 "$V_DKB_HOME" "$V_DKB_USER" "$V_DKB_TTYC" "$V_DKB_TERM" "$V_DKB_RUNT" "$V_DKB_GETP" "$V_DKB_SUBT" "$V_DKB_AZIE" "$V_DKB_UTEN" "$V_DKB_PRMS" "$V_DKB_POST";

######
# - Fine procedura
###