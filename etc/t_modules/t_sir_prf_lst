#!/usr/bin/perl -w
#==========================================*
# Modulo Perl per FTP                      *
#                                          *
# t_sir_prf_lst                            *
#                                          *
# Per controllare Print File Catalog (PRF) *
#                                          *
# Ultimo aggiornamento 23/01/09            *
# ---------------------------------------  *
#                                          *
# Funzionalita' del modulo:                *
#                                          *
# scansione della directory e per ciascun  *
# file di testo contenuto si legge la pri- *
# ma riga dalla quale si estraggono alcune *
# porzioni di testo a posizione fissa      *
#                                          *
#------------------------------------------*

#==========================================*
# Pathname directory                       *
#------------------------------------------*
my $dir = "/abd/prf/"                     ;

#==========================================*
# Open directory                           *
#------------------------------------------*
opendir (DIR,$dir)                        ;

#==========================================*
# Scansione directory di base              *
#------------------------------------------*
foreach $nam (sort readdir(DIR))
{
    #--------------------------------------*
    # Variabili di comodo                  *
    #                                      *
    # Si utilizza la funzione stat che     *
    # ritorna informazioni sul file in     *
    # forma di array                       *
    #--------------------------------------*
    my $fil = $dir . $nam                 ;
    my @time = stat($fil)                 ;            
    my $tim = $time[9]                    ;            
        
    #--------------------------------------*
    # Se non e' una directory              *
    #--------------------------------------*
    if (! -d $fil)
    {
        #----------------------------------*
        # Estrazione della data            *
        #----------------------------------*
        my $aaa = 1900+(localtime($tim))[5];
        my $mmm = (localtime($tim))[4]    ;
        my $ggg = (localtime($tim))[3]    ;
        
        my $ann  = sprintf ("%04d",$aaa)  ;
        my $mes  = sprintf ("%02d",$mmm+1);
        my $gio  = sprintf ("%02d",$ggg)  ;
        
        my $day = $ann
                . "-"
                . $mes
                . "-"
                . $gio                    ;
        #----------------------------------*
        # Lettura del file                 *
        #----------------------------------*
        &read_file($fil)                  ;                    
        #----------------------------------*
        # Estrazione utente                *
        #----------------------------------*
        my $prf = substr($text[0],20,8)   ;
        #----------------------------------*
        # Visualizzazione                  *
        #----------------------------------*
        print "$day $fil $prf\n"          ;
    }
}
    
#==========================================*
# Close directory                          *
#------------------------------------------*
closedir (DIR)                            ;

#==========================================*
# Apertura file                            *
#------------------------------------------*
sub read_file
{
    #--------------------------------------*
    # Path del file in input               *
    #--------------------------------------*
    my $pth = shift                       ;
    #--------------------------------------*
    # Path del file in input               *
    #--------------------------------------*
    open (PRF, "$pth")or die
         "Impossibile aprire '$pth'"      ;
    @text=<PRF>                           ;
    #--------------------------------------*
    # Path del file in input               *
    #--------------------------------------*
    close PRF                             ;
}

