#===============================================================#
# Subroutine per disegnare un box                               #
#                                                               #
# In Input : - coordinata X                                     #
#            - coordinata Y                                     #
#            - lunghezza (mm)                                   #
#            - altezza (mm)                                     #
#            - raggio angoli (mm)                               #
#            - spessore linee (mm)                              #
#            - colore                                           #
#---------------------------------------------------------------#
sub draw_box
{
#   #-----------------------------------------------------------#
#   # Variabili da chiamante                                    #
#   #-----------------------------------------------------------#
    my $x = shift;
    my $y = shift;
    my $l = shift;
    my $a = shift;
    my $r = shift;
    my $s = shift;
    my $c = shift;
#   #-----------------------------------------------------------#
#   # Spessore linea                                            #
#   #-----------------------------------------------------------#
    $p->setlinewidth($s)                                       ;
#   #-----------------------------------------------------------#
#   # Colore                                                    #
#   #-----------------------------------------------------------#
    $p->setcolour($c)                                          ;
#   #-----------------------------------------------------------#
#   # Test se angoli curvi                                      #
#   #-----------------------------------------------------------#
    if ($r == 0)
    {
#       #-------------------------------------------------------#
#       # Box rettangolare                                      #
#       #-------------------------------------------------------#
        $p->box($x, $y, $x+$l, $y+$a)                          ;
    }
     else
    {
#       #-------------------------------------------------------#
#       # Linee Box                                             #
#       #-------------------------------------------------------#
        $p->line($x+$r, $y, $x+$l-$r, $y)           ; # linea in basso
        $p->line($x+$r, $y+$a, $x+$l-$r, $y+$a)     ; # linea in alto
        $p->line($x, $y+$r, $x, $y+$a-$r)           ; # linea a sinistra
        $p->line($x+$l, $y+$r, $x+$l, $y+$a-$r)     ; # linea a destra
#       #-------------------------------------------------------#
#       # Angoli Box                                            #
#       #-------------------------------------------------------#
        $p->arc($x+$r, $y+$r, $r, 180, 270)         ; # angolo in basso a sinistra
        $p->arc($x+$l-$r, $y+$r, $r, 270, 360)      ; # angolo in basso a destra
        $p->arc($x+$r, $y+$a-$r, $r, 90, 180)       ; # angolo in alto a sinistra
        $p->arc($x+$l-$r, $y+$a-$r, $r, 0, 90)      ; # angolo in alto a destra
    }
}

#===============================================================*
# Trattamento EPS                                               *
#---------------------------------------------------------------*
sub inc_eps
{
#   *-----------------------------------------------------------*
#   * Valori in input                                           *
#   *-----------------------------------------------------------*
    my $x = shift;
    my $y = shift;
    my $l = shift;
    my $a = shift;
#   *-----------------------------------------------------------*
#   * Percorso file barcode EPS                                 *
#   *-----------------------------------------------------------*
    $pth_eps = "/abd/asc/tmp/wip_2.eps"                        ;
#   *-----------------------------------------------------------*
#   * Inclusione barcode EPS                                    *
#   *-----------------------------------------------------------*
    $p->importepsfile($pth_eps,
                      $x,
                      $y,
                      $x+$l,
                      $y+$a)                                   ;
}


