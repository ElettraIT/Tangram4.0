     ############ /abd/etc/xagg
     #
     # Procedura di creazione file di aggiornamento per Internet
     #
     ######

######
# Controllo identita' utente
###

altervx88=`whoami`
if [ $altervx88 != "master" ]
   then
       echo "                                                                 " ;
       echo "-----------------------------------------------------------------" ;
       echo "               # Errore per il comando 'xagg' #                  " ;
       echo "              ------------------------------------               " ;
       echo "                                                                 " ;
       echo "Il comando puo' essere eseguito solamente dall'utente 'master'   " ;
       echo "                                                                 " ;
       echo "-----------------------------------------------------------------" ;
       echo "                                                                 " ;
       exit 0;
   fi

######
# - Note operative per l'accettazione del pathname
###

clear;
echo    "======================================================================" ;
echo    "                  CREAZIONE FILE ESPORTAZIONE 'aggint.tar'            " ;
echo    "----------------------------------------------------------------------" ;
echo    "                                                                      " ;
echo    "Note operative  : Digitare il pathname che si vuole esportare         " ;
echo    "                                                                      " ;
echo    "           Nota : Rispondere a vuoto se si vuole uscire immediatamen- " ;
echo    "                  te dalla procedura.                                 " ;
echo    "                                                                      " ;
/abd/etc/echonnl "--------------> : " ;

######
# - Accettazione pathname
###

read    altervx10;

######
# - Una linea di separazione
###

echo    "                                                                      " ;

######
# - Test se impostazione a vuoto
###

if [ -z "$altervx10" ]
   then
      exit 0;
   fi

######
# - Creazione file 'aggin.tar'
###

#
# Posizionamento sulla directory di base per oggetti
#
cd /abd/ogt;

#
# Esecuzione tar
#
tar cvf /abd/asc/agg/aggint.tar $altervx10;


######
# - Fine procedura
###
