######
# Preparazione esecuzione
###

#
# Set della nuova umask
#
umask 022;

#
# Posizionamento sulla directory di base per oggetti
#
cd /abd/ogt1;

######
# Preparazione variabili per Acucobol
###

#
# Tipo di terminale
#
A_TERM="vt300"; export A_TERM;

#
# File di terminal capabilities
#
A_TERMCAP="/abd/run/runcbltec"; export A_TERMCAP;

#
# File di configurazione Runtime Acucobol
#
A_CONFIG="/abd/run/runcblcfg"; export A_CONFIG;

######
# Preparazione variabili per esecuzione 'TANGRAM'
###

#
# Directory di base 'abd'
#
V_ALTER_HOME="/abd"; export V_ALTER_HOME;

#
# Real User-Id
#
V_ALTER_USER="`whoami`"; export V_ALTER_USER;

#
# Codice del terminale
#
altervx71="`tty`";
V_ALTER_TTYC="`basename $altervx71`"; export V_ALTER_TTYC;

#
# Tipo di terminale utilizzato
#
V_ALTER_TERM="vt300"; export V_ALTER_TERM;

#
# Tipo di runtime utilizzato : Acucobol
#
V_ALTER_RUNT="00"; export V_ALTER_RUNT;

#
# Process-ID unico
#
V_ALTER_GETP="`/abd/run/getpid`"; export V_ALTER_GETP;

######
# Lancio del runtime Acucobol
###

#
# Esecuzione TANGRAM in foreground
#
/abd/run/runcbl -x swd/xpg/prg/obj/pxpg0000 "$V_ALTER_HOME" "$V_ALTER_USER" "$V_ALTER_TTYC" "$V_ALTER_TERM" "$V_ALTER_RUNT" "$V_ALTER_GETP";

######
# - Fine procedura
###
