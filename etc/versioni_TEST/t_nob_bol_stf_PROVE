#!/usr/bin/perl -w
#===============================================================*
# Modulo Perl per invio file a STEF                             *
#                                                               *
# t_nob_bol_stf                                                 *
#                                                               *
# SU MISURA PER NOBILI                                          *
#                                                               *
#                   ------------------------------------------- *
#                    Versione originale:    001 del 11/05/2018  *
#                      Ultima revisione:    NdK del 08/08/2018  *
#                   ------------------------------------------- *
#                                Autore:    Nicola de Kunovich  *
# ------------------------------------------------------------- *
#                                                               *
# Parametri in input : - numero distinta di invio               *
#                                                               *
#                      - percorso del file da inviare a STEF    *
#                                                               *
#---------------------------------------------------------------*

#===============================================================*
# Moduli Perl                                                   *
#---------------------------------------------------------------*
use Net::FTP                                                   ;
use File::Basename                                             ;

#===============================================================*
# Variabili statiche                                            *
#---------------------------------------------------------------*
#   *-----------------------------------------------------------*
#   * Lettura configurazione                                    *
#   *-----------------------------------------------------------*
    my $cfg_bas = "/abd/asc/cfg/t_nob_bol_stf.ini"             ;
    my %cnf_ele = do $cfg_bas                                  ;
#   *-----------------------------------------------------------*
#   * Parametri di configurazione                               *
#   *-----------------------------------------------------------*
    my $hst_ftp = $cnf_ele{hst_ftp}                            ;
    my $hst_usr = $cnf_ele{hst_usr}                            ;
    my $hst_pwd = $cnf_ele{hst_pwd}                            ;
    my $pth_inp = $cnf_ele{pth_inp}                            ;
    my $pth_out = $cnf_ele{pth_out}                            ;
#   *-----------------------------------------------------------*
#   * Parametri in input                                        *
#   *-----------------------------------------------------------*
    my $num_dst = shift                                        ;
    my $pth_fil = shift                                        ;
#   *-----------------------------------------------------------*
#   * Percorsi file                                             *
#   *-----------------------------------------------------------*
    my $log_fil = "/abd/asc/log/STEF_" . $num_dst . ".log"     ;
#   *-----------------------------------------------------------*
#   * Data di sistema                                           *
#   *-----------------------------------------------------------*
    my @months   = qw(Gen Feb Mar Apr Mag Giu Lug Ago Set Ott Nov Dic);
    my @weekDays = qw(Dom Lun Mar Mer Gio Ven Sab Dom)         ;
    my ($second,
        $minute,
        $hour,
        $dayOfMonth,
        $month,
        $yearOffset,
        $dayOfWeek,
        $dayOfYear,
        $daylightSavings) = localtime()                        ;
    $year = 1900 + $yearOffset                                 ;
    $theTime = "$hour:$minute:$second, $weekDays[$dayOfWeek] $months[$month] $dayOfMonth, $year";

#===============================================================*
# Open file di LOG                                              *
#---------------------------------------------------------------*
#   *-----------------------------------------------------------*
#   * Open                                                      *
#   *-----------------------------------------------------------*
    open (LOG_FIL, ">$log_fil") or die
        "Impossibile aprire '$log_fil'"                        ;
#   *-----------------------------------------------------------*
#   * Intestazione LOG                                          *
#   *-----------------------------------------------------------*
    print LOG_FIL "==========================\n"               ; 
    print LOG_FIL "Distinta : " . $num_dst . "\n"              ; 
    print LOG_FIL "File     : " . $pth_fil . "\n"              ; 
    print LOG_FIL "Data     : " . $theTime . "\n"              ; 

#===============================================================*
# Connessione                                                   *
#---------------------------------------------------------------*
my $ftp = Net::FTP->new($hst_ftp,
                   Debug => 0,
                 Timeout =>240)
  or print LOG_FIL "Connessione KO : $@"                       ;

#===============================================================*
# Login                                                         *
#---------------------------------------------------------------*
$ftp->login($hst_usr, $hst_pwd)
  or print LOG_FIL $ftp->message                               ;

#===============================================================*
# Directory di output                                           *
#---------------------------------------------------------------*
$ftp->cwd($pth_out)
  or print LOG_FIL $ftp->message                               ;

#===============================================================*
# Metodo binario                                                *
#---------------------------------------------------------------*
$ftp->binary()                                                 ;

#===============================================================*
# Invio file in input                                           *
#---------------------------------------------------------------*
&fil_snd ($ftp, $pth_fil)                                      ;

#===============================================================*
# Uscita da FTP                                                 *
#---------------------------------------------------------------*
$ftp->quit                                                     ;

#===============================================================*
# Stampa del log file                                           *
#---------------------------------------------------------------*
my $printer = "mfp"                                            ;
system("cat $log_fil | lpr -P$printer")                        ;

#===============================================================*
# Close file di LOG                                             *
#---------------------------------------------------------------*
close LOG_FIL                                                  ;

#===============================================================*
# SUBROUTINES                                                   *
#===============================================================*

#===============================================================*
# Invio di un file                                              *
#---------------------------------------------------------------*
sub fil_snd
{
#   *-----------------------------------------------------------*
#   * Estrazione campi                                          *
#   *-----------------------------------------------------------*
    my $wrk_ftp = shift                                        ;
    my $wrk_fil = shift                                        ;
#   *-----------------------------------------------------------*
#   * Aggiunta provvisoria estensione TMP                       *
#   *-----------------------------------------------------------*
    my $new_fil = $wrk_fil . ".TMP"                            ;
    rename ($wrk_fil, $new_fil)                                ;
#   *-----------------------------------------------------------*
#   * Invio vero e proprio                                      *
#   *-----------------------------------------------------------*
    $wrk_ftp->put($new_fil)
            or print LOG_FIL $wrk_ftp->message                 ;
#   *-----------------------------------------------------------*
#   * Rename del file per togliere estensione TMP               *
#   *-----------------------------------------------------------*
    my ($fil, $dir, $ext) = fileparse($wrk_fil, qr/\.[^.]*/)   ;
    my $old_nmd = $fil . $ext . ".TMP"                         ;
    my $ren_nmd = $fil . $ext                                  ;
    $wrk_ftp->rename($old_nmd, $ren_nmd)
            or print LOG_FIL $wrk_ftp->message                 ;
}

