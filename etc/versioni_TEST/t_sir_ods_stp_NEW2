#!/usr/bin/perl -w
#===============================================================*
#                                                               *
# Stampa lista DDT (da bol300s) con barcode QR                  *
#                                                               *
# Script SPERIMENTALE MAI USATO - FUNZIONA                      *
#                                                               *
#                   ------------------------------------------- *
#                    Versione originale:    001 del 10/04/2016  *
#                      Ultima revisione:    NdK del 24/11/2021  *
#                   ------------------------------------------- *
#                                Autore:    Nicola de Kunovich  *
# ------------------------------------------------------------- *
#                                                               *
# Parametri in input : - file CSV da stampare (protocollo)      *
#                                                               *
# ------------------------------------------------------------- *
#                                                               *
# Nota bene : i barcode EPS vengono generati on-fly tramite     *
#             il modulo PostScript 'barcode.ps'                 *
#                                                               *
# ------------------------------------------------------------- *
#                                                               *
# Utilizzo :                                                    *
#                                                               *
# $ t_sir_ods_stp_NEW2 99999999999                              *
#                                                               *
# ___ NON IN USO ___                                            *
# ___ EPS di QR  ___                                            *
#                                                               *
#===============================================================*

#===============================================================*
# Moduli Perl                                                   *
#---------------------------------------------------------------*
use PostScript::Simple                                         ;

#===============================================================*
# Variabili in input                                            *
#---------------------------------------------------------------*
#   *-----------------------------------------------------------*
#   * Protocollo in input                                       *
#   *-----------------------------------------------------------*
    my $num_prt = $ARGV[0]                                     ;

#===============================================================*
# Variabili statiche                                            *
#---------------------------------------------------------------*
#   *-----------------------------------------------------------*
#   * Lettura configurazione                                    *
#   *-----------------------------------------------------------*
    my $cfg_bas = "/abd/asc/cfg/t_sir_ods_stp.ini"             ;
    my %cnf_ele = do $cfg_bas                                  ;
#   *-----------------------------------------------------------*
#   * Codice stampante da file configurazione                   *
#   *-----------------------------------------------------------*
    my $cod_stp = $cnf_ele{cod_stp}                            ;
#   *-----------------------------------------------------------*
#   * Percorsi file da file configurazione                      *
#   *-----------------------------------------------------------*
    my $pth_tmp = $cnf_ele{pth_tmp}                            ;
    my $pth_bcd = $cnf_ele{pth_bcd}                            ;
#   *-----------------------------------------------------------*
#   * Percorsi file                                             *
#   *-----------------------------------------------------------*
    my $pth_csv = $pth_tmp . $num_prt . ".CSV"                 ;
    my $out_stp = $pth_tmp . $num_prt . ".ps"                  ;
    my $out_pdf = $pth_tmp . $num_prt . ".pdf"                 ;
#   *-----------------------------------------------------------*
#   * Contatori e posizionatori pagina                          *
#   *-----------------------------------------------------------*
    my $max_rig = 18                                           ;
    my $ctr_rig = 0                                            ;
    my $num_pag = 0                                            ;
    my $tit_lin = 278                                          ;
    my $top_pag = 275                                          ;
    my $cur_lin = $top_pag                                     ;
    my $alt_lin = -15                                          ;
    my $top_grd = 275                                          ;
    my $bot_grd = 12                                           ;
#   *-----------------------------------------------------------*
#   * Colonne griglia                                           *
#   *-----------------------------------------------------------*
    my $c01_grd = 38                                           ;
    my $c02_grd = 50                                           ;
    my $c03_grd = 120                                          ;
    my $c04_grd = 132                                          ;
    my $c05_grd = 152                                          ;
    my $c06_grd = 180                                          ;
#   *-----------------------------------------------------------*
#   * Dimensioni barcode EPS in mm.                             *
#   *-----------------------------------------------------------*
    my $eps_alt = 15                                           ;
    my $eps_lun = 36                                           ;
#   *-----------------------------------------------------------*
#   * Comodi per trattamento numero protocollo                  *
#   *-----------------------------------------------------------*
    my $lit_sec = substr($num_prt, 1, 2)                       ;
    my $lit_num = substr($num_prt, 6, 6)                       ;
       $lit_num += 0                                           ;
    my $lit_prt = $lit_num . "/" . $lit_sec                    ;
#   *-----------------------------------------------------------*
#   * Comodi per trattamento numero protocollo in EPS           *
#   *-----------------------------------------------------------*
    my $eps_sec = substr($num_prt, 1, 2)                       ;
    my $eps_num = substr($num_prt, 7, 4)                       ;
    my $eps_prt = $eps_sec . $eps_num                          ;

#===============================================================*
# Lettura del modulo 'barcode.ps'                               *
#---------------------------------------------------------------*
my $gen_bcd = "/abd/asc/cfg/barcode.ps"                        ;
open(PS,$gen_bcd) || die 'File di '
                           . 'configurazione non trovato'      ;
$_=join('',<PS>)                                               ;
close(PS)                                                      ;

#===============================================================*
# Estrazione dal modulo 'barcode.ps' del TEMPLATE da richiamare *
#---------------------------------------------------------------*
m/
    %\ --BEGIN\ TEMPLATE--
    (.*)
    %\ --END\ TEMPLATE--
    /sx || die 'Unable to parse out the template'              ;

#===============================================================*
# Completamento del TEMPLATE                                    *
#---------------------------------------------------------------*
my $template=''                                                ;
$template.="%!PS-Adobe-2.0 EPSF-2.0\n"                         ;
$template.="%%BoundingBox: 0 0 [% width %] [% height %]\n"     ;
$template.="%%EndComments"                                     ;
$template.=$1                                                  ;
$template.="10 7 moveto\n"                                     ;
$template.="[% call %]\n"                                      ;
$template.="showpage\n"                                        ;

#===============================================================*
# Preparazione pagina                                           *
#---------------------------------------------------------------*
my $ps = new PostScript::Simple::(papersize => "A4",
                                     colour => 1,
                                        eps => 0,
                                      units => "mm")           ;

#===============================================================*
# Spessore linea generale                                       *
#---------------------------------------------------------------*
$ps->setlinewidth( 0.01 )                                      ;

#===============================================================*
# Trattamento stampa                                            *
#---------------------------------------------------------------*
#   *-----------------------------------------------------------*
#   * Open e Close file in input                                *
#   *-----------------------------------------------------------*
    open (I_FILE, "$pth_csv") or die
         "Impossibile aprire il file '$pth_csv'"               ;
    my   @linea = <I_FILE>                                     ;
    close I_FILE                                               ;

#   *-----------------------------------------------------------*
#   * Ciclo di scansione                                        *
#   *-----------------------------------------------------------*
foreach $linea (@linea)
{
    my   @campo = split(/;/, $linea)                           ;
#       *-------------------------------------------------------*
#       * Trattamento testata                                   *
#       *-------------------------------------------------------*
    if  ($campo[0] eq "T")
    {
        &stp_tes                                               ;
    }
#        *------------------------------------------------------*
#        * Trattamento righe                                    *
#        *------------------------------------------------------*
    else
    {
        &stp_rig                                               ;
    }
}

#===============================================================*
# Generazione file Postscript                                   *
#---------------------------------------------------------------*
$ps->output($out_stp)                                          ;

#===============================================================*
# Stampa file Postscript                                        *
#---------------------------------------------------------------*
if ($cod_stp eq "pdf")
{
    system("ps2pdf $out_stp $out_pdf")                        ;
}
 else
{
    system("cat $out_stp | lpr -P$cod_stp")                   ;
}

#===============================================================*
# SUBROUTINES                                                   *
#===============================================================*

#===============================================================*
# Stampa testata                                                *
#---------------------------------------------------------------*
sub stp_tes
{
#   *-----------------------------------------------------------*
#   * Estrazione campi                                          *
#   *-----------------------------------------------------------*
    my @campo = split(/;/, $linea)                             ;
    
    
       $rag_sc1 = substr($campo[1], 0, 28)                     ;
       $rag_sc2 = substr($campo[1], 28, 20)                    ;
#   *-----------------------------------------------------------*
#   * Titolo                                                    *
#   *-----------------------------------------------------------*
    &mynewpage($ps, "DDT Nr. : " . $lit_prt)                   ;
#   *-----------------------------------------------------------*
#   * Protocollo: inclusione barcode EPS                        *
#   *-----------------------------------------------------------*
    &inc_eps ($eps_prt,$eps_prt, 70)                           ;
}

#===============================================================*
# Stampa riga                                                   *
#---------------------------------------------------------------*
sub stp_rig
{
#   *-----------------------------------------------------------*
#   * Contatore righe                                           *
#   *-----------------------------------------------------------*
    $ctr_rig++                                                 ;
#   *-----------------------------------------------------------*
#   * Eventuale reintestazione pagina                           *
#   *-----------------------------------------------------------*
    if ( !($ctr_rig < $max_rig))
    {
        &mynewpage($ps, "Spedizione : " . $lit_prt)            ;
        $ctr_rig = 1                                           ;
        $cur_lin = $top_pag                                    ;
    }
#   *-----------------------------------------------------------*
#   * Interlinea                                                *
#   *-----------------------------------------------------------*
    $cur_lin = $cur_lin + $alt_lin                             ;
#   *-----------------------------------------------------------*
#   * Estrazione campi                                          *
#   *-----------------------------------------------------------*
    my @campo = split(/;/, $linea)                             ;
#   *-----------------------------------------------------------*
#   * Pulizia trailing spaces campi testo                       *
#   *-----------------------------------------------------------*
    my $max_val = 7                                            ;
    my $ctr_001                                                ;
    for ($ctr_001 = 1 ; $ctr_001 < $max_val ; $ctr_001++ )
    {
        $campo[$ctr_001] =~ s/^\s+//                           ;
        $campo[$ctr_001] =~ s/\s+$//                           ;
    }
#   *-----------------------------------------------------------*
#   * Intera riga: inclusione barcode EPS                       *
#   *-----------------------------------------------------------*
    my $int_rig = $campo[1]
                . ";"
                . $campo[2]
                . ";"
                . $campo[3]
                . ";"
                . $campo[4]
                . ";"
                . $campo[5]
                . ";"
                . $campo[6]
                . ";"
                . $campo[7]
                . ";"                                          ;
    
    
    &inc_eps ($ctr_rig, $int_rig, 10)                          ;
#   *-----------------------------------------------------------*
#   * Codice prodotto sotto al barcode                          *
#   *-----------------------------------------------------------*
#    $ps->setfont("Courier", 10)                                ;
#    $ps->text(20, $cur_lin, $campo[1])                         ;
#   *-----------------------------------------------------------*
#   * Riga per pagina - INIBITO                                 *
#   *-----------------------------------------------------------*
#   $ps->setfont("Helvetica", 14)                              ;
#   $ps->text({align => 'right'}, 7, $cur_lin, $ctr_rig)       ;
#   *-----------------------------------------------------------*
#   * Progressivo riga: inclusione barcode EPS - INIBITO        *
#   *-----------------------------------------------------------*
#    &inc_eps ($campo[5], 10)                                   ;
#   *-----------------------------------------------------------*
#   * Stampa Codice prodotto - INIBITO                          *
#   *-----------------------------------------------------------*
#    $ps->text(40, $cur_lin+5,  $campo[1])                      ;
#   *-----------------------------------------------------------*
#   * Stampa Descrizione prodotto                               *
#   *-----------------------------------------------------------*
    $ps->setfont("Helvetica", 14)                              ;
    my $des_pr1 = substr($campo[2], 0, 20)                     ;
    my $des_pr2 = substr($campo[2], 20, 20)                    ;
    $ps->text(52, $cur_lin+6, $des_pr1)                        ;
    $ps->text(52, $cur_lin+1, $des_pr2)                        ;
    $ps->setfont("Courier", 8)                                 ;
#   *-----------------------------------------------------------*
#   * Stampa lotto                                              *
#   *-----------------------------------------------------------*
    $ps->text({align => 'right'},130, $cur_lin+5,  $campo[6])  ;
#   *-----------------------------------------------------------*
#   * Stampa giacenza                                           *
#   *-----------------------------------------------------------*
    $ps->text({align => 'right'},155, $cur_lin+5,  $campo[7])  ;
#   *-----------------------------------------------------------*
#   * Stampa codice prodotto per la casa produttrice            *
#   *-----------------------------------------------------------*
    $ps->setfont("Helvetica", 12)                               ;
    $ps->text(153, $cur_lin+7,  $campo[3])                      ;
#   *-----------------------------------------------------------*
#   * Stampa quantita'                                          *
#   *-----------------------------------------------------------*
    $ps->setfont("Helvetica-Bold", 12)                         ;
    $ps->text({align => 'right'},197, $cur_lin-1,  $campo[4])  ;
    $ps->setfont("Courier", 8)                                 ;
#   *-----------------------------------------------------------*
#   * Sottolineatura linea                                      *
#   *-----------------------------------------------------------*
    $ps->line(10, $cur_lin-2, 200, $cur_lin-2)                 ;
}

#===============================================================*
# Trattamento EPS                                               *
#---------------------------------------------------------------*
sub inc_eps
{
#   *-----------------------------------------------------------*
#   * Valore in input                                           *
#   *-----------------------------------------------------------*
    my $nom_cmp = shift                                        ;
    my $val_cmp = shift                                        ;
    my $pos_cmp = shift                                        ;
#   *-----------------------------------------------------------*
#   * Determinazione coordinate barcode EPS                     *
#   *-----------------------------------------------------------*
    my $eps_x01 = $pos_cmp                                     ;
    my $eps_y01 = $cur_lin-1.5                                 ;
    my $eps_x02 = $eps_x01+$eps_lun                            ;
    my $eps_y02 = $cur_lin+$eps_alt-1.5                        ;
    
    
#   *-----------------------------------------------------------*
#   * DEBUG                                                     *
#   *-----------------------------------------------------------*
#   print "eps_x01 = " . $eps_x01 . "\n";
#   print "eps_y01 = " . $eps_y01 . "\n";
#   print "eps_x02 = " . $eps_x02 . "\n";
#   print "eps_y02 = " . $eps_y02 . "\n\n";
    
    
#   *-----------------------------------------------------------*
#   * Percorso file barcode EPS                                 *
#   *-----------------------------------------------------------*
    my $pth_eps = $pth_tmp
                . $nom_cmp
                . ".eps"                                       ;
                
#   *-----------------------------------------------------------*
#   * Parametri per generazione tramite modulo 'barcode.ps'     *
#   *-----------------------------------------------------------*
    my $filename=$pth_eps                                      ;
    my $width=95                                              ;
    my $height=95                                             ;
    my $contents = "("
                 . $val_cmp
                 . ") (includetext) /qrcode "
                 . "/uk.co.terryburton.bwipp "
                 . "findresource exec"                    ;
#   *-----------------------------------------------------------*
#   * Completamento per EPS                                     *
#   *-----------------------------------------------------------*
    my $barcode=$template                                      ;
    $barcode=~s/\[% call %\]/$contents/                        ;
    $barcode=~s/\[% width %\]/$width/                          ;
    $barcode=~s/\[% height %\]/$height/                        ;

#   *-----------------------------------------------------------*
#   * DEBUG                                                     *
#   *-----------------------------------------------------------*
#    print $filename . "\n";
#    print $width . "\n";
#    print $height . "\n";
#    print $contents . "\n";


#   *-----------------------------------------------------------*
#   * Apertura e generazione del file EPS                       *
#   *-----------------------------------------------------------*
    open(OUT,"> $filename")                                ;
    print OUT $barcode                                         ;
    close(OUT)                                                 ;
#   *-----------------------------------------------------------*
#   * Inclusione barcode EPS                                    *
#   *-----------------------------------------------------------*
    $ps->importepsfile($pth_eps,
                       $eps_x01,
                       $eps_y01,
                       $eps_x02,
                       $eps_y02)                               ;
}

#===============================================================*
# Intestazione pagina                                           *
#---------------------------------------------------------------*
sub mynewpage
{
#   *-----------------------------------------------------------*
#   * Documento in input                                        *
#   *-----------------------------------------------------------*
    my $ps = shift                                             ;
#   *-----------------------------------------------------------*
#   * Titolo pagina in input                                    *
#   *-----------------------------------------------------------*
    my $tit_pag = shift                                        ;
#   *-----------------------------------------------------------*
#   * Numero pagina                                             *
#   *-----------------------------------------------------------*
    $num_pag++                                                 ;
#   *-----------------------------------------------------------*
#   * Nuova pagina                                              *
#   *-----------------------------------------------------------*
    $ps->newpage                                               ;
#   *-----------------------------------------------------------*
#   * Box pagina                                                *
#   *-----------------------------------------------------------*
    $ps->box(10, 12, 200, 288)                                 ;
#   *-----------------------------------------------------------*
#   * Sottolineatura titolo                                     *
#   *-----------------------------------------------------------*
    $ps->line(10, $top_grd, 200, $top_grd)                     ;
#   *-----------------------------------------------------------*
#   * Colonna progressivo riga                                  *
#   *-----------------------------------------------------------*
#    $ps->line($c01_grd, $bot_grd, $c01_grd, $top_grd)          ;
#   *-----------------------------------------------------------*
#   * Colonna codice prodotto                                   *
#   *-----------------------------------------------------------*
    $ps->line($c02_grd, $bot_grd, $c02_grd, $top_grd)          ;
#   *-----------------------------------------------------------*
#   * Colonna descrizione prodotto                              *
#   *-----------------------------------------------------------*
    $ps->line($c03_grd, $bot_grd, $c03_grd, $top_grd)          ;
#   *-----------------------------------------------------------*
#   * Colonna lotto prodotto                                    *
#   *-----------------------------------------------------------*
    $ps->line($c04_grd, $bot_grd, $c04_grd, $top_grd)          ;
#   *-----------------------------------------------------------*
#   * Colonna giacenza                                          *
#   *-----------------------------------------------------------*
    $ps->line($c05_grd, $bot_grd, $c05_grd, $top_grd)          ;
#   *-----------------------------------------------------------*
#   * Colonna codice prodotto per il fornitore                  *
#   *-----------------------------------------------------------*
#   $ps->line($c06_grd, $bot_grd, $c06_grd, $top_grd)          ;
#   *-----------------------------------------------------------*
#   * Font                                                      *
#   *-----------------------------------------------------------*
    $ps->setfont("Courier", 8)                                 ;
#   *-----------------------------------------------------------*
#   * Titolo                                                    *
#   *-----------------------------------------------------------*
    $ps->text(15, $tit_lin,
                  $tit_pag
                . " - Pag. "
                . $num_pag)                                    ;
#   *-----------------------------------------------------------*
#   * Stampa ragione sociale cliente                            *
#   *-----------------------------------------------------------*
    $ps->setfont("Helvetica-Bold", 14)                         ;
    $ps->text(110, $tit_lin+5, $rag_sc1)                       ;
    $ps->text(110, $tit_lin, $rag_sc2)                         ;
}

