sub det_num 
{
    #--------------------------------------*
    # Filename                             *
    #--------------------------------------*
    my $filn = "/abd/asc/imp/" . $elemento ;
    #--------------------------------------*
    # Open file                            *
    #--------------------------------------*
    open (CONFERMA, $filn)                ;
    #--------------------------------------*
    # Estrazione I riga                    *
    #--------------------------------------*
    my $trow = ''                         ;
    if (<CONFERMA>)
    {
        $trow=<CONFERMA>                  ;
    }
    return $trow                          ;
    #--------------------------------------*
    # Close file                           *
    #--------------------------------------*
    close CONFERMA                        ;
}
