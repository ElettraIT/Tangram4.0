#=========================================*
# Trattamento messaggio di posta          *
#-----------------------------------------*
sub messaggio 
{
    #--------------------------------------*
    # Estrazione del fornitore dal nome    *
    # file                                 *
    #--------------------------------------*
    my $forn = "PADIS"                    ;

    #--------------------------------------*
    # Composizione soggetto                *
    #--------------------------------------*
    my $subj = "Conferma ordine da "
             . $forn
             . " "
             . $rnum                      ;
    #--------------------------------------*
    # Messaggio di posta                   *
    #--------------------------------------*
    $msg = MIME::Lite->new(
           From     =>$mitt,
           To       =>$dest,
           Bcc      =>$desb,
           Subject  =>$subj,
           Data     =>"Conferma "
                    . $elemento
                    . " da "
                    . $forn
                    . " "
                    . $rnum)              ;
    #--------------------------------------*
    # Invio                                *
    #--------------------------------------*
    $msg->send('smtp', $isps, Timeout=>60);
}

