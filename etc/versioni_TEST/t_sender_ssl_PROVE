#!/usr/bin/perl -w
#==========================================*
# Modulo Perl di invio posta con autenti-  *
# cazione SSL                              *
#                                          *
# t_sender_ssl                             *
#                                          *
# Invio di messaggi ad una lista di        *
# indirizzi e con i relativi allegati      *
# (utilizzato per i lotti di fatture PDF)  *
#                                          *
# ---------------------------------------- *
# Versione originale:   001 del 31/10/12   *
#   Ultima revisione:   NdK del 07/04/16   *
# ---------------------------------------- *
#             Autore:   Nicola de Kunovich *
# ---------------------------------------- *
#                                          *
# In input : - codice azienda              *
#            - server SMTP                 *
#            - mittente                    *
#            - username                    *
#            - password                    *
#            - indirizzi (opzionale)       *
#            - soggetto  (opzionale)       *
#            - messaggio (opzionale)       *
#                                          *
# ---------------------------------------- *
# N.B.: i campi in input sono separati da  *
#       virgola ','                        *
#                                          *
# ---------------------------------------- *
# N.B.: UNIFORMABILE CON 't_sender_aut'    *
# ---------------------------------------- *
# N.B.: il campo indirizzi puo' contenere  *
#       il nome di un file di indirizzi e  *
#       percorsi di allegati, oppure un    *
#       solo indirizzo e un solo allegato  *
#       separati da '#'                    *
#------------------------------------------*

#==========================================*
# Moduli Perl utilizzati                   *
#------------------------------------------*
#use Net::SMTP::SSL                        ;
use Net::SMTP                        ;
use MIME::Base64                          ;
use File::Spec                            ;
use File::Basename                        ;
use LWP::MediaTypes                       ;

#==========================================*
# Variabili statiche                       *
#------------------------------------------*
my $base = '/abd/asc/'                    ;
my $temp = '/tmp/'                        ;
#
my $sogg = 'sogg.txt'                     ;
my $mess = 'mess.txt'                     ;
my $emla = 'indi.txt'                     ;
#
my $wsog = ''                             ;
my $wmes = ''                             ;
my $wind = ''                             ;

#==========================================*
# Variabili lette in input                 *
#------------------------------------------*
#    *-------------------------------------*
#    * Lettura variabile in input          *
#    *-------------------------------------*
$inpt = $ARGV[0]                          ;

#==========================================*
# Help                                     *
#------------------------------------------*
if (!$ARGV[0] || $ARGV[0] eq "-help")
{
    print "\n"
        . "Uso : (parametri "
        . "separati da virgola)"
        . "\n"
        . "> t_sender_ssl"
        . "\n"
        . "           AZIENDA(default: doc),"
        . "\n"
        . "           SERVER_SMTP,"
        . "\n"
        . "           MITTENTE,"
        . "\n"
        . "           USERID_SSL,"
        . "\n"
        . "           PASSWORD_SSL,"
        . "\n"
        . "           INDIRIZZI(opz),"
        . "\n"
        . "           SOGGETTO(opz),"
        . "\n"
        . "           MESSAGGIO(opz),"
        . "\n"
        . "\n"
        . "Release : 07/04/2016"
        . "\n"
        . "\n"
        . "(C) Copyright - wip"
        . "\n"
        . "\n"                            ;
    exit()                                ;
}

#    *-------------------------------------*
#    * Separazione dei componenti (,)      *
#    *-------------------------------------*
@vars = split(/,/, $inpt)                 ;
#    *-------------------------------------*
#    * Azienda Tangram                     *
#    *-------------------------------------*
my $atgm = $vars[0]                       ;
#    *-------------------------------------*
#    * Server SMTP                         *
#    *-------------------------------------*
my $srvr = $vars[1]                       ;
#    *-------------------------------------*
#    * Mittente                            *
#    *-------------------------------------*
my $mitt = $vars[2]                       ;
#    *-------------------------------------*
#    * Username autenticazione             *
#    *-------------------------------------*
my $user = $vars[3]                       ;
#    *-------------------------------------*
#    * Password autenticazione             *
#    *-------------------------------------*
my $pass = $vars[4]                       ;
#    *-------------------------------------*
#    * Indirizzi                          *
#    *-------------------------------------*
my $indi = $vars[5]                       ;
#    *-------------------------------------*
#    * Soggetto                            *
#    *-------------------------------------*
my $sogi = $vars[6]                       ;
#    *-------------------------------------*
#    * Messaggio                           *
#    *-------------------------------------*
my $mesi = $vars[7]                       ;

#==========================================*
# Debug (da scommentare)                   *
#------------------------------------------*
#    print "azienda :" . $vars[0] . "\n";
#    print $vars[1] . "\n";
#    print $vars[2] . "\n";
#    print $vars[3] . "\n";
