#!/usr/bin/perl -w
#==========================================*
# Modulo Perl di invio posta con autenti-  *
# cazione SSL                              *
#                                          *
# t_sender_ssl TEST                        *
#                                          *
#------------------------------------------*

#==========================================*
# Moduli Perl utilizzati                   *
#------------------------------------------*
use Net::SMTP::SSL                        ;
use IO::Socket::SSL qw(debug3);

my $srvr = 'smtps.pec.aruba.it';
my $user = 'wip@gigapec.it';
my $pass = 'Cippy_Lippy2020';
my $mitt = 'wip@gigapec.it';
my $dest = 'wip@gigapec.it';
# my $dest2 = 'sis@pec.sis-immobiliare.it';
my $testo = 'CONTENUTO MESSAGGIO DI PROVA DA WIP';

    #--------------------------------------*
    # Normalizzazione preliminare          *
    #--------------------------------------*
    my $smtp                              ;

    #--------------------------------------*
    # Invio vero e proprio                 *
    #--------------------------------------*
    if (not $smtp = Net::SMTP::SSL->new($srvr,
                              Port => 465,
                              Debug => 1))
       {
           die "Connessione al server "
             . "fallita\n"                ;
       }

    #--------------------------------------*
    # Autenticazione                       *
    #--------------------------------------*
    $smtp->auth($user, $pass)
     || die "Autenticazione fallita!\n"   ;

    $smtp->mail($mitt)                    ;
    $smtp->to($dest)                      ;
    $smtp->data();
    $smtp->datasend("To: " . $dest . "\n");
    $smtp->datasend("Subject: PROVA\n")   ;

    #--------------------------------------*
    # Chiusura invio                       *
    #--------------------------------------*
    $smtp->datasend("\n")                 ;
    $smtp->datasend($testo . "\n")        ;
    $smtp->dataend()                      ;
    $smtp->quit                           ;

