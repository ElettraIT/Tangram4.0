#!/usr/bin/perl -w
#==========================================*
# Modulo Perl per ricevimento file da      *
# sito di Web Creative                     *
#                                          *
# t_zat_web_del                            *
#                                          *
# (richiamato da pgtv7200)                 *
#                                          *
# ---------------------------------------- *
# Versione originale:  001 del 30/04/13    *
#   Ultima revisione:  NdK del 10/05/13    *
