#!/usr/bin/perl -w
#===============================================================*
#                                                               *
# Parser file di tipo CSV                                       *
#                                                               *
# ------------------------------------------------------------- *
#                                                               *
# Parametri in input : - file CSV da tradurre (percorso)        *
#                                                               *
#                   ------------------------------------------- *
#                    Versione originale:    001 del 25/05/09    *
#                      Ultima revisione:    NdK del 07/10/09    *
#                   ------------------------------------------- *
#                                Autore:    Nicola de Kunovich  *
# ------------------------------------------------------------- *
# SU MISURA PER ZATTI : Traduzione file da Tedesco a ASCII      *
# ------------------------------------------------------------- *
#                                                               *
# Utilizzo :                                                    *
#                                                               *
# $ t_zat_csv_flo /percorso/FILE                                *
#                                                               *
# Output in file temporaneo '/abd/asc/tmp/florissima.txt'       *
#                                                               *
#===============================================================*

#===============================================================*
# Dichiarazione per restrizione variabili                       *
#---------------------------------------------------------------*
use strict                                                     ;

#===============================================================*
# Moduli Perl                                                   *
#---------------------------------------------------------------*
use Lingua::DE::ASCII                                          ;

#===============================================================*
# Lettura della variabile in input                              *
#---------------------------------------------------------------*
my $csv = $ARGV[0]                                             ;

#===============================================================*
# Variabili di appoggio                                         *
#---------------------------------------------------------------*
my $out = "/abd/asc/tmp/florissima.txt"                        ;

#===============================================================*
# Open del file in input                                        *
#---------------------------------------------------------------*
&f_input                                                       ;

#===============================================================*
# Open del file in output                                       *
#---------------------------------------------------------------*
&f_output                                                      ;

#===============================================================*
# Trattamento file                                              *
#---------------------------------------------------------------*
#    *----------------------------------------------------------*
#    * Normalizzazione contatore righe                          *
#    *----------------------------------------------------------*
my $row = 0                                                    ;
#    *----------------------------------------------------------*
#    * Ciclo di scansione                                       *
#    *----------------------------------------------------------*
while (<I_FILE>)
{
#        *------------------------------------------------------*
#        * Pulizia fine riga                                    *
#        *------------------------------------------------------*
    chomp                                                      ;
#        *------------------------------------------------------*
#        * Split della riga                                     *
#        *------------------------------------------------------*
    my @Fld = split(';', $_)                                   ;
#        *------------------------------------------------------*
#        * Filtraggio caratteri accentati                       *
#        *------------------------------------------------------*
    my $code = to_ascii($Fld[0])                               ;
    my $des1 = to_ascii($Fld[1])                               ;
    my $des2 = to_ascii($Fld[2])                               ;
    my $cart = to_ascii($Fld[11])                              ;
    my $unit = to_ascii($Fld[12])                              ;
    my $imba = to_ascii($Fld[13])                              ;
#        *------------------------------------------------------*
#        * Codice alfanumerico prodotto                         *
#        *------------------------------------------------------*
    my $alf = sprintf ("%-9s",$code)                           ;
#        *------------------------------------------------------*
#        * Descrizione 1 in uppercase                           *
#        *------------------------------------------------------*
    $des1 = uc $des1                                           ;
    $des1 = sprintf ("%-40s",$des1)                            ;    
#        *------------------------------------------------------*
#        * Descrizione 2 in uppercase                           *
#        *------------------------------------------------------*
    $des2 = uc $des2                                           ;
    $des2 = sprintf ("%-40s",$des2)                            ;
#        *------------------------------------------------------*
#        * Contenuto cartone                                    *
#        *------------------------------------------------------*
    if ($cart)
    {
        $cart = sprintf ("%-20s",$cart)                        ;
    }
     else
    {
        $cart = sprintf ("%-20s"," ")                          ;
    }
#        *------------------------------------------------------*
#        * Unita' per l'ordine                                  *
#        *------------------------------------------------------*
    if ($unit)
    {
        $unit = sprintf ("%-20s",$unit)                        ;
    }
     else
    {
        $unit = sprintf ("%-20s"," ")                          ;
    }
#        *------------------------------------------------------*
#        * Imballo                                              *
#        *------------------------------------------------------*
    if ($imba)
    {
        $imba = sprintf ("%-20s",$imba)                        ;
    }
     else
    {
        $imba = sprintf ("%-20s"," ")                          ;
    }
#        *------------------------------------------------------*
#        * Emissione della riga                                 *
#        *------------------------------------------------------*
    print O_FILE "$alf $des1 $des2 $cart $unit $imba\n"        ;   
#        *------------------------------------------------------*
#        * Incremento riga                                      *
#        *------------------------------------------------------*
    $row++                                                     ;
}

#===============================================================*
# Chiusura file input                                           *
#---------------------------------------------------------------*
close I_FILE                                                   ;

#===============================================================*
# Chiusura file output                                          *
#---------------------------------------------------------------*
close O_FILE                                                   ;

#===============================================================*
# Apertura file da trattare                                     *
#---------------------------------------------------------------*
sub f_input
{
    open (I_FILE, "$csv") or die
         "Impossibile aprire il file '$csv'"                   ;
}

#===============================================================*
# Apertura file da trattare                                     *
#---------------------------------------------------------------*
sub f_output
{
    open (O_FILE, ">$out") or die
         "Impossibile aprire il file '$out'"                   ;
}
