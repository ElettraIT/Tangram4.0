     ############ /abd/etc/altrboot
     #
     # Procedura di boot per l' ambiente TANGRAM
     #
     ######
     
######
# - Rimozione eventuali files temporanei residui
###

(cd /abd/tmp; find . ! -name . -type f -exec rm {} \;)

######
# - Rimozione eventuali files di spool residui
###

(cd /abd/spl; find . ! -name . -type f -exec rm {} \;)

######
# - Rimozione eventuali files di sort residui
###

(cd /abd/srt; find . ! -name . -type f -exec rm {} \;)

