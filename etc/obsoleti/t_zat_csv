#!/usr/bin/perl -w
#===============================================================*
#                                                               *
# Parser file di tipo CSV                                       *
#                                                               *
# ------------------------------------------------------------- *
#                                                               *
# Parametri in input : - file CSV da tradurre (percorso)        *
#                                                               *
#                   ------------------------------------------- *
#                    Versione originale:    001 del 07/10/09    *
#                      Ultima revisione:    NdK del 10/05/11    *
#                   ------------------------------------------- *
#                                Autore:    Nicola de Kunovich  *
# ------------------------------------------------------------- *
# SU MISURA PER ZATTI : Traduzione file da Tedesco a ASCII      *
# ------------------------------------------------------------- *
#                                                               *
# Utilizzo :                                                    *
#                                                               *
# $ t_zat_csv /percorso/FILE                                    *
#                                                               *
# Pulizia preliminare CR in '/abd/asc/imp/new.csv'              *
#                                                               *
# Output in file temporaneo '/abd/asc/imp/FILE_IT.CSV'          *
#                                                               *
# ------------------------------------------------------------- *
#                                                               *
# Utilizzato dal programma 'pgpz2200'                           *
#                                                               *
#===============================================================*

#===============================================================*
# Dichiarazione per restrizione variabili                       *
#---------------------------------------------------------------*
use strict                                                     ;

#===============================================================*
# Moduli Perl                                                   *
#---------------------------------------------------------------*
use Lingua::DE::ASCII                                          ;
use Text::CSV                                                  ;

#===============================================================*
# Lettura della variabile in input                              *
#---------------------------------------------------------------*
my $fil = $ARGV[0]                                             ;

#===============================================================*
# Variabili di appoggio                                         *
#---------------------------------------------------------------*
my $inp = "/abd/asc/imp/new.csv"                               ;
my $out = "/abd/asc/imp/FILE_IT.CSV"                           ;

#===============================================================*
# Trattamento preliminare file in input                         *
#---------------------------------------------------------------*
&f_trt_input                                                   ;

#===============================================================*
# Open del file in input                                        *
#---------------------------------------------------------------*
&f_input                                                       ;

#===============================================================*
# Open del file in output                                       *
#---------------------------------------------------------------*
&f_output                                                      ;

#===============================================================*
# Trattamento file                                              *
#---------------------------------------------------------------*
#    *----------------------------------------------------------*
#    * Normalizzazione contatore righe                          *
#    *----------------------------------------------------------*
my $row = 0                                                    ;
#    *----------------------------------------------------------*
#    * Ciclo di scansione                                       *
#    *----------------------------------------------------------*
while (<I_FILE>)
{
#        *------------------------------------------------------*
#        * Pulizia fine riga                                    *
#        *------------------------------------------------------*
    chomp                                                      ;
    
#        *------------------------------------------------------*
#        * Split della riga                                     *
#        *------------------------------------------------------*
    my @Fld = split(';', $_)                                   ;
#        *------------------------------------------------------*
#        * Filtraggio caratteri accentati                       *
#        *------------------------------------------------------*
    my $des1 = to_ascii($Fld[4])                               ;
    my $des2 = to_ascii($Fld[18])                              ;
#        *------------------------------------------------------*
#        * Emissione della riga                                 *
#        *------------------------------------------------------*
#        * (Debug)                                              *
#        *------------------------------------------------------*
#   print @Fld . "\n"                                          ;

    print O_FILE "$Fld[0]"
               . ";"
               . "$Fld[1]"
               . ";"
               . "$Fld[2]"
               . ";"
               . "$Fld[3]"
               . ";"
               . "$des1"
               . ";"
               . "$Fld[5]"
               . ";"
               . "$Fld[6]"
               . ";"
               . "$Fld[7]"
               . ";"
               . "$Fld[8]"
               . ";"
               . "$Fld[9]"
               . ";"
               . "$Fld[10]"
               . ";"
               . "$Fld[11]"
               . ";"
               . "$Fld[12]"
               . ";"
               . "$Fld[13]"
               . ";"
               . "$Fld[14]"
               . ";"
               . "$Fld[15]"
               . ";"
               . "$Fld[16]"
               . ";"
               . "$Fld[17]"
               . ";"
               . "$des2"
               . ";"
               . "$Fld[19]"
               . ";"
               . "$Fld[20]\n"                                  ;
#        *------------------------------------------------------*
#        * Incremento riga                                      *
#        *------------------------------------------------------*
    $row++                                                     ;
}

#===============================================================*
# Chiusura file input                                           *
#---------------------------------------------------------------*
close I_FILE                                                   ;

#===============================================================*
# Chiusura file output                                          *
#---------------------------------------------------------------*
close O_FILE                                                   ;

#===============================================================*
# Apertura file da trattare                                     *
#---------------------------------------------------------------*
sub f_input
{
    open (I_FILE, "$inp") or die
         "Impossibile aprire il file '$inp'"                   ;
}

#===============================================================*
# Apertura file da trattare                                     *
#---------------------------------------------------------------*
sub f_output
{
    open (O_FILE, ">$out") or die
         "Impossibile aprire il file '$out'"                   ;
}

#===============================================================*
# Trattamento preliminare file in input                         *
#---------------------------------------------------------------*
sub f_trt_input
{
 my @rows;
 my $csv = Text::CSV->new ( { allow_loose_quotes => 1, binary => 1 } )
    or die "Cannot use CSV: ".Text::CSV->error_diag ()         ;
 
 open my $fh, "<:encoding(iso-8859-1)", "$fil" or die "$fil: $!";
 while ( my $row = $csv->getline( $fh ) )
 {
     push @rows, $row;
 }
 $csv->eof or $csv->error_diag();
 close $fh;
 
 $csv->eol ("\r\n");
 
 open $fh, ">:encoding(utf8)", "$inp" or die "$inp: $!";
 $csv->print ($fh, $_) for @rows;
 close $fh or die "$inp: $!";
}

