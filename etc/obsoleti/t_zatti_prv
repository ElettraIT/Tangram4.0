#!/usr/bin/perl -w
# Legge da HTTP, scrive su file e invia tramite FTP
# Funziona anche mettendo la data ...

use Net::HTTP;

my $ann = (localtime)[5]                  ;
my $anu = int($ann)                       ;
$anu = $anu + 1900                        ;
my $anx = sprintf ("%04d",$anu)           ;

my $mes = (localtime)[4]                  ;
my $meu = int($mes)                       ;
$meu = $meu + 1                           ;
my $mex = sprintf ("%02d",$meu)           ;

my $gio = (localtime)[3]                  ;

# my $giu = int($gio)                       ;
# $giu = $giu - 1                           ;
# my $gix = sprintf ("%02d",$giu)           ;

my $gix = sprintf ("%02d",$gio)           ;


my $dat = $anx  . $mex . $gix             ;

my $req = "/utente/classi/gest_img/addImg_b.php?ric_prd=143232";

my $s = Net::HTTP->new(Host => "www.zatti.it") || die $@;

$s->write_request(GET => $req, 'User-Agent' => "Mozilla/5.0");

my($code, $mess, %h) = $s->read_response_headers;

open (IMMAGINE, ">/abd/asc/tmp/ct1.jpg") or die
         "Impossibile aprire il file Immagine";

while (1) {
   my $buf;
   my $n = $s->read_entity_body($buf, 1024);
   die "read failed: $!" unless defined $n;
   last unless $n;
   print IMMAGINE $buf;   
}

close IMMAGINE;

use Net::FTP;

$ftp = Net::FTP->new("www9.protec.it", Debug => 0)
  or die "Cannot connect to some.host.name: $@";

$ftp->login("dkb",'cavallo')
  or die "Cannot login ", $ftp->message;

$ftp->cwd("dkb.it/img")
  or die "Cannot change working directory ", $ftp->message;

$ftp->binary
  or die "Cannot make binary ", $ftp->message;

$ftp->put("/abd/asc/tmp/ct1.jpg")
  or die "put failed ", $ftp->message;

$ftp->quit;
