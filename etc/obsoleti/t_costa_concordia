#==========================================*
# Moduli Perl utilizzati                   *
#------------------------------------------*
use Net::HTTP                             ;
use Net::FTP                              ;

#==========================================*
# Elaborazione della data - NON UTILIZZATA *
#------------------------------------------*
    #--------------------------------------*
    # Data di sistema (AAAA) - Anno (est.) *
    #--------------------------------------*
    my $ann = sprintf("%04d",
                     (localtime)[5]+1900) ;
    #--------------------------------------*
    # Data di sistema (MM) - Mese          *
    #--------------------------------------*
    my $mes = sprintf("%02d",
                     (localtime)[4]+1)    ;
    #--------------------------------------*
    # Data di sistema (GG) - Giorno        *
    #--------------------------------------*
    my $gio = sprintf("%02d",
                     (localtime)[3])      ;

my $dat = $ann  . $mes . $gio             ;

#==========================================*
# Elaborazione della data - NON UTILIZZATA *
#                                          *
# Fine                                     *
#------------------------------------------*

#==========================================*
# Variabili statiche                       *
#------------------------------------------*
#my $req = "/upload_teolo/bollettini_meteo"
#        . "/meteoveneto/ct1.jpg"          ;

my $req = "/isoladelgiglio_traghetto.jpg";

#==========================================*
# Richiesta HTTP                           *
#------------------------------------------*
my $s = Net::HTTP->new(Host => "www.giglionews.com") || die $@;

$s->write_request(GET => $req, 'User-Agent' => "Mozilla/5.0");

my($code, $mess, %h) = $s->read_response_headers;

#==========================================*
# Open Immagine                            *
#------------------------------------------*
open (IMMAGINE, ">/abd/asc/tmp/isoladelgiglio_traghetto.jpg") or die
         "Impossibile aprire il file Immagine";

#==========================================*
# Scrittura Immagine                       *
#------------------------------------------*
while (1) {
   my $buf                                ;
   my $n = $s->read_entity_body($buf, 1024);
   die "read failed: $!" unless defined $n;
   last unless $n                         ;
   print IMMAGINE $buf                    ;   
}

#==========================================*
# Close Immagine                           *
#------------------------------------------*
close IMMAGINE                            ;

#==========================================*
# Invio finale del file al Server          *
#------------------------------------------*
&ftpf                                     ;

#==========================================*
# Subroutine di trasferimento del file     *
#------------------------------------------*
sub ftpf
{
    #--------------------------------------*
    # Apertura connessione                 *
    #--------------------------------------*
    $ftp = Net::FTP->new("www17.protec.it", Debug => 0)
       or die "Cannot connect to some.host.name: $@";

    #--------------------------------------*
    # Login connessione                    *
    #--------------------------------------*
    $ftp->login("dkb",'cavallo')
       or die "Cannot login ", $ftp->message;

    #--------------------------------------*
    # Posizionamento cartella destinazione *
    #--------------------------------------*
    $ftp->cwd("dkb.it/img/mix")
       or die "Cannot change working"
            . "directory ", $ftp->message ;

    #--------------------------------------*
    # Modalita' Binary                     *
    #--------------------------------------*
    $ftp->binary
       or die "Cannot make binary ", $ftp->message;

    #--------------------------------------*
    # Trasferimento                        *
    #--------------------------------------*
    $ftp->put("/tmp/isoladelgiglio_traghetto.jpg")
       or die "put failed ", $ftp->message;

    #--------------------------------------*
    # Chiusura FTP                         *
    #--------------------------------------*
    $ftp->quit                            ;
}


