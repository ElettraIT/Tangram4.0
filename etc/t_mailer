use MIME::Lite                            ;
use Net::SMTP_auth                        ;

#=========================================*
# Variabili statiche                      *
# --------------------------------------- *
#  - Pathname di base per i file          *
#  - Nome file contenente il soggetto     *
#-----------------------------------------*
$base = '/abd/asc/'                       ;
$temp = '/tmp/'                           ;
#$apdf = '/pdf/out/'                      ;
$sogg = 'sogg.txt'                        ;

#=========================================*
# Variabili lette in input                *
#-----------------------------------------*

#    *------------------------------------*
#    * Lettura variabile in input         *
#    *------------------------------------*
$inpt = $ARGV[0]                          ;

#==========================================*
# Help                                     *
#------------------------------------------*
if (!$ARGV[0] || $ARGV[0] eq "-help")
{
    print "\n"
        . "Uso :"
        . "\n"
        . "> t_mailer UTENTE tangram,"
        . "SERVER_SMTP,"
        . "MITTENTE,"
        . "FILE_LISTA,"
        . "FILE_MESS(opz),"
        . "FILE_ATTACH(opz),"
        . "FILENAME_ATTACH(opz),"
        . "FILE_SOGG(opz),"
        . "SI/NO_RICEVUTA(opz),"
        . "ID_USER(opz),"
        . "PWD_USER(opz),"
        . "\n"
        . "\n"
        . "Release : 17/01/2013"
        . "\n"
        . "\n"
        . "(C) Copyright - dKb"
        . "\n"
        . "\n"                            ;
    exit()                                ;
}

#    *------------------------------------*
#    * Separazione dei componenti (,)     *
#    *------------------------------------*
@vars = split(/,/, $inpt)                 ;

#    *====================================*
#    * Utente Tangram                     *
#    *------------------------------------*
$user = $vars[0]                          ;
#    *------------------------------------*
#    * Server di posta                    *
#    *------------------------------------*
$isps = $vars[1]                          ;
#    *------------------------------------*
#    * Mittente                           *
#    *------------------------------------*
$mitt = $vars[2]                          ;
#    *------------------------------------*
#    * Destinatari / destinatario         *
#    *------------------------------------*
$indi = $vars[3]                          ;
#    *------------------------------------*
#    * File contenente il messaggio       *
#    *------------------------------------*
$mess = $vars[4]                          ;
#    *------------------------------------*
#    * File attachement       (opzionale) *
#    *------------------------------------*
$attp = $vars[5]                          ;
#    *------------------------------------*
#    * Nome attachement       (opzionale) *
#    *------------------------------------*
$atta = $vars[6]                          ;
#    *------------------------------------*
#    * Soggetto manuale       (opzionale) *
#    *------------------------------------*
$msog = $vars[7]                          ;
#    *------------------------------------*
#    * Si/no ricevuta         (opzionale) *
#    *------------------------------------*
$snxr = $vars[8]                          ;
#    *------------------------------------*
#    * ID account             (opzionale) *
#    *------------------------------------*
$uidx = $vars[9]                          ;
#    *------------------------------------*
#    * PW account             (opzionale) *
#    *------------------------------------*
$pwdx = $vars[10]                         ;

