#    exit ();

#=========================================*
# Normalizzazioni                         *
#-----------------------------------------*
    #-------------------------------------*
    # Pathname file testo                 *
    #-------------------------------------*
if (!$mess) { $mess = 'mess.txt';}
    #-------------------------------------*
    # Pathname file lista indirizzi       *
    #-------------------------------------*
if (!$indi) { $indi = 'mail.001';}
    #-------------------------------------*
    # Si/no ricevuta                      *
    #-------------------------------------*
if (!$snxr) { $snxr = "N";}

#=========================================*
# Sub-routine per lettura soggetto        *
#-----------------------------------------*
&soggetto                                 ;

#=========================================*
# Sub-routine per lettura testo           *
#-----------------------------------------*
&messaggio                                ;

#=========================================*
# Sub-routine di spedizione               *
#-----------------------------------------*
&spedisci                                 ;

#******************************************
# SUB-ROUTINES                            *
#******************************************

#=========================================*
# Spedizione                              *
#-----------------------------------------*
sub spedisci 
{
    #-------------------------------------*
    # Se passata una lista                *
    #-------------------------------------*
    if ($indi !~ /\@/)
         {&lista;}
    #-------------------------------------*
    # Se passato un singolo indirizzo     *
    #-------------------------------------*
    else {$indirizzo=$indi;
          &send};
}

#=========================================*
# Singolo invio con MIME::Lite            *
#-----------------------------------------*
sub send
{
    #-------------------------------------*
    # Invio vero e proprio                *
    #-------------------------------------*
      $msg = MIME::Lite->new
    (
        #---------------------------------*
        # Mittente                        *
        #---------------------------------*
        'From'  =>$mitt,
        #---------------------------------*
        # Destinatario e mittente         *
        #---------------------------------*
        #To      =>$indirizzo,
        'To'     =>[$indirizzo, $mitt],
        #---------------------------------*
        # Copia per il mittente: sempre   *
        #                                 *
        # N.B.: non va in MIME::Lite!     *
        #---------------------------------*
        #Bcc     =>$mitt,
        #---------------------------------*
        # Oggetto                         *
        #---------------------------------*
        'Subject' =>@subject,
        #---------------------------------*
        # Tipo messaggio                  *
        #---------------------------------*
        Type    =>'multipart/alternative',
    );
    
    #-------------------------------------*
    # Eventuale ricevuta di ritorno       *
    #-------------------------------------*
    if ($snxr eq "S")
        {
            &rerc;
        }

    $msg->attach
    (
        Type    => 'text/html',
        Data    => $testo
    );

    #-------------------------------------*
    # Eventuale attachement               *
    #-------------------------------------*
    if ($atta)
        {
            $msg->attach
                (Type        => 'application/pdf',
                 Path        => $attp,
                 Filename    => $atta,
                 Disposition => 'attachment'
                );
        }

    #-------------------------------------*
    # Spedizione in funzione della        *
    # eventuale autenticazione            *
    #-------------------------------------*
    if ($pwdx)
    {
        #---------------------------------*
        # Uso di SMTP_auth                *
        #---------------------------------*
        my $smtp = Net::SMTP_auth -> new($isps, debug=>1);
        
        $smtp -> auth( 'PLAIN', $uidx, $pwdx);
    
        $smtp->mail($mitt)                ;
        $smtp->recipient($indirizzo)      ;
        $smtp -> data()                   ;
                
        $smtp -> datasend( $msg->as_string());
        $smtp -> dataend()                ;
        $smtp -> quit                     ;
    }
     else
    {
        $msg->send('smtp',
                   $isps,
                   Timeout=>60);
    }
}

#=========================================*
# Trattamento soggetto                    *
#-----------------------------------------*
sub soggetto 
{
#    *------------------------------------*
#    * Se non passato un soggetto manuale *
#    * si legge il file                   *
#    *------------------------------------*
    if (!$msog)
         {&read_sog;}
#    *------------------------------------*
#    * Se passato un soggetto manuale     *
#    *------------------------------------*
    else {@subject=qq{$msog};};
}

#=========================================*
# Apertura file contenente il soggetto    *
#-----------------------------------------*
sub read_sog
{
    open (SOGGETTO, "$base$user$temp$sogg")or die
         "Impossibile aprire il file '$sogg'";
    @subject=<SOGGETTO>;
    close SOGGETTO;
}

#=========================================*
# Apertura file contenente il messaggio   *
#-----------------------------------------*
sub messaggio
{
    #-------------------------------------*
    # Open                                *
    #-------------------------------------*
    open (MESSAGE, "$base$user$temp$mess")
          or die
         "Impossibile aprire il file '$mess'";
    @message=<MESSAGE>;
    close MESSAGE;
    #-------------------------------------*
    # Compattazione testo letto           *
    #-------------------------------------*
    $testo = qq{@message};
}

#=========================================*
# Invio ad una lista                      *
#-----------------------------------------*
sub lista
{
    open (INDIRIZZI, "$base$temp$indi")or die
        "Impossibile aprire il file indirizzi";
    @indirizzo = <INDIRIZZI>;
    foreach $indirizzo (@indirizzo)
    {
        if ($indirizzo !~ /\@/)
            {next}
            else {&send};
    }
    close (INDIRIZZI);
}

#=========================================*
# Ricevuta di ritorno                     *
#                                         *
# (rivedere ID)                           *
#                                         *
#-----------------------------------------*
sub rerc
{
    $msg->add("Disposition-Notification-To:" =>$mitt );
#   $msg->add("Message-ID:" =>'123456789');
}
