#!/usr/bin/perl -w
#===============================================================*
#                                                               *
# Traduttore in formato Spreadsheet (tipo Excel)                *
#                                                               *
# Ad hoc per Ordini Fornitori SIRI                              *
#                                                               *
#                   ------------------------------------------- *
#                    Versione originale:    001 del 14/10/05    *
#                      Ultima revisione:    NdK del 20/03/06    *
#                   ------------------------------------------- *
#                                Autore:    Nicola de Kunovich  *
# ------------------------------------------------------------- *
#                                                               *
# Parametri in input : - file CSV da tradurre (percorso)        *
#                                                               *
# ------------------------------------------------------------- *
#                                                               *
# Utilizzo :                                                    *
#                                                               *
# $ t_sir_orf_xls /percorso/FILE                                *
#                                                               *
#===============================================================*

#===============================================================*
# Dichiarazione per restrizione variabili                       *
#---------------------------------------------------------------*
use strict                                                     ;

#===============================================================*
# Modulo Perl Spreadsheet::WriteExcel                           *
#---------------------------------------------------------------*
use Spreadsheet::WriteExcel                                    ;

#===============================================================*
# Lettura della variabile in input                              *
#---------------------------------------------------------------*
my $csv = $ARGV[0]                                             ;

#===============================================================*
# Open del file in input                                        *
#---------------------------------------------------------------*
&f_input                                                       ;

#===============================================================*
# Trattamento foglio                                            *
#---------------------------------------------------------------*
#    *----------------------------------------------------------*
#    * Nuovo file                                               *
#    *----------------------------------------------------------*
my $workbook  = Spreadsheet::WriteExcel->new("$csv.xls")       ;
my $worksheet = $workbook->add_worksheet()                     ;

#    *----------------------------------------------------------*
#    * Formattazione per celle                                  *
#    *                                                          *
#    * Bordo da 1 punto di spessore                             *
#    *----------------------------------------------------------*
my $cel_fmt = $workbook->add_format()                          ;
   $cel_fmt->set_border(1)                                     ;

#    *----------------------------------------------------------*
#    * Formattazione colonne valori                             *
#    *                                                          *
#    * Formato numero e 'bold'                                  *
#    *----------------------------------------------------------*
my $col_fmt = $workbook->add_format()                          ;
   $col_fmt->set_num_format('#,###.00')                        ;
   $col_fmt->set_bold()                                        ;

#    *----------------------------------------------------------*
#    * Formattazione colonne                                    *
#    *----------------------------------------------------------*
#        *------------------------------------------------------*
#        * Data ordine                                          *
#        *------------------------------------------------------*
$worksheet->set_column(0, 0, 10)                               ;
#        *------------------------------------------------------*
#        * Numero ordine                                        *
#        *------------------------------------------------------*
$worksheet->set_column(1, 1, 9)                                ;
#        *------------------------------------------------------*
#        * Progressivo riga ordine                              *
#        *------------------------------------------------------*
$worksheet->set_column(2, 2, 5)                                ;
#        *------------------------------------------------------*
#        * Codice prodotto                                      *
#        *------------------------------------------------------*
$worksheet->set_column(3, 3, 14)                               ;
#        *------------------------------------------------------*
#        * Codice prodotto per il fornitore                     *
#        *------------------------------------------------------*
$worksheet->set_column(4, 4, 20)                               ;
#        *------------------------------------------------------*
#        * Quantita' ordinata                                   *
#        *------------------------------------------------------*
$worksheet->set_column(5, 5, 10)                               ;
#        *------------------------------------------------------*
#        * Data consegna richiesta                              *
#        *------------------------------------------------------*
$worksheet->set_column(6, 6, 10)                               ;
#        *------------------------------------------------------*
#        * Quantita' confermata                                 *
#        *------------------------------------------------------*
$worksheet->set_column(7, 7, 10)                               ;
#        *------------------------------------------------------*
#        * Data consegna confermata                             *
#        *------------------------------------------------------*
$worksheet->set_column(8, 8, 10)                               ;
#        *------------------------------------------------------*
#        * Prezzo speciale                                      *
#        *------------------------------------------------------*
$worksheet->set_column(9, 9, 10, $col_fmt)                     ;
#        *------------------------------------------------------*
#        * Commento                                             *
#        *------------------------------------------------------*
$worksheet->set_column(10, 10, 20)                             ;

#    *----------------------------------------------------------*
#    * Normalizzazione contatore righe                          *
#    *----------------------------------------------------------*
my $row = 0                                                    ;

#    *----------------------------------------------------------*
#    * Ciclo di scansione                                       *
#    *----------------------------------------------------------*
while (<I_FILE>) {

#        *------------------------------------------------------*
#        * Pulizia fine riga                                    *
#        *------------------------------------------------------*
    chomp                                                      ;

#        *------------------------------------------------------*
#        * Split della riga                                     *
#        *------------------------------------------------------*
    my @Fld = split(';', $_)                                   ;

#        *------------------------------------------------------*
#        * Costruzione colonne                                  *
#        *------------------------------------------------------*
#            *--------------------------------------------------*
#            * Data ordine                                      *
#            *--------------------------------------------------*
    $worksheet->write_string($row, 0, $Fld[0], $cel_fmt)       ;
#            *--------------------------------------------------*
#            * Numero ordine                                    *
#            *--------------------------------------------------*
    $worksheet->write_string($row, 1, $Fld[1], $cel_fmt)       ;
#            *--------------------------------------------------*
#            * Progressivo riga ordine                          *
#            *--------------------------------------------------*
    $worksheet->write_string($row, 2, $Fld[2], $cel_fmt)       ;
#            *--------------------------------------------------*
#            * Codice prodotto                                  *
#            *--------------------------------------------------*
    $worksheet->write_string($row, 3, $Fld[3], $cel_fmt)       ;
#            *--------------------------------------------------*
#            * Codice prodotto per il fornitore                 *
#            *--------------------------------------------------*
    $worksheet->write_string($row, 4, $Fld[4], $cel_fmt)       ;
#            *--------------------------------------------------*
#            * Quantita' ordinata                               *
#            *--------------------------------------------------*
    $worksheet->write_string($row, 5, $Fld[5], $cel_fmt)       ;
#            *--------------------------------------------------*
#            * Data consegna richiesta                          *
#            *--------------------------------------------------*
    $worksheet->write_string($row, 6, $Fld[6], $cel_fmt)       ;
#            *--------------------------------------------------*
#            * Quantita' confermata                             *
#            *--------------------------------------------------*
    $worksheet->write_string($row, 7, $Fld[7], $cel_fmt)       ;
#            *--------------------------------------------------*
#            * Data consegna confermata                         *
#            *--------------------------------------------------*
    $worksheet->write_string($row, 8, $Fld[8], $cel_fmt)       ;
#            *--------------------------------------------------*
#            * Prezzo speciale                                  *
#            *--------------------------------------------------*
    $worksheet->write_number($row, 9, $Fld[9], $col_fmt)       ;
#            *--------------------------------------------------*
#            * Commento                                         *
#            *--------------------------------------------------*
    $worksheet->write_string($row, 10, $Fld[10], $cel_fmt)     ;
#        *------------------------------------------------------*
#        * Incremento riga                                      *
#        *------------------------------------------------------*
    $row++                                                     ;
}

#===============================================================*
# Apertura file da trattare                                     *
#---------------------------------------------------------------*
sub f_input
{
    open (I_FILE, "$csv.CSV") or die
         "Impossibile aprire il file '$csv.CSV'"               ;
}

#===============================================================*
# Chiusura file da trattare                                     *
#---------------------------------------------------------------*
close I_FILE                                                   ;

