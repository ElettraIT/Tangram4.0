#!/usr/bin/perl -w
#==========================================*
# Modulo Perl per importare le fatture     *
# fornitori in formato 'xml' o 'p7m' con   *
# aggiornamento del database e creazione   *
# della versione 'html' del file           *
#                                          *
# Nome del modulo: t_xml_for_imp           *
#                                          *
# N.B.: Utilizzato da 'pscf8000'           *
#                                          *
# NOTA IMPORTANTE : le 'testate' conten-   *
#                   gono l'estensione      *
#                   'p7m' mentre le        *
#                   'righe' no!!!          *
#                                          *
# ---------------------------------------- *
# Versione originale:   001 del 19/04/2021 *
#   Ultima revisione:   wip del 21/02/2025 *
# ---------------------------------------- *
#             Autore:   Nicola de Kunovich *
# ---------------------------------------- *
#                                          *
# In input       : - codice azienda        *
#                                          *
# (Configurazione: - 't_xml_for.ini'       *
#                  - 'dtb.ini')            *
#                                          *
# (LOG           : - 't_xml_for_imp.log'   *
#                                          *
# ---------------------------------------- *
# Per creare il database                   *
#                                          *
# CREATE TABLE `{AZI}`.`xml_for` (         *
# `nam_xml` VARCHAR( 40 ) NOT NULL ,       *
# `tip_doc` VARCHAR( 20 ) NOT NULL ,       *
# `num_doc` VARCHAR( 40 ) NOT NULL ,       *
# `dat_doc` DATE NOT NULL ,                *
# `ide_fis` VARCHAR( 20 ) NOT NULL ,       *
# `den_azi` VARCHAR( 80 ) NOT NULL ,       *
# `att_pth` VARCHAR( 80 ) NOT NULL ,       *
# `dat_imp` DATETIME NOT NULL ,            *
# `dat_sql` DATETIME NOT NULL ,            *
# `dat_tgm` DATETIME NOT NULL ,            *
# PRIMARY KEY ( `nam_xml` )                *
# ) ENGINE = MYISAM;                       *
#                                          *
# (Utilizzato da 't_xml_for_wrt')          *
#                                          *
# CREATE TABLE `{AZI}`.`xml_frr` (         *
# `nam_xml` varchar(40) NOT NULL,          *
# `tip_rec` tinytext NOT NULL,             *
# `tip_ele` varchar(5) NOT NULL,           *
# `ctr_ele` varchar(5) NOT NULL,           *
# `pmt_ele` varchar(60) NOT NULL,          *
# `val_ele` mediumtext NOT NULL,           *
# `dat_imp` datetime NOT NULL              *
# ) ENGINE = MYISAM;                       *
#==========================================*

#==========================================*
# Moduli Perl utilizzati                   *
#------------------------------------------*
use DBI()                                 ;
use XML::Simple                           ;
use File::Basename                        ;
use File::Copy                            ;
use Unicode::Normalize                    ;
use MIME::Base64 qw(decode_base64)        ;
use XML::LibXSLT                          ;
use Archive::Zip                          ;

#==========================================*
# Valori in input                          *
#------------------------------------------*
my $cod_azi = shift                       ;

#==========================================*
# Help                                     *
#------------------------------------------*
if (!$cod_azi || $cod_azi eq "-help")
{
    my $sys_clr = "clear"                 ;
    system($sys_clr)                      ;
    print "\n"
        . "Uso :"
        . "\n"
        . "> t_xml_for_imp {AZI} "
        . "\n"
        . "\n"
        . "(C) Copyright - wip - 3 giugno 2021"
        . "\n"
        . "\n"                            ;
    exit()                                ;
}

#==========================================*
# Variabili definite                       *
#------------------------------------------*
#------------------------------------------*
# Directory di configurazione base         *
#------------------------------------------*
my $cfg_bas = "/abd/asc/cfg/"
            . "t_xml_for.ini"             ;
#
my %cnf_ele = do $cfg_bas                 ;
my $pth_scf = $cnf_ele{pth_scf}           ;
my $pth_bas = $cnf_ele{pth_bas}           ;
my $pth_tmp = $cnf_ele{pth_tmp}           ;
my $pth_att = $cnf_ele{pth_att}           ;
my $pth_htm = $cnf_ele{pth_htm}           ;
my $pth_xsl = $cnf_ele{pth_xsl}           ;
#------------------------------------------*
# Parametri di connessione al database     *
#------------------------------------------*
my $dtb_azi = $cod_azi                    ;
#
my $cfg_dtb = "/abd/asc/cfg/dtb.ini"      ;
#
my %cnf_dtb = do $cfg_dtb                 ;
my $dtb_hst = $cnf_dtb{dtb_hst}           ;
my $dtb_usr = $cnf_dtb{dtb_usr}           ;
my $dtb_pwd = $cnf_dtb{dtb_pwd}           ;
my $dtb_tbt = $cnf_dtb{dtb_tbt}           ;
#
my $dtb_fnt = "fnt"                       ;
#------------------------------------------*
# Directory per lettura dei file           *
#------------------------------------------*
my $dir_xml = $pth_bas
            . $cod_azi
            . "/"
            . $pth_scf                    ;
#------------------------------------------*
# Directory per Attachement                *
#------------------------------------------*
my $dir_att = $pth_bas
            . $cod_azi
            . "/"
            . $pth_att                    ;
#------------------------------------------*
# Directory per file 'index.html'          *
#------------------------------------------*
my $dir_ind = $pth_bas
            . $cod_azi
            . "/"
            . $pth_htm
            . "scf800.html"               ;
#------------------------------------------*
# Normalizzazioni                          *
#------------------------------------------*
my $new_pth = ""                          ;
my $old_pth = ""                          ;
#------------------------------------------*
# Data di sistema per LOG                  *
#------------------------------------------*
$theTime = &sys_tim                       ;
#------------------------------------------*
# Data di sistema - Giorno                 *
#------------------------------------------*
my $gio_lct = (localtime)[3]              ;
my $gio_wrk = int($gio_lct)               ;
my $gio_fmt = sprintf ("%02d",$gio_wrk)   ;
#------------------------------------------*
# Data di sistema - Mese                   *
#------------------------------------------*
my $mes_lct = (localtime)[4]              ;
my $mes_wrk = int($mes_lct)               ;
   $mes_wrk = $mes_wrk + 1                ;
my $mes_fmt = sprintf ("%02d",$mes_wrk)   ;
#------------------------------------------*
# Data di sistema - Anno                   *
#------------------------------------------*
my $ann_lct = (localtime)[5]              ;
my $ann_wrk = int($ann_lct)               ;
   $ann_wrk = $ann_wrk + 1900             ;
my $ann_fmt = sprintf ("%04d",$ann_wrk)   ;
#------------------------------------------*
# Data di sistema - Ora                    *
#------------------------------------------*
my $ora_lct = (localtime)[2]              ;
my $ora_wrk = int($ora_lct)               ;
my $ora_fmt = sprintf ("%02d",$ora_wrk)   ;
#------------------------------------------*
# Data di sistema - Minuti                 *
#------------------------------------------*
my $min_lct = (localtime)[1]              ;
my $min_wrk = int($min_lct)               ;
my $min_fmt = sprintf ("%02d",$min_wrk)   ;

#------------------------------------------*
# Normalizzazione contatore righe html     *
#------------------------------------------*
my $ctr_ind = 0                           ;

#==========================================*
# Open file di 'index.html'                *
#------------------------------------------*
&opn_ind                                  ;

#==========================================*
# DEBUG                                    *
#------------------------------------------*
# print "dir_xml = " . $dir_xml . "\n"    ;
# print "dir_new = " . $pth_tmp . "\n"    ;
# exit()                                  ;
            
#==========================================*
# Connessione database                     *
#------------------------------------------*
my $dtb_con = DBI->connect("DBI:"
                         . "mysql:database="
                         . "$dtb_azi;"
                         . "host=$dtb_hst",
                                  $dtb_usr,
                                  $dtb_pwd,
                          {RaiseError => 1,
                           PrintError => 0});

#==========================================*
# Open del file di LOG                     *
#------------------------------------------*
my $log_fil = $pth_bas
            . 'log/t_xml_for_imp.log'     ;
open (LOG_FIL, ">>$log_fil") or die 
        "Impossibile aprire '$log_fil'"   ;

#==========================================*
# Ciclo di scansione cartella              *
#------------------------------------------*
opendir(DIR, $dir_xml)                    ;
my @dir=grep { !/^\.+$/ } sort readdir(DIR);
closedir(DIR)                             ;

#==========================================*
# Scansione elenco dei file                *
#------------------------------------------*
foreach my $fil_for (@dir)
{
    #--------------------------------------*
    # Skip directory                       *
    #--------------------------------------*
    if(-d $fil_for)
        { next;}                          ;
    #--------------------------------------*
    # Skip dei file "."                    *
    #--------------------------------------*
    if($fil_for eq "." || $fil_for eq "..")
        { next;}                          ;
    #--------------------------------------*
    # Skip dei file che iniziano  "._"     *
    #--------------------------------------*
    my $sys_fil = substr($fil_for,0,2)    ;
    if($sys_fil eq "._")
        { next;}                          ;
    #--------------------------------------*
    # Se il file trattato non e' una di-   *
    # rectory                              *
    #--------------------------------------*
    if (! -d $fil_for)
    {
        #----------------------------------*
        # Estrazione nome file             *
        #----------------------------------*
       (my $fil_nam,
        my $fil_pat,
        my $fil_ext) = fileparse($fil_for, qr/\.[^.]*/);
        #----------------------------------*
        # Test se nome file duplicato se   *
        # proveniente da ambiente MAC      *
        #----------------------------------*
        my $substr = "xml-1"              ;
        if (index($fil_nam, $substr) != -1)
        {next;}
        #----------------------------------*
        # Test se nome file contiene spazi *
        #----------------------------------*
        my $fil_wrk = $fil_nam            ;
           $fil_wrk =~ s/^\s+|\s+$//g     ;
        if ( $fil_nam ne $fil_wrk)
        {next;}
        #----------------------------------*
        # Skip dei file NON '.xml' o 'p7m' *
        #----------------------------------*
        if ($fil_ext ne ".xml"
         && $fil_ext ne ".XML"
         && $fil_ext ne ".p7m"
         && $fil_ext ne ".P7M")
        {next;}                           ;
        #----------------------------------*
        # Verifica che non si tratti di un *
        # file metadati                    *
        #                                  *
        # ___ VALUTARE ALTRE AZIONI ___    *
        # ___ VEDI 't_xml_for_sdi'  ___    *
        #----------------------------------*
        my $und_scr = "_"                 ;
        my @mat_che = $fil_nam =~ /($und_scr)/g;
        my $und_cnt = @mat_che            ;
        if ($und_cnt == 3){next;}         ;
        #----------------------------------*
        # Verifica preliminare se file gia *
        # importato nel database           *
        #----------------------------------*
        my $det_sts = &det_exi($fil_for)  ;
        if ($det_sts > 0)
        {
            #------------------------------*
            # Messaggio nel LOG            *
            #------------------------------*
            print LOG_FIL
                $theTime
	         . " - File: "
	         . $fil_for
	         . " gia' caricato"
                . "\n"                    ;
            #------------------------------*
            # Messaggio in 'Index.html'    *
            #------------------------------*
            &row_err("Gia' caricato!",
                                  "-",
                                  "-",
                             $fil_for,
                                   "-")   ;
            #------------------------------*
            # A file successivo            *
            #------------------------------*
            next                          ;
        }
        #----------------------------------*
        # Eventuale estrazione preliminare *
        # se estensione 'p7m'              *
        #----------------------------------*
        if ($fil_ext eq ".p7m" || $fil_ext eq ".P7M")
        {
            #------------------------------*
            # Nuovo path                   *
            #------------------------------*
            $old_pth = $dir_xml
                     . $fil_for           ;
            $new_pth = $pth_tmp
                     . $fil_nam           ;
            #------------------------------*
            # Test per file codificati in  *
            # base64                       *
            #                              *
            # Attualmente si riconoscono   *
            # dal nome file, cioe' dalla   *
            # Partita Iva del Fornitore    *
            #                              *
            # ___ MIGLIORARE ___           *
            #                              *
            # ___ VEDI 't_b64_dec_p7m' ___ *
            #                              *
            #------------------------------*
            my $skp_wrk = substr $fil_nam, 0, 13;
            my $sys_cmd = ""              ;
            #
            if ($skp_wrk eq "IT03632460485" ||
                $skp_wrk eq "IT04402180279" ||
                $skp_wrk eq "IT12293460155" ||
                $skp_wrk eq "IT01336610587" ||
                $skp_wrk eq "IT02757620592" ||
                $skp_wrk eq "IT04370040232" ||
                $skp_wrk eq "IT03217580269")
            {
                #--------------------------*
                # Comando di estrazione    *
                # per file in Base64       *
                #--------------------------*
                $sys_cmd = "cat "
                         . $old_pth
                         . " | tr -d '\r\n' "
                         . "| openssl base64"
                         . " -d -A | openssl"
                         . " cms -verify "
                         . "-inform DER "
                         . "-noverify -out "
                         . $new_pth       ;
            }
             else
            {
                #--------------------------*
                # Comando di estrazione    *
                #--------------------------*
                $sys_cmd = "openssl cms -verify "
                         . "-noverify -in "
                         . $old_pth
                         . " -inform DER -out "
                         . $new_pth       ;
            }
            #------------------------------*
            # Esecuzione                   *
            #------------------------------*
            system($sys_cmd . "  >/dev/null 2>&1");
            #------------------------------*
            # Assegnazione nome file       *
            #------------------------------*
            my $fil_pth = $new_pth        ;
        }
         else
        {
            #------------------------------*
            # Nuovo path                   *
            #------------------------------*
            $old_pth = $dir_xml
                     . $fil_for           ;
            $new_pth = $pth_tmp
                     . $fil_nam
                     . $fil_ext           ;
            #------------------------------*
            # Copia del file nella cartel- *
            # la di lavoro                 *
            #------------------------------*
	     copy($old_pth, $new_pth) or print LOG_FIL
                $theTime
	         . " - copia del file "
	         . $old_pth
	         . " -> "
	         . $new_pth
	         . " fallita: $!"
                . "\n"                    ;
        }
        
        #----------------------------------*
        # Check preliminare                *
        #----------------------------------*
        my $chk_xml = XML::Simple->new()  ;
        my $chk_dat = eval{XMLin($new_pth)};
        if ($@) 
        { 
            print LOG_FIL $new_pth
                        . " : Errore - $@";
            next;
        }
        #----------------------------------*
        # Lettura dati singolo file        *
        #----------------------------------*
        my @rea_dat = ()                  ;
           @rea_dat = &rea_doc($new_pth,
                               $fil_nam)  ;
        #----------------------------------*
        # Partita Iva                      *
        #----------------------------------*
        my $rea_piv = $rea_dat[0]         ;
        #----------------------------------*
        # Tipo documento                   *
        #----------------------------------*
        my $rea_tdo = $rea_dat[1]         ;
        #----------------------------------*
        # Data documento                   *
        #----------------------------------*
        my $rea_ddo = $rea_dat[2]         ;
        #----------------------------------*
        # Numero documento                 *
        #----------------------------------*
        my $rea_ndo = $rea_dat[3]         ;
        #----------------------------------*
        # Ragione sociale                  *
        #----------------------------------*
        my $rea_rag = $rea_dat[4]         ;
           $rea_rag =~ s/^\s+|\s+$//g     ;
        #----------------------------------*
        # Percorso Attachment eventuale    *
        #----------------------------------*
        my $rea_att = ""                  ;
        if (defined $rea_dat[5] && $rea_dat[5] ne "")
        {
            $rea_att = $rea_dat[5]        ;
        }
        #----------------------------------*
        # Scrittura su database            *
        #----------------------------------*
        &inp_dtb($rea_tdo,
                 $rea_ddo,
                 $rea_ndo,
                 $rea_piv,
                 $fil_for,
                 $rea_rag,
                 $rea_att)                ;
        #----------------------------------*
        # Creazione 'html' singolo file    *
        #----------------------------------*
        &wrt_htm($new_pth,
                 $fil_nam,
                 $rea_ddo,
                 $rea_ndo,
                 $rea_piv,
                 $rea_rag,
                 $rea_att)                ;
        #----------------------------------*
        # Estrazione anno documento        *
        #----------------------------------*
        my $ann_doc = substr($rea_ddo,0,4);
        #----------------------------------*
        # Percorso documento in base al-   *
        # l'anno                           *
        #----------------------------------*
        $ann_pth = $dir_xml
                 . $ann_doc
                 . "/" 
                 . $fil_for               ;
                 
        #----------------------------------*
        # DEBUG                            *
        #----------------------------------*
#       print "old_pth = " . $old_pth . "\n"    ;
#       print "new_pth = " . $new_pth . "\n\n"    ;
#       print "dir_xml = " . $dir_xml . "\n"    ;
#       print "ann_pth = " . $ann_pth . "\n"    ;
#       print "rea_ddo = " . $rea_ddo . "\n"    ;
#       exit()                                  ;

        #----------------------------------*
        # Privilegi                        *
        # ___ SOPPRESSO ___                *
        #----------------------------------*
#       chmod(0666, $old_pth) or print LOG_FIL
#              $theTime
#              . " - cambio privilegi del file "
#              . $old_pth
#              . " fallita: $!"
#              . "\n"                    ;
        #----------------------------------*
        # Rinomina del file per posizio-   *
        # narlo nell'anno di competenza    *
        # in base alla data del documento  *
        #----------------------------------*
	 rename($old_pth, $ann_pth) or print LOG_FIL
               $theTime
	        . " - copia del file "
	        . $old_pth
	        . " -> "
	        . $ann_pth
	        . " fallita: $!"
               . "\n"                    ;
                 
    #--------------------------------------*
    # Fine ciclo di scansione              *
    #======================================*
    }
}

#==========================================*
# Disconnessione dal database              *
#------------------------------------------*
$dtb_con->disconnect()                    ;

#==========================================*
# Close file 'index.html'                  *
#------------------------------------------*
&cls_ind                                  ;

#==========================================*
# Close file di LOG                        *
#------------------------------------------*
close LOG_FIL                             ;

#------------------------------------------*
# Fine script                              *
#==========================================*

#==========================================*
# SUBROUTINES                              *
#==========================================*

#==========================================*
# Apertura file 'index.html'               *
#------------------------------------------*
sub opn_ind
{
    #--------------------------------------*
    # Open                                 *
    #--------------------------------------*
    open (IND_HTM, ">$dir_ind") or die 
        "Impossibile aprire '$dir_ind'"   ;
    #--------------------------------------*
    # Trattamento data di sistema          *
    #--------------------------------------*
    my $dat_sys = $gio_fmt
                . "/"
                . $mes_fmt
                . "/"
                . $ann_fmt                ;
    #--------------------------------------*
    # Intestazione 'index.html'            *
    #--------------------------------------*
    &wrt_ind ("<!DOCTYPE html>")          ;
    &wrt_ind ("<head><title>DOCUMENTI "
            . "'XML' "
            . "RICEVUTI"
            . "</title>")                 ;
    #--------------------------------------*
    # CSS generico                         *
    #--------------------------------------*
    &wrt_ind ("<link rel='stylesheet' "
            . "type='text/css' "
            . "href='../../"
            . "tmp/ind/css/index.css'>")  ;
    #--------------------------------------*
    # CSS: per sort tabella                *
    #--------------------------------------*
    &wrt_ind ("<style>th {cursor: "
            . "pointer;}</style>")        ;
    &wrt_ind ("</head>")                  ;
    #--------------------------------------*
    # Body 'index.html'                    *
    #--------------------------------------*
    &wrt_ind ("<body bgcolor=#777777 "
            . "style=color:#dddddd;"
            . "font-size:14px;"
            . "font-family:Arial;>")      ;
    &wrt_ind ("<center>")                 ;
    &wrt_ind ("<br>")                     ;
    &wrt_ind ("<h1>Documenti 'XML' "
            . "caricati il "
            . $dat_sys
            . " alle "
            . $ora_fmt
            . ":"
            . $min_fmt
            . "</h1>")                    ;
    &wrt_ind ("<br>")                     ;
    #--------------------------------------*
    # Tabella 'index.html'                 *
    #--------------------------------------*
    &wrt_ind ("<table id='tabella' width=100% "
            . "border='1' "
            . "bordercolor=#CCCCCC "
            . "cellspacing='1' "
            . "cellpadding='2'>")         ;
    #--------------------------------------*
    # Intestazione tabella 'index.html'    *
    #--------------------------------------*
    &wrt_ind ("<tr bgcolor=#CCCCCC "
            . "style=color:#000000;>")    ;
    &wrt_ind ("<th>NR</th>")              ;
    &wrt_ind ("<th>CODICE</th>")          ;
    &wrt_ind ("<th>FORNITORE</th>")       ;
    &wrt_ind ("<th>NUMERO</th>")          ;
    &wrt_ind ("<th>DATA</th>")            ;
    &wrt_ind ("<th>LINK</th>")            ;
    &wrt_ind ("<th>ATTACHMENT</th>")      ;
    &wrt_ind ("</tr>")                    ;
}

#==========================================*
# Riga tabella file 'index.html'           *
#------------------------------------------*
sub row_ind
{
    #--------------------------------------*
    # Valori in input                      *
    #--------------------------------------*
    my $ddo_row = shift                   ;
    my $ndo_row = shift                   ;
    my $rdo_row = shift                   ;
    my $piv_row = shift                   ;
    my $pth_row = shift                   ;
    my $att_row = shift                   ;
    #--------------------------------------*
    # Contatore righe emesse               *
    #--------------------------------------*
    $ctr_ind++                            ;
    #--------------------------------------*
    # Trattamento data in input            *
    #--------------------------------------*
    my @dat_row = split (/-/, $ddo_row)   ;
    #
    my $day_row = sprintf ("%02d",
                           $dat_row[2])   ;
    my $mon_row = sprintf ("%02d",
                           $dat_row[1])   ;
    my $yea_row = sprintf ("%04d",
                           $dat_row[0])   ;
    #
    my $dat_wrt = $day_row
                . "/"
                . $mon_row
                . "/"
                . $yea_row               ;
    #--------------------------------------*
    # Trattamento filename in input        *
    #--------------------------------------*
    my @dir_row = split (/\//, $pth_row)  ;
    my $nw1_row = $dir_row[6]             ;
    my $nw2_row = $dir_row[7]             ;
    my $new_row = "./"
                . $nw1_row
                . "/"
                . $nw2_row                ;
    #--------------------------------------*
    # Trattamento attachment in input      *
    #--------------------------------------*
    my $nea_row = ""                      ;
    if ($att_row ne "no")
    {
        $nea_row = "../att/"
                 . $nw1_row
                 . "/"
                 . $att_row               ;
    }
    #--------------------------------------*
    # Riga tabella                         *
    #--------------------------------------*
    &wrt_ind ("<tr align=center>")        ;
    #--------------------------------------*
    # Colonna progressivo                  *
    #--------------------------------------*
    &wrt_ind ("<td>"
            . $ctr_ind
            . "</td>")                    ;
    #--------------------------------------*
    # Lettura database per determinare il  *
    # codice fornitore                     *
    #--------------------------------------*
    my $det_cod = &let_fnt($piv_row)      ;
    if (!$det_cod){$det_cod = ""}         ;
    #--------------------------------------*
    # Colonna 'Codice'                     *
    #--------------------------------------*
    &wrt_ind ("<td>"
            . $det_cod
            . "</td>")                    ;
    #--------------------------------------*
    # Colonna 'Fornitore'                  *
    #--------------------------------------*
    &wrt_ind ("<td>"
            . $rdo_row
            . "</td>")                    ;
    #--------------------------------------*
    # Colonna 'Numero documento'           *
    #--------------------------------------*
    &wrt_ind ("<td>"
            . $ndo_row
            . "</td>")                    ;
    #--------------------------------------*
    # Colonna 'Data documento'             *
    #--------------------------------------*
    &wrt_ind ("<td>"
            . $dat_wrt
            . "</td>")                ;
    #--------------------------------------*
    # Colonna 'Link documento'             *
    #--------------------------------------*
    &wrt_ind ("<td align=center>"
            . "<a href='"
            . $new_row
            . "' target='_blank'<p>"
            . $nw2_row
            . "</p></a></td>")            ;
    #--------------------------------------*
    # Colonna 'Link Attachment'            *
    #--------------------------------------*
    my $str_out = ""                      ;
    if ($att_row eq "no")
    {
        $str_out = "<td>"
                 . $att_row
                 . "</td>"                ;
        &wrt_ind ($str_out)               ;
    }
     else
    {
        $str_out = "<td>"
                 . "<a href='"
                 . $nea_row
                 . "' target='_blank'<p>"
                 . $att_row
                 . "</p></a></td>"        ;
        &wrt_ind ($str_out)               ;
    }
    #--------------------------------------*
    # Riga tabella - fine                  *
    #--------------------------------------*
