    if ($@)
    {
        $inp_fil =~ s/\?\/?(desc|en|es|de|fl)>/<\/$1>/g;
        $tst_dat = eval { $xml->XMLin($inp_fil) };
        if ($@) 
        {
            print LOG_FIL "Errori in lettura : "
                        . $inp_fil
                        . "\n"
                        . "- "
                        . $@
                        . "\n"            ;
        }
    }
}

