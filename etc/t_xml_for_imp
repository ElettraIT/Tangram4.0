#==========================================*
# Percorso file attachment                 *
#------------------------------------------*
sub det_att
{
    #--------------------------------------*
    # Valori in input                      *
    #--------------------------------------*
    my $inp_fil = shift                   ;
    my $inp_ctr = shift                   ;
    my $inp_fmt = shift                   ;
    my $inp_dat = shift                   ;
    #--------------------------------------*
    # Estrazione anno documento            *
    #--------------------------------------*
    my $inp_ann = substr($inp_dat,0,4)    ;
    #--------------------------------------*
    # Normalizzazione formato              *
    #--------------------------------------*
    if (!$inp_fmt)
    {
        $inp_fmt = "pdf"                  ;
    }
    if ($inp_fmt eq "")
    {
        $inp_fmt = "pdf"                  ;
    }
    $inp_fmt = lc $inp_fmt                ;
    #--------------------------------------*
    # Estrazione nome file                 *
    #--------------------------------------*
    (my $wrk_nam,
     my $wrk_pat,
     my $wrk_ext) = fileparse($inp_fil, qr/\.[^.]*/);
    #--------------------------------------*
    # Eventuale contatore                  *
    #--------------------------------------*
    my $wrk_new = ""                      ;
    if ($inp_ctr ne "000" && $inp_ctr ne "")
    {
        $wrk_new = $wrk_nam
                 . "."
                 . $inp_ctr               ;
    }
     else
    {
        $wrk_new = $wrk_nam               ;
    }
    #--------------------------------------*
    # Nome file attachment                 *
    #--------------------------------------*
    $nom_att = $wrk_new
             . "."
             . $inp_fmt                   ;
    #--------------------------------------*
    # Percorso attachment                  *
    #--------------------------------------*
    my $per_att = ""                      ;
    $per_att = $dir_att
             . $inp_ann
             . "/"
             . $nom_att                   ;

    #======================================*
    # DEBUG                                *
    #--------------------------------------*
#    print "inp_dat = " . $inp_dat . "\n"    ;
#    print "inp_ctr = " . $inp_ctr . "\n"    ;
#    print "inp_fmt = " . $inp_fmt . "\n"    ;
#    print "inp_dat = " . $inp_dat . "\n\n"    ;
#    print "dir_att = " . $dir_att . "\n\n"    ;
#    print "nom_att = " . $nom_att . "\n"    ;
#    print "per_att = " . $per_att . "\n"    ;
#    exit()                                  ;

    #--------------------------------------*
    # Valori restituiti                    *
    #======================================*
    return $nom_att, $per_att             ;
}

#==========================================*
# Pulizia stringhe                         *
#------------------------------------------*
sub pul_str
{
    #--------------------------------------*
    # Valori in input                      *
    #--------------------------------------*
    my $wrk_str = shift                   ;
    #--------------------------------------*
    # Pulizia caratteri accentati          *
    #--------------------------------------*
    $wrk_str = NFKD($wrk_str)             ;
    $wrk_str =~ s/\p{NonspacingMark}//g   ;
    #--------------------------------------*
    # Eliminazione eventuali caratteri     *
    # strani                               *
    #--------------------------------------*
    $wrk_str=~s/[^\x00-\x7f]//g           ;
    #--------------------------------------*
    # Eliminazione spazi superflui valore  *
    #--------------------------------------*
    $wrk_str =~ s/^\s+|\s+$//g            ;
    #--------------------------------------*
    # Valore restituito                    *
    #======================================*
    return $wrk_str                       ;
}

