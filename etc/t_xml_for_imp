#==========================================*
# Determinazione dati dal documento        *
#------------------------------------------*
sub rea_doc 
{
    #--------------------------------------*
    # File in input                        *
    #--------------------------------------*
    my $pth_doc = shift                   ;
    my $nam_doc = shift                   ;
    #--------------------------------------*
    # Normalizzazione contatore documenti  *
    #--------------------------------------*
    my $wrk_ctr = ""                      ;
    #--------------------------------------*
    # Test preliminare file                *
    #--------------------------------------*
    &tst_fil ($pth_doc)                   ;
    #--------------------------------------*
    # Caricamento file                     *
    #--------------------------------------*
    my $xml = XML::Simple->new()          ;
    my $data = XMLin($pth_doc)            ;
    #--------------------------------------*
    # Partita Iva Cedente Prestatore       *
    #            (Fornitore)               *
    #--------------------------------------*
    my $pmt_doc = $data->{FatturaElettronicaHeader}
                       ->{CedentePrestatore}
                       ->{DatiAnagrafici}
                       ->{IdFiscaleIVA}   ;
    my $prt_iva = $pmt_doc->{IdCodice}    ;
    #--------------------------------------*
    # Ragione sociale cedente              *
    #--------------------------------------*
    $pmt_doc = $data->{FatturaElettronicaHeader}
                    ->{CedentePrestatore}
                    ->{DatiAnagrafici}
                    ->{Anagrafica}        ;
    my $rag_soc = $pmt_doc->{Denominazione};
    #
    if($rag_soc)
    {
        $rag_soc = &pul_str($rag_soc)     ;
    }
     else
    {
        $rag_soc = "???"                  ;
    }
    #--------------------------------------*
    # Cognome cedente (se persona fisica)  *
    #--------------------------------------*
    $pmt_doc = $data->{FatturaElettronicaHeader}
                       ->{CedentePrestatore}
                       ->{DatiAnagrafici}
                       ->{Anagrafica}     ;
    my $cog_nom = $pmt_doc->{Cognome}     ;
    #
    if($cog_nom)
    {
        $cog_nom = &pul_str($cog_nom)     ;
    }
     else
    {
        $cog_nom = "???"                  ;
    }
    
    #--------------------------------------*
    # Nome cedente (se persona fisica)     *
    #--------------------------------------*
    $pmt_doc = $data->{FatturaElettronicaHeader}
                       ->{CedentePrestatore}
                       ->{DatiAnagrafici}
                       ->{Anagrafica}     ;
    my $nom_nom = $pmt_doc->{Nome}        ;
    #
    if($nom_nom)
    {
        $nom_nom = &pul_str($nom_nom)     ;
    }
     else
    {
        $nom_nom = "???"                  ;
    }
    #--------------------------------------*
    # Assemblaggio Nome e Cognome          *
    #--------------------------------------*
    my $nom_cog = ""                      ;
    if($cog_nom && $nom_nom)
    {
        $nom_cog = $nom_nom
                 . " "
                 . $cog_nom               ;
    }
    #--------------------------------------*
    # Utilizzare o l'uno o l'altro         *
    #--------------------------------------*
    if($nom_cog && $rag_soc eq "???")
    {
        $rag_soc = $nom_cog               ;
    }
    #--------------------------------------*
    # Tipo documento                       *
    #--------------------------------------*
       $pmt_doc = $data->{FatturaElettronicaBody}
                       ->{DatiGenerali}
                       ->{DatiGeneraliDocumento};
    my $tip_doc = $pmt_doc->{TipoDocumento};
    #--------------------------------------*
    # Data documento                       *
    #--------------------------------------*
       $pmt_doc = $data->{FatturaElettronicaBody}
                       ->{DatiGenerali}
                       ->{DatiGeneraliDocumento};
    my $dat_doc = $pmt_doc->{Data}        ;
    #--------------------------------------*
    # Numero documento                     *
    #--------------------------------------*
       $pmt_doc = $data->{FatturaElettronicaBody}
                       ->{DatiGenerali}
                       ->{DatiGeneraliDocumento};
    my $num_doc = $pmt_doc->{Numero}      ;
    
    #======================================*
    # Test se presenti allegati            *
    #--------------------------------------*
    my $att_nom = ""                      ;
    my $att_per = ""                      ;
    #--------------------------------------*
    # Test                                 *
    #--------------------------------------*
    if (! ref($data->{FatturaElettronicaBody}
                   ->{Allegati}))
    {
        #----------------------------------*
        # Se nessun Allegato               *
        #----------------------------------*
        $att_nom = ""                     ;
        $att_per = ""                     ;
    }
     else
    {
        #----------------------------------*
        # Se Allegati documento            *
        #----------------------------------*
        #----------------------------------*
        # Contatore per piu' allegati      *
        #----------------------------------*
        my $loc_ctr = 0                   ;
        #----------------------------------*
        # Test se uno o piu' allegati      *
        #----------------------------------*
        if (ref($data->{FatturaElettronicaBody}
                     ->{Allegati}) =~ /ARRAY/)
        {
            #------------------------------*
            # Se piu' righe di allegato    *
            #------------------------------*
            foreach $a (@{$data->{FatturaElettronicaBody}
                               ->{Allegati}})
            {
            #------------------------------*
            # Tipo allegato                *
            #------------------------------*
            $wrk_fmt = $a->{FormatoAttachment};
            #------------------------------*
            # Contatore elementi           *
            #------------------------------*
            $loc_ctr++                    ;
            $wrk_ctr = sprintf "%03d", $loc_ctr;
            #------------------------------*
            # Nome e percorso attachment   *
            #------------------------------*
            ($att_nom,
             $att_per) = &det_att($pth_doc, 
                                  $wrk_ctr,
                                  $wrk_fmt,
                                  $dat_doc);
            #------------------------------*
            # Estrazione Attachment        *
            #------------------------------*
            $b64_fil = $a->{Attachment}   ;
            #------------------------------*
            # Apertura file attachment     *
            #------------------------------*
            open (ATTACH, ">$att_per") or print LOG_FIL
                $theTime
	         . " - impossibile aprire il file "
                . $att_per
                . "\n"                    ;
            binmode ATTACH                ;
            #------------------------------*
            # Scrittura file attachment    *
            #------------------------------*
            print ATTACH decode_base64($b64_fil);
            #------------------------------*
            # Chiusura file attachment     *
            #------------------------------*
            close ATTACH                  ;
            }
        }
         else
        {
            #------------------------------*
            # Se una sola riga di allegato *
            #------------------------------*
            #------------------------------*
            # Tipo allegato                *
            #------------------------------*
            $wrk_fmt = $data->{FatturaElettronicaBody}
                            ->{Allegati}
                            ->{FormatoAttachment};
            #------------------------------*
            # Contatore elementi           *
            #------------------------------*
            $wrk_ctr = ""                 ;
            #------------------------------*
            # Nome e percorso attachment   *
            #------------------------------*
            ($att_nom,
             $att_per) = &det_att($pth_doc, 
                                  $wrk_ctr,
                                  $wrk_fmt,
                                  $dat_doc);
            #------------------------------*
            # Estrazione Attachment        *
            #------------------------------*
            $b64_fil = $data->{FatturaElettronicaBody}
                            ->{Allegati}
                            ->{Attachment};
            #------------------------------*
            # Apertura file attachment     *
            #------------------------------*
            open (ATTACH, ">$att_per") or print LOG_FIL
                $theTime
	         . " - impossibile aprire il file "
                . $att_per
                . "\n"                    ;
            binmode ATTACH                ;
            #------------------------------*
            # Scrittura file attachment    *
            #------------------------------*
            print ATTACH decode_base64($b64_fil);
            #------------------------------*
            # Chiusura file attachment     *
            #------------------------------*
            close ATTACH                  ;
        }
    }

    #======================================*
    # Valori restituiti                    *
    #--------------------------------------*
    #--------------------------------------*
    # Contatore elementi                   *
    #                                      *
    # N.B: attualmente al posto del nome   *
    #      allegato                        *
    #                                      *
    # ___ NO: RIVEDERE ___                 *
    #--------------------------------------*
    if (!$wrk_ctr)
    {
        $wrk_ctr = ""                    ;
    }
    #--------------------------------------*
    # Nome allegato                        *
    #--------------------------------------*
    if (!$att_nom or $att_nom eq "")
    {
        $att_nom = "no"                  ;
    }
    #--------------------------------------*
    # Push elementi letti                  *
    #--------------------------------------*
    my @val_dat                           ;
    push (@val_dat, $prt_iva)             ;
    push (@val_dat, $tip_doc)             ;
    push (@val_dat, $dat_doc)             ;
    push (@val_dat, $num_doc)             ;
    push (@val_dat, $rag_soc)             ;
    push (@val_dat, $att_nom)             ;
    return @val_dat                       ;
    #--------------------------------------*
    # Fine subroutine 'rea_doc'            *
    #======================================*
}

