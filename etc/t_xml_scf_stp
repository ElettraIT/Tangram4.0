    {
        $fld_pos = 14                     ;
        $fld_out = 774                    ;
    }
     elsif ($fld_tag eq 'Importo')
    {
        $fld_pos = 15                     ;
        $fld_out = 776                    ;
    }
     elsif ($fld_tag eq 'PrezzoTotale')
    {
        $fld_pos = 7                      ;
        $fld_out = 780                    ;
    }
     elsif ($fld_tag eq 'AliquotaIVA')
    {
        $fld_pos = 8                      ;
        $fld_out = 790                    ;
    }
     elsif ($fld_tag eq 'Natura')
    {
        $fld_pos = 9                      ;
        $fld_out = 800                    ;
    }
     elsif ($fld_tag eq 'TipoDato')
    {
        $fld_pos = 9                      ;
        $fld_out = 800                    ;
        $fld_inn = $fld_inw               ;
        $fld_inw++                        ;
