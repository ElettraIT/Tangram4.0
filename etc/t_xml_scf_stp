                   $box_doc[0]+10,
                   $box_doc[1]-36,
                         $num_doc)        ;
#   *--------------------------------------*
#   * Data documento                       *
#   *--------------------------------------*
    $ps->text({align => 'center'},
                   $box_doc[0]+90,
                   $box_doc[1]-36,
                         $dat_doc)        ;
#   *--------------------------------------*
#   * Stampa codice fiscale cliente        *
#   *--------------------------------------*
#   * Ritaratura carattere in base alla    *
#   * lunghezza del codice fiscale         *
#   *--------------------------------------*
    if($cfi_cli)
    {
        if (length($cfi_cli) > 11)
           {$siz = 8} else {$siz = 10}
#
        $ps->setfont("Helvetica-Bold", $siz);
        $ps->text($box_doc[0]-34,
                  $box_doc[1]-65,
                  $cfi_cli)               ;
        $ps->setfont("Helvetica", 10)     ;
    }
#   *--------------------------------------*
#   * Stampa partita Iva cliente           *
#   *--------------------------------------*
    if($piv_cli)
    {
        $ps->text($box_doc[0]+60,
                  $box_doc[1]-65,
                     $piv_cli)            ;
    }

#   *======================================*
#   * Stampa ragione sociale fornitore     *
#   *--------------------------------------*
#   * Ritaratura carattere in base alla    *
#   * lunghezza della ragione sociale      *
#   *--------------------------------------*
    if (length($rag_fnt) > 35)
       {$siz = 14} else {$siz = 16}
#
    $ps->setfont("Helvetica-Bold", $siz)  ;
    $ps->text($box_fnt[0],
              $box_fnt[1],
              $rag_fnt)                   ;
#   *--------------------------------------*
#   * Stampa indirizzo fornitore           *
#   *--------------------------------------*
    $ps->text($box_fnt[0],
              $box_fnt[1]-$int_fnt,
              $via_fnt)                   ;
#   *--------------------------------------*
#   * Stampa localita' fornitore           *
#   *--------------------------------------*
#   * Assemblaggio                         *
#   *--------------------------------------*
    $loc_stp = $cap_fnt
             . " "
             . $cmn_fnt
             . " "
             . $prv_fnt                   ;
#
    $ps->text($box_fnt[0],
              $box_fnt[1]-$int_fnt*2,
              $loc_stp)                   ;
#   *--------------------------------------*
#   * Stampa telefono ed email fornitore   *
#   *--------------------------------------*
#   * Assemblaggio                         *
#   *--------------------------------------*
    $ps->setfont("Helvetica-Bold", 12)    ;
    
    if($tel_fnt && $eml_fnt)
    {
        $tee_stp = $tel_fnt
                 . " - "
                 . $eml_fnt               ;
#
        $ps->text($box_fnt[0],
       $box_fnt[1]-$int_fnt*3,
                     $tee_stp)            ;
    }
#   *--------------------------------------*
#   * Stampa causale documento             *
#   *--------------------------------------*
#   * Ritaratura carattere in base alla    *
#   * lunghezza della causale              *
#   *--------------------------------------*
    if(@cau_doc)
    {

        if (length($cau_doc[0]) > 35)
           {$siz = 5} else {$siz = 9}
#
        $ps->setfont("Helvetica-Bold", $siz)  ;
        my $cau_lin = -10                     ;
        foreach (@cau_doc)
        {
            $cau_lin = $cau_lin + 20          ;
            $ps->text($box_cau[0],
             $box_cau[1]-$cau_lin,
                               $_)            ;
        }
    }

#   *--------------------------------------*
#   * Stampa ragione sociale cliente       *
#   *--------------------------------------*
    $ps->setfont("Helvetica-Bold", 10)    ;
    $ps->text($box_cli[0],
              $box_cli[1],
              $rag_cli)                   ;
#   *--------------------------------------*
#   * Stampa indirizzo cliente             *
#   *--------------------------------------*
    $ps->text($box_cli[0],
              $box_cli[1]-$int_cli,
              $via_cli)                   ;
#   *--------------------------------------*
#   * Stampa localita' cliente             *
#   *--------------------------------------*
    $loc_stp = $cap_cli
             . " "
             . $cmn_cli
             . " "
             . $prv_cli                   ;
#
    $ps->text($box_cli[0],
              $box_cli[1]-$int_cli*2,
              $loc_stp)                   ;
}

#==========================================*
# Raccolta dati riga                       *
#------------------------------------------*
sub rdt_rig
{
#   *--------------------------------------*
#   * Estrazione campi                     *
#   *--------------------------------------*
    my @rig = split(/;/, $row)            ;
#   *--------------------------------------*
#   * Pulizia trailing spaces campi testo  *
#   *--------------------------------------*
    my $max = 4                           ;
    my $ctr                               ;
    for ($ctr = 1 ; $ctr < $max ; $ctr++ )
    {
        $rig[$ctr] =~ s/^\s+//            ;
        $rig[$ctr] =~ s/\s+$//            ;
    }

#   *--------------------------------------*
#   * Assegnazione indice campo            *
#   *                                      *
#   * Valori restituiti                    *
#   *                                      *
#   * 1. = id campo assegnato              *
#   * 2. = posizione del campo nella riga  *
#   * 3. = indice ripetizione campo        *
#   * 3. = valore del campo (contenuto)    *
#   *--------------------------------------*
    my ($fld_idr,
        $fld_psz,
        $fld_inx,
        $fld_val) = &frg_inx ($rig[2],
                              $rig[3])    ;
#   *--------------------------------------*
#   * Test se nuova linea                  *
#   *--------------------------------------*
    if ($rig[2] eq "NumeroLinea")
    {
        $rig_num++                        ;
    }
#   *--------------------------------------*
#   * Assegnazione valore campo riga       *
#   *--------------------------------------*
    if ($fld_idr)
    {
        $rig_fld[$rig_num]
                [$fld_psz]
                [$fld_inx]
                [$fld_idr] = $fld_val     ;
    }
}

#==========================================*
# Stampa riga                              *
#------------------------------------------*
sub stp_rig
{
#   *--------------------------------------*
#   * Numero riga in corso di trattamento  *
#   *--------------------------------------*
    $rig_trt = shift                      ;
#   *--------------------------------------*
#   * Contatore righe                      *
#   *--------------------------------------*
    $ctr_rig++                            ;
#   *--------------------------------------*
#   * Se prima riga, intestazione pagina   *
#   *--------------------------------------*
    if ($rig_trt == 1)
    {
        &mynewpage($ps)                   ;
        $ctr_rig = 1                      ;
        $cur_lin = $top_rig               ;
    }
#   *--------------------------------------*
#   * Eventuale reintestazione pagina      *
#   *--------------------------------------*
    if ($ctr_rig > $max_ric)
    {
        &mynewpage($ps)                   ;
        $ctr_rig = 1                      ;
        $cur_lin = $top_rig               ;
    }
#   *--------------------------------------*
#   * Interlinea                           *
#   *--------------------------------------*
    $cur_lin = $cur_lin - $row_hgt        ;
#   *--------------------------------------*
#   * Font per riga                        *
#   *--------------------------------------*
    $ps->setfont("Helvetica-Bold", 8)     ;
#   *--------------------------------------*
#   * Progressivo riga                     *
#   *--------------------------------------*
    $ps->text({align => 'right'},
                              50,
                      $cur_lin+2,
                        $rig_trt)         ;
#   *--------------------------------------*
#   * Codice prodotto                      *
#   *--------------------------------------*
    $fld_stp = $rig_fld[$rig_trt][2][0][730];
    if ($fld_stp)
    {
        $ps->text($col_cor[0],
                   $cur_lin+2,
                     $fld_stp)            ;
    }
#   *--------------------------------------*
#   * Descrizione prodotto                 *
#   *--------------------------------------*
    $fld_stp = $rig_fld[$rig_trt][3][0][740];
    if ($fld_stp)
    {
        $fld_stp = substr ($fld_stp, 0,35);
        $ps->text($col_cor[1],
                   $cur_lin+2,
                     $fld_stp)            ;
    }
#   *--------------------------------------*
#   * Quantita' prodotto                   *
#   *--------------------------------------*
    $fld_stp = $rig_fld[$rig_trt][4][0][750];
    if ($fld_stp)
    {
#       *----------------------------------*
#       * Limitazione decimali             *
#       *----------------------------------*
        $num_stp = (sprintf("%.3f", $fld_stp));
#       *----------------------------------*
#       * Sostituzione '.' con ','         *
#       *----------------------------------*
        $num_stp =~ s/\./,/               ;
#       *----------------------------------*
#       * Stampa                           *
#       *----------------------------------*
        $ps->text({align => 'right'},
                         $col_cor[2]+45,
                          $cur_lin+2,
                            $num_stp)     ;
    }
#   *--------------------------------------*
#   * Unita' di misura prodotto            *
#   *--------------------------------------*
    $fld_stp = $rig_fld[$rig_trt][5][0][760];
    if ($fld_stp)
    {
        $fld_stp = substr ($fld_stp, 0, 3);
        $ps->text($col_cor[3],
                   $cur_lin+2,
                     $fld_stp)            ;
    }
#   *--------------------------------------*
#   * Prezzo unitario prodotto             *
#   *--------------------------------------*
    $fld_stp = $rig_fld[$rig_trt][6][0][770];
    if ($fld_stp)
    {
#       *----------------------------------*
#       * Limitazione decimali             *
#       *----------------------------------*
        $num_stp = (sprintf("%.5f", $fld_stp))   ;
#       *----------------------------------*
#       * Sostituzione '.' con ','         *
#       *----------------------------------*
        $num_stp =~ s/\./,/               ;
#       *----------------------------------*
#       * Stampa                           *
#       *----------------------------------*
        $ps->text({align => 'right'},
                         $col_cor[4]+50,
                          $cur_lin+2,
                            $num_stp)     ;
    }
    
#   *--------------------------------------*
#   * Sconto                               *
#   *--------------------------------------*
    $fld_stp = $rig_fld[$rig_trt][14][0][774];
    if ($fld_stp)
    {
        $fld_stp = substr ($fld_stp, 0, 2);
        $ps->text($col_cor[5],
                   $cur_lin+2,
                     $fld_stp)            ;
    }
#   *--------------------------------------*
#   * Prezzo totale prodotto               *
#   *--------------------------------------*
    $fld_stp = $rig_fld[$rig_trt][7][0][780];
    if ($fld_stp)
    {
#       *----------------------------------*
#       * Limitazione decimali             *
#       *----------------------------------*
        $num_stp = (sprintf("%.2f", $fld_stp))   ;
#       *----------------------------------*
#       * Sostituzione '.' con ','         *
#       *----------------------------------*
        $num_stp =~ s/\./,/               ;
#       *----------------------------------*
#       * Stampa                           *
#       *----------------------------------*
        $ps->text({align => 'right'},
                         $col_cor[6]+45,
                          $cur_lin+2,
                            $num_stp)     ;
    }
#   *--------------------------------------*
#   * Aliquota Iva o 'natura'              *
#   *--------------------------------------*
    $fld_stp = $rig_fld[$rig_trt][8][0][790];
    
    if ($fld_stp eq "0.00")
    {
        $fld_stp = $rig_fld[$rig_trt][9][0][800];
        $ps->text({align => 'right'},
                         $col_cor[7]+18,
                          $cur_lin+2,
                            $fld_stp)     ;
    }
     else
    {
        $fld_stp = int($fld_stp)          ;
        $ps->text({align => 'right'},
                         $col_cor[7]+18,
                          $cur_lin+2,
                            $fld_stp)     ;
    }
#   *--------------------------------------*
#   * Data inizio e fine periodo           *
#   *--------------------------------------*
    $prd_ini = $rig_fld[$rig_trt][13][0][762];
    $prd_fin = $rig_fld[$rig_trt][14][0][764];
    if ($prd_ini && $prd_fin)
    {
        $fld_stp = "Periodo dal : "
                 . $prd_ini
                 . " al: "
                 . $prd_fin               ;
#
        $ps->text($col_cor[1]+10,
                   $cur_lin+2-10,
                        $fld_stp)         ;
    }
}

#==========================================*
# Raccolta dati piede                      *
#------------------------------------------*
sub rdt_pie
{
#   *--------------------------------------*
#   * Estrazione campi                     *
#   *--------------------------------------*
    my @pie = split(/;/, $row)            ;
#   *--------------------------------------*
#   * Pulizia trailing spaces campi testo  *
#   *--------------------------------------*
    my $max = 4                           ;
    my $ctr                               ;
    for ($ctr = 1 ; $ctr < $max ; $ctr++ )
    {
        $pie[$ctr] =~ s/^\s+//            ;
        $pie[$ctr] =~ s/\s+$//            ;
    }
#   *--------------------------------------*
#   * Assegnazione indice campo piede      *
#   *--------------------------------------*
    my $fld_ide = &fpd_inx ($pie[1], $pie[2]);
#   *--------------------------------------*
#   * Assegnazione valore campo piede      *
#   *--------------------------------------*
    if ($fld_ide){$pie_fld[$fld_ide] = $pie[3]}

#   *======================================*
#   * Castelletto Iva                      *
#   *--------------------------------------*
#   * Aliquota Iva                         *
#   *--------------------------------------*
    if ($pie[2] eq "AliquotaIVA")
    {
#       *----------------------------------*
#       * Incremento contatore             *
#       *----------------------------------*
        $cst_ivi++                        ;
#       *----------------------------------*
#       * Bufferizzazione                  *
#       *----------------------------------*
        if($pie[3])
        {
#           *------------------------------*
#           * Aliquota                     *
#           *------------------------------*
            $cst_iva[$cst_ivi][0]= $pie[3];
        }
    }
#   *--------------------------------------*
#   * Natura                               *
#   *--------------------------------------*
     elsif ($pie[2] eq "Natura")
    {
        $cst_iva[$cst_ivi][1]= $pie[3]    ;
    }
#   *--------------------------------------*
#   * Imponibile importo                   *
#   *--------------------------------------*
     elsif ($pie[2] eq "ImponibileImporto")
    {
        $cst_iva[$cst_ivi][2]= $pie[3]    ;
    }
#   *--------------------------------------*
#   * Imposta                              *
#   *--------------------------------------*
     elsif ($pie[2] eq "Imposta")
    {
        $cst_iva[$cst_ivi][3]= $pie[3]    ;
    }

#   *======================================*
#   * Castelletto pagamenti                *
#   *--------------------------------------*
#   * Modalita di pagamento                *
#   *--------------------------------------*
    if ($pie[2] eq "ModalitaPagamento")
    {
#       *----------------------------------*
#       * Incremento contatore             *
#       *----------------------------------*
        $cst_pgi++                        ;
#       *----------------------------------*
#       * Bufferizzazione                  *
#       *----------------------------------*
        if($pie[3])
        {
#           *------------------------------*
#           * Tipo                         *
#           *------------------------------*
            $cst_pag[$cst_pgi][0]= $pie[3];
#           *------------------------------*
#           * Descrizione                  *
#           *------------------------------*
            my $des_csp = &dec_pag($pie[3]);
            $cst_pag[$cst_pgi][1]= $des_csp;
        }
    }
#   *--------------------------------------*
#   * Data scadenza pagamento              *
#   *--------------------------------------*
     elsif ($pie[2] eq "DataScadenzaPagamento")
    {
        $cst_pag[$cst_pgi][2]= $pie[3]    ;
    }
#   *--------------------------------------*
#   * Importo pagamento                    *
#   *--------------------------------------*
     elsif ($pie[2] eq "ImportoPagamento")
    {
        $cst_pag[$cst_pgi][3]= &trt_imp($pie[3]);
    }
#   *--------------------------------------*
#   * IBAN                                 *
#   *--------------------------------------*
     elsif ($pie[2] eq "IBAN")
    {
        $cst_pag[$cst_pgi][4]= $pie[3]    ;
    }
#   *--------------------------------------*
#   * ABI                                  *
#   *--------------------------------------*
     elsif ($pie[2] eq "IBAN")
    {
        $cst_pag[$cst_pgi][5]= $pie[3]    ;
    }
#   *--------------------------------------*
#   * CAB                                  *
#   *--------------------------------------*
     elsif ($pie[2] eq "IBAN")
    {
        $cst_pag[$cst_pgi][6]= $pie[3]    ;
    }
#   *--------------------------------------*
#   * Istituto finanziario                 *
#   *--------------------------------------*
     elsif ($pie[2] eq "IstitutoFinanziario")
    {
        $cst_pag[$cst_pgi][7]= $pie[3]    ;
    }
#   *--------------------------------------*
#   * Beneficiario                         *
#   *--------------------------------------*
     elsif ($pie[2] eq "Beneficiario")
    {
        $cst_pag[$cst_pgi][8]= $pie[3]    ;
    }
}

#==========================================*
# Stampa piede                             *
#------------------------------------------*
sub stp_pie
{
#   *======================================*
#   * Castelletto Iva                      *
#   *--------------------------------------*
#   * Font per il box 2 piede              *
#   *--------------------------------------*
    $ps->setfont("Helvetica", 9)          ;
#   *--------------------------------------*
#   * Scansione castelletto Iva            *
#   *--------------------------------------*
    $ctr_wrk = 0                          ;
    for $ctr_wrk (0 .. $max_iva)
    {
#       *----------------------------------*
#       * Skip riga zero                   *
#       *----------------------------------*
        if($ctr_wrk == 0){next}           ;
#       *----------------------------------*
#       * Stampa riga                      *
#       *----------------------------------*
        &stp_csi($ctr_wrk)                ;
#       *----------------------------------*
#       * Accumulo totale imponibile       *
#       *----------------------------------*
        $tot_ibl = $tot_ibl + $cst_iva[$rig_trt][2];
#       *----------------------------------*
#       * Accumulo totale imposta          *
#       *----------------------------------*
        $tot_imp = $tot_imp + $cst_iva[$rig_trt][3];
}

#   *--------------------------------------*
#   * Totale imponibile                    *
#   *--------------------------------------*
    $tot_ibl = (sprintf("%.2f", $tot_ibl));
    $ps->text({align => 'right'},
                 $box_pi2[0]+240,
                     $box_pi2[1],
              &trt_imp($tot_ibl))         ;
#   *--------------------------------------*
#   * Totale imposta                       *
#   *--------------------------------------*
    $tot_imp = (sprintf("%.2f", $tot_imp));
    $ps->text({align => 'right'},
                 $box_pi2[0]+240,
                  $box_pi2[1]-25,
              &trt_imp($tot_imp))         ;
#   *--------------------------------------*
#   * Totale documento                     *
#   *--------------------------------------*
    if ($tot_doc)
    {
        $ps->text({align => 'right'},
                     $box_pi2[0]+240,
                      $box_pi2[1]-50,
                  &trt_imp($tot_doc))     ;
    }
     else
    {
        $tot_wrk = $tot_ibl + $tot_imp    ;
        $tot_wrk = (sprintf("%.2f", $tot_wrk));
        $ps->text({align => 'right'},
                     $box_pi2[0]+240,
                      $box_pi2[1]-50,
                  &trt_imp($tot_wrk))     ;
    }
              
#   *======================================*
#   * Castelletto pagamenti                *
#   *--------------------------------------*
#   * Font per il box 3 piede              *
#   *--------------------------------------*
    $ps->setfont("Helvetica", 9)          ;
#   *--------------------------------------*
#   * Scansione castelletto pagamento      *
#   *--------------------------------------*
    $ctr_wrk = 0                          ;
    for $ctr_wrk (0 .. $max_pag)
    {
#       *----------------------------------*
#       * Skip riga zero                   *
#       *----------------------------------*
        if($ctr_wrk == 0){next}           ;
#       *----------------------------------*
#       * Stampa riga                      *
#       *----------------------------------*
        &stp_csp($ctr_wrk)                ;
    }

#   *======================================*
#   * Ritenuta                             *
#   *--------------------------------------*

#   *======================================*
#   * Attachment                           *
#   *--------------------------------------*
    if($nam_att)
    {
        my $all_stp = "Allegato : "
                    . substr($nam_att, 0, 35);
        $ps->setfont("Helvetica-Bold", 10);
        $ps->text($box_pi4[0],
               $box_pi4[1]-55,
                     $all_stp)            ;
    }
}

