# Assegnazione indice campo testata        *
# ---------------------------------------- *
#                                          *
#       CedentePrestatore (Fornitore)      *
#                                          *
# 010 - IdCodice                           *
# 020 - CodiceFiscale                      *
# 030 - Denominazione                      *
# 032 - Nome                               *
# 034 - Cognome                            *
# 036 - Telefono                           *
# 038 - Email                              *
# 040 - Indirizzo                          *
# 050 - CAP                                *
# 060 - Comune                             *
# 070 - Provincia                          *
# 080 - Nazione                            *
#                                          *
#       CessionarioCommittente (Cliente)   *
#                                          *
# 210 - IdCodice                           *
# 220 - CodiceFiscale                      *
# 230 - Denominazione                      *
# 240 - Indirizzo                          *
# 250 - CAP                                *
# 260 - Comune                             *
# 270 - Provincia                          *
# 280 - Nazione                            *
#                                          *
#       DatiGeneraliDocumento              *
#                                          *
# 410 - TipoDocumento                      *
# 420 - Divisa                             *
# 430 - Data                               *
# 440 - Numero                             *
# 450 - ImportoBollo                       *
# 460 - ImportoTotaleDocumento             *
# 470 - Causale                            *
#------------------------------------------*
sub fts_inx
{
    #======================================*
    # Valori in input                      *
    #--------------------------------------*
    my $fld_tip = shift                   ;
    my $fld_tag = shift                   ;

    if ($fld_tip eq "fnt")
    {
        #----------------------------------*
        # Cedente (fornitore)              *
        #----------------------------------*
        if    ($fld_tag eq 'IdCodice' && $fld_tip eq 'fnt')
              {$fld_out = 10}
        elsif ($fld_tag eq 'CodiceFiscale')
              {$fld_out = 20}
        elsif ($fld_tag eq 'Denominazione')
              {$fld_out = 30}
        elsif ($fld_tag eq 'Nome')
              {$fld_out = 32}
        elsif ($fld_tag eq 'Cognome')
              {$fld_out = 34}
        elsif ($fld_tag eq 'Telefono')
              {$fld_out = 36}
        elsif ($fld_tag eq 'Email')
              {$fld_out = 38}
        elsif ($fld_tag eq 'Indirizzo')
              {$fld_out = 40}
        elsif ($fld_tag eq 'CAP')
              {$fld_out = 50}
        elsif ($fld_tag eq 'Comune')
              {$fld_out = 60}
        elsif ($fld_tag eq 'Provincia')
              {$fld_out = 70}
    }
     elsif ($fld_tip eq "cli")
    {
        #----------------------------------*
        # Cessionario (cliente)            *
        #----------------------------------*
        if    ($fld_tag eq 'IdCodice' && $fld_tip eq 'cli')
              {$fld_out = 210}
        elsif ($fld_tag eq 'CodiceFiscale')
              {$fld_out = 220}
        elsif ($fld_tag eq 'Denominazione')
              {$fld_out = 230}
        elsif ($fld_tag eq 'Indirizzo')
              {$fld_out = 240}
        elsif ($fld_tag eq 'CAP')
              {$fld_out = 250}
        elsif ($fld_tag eq 'Comune')
              {$fld_out = 260}
        elsif ($fld_tag eq 'Provincia')
              {$fld_out = 270}
    }
     else
    {
        #----------------------------------*
        # Estremi documento                *
        #----------------------------------*
        if    ($fld_tag eq 'TipoDocumento')
              {$fld_out = 410}
        elsif ($fld_tag eq 'Divisa')
              {$fld_out = 420}
        elsif ($fld_tag eq 'Data' && $fld_tip eq 'doc')
              {$fld_out = 430}
        elsif ($fld_tag eq 'Numero' && $fld_tip eq 'doc')
              {$fld_out = 440}
        elsif ($fld_tag eq 'ImportoBollo')
              {$fld_out = 450}
        elsif ($fld_tag eq 'ImportoTotaleDocumento')
              {$fld_out = 460}
        elsif ($fld_tag eq 'Causale')
              {$fld_out = 470}
        else  {$fld_out = 0}              ;
    }
    #--------------------------------------*
    # Valore restituito                    *
    #======================================*
    return $fld_out                       ;
}

#==========================================*
# Assegnazione indice campo riga           *
# ---------------------------------------- *
#                                          *
#       DatiOrdineAcquisto                 *
#                                          *
