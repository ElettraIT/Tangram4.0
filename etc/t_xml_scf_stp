#==========================================*
# Raccolta dati di testata                 *
#------------------------------------------*
sub rdt_tes
{
#   *--------------------------------------*
#   * Estrazione campi                     *
#   *--------------------------------------*
    my @tes = split(/;/, $row)            ;
#   *--------------------------------------*
#   * Pulizia trailing spaces campi testo  *
#   *--------------------------------------*
    my $max = 4                           ;
    my $ctr                               ;
    for ($ctr = 1 ; $ctr < $max ; $ctr++ )
    {
        $tes[$ctr] =~ s/^\s+//            ;
        $tes[$ctr] =~ s/\s+$//            ;
    }
#   *--------------------------------------*
#   * Assegnazione indice campo testata    *
#   *--------------------------------------*
    my $fld_ide = &fts_inx ($tes[1], $tes[2]);
#   *--------------------------------------*
#   * Assegnazione valore campo testata    *
#   *--------------------------------------*
    if ($fld_ide){$tes_fld[$fld_ide] = $tes[3]}
#   *--------------------------------------*
#   * Causale documento                    *
#   *--------------------------------------*
    if ($tes[2] eq "Causale")
    {
        push (@cau_doc, $tes[3])          ;
    }
}

#==========================================*
# Stampa testata                           *
#------------------------------------------*
sub stp_tes
{
#   *======================================*
#   * Font per il box data e numero        *
#   *--------------------------------------*
