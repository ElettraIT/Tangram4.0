#==========================================*
# Calcolo numero massimo di pagine         *
#------------------------------------------*
sub clc_pag
{
    #--------------------------------------*
    # Valori in input                      *
    #--------------------------------------*
    my $wrk_mpg = shift                   ;
    my $wrk_nrg = shift                   ;
    #--------------------------------------*
    # Calcolo                              *
    #--------------------------------------*
    my $wrk_max = 1                       ;
    my $wrk_int = int($wrk_nrg / $wrk_mpg);
    my $wrk_rem = $wrk_nrg / $wrk_mpg     ;
    if ($wrk_rem > $wrk_int)
       {$wrk_max = $wrk_max+$wrk_int}     ;
    #--------------------------------------*
    # Valore in output                     *
    #--------------------------------------*
    return $wrk_max                       ;
}

