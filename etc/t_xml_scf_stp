     elsif ($fld_tag eq 'Descrizione')
    {
        $fld_pos = 3                      ;
        $fld_out = 740                    ;
    }
     elsif ($fld_tag eq 'Quantita')
    {
        $fld_pos = 4                      ;
        $fld_out = 750                    ;
    }
     elsif ($fld_tag eq 'UnitaMisura')
    {
        $fld_pos = 5                      ;
        $fld_out = 760                    ;
    }
     elsif ($fld_tag eq 'DataInizioPeriodo')
    {
        $fld_pos = 13                     ;
        $fld_out = 762                    ;
    }
     elsif ($fld_tag eq 'DataFinePeriodo')
    {
