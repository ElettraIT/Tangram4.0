    #--------------------------------------*
    # Assegnazione                         *
    #--------------------------------------*
    if     ($fld_tag eq 'AliquotaIVA')
               {$fld_out = 910}
    elsif  ($fld_tag eq 'ImponibileImporto')
               {$fld_out = 920}
    elsif  ($fld_tag eq 'Imposta')
               {$fld_out = 930}
    elsif  ($fld_tag eq 'EsigibilitaIVA')
               {$fld_out = 940}
    elsif  ($fld_tag eq 'CondizioniPagamento')
               {$fld_out = 950}
    elsif  ($fld_tag eq 'ModalitaPagamento')
               {$fld_out = 960}
    elsif  ($fld_tag eq 'DataScadenzaPagamento')
               {$fld_out = 970}
    elsif  ($fld_tag eq 'ImportoPagamento')
               {$fld_out = 980}
    elsif  ($fld_tag eq 'IBAN')
               {$fld_out = 990}
    elsif  ($fld_tag eq 'ABI')
               {$fld_out = 992}
    elsif  ($fld_tag eq 'CAB')
               {$fld_out = 994}
    elsif  ($fld_tag eq 'IstitutoFinanziario')
               {$fld_out = 996}
    elsif  ($fld_tag eq 'Beneficiario')
               {$fld_out = 998}
    elsif  ($fld_tag eq 'NomeAttachment')
               {$fld_out = 1100}
    elsif  ($fld_tag eq 'AlgoritmoCompressione')
               {$fld_out = 1110}
    elsif  ($fld_tag eq 'FormatoAttachment')
               {$fld_out = 1120}
    elsif  ($fld_tag eq 'DescrizioneAttachment')
               {$fld_out = 1130}
    elsif  ($fld_tag eq 'Attachment')
               {$fld_out = 1140}
    #--------------------------------------*
    # Valore restituito                    *
    #======================================*
    return $fld_out                       ;
}

#==========================================*
# Decodifica pagamento                     *
# Tabella ministeriale                     *
#                                          *
# 'MP01' : Contanti                        *
# 'MP02' : Assegno                         *
# 'MP03' : Assegno Circolare               *
# 'MP04' : Contanti presso Tesoreria       *
# 'MP05' : Bonifico                        *
# 'MP06' : Vaglia cambiario                *
# 'MP07' : Bollettino bancario             *
# 'MP08' : carta di pagamento              *
# 'MP09' : RID		               *				
# 'MP10' : RID utenze	               *
# 'MP11' : RID veloce			 *
# 'MP12' : RIBA				 *
# 'MP13' : MAV				 *
# 'MP14' : quietanza erario			 *
# 'MP15' : giroconto su conti di contab    *
# 'MP16' : domiciliazione bancaria		 *
# 'MP17' : domiciliazione postale		 *
# 'MP18' : bollettino di c/c postale	 *
# 'MP19' : SEPA Direct Debit		 *
# 'MP20' : SEPA Direct Debit CORE		 *
# 'MP21' : SEPA Direct Debit B2B		 *
# 'MP22' : Trattenuta su somme gia' risc.  *
#------------------------------------------*
sub dec_pag
{
    #======================================*
    # Valori in input                      *
    #--------------------------------------*
    my $cod_pag = shift                   ;
    #--------------------------------------*
    # Decodifica                           *
    #--------------------------------------*
    my $des_pag = ""                      ;
    
    if    ($cod_pag eq 'MP01'){$des_pag = "Contanti"}
    elsif ($cod_pag eq 'MP02'){$des_pag = "Assegno"}
    elsif ($cod_pag eq 'MP03'){$des_pag = "Assegno Circolare"}
    elsif ($cod_pag eq 'MP04'){$des_pag = "Contanti Tesoreria"}
    elsif ($cod_pag eq 'MP05'){$des_pag = "Bonifico"}
    elsif ($cod_pag eq 'MP06'){$des_pag = "Vaglia cambiario"}
    elsif ($cod_pag eq 'MP07'){$des_pag = "Bollettino bancario"}
    elsif ($cod_pag eq 'MP08'){$des_pag = "Carta di pagamento"}
    elsif ($cod_pag eq 'MP09'){$des_pag = "RID"}
    elsif ($cod_pag eq 'MP10'){$des_pag = "RID utenze"}
    elsif ($cod_pag eq 'MP11'){$des_pag = "RID veloce"}
    elsif ($cod_pag eq 'MP12'){$des_pag = "Riba"}
    elsif ($cod_pag eq 'MP13'){$des_pag = "MAV"}
    elsif ($cod_pag eq 'MP14'){$des_pag = "Quietanza erario"}
    elsif ($cod_pag eq 'MP15'){$des_pag = "Giroconto"}
    elsif ($cod_pag eq 'MP16'){$des_pag = "Domiciliaz. bancaria"}
    elsif ($cod_pag eq 'MP17'){$des_pag = "Domiciliazione postale"}
    elsif ($cod_pag eq 'MP18'){$des_pag = "Bollettino postale"}
    elsif ($cod_pag eq 'MP19'){$des_pag = "SEPA Direct Debit"}
    elsif ($cod_pag eq 'MP20'){$des_pag = "SEPA Direct Debit CORE"}
    elsif ($cod_pag eq 'MP21'){$des_pag = "SEPA Direct Debit B2B"}
    elsif ($cod_pag eq 'MP22'){$des_pag = "Trattenuta su somme gia' risc."}
    else {$des_pag = "(non riconosciuto)"}
    #--------------------------------------*
    # Valore restituito                    *
    #======================================*
    return $des_pag                       ;
}

#==========================================*
# Trattamento importo                      *
#------------------------------------------*
sub trt_imp
{
    #======================================*
    # Valori in input                      *
    #--------------------------------------*
    my $imp_inp = shift                   ;
    #--------------------------------------*
    # Formattazione                        *
    #--------------------------------------*
    $imp_inp =~ s/\./,/                   ;
    $imp_inp =~ s/(^[-+]?\d+?(?=(?>(?:\d{3})+)(?!\d))|\G\d{3}(?=\d))/$1./g;
    #--------------------------------------*
    # Valore restituito                    *
    #======================================*
    return $imp_inp                       ;
}

