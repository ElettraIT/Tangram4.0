#!/usr/bin/perl -w
#===============================================================*
#                                                               *
# Traduttore in formato Spreadsheet (tipo Excel)                *
#                                                               *
# Ad hoc per Bolle Clienti SIRI - CAREL                         *
#                                                               *
#                   ------------------------------------------- *
#                    Versione originale:    001 del 11/09/14    *
#                      Ultima revisione:    NdK del 18/03/15    *
#                   ------------------------------------------- *
#                                Autore:    Nicola de Kunovich  *
# ------------------------------------------------------------- *
#                                                               *
# Parametri in input : - file CSV da tradurre (percorso)        *
#                                                               *
# ------------------------------------------------------------- *
#                                                               *
# Utilizzo :                                                    *
#                                                               *
# $ t_sir_bol_xls /percorso/FILE                                *
#                                                               *
#===============================================================*

#===============================================================*
# Dichiarazione per restrizione variabili                       *
#---------------------------------------------------------------*
use strict                                                     ;

#===============================================================*
# Modulo Perl Spreadsheet::WriteExcel                           *
#---------------------------------------------------------------*
use Spreadsheet::WriteExcel                                    ;

#===============================================================*
# Lettura della variabile in input                              *
#---------------------------------------------------------------*
my $csv = $ARGV[0]                                             ;

#===============================================================*
# Open del file in input                                        *
#---------------------------------------------------------------*
&f_input                                                       ;

#===============================================================*
# Trattamento foglio                                            *
#---------------------------------------------------------------*
#    *----------------------------------------------------------*
#    * Nuovo file                                               *
#    *----------------------------------------------------------*
my $workbook  = Spreadsheet::WriteExcel->new("$csv.xlsx")      ;
my $worksheet = $workbook->add_worksheet()                     ;

#    *----------------------------------------------------------*
#    * Formattazione per celle                                  *
#    *                                                          *
#    * Bordo da 1 punto di spessore                             *
#    *----------------------------------------------------------*
my $cel_fmt = $workbook->add_format()                          ;
   $cel_fmt->set_border(1)                                     ;

#    *----------------------------------------------------------*
#    * Formattazione colonne valori                             *
#    *                                                          *
#    * Formato numero e 'bold'                                  *
#    *----------------------------------------------------------*
my $col_fmt = $workbook->add_format()                          ;
   $col_fmt->set_num_format('#,###.00')                        ;
   $col_fmt->set_bold()                                        ;

#    *----------------------------------------------------------*
#    * Formattazione colonne                                    *
#    *----------------------------------------------------------*
#        *------------------------------------------------------*
#        * WAY BILL                                             *
#        *------------------------------------------------------*
$worksheet->set_column('A:A', 10)                              ;
#        *------------------------------------------------------*
#        * SUPPLIER NUMBER (Valore fisso '2937')                *
#        *------------------------------------------------------*
$worksheet->set_column('B:B', 5)                               ;
#        *------------------------------------------------------*
#        * SUPPLIER NAME                                        *
#        *------------------------------------------------------*
$worksheet->set_column('C:C', 20)                              ;
#        *------------------------------------------------------*
#        * Colonne vuote                                        *
#        *------------------------------------------------------*
$worksheet->set_column('D:O', 5)                               ;
#        *------------------------------------------------------*
#        * SHIPPING DATE                                        *
#        *------------------------------------------------------*
$worksheet->set_column('P:P', 10)                              ;
#        *------------------------------------------------------*
#        * EXPECTED ARRIVAL DATE                                *
#        *------------------------------------------------------*
$worksheet->set_column('Q:Q', 10)                              ;
#        *------------------------------------------------------*
#        * Colonne vuote                                        *
#        *------------------------------------------------------*
$worksheet->set_column('R:R', 5)                               ;
#        *------------------------------------------------------*
#        * CAREL PO                                             *
#        *------------------------------------------------------*
$worksheet->set_column('S:S', 10)                              ;
#        *------------------------------------------------------*
#        * CAREL PO LINE                                        *
#        *------------------------------------------------------*
$worksheet->set_column('T:T', 10)                              ;
#        *------------------------------------------------------*
#        * Colonne vuote                                        *
#        *------------------------------------------------------*
$worksheet->set_column('U:U', 5)                               ;
#        *------------------------------------------------------*
#        * CAREL ITEM CODE                                      *
#        *------------------------------------------------------*
$worksheet->set_column('V:V', 20)                              ;
#        *------------------------------------------------------*
#        * Colonne vuote                                        *
#        *------------------------------------------------------*
$worksheet->set_column('W:W', 5)                               ;
#        *------------------------------------------------------*
#        * QUANTITY                                             *
#        *------------------------------------------------------*
$worksheet->set_column('X:X', 12)                              ;
#        *------------------------------------------------------*
#        * UOM                                                  *
#        *------------------------------------------------------*
$worksheet->set_column('Y:Y', 3)                               ;
#        *------------------------------------------------------*
#        * Colonne vuote                                        *
#        *------------------------------------------------------*
$worksheet->set_column('Z:AA', 5)                              ;
#        *------------------------------------------------------*
#        * PACKING SLIP NUMBER                                  *
#        *------------------------------------------------------*
$worksheet->set_column('AB:AB', 3)                             ;
#        *------------------------------------------------------*
#        * Colonne vuote                                        *
#        *------------------------------------------------------*
$worksheet->set_column('AC:AD', 5)                              ;

#    *----------------------------------------------------------*
#    * Normalizzazione contatore righe                          *
#    *----------------------------------------------------------*
my $row = 0                                                    ;

#    *----------------------------------------------------------*
#    * Ciclo di scansione                                       *
#    *----------------------------------------------------------*
while (<I_FILE>) {

#        *------------------------------------------------------*
#        * Pulizia fine riga                                    *
#        *------------------------------------------------------*
    chomp                                                      ;

#        *------------------------------------------------------*
#        * Split della riga                                     *
#        *------------------------------------------------------*
    my @Fld = split(';', $_)                                   ;

#        *------------------------------------------------------*
#        * Costruzione colonne                                  *
#        *------------------------------------------------------*
#            *--------------------------------------------------*
#            * WAY BILL (Numero documento)                      *
#            *--------------------------------------------------*
    $worksheet->write_string($row, 0, $Fld[0], $cel_fmt)       ;
#            *--------------------------------------------------*
#            * SUPPLIER NUMBER (Valore fisso '2937')            *
#            *--------------------------------------------------*
    $worksheet->write_string($row, 1, '2937', $cel_fmt)        ;
#            *--------------------------------------------------*
#            * SUPPLIER NAME (Valore fisso 'SIRI ...')          *
#            *--------------------------------------------------*
    $worksheet->write_string($row, 2, 'SIRI ELETTRONICA ' .
                                      'SPA', $cel_fmt)         ;
#            *--------------------------------------------------*
#            * Colonne vuote                                    *
#            *--------------------------------------------------*
    $worksheet->write_string($row, 3, '', $cel_fmt)            ;
    $worksheet->write_string($row, 4, '', $cel_fmt)            ;
    $worksheet->write_string($row, 5, '', $cel_fmt)            ;
    $worksheet->write_string($row, 6, '', $cel_fmt)            ;
    $worksheet->write_string($row, 7, '', $cel_fmt)            ;
    $worksheet->write_string($row, 8, '', $cel_fmt)            ;
    $worksheet->write_string($row, 9, '', $cel_fmt)            ;
    $worksheet->write_string($row, 10, '', $cel_fmt)           ;
    $worksheet->write_string($row, 11, '', $cel_fmt)           ;
    $worksheet->write_string($row, 12, '', $cel_fmt)           ;
    $worksheet->write_string($row, 13, '', $cel_fmt)           ;
    $worksheet->write_string($row, 14, '', $cel_fmt)           ;
#            *--------------------------------------------------*
#            * SHIPPING DATE (Data consegna)                    *
#            *--------------------------------------------------*
    $worksheet->write_string($row, 15, $Fld[1], $cel_fmt)      ;
#            *--------------------------------------------------*
#            * EXPECTED ARRIVAL DATE (Data consegna prevista)   *
#            *--------------------------------------------------*
    $worksheet->write_string($row, 16, $Fld[2], $cel_fmt)      ;
#            *--------------------------------------------------*
#            * Colonne vuote                                    *
#            *--------------------------------------------------*
    $worksheet->write_string($row, 17, '', $cel_fmt)           ;
#            *--------------------------------------------------*
#            * CAREL PO (Numero ordine Carel)                   *
#            *--------------------------------------------------*
    $worksheet->write_string($row, 18, $Fld[3], $cel_fmt)      ;
#            *--------------------------------------------------*
#            * CAREL PO LINE (Numero riga ordine Carel)         *
#            *--------------------------------------------------*
    $worksheet->write_string($row, 19, $Fld[4], $cel_fmt)      ;
#            *--------------------------------------------------*
#            * Colonne vuote                                    *
#            *--------------------------------------------------*
    $worksheet->write_string($row, 20, '', $cel_fmt)           ;
#            *--------------------------------------------------*
#            * CAREL ITEM CODE (Codice prodotto per Carel)      *
#            *--------------------------------------------------*
    $worksheet->write_string($row, 21, $Fld[5], $cel_fmt)      ;
#            *--------------------------------------------------*
#            * Colonne vuote                                    *
#            *--------------------------------------------------*
    $worksheet->write_string($row, 22, '', $cel_fmt)           ;
#            *--------------------------------------------------*
#            * QUANTITY (Quantita')                             *
#            *--------------------------------------------------*
    $worksheet->write_string($row, 23, $Fld[6], $cel_fmt)      ;
#            *--------------------------------------------------*
#            * UOM (Unita' di misura)                           *
#            *--------------------------------------------------*
    $worksheet->write_string($row, 24, $Fld[7], $cel_fmt)      ;
#            *--------------------------------------------------*
#            * Colonne vuote                                    *
#            *--------------------------------------------------*
    $worksheet->write_string($row, 25, '', $cel_fmt)           ;
    $worksheet->write_string($row, 26, '', $cel_fmt)           ;
#            *--------------------------------------------------*
#            * PACKING SLIP NUMBER                              *
#            *--------------------------------------------------*
    $worksheet->write_string($row, 27, '', $cel_fmt)           ;
#            *--------------------------------------------------*
#            * Colonne vuote                                    *
#            *--------------------------------------------------*
    $worksheet->write_string($row, 28, '', $cel_fmt)           ;
    $worksheet->write_string($row, 29, '', $cel_fmt)           ;
#        *------------------------------------------------------*
#        * Incremento riga                                      *
#        *------------------------------------------------------*
    $row++                                                     ;
}

#===============================================================*
# Apertura file da trattare                                     *
#---------------------------------------------------------------*
sub f_input
{
    open (I_FILE, "$csv.CSV") or die
         "Impossibile aprire il file '$csv.CSV'"               ;
}

#===============================================================*
# Chiusura file da trattare                                     *
#---------------------------------------------------------------*
close I_FILE                                                   ;

